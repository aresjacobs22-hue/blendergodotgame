--!strict
-- The five nights: map, vibe, monster and objective for each. This is the file to
-- edit if you want to rebalance a night.

local Config = require(script.Parent.Config)

export type MazeParams = {
	CellSize: number,
	WallHeight: number,
	CeilingHeight: number,
	DoorHeight: number,
	Width: number,
	Depth: number,
	Hub: string, -- "house" (fixed 5x3 blueprint) or "hall" (one open room)
	HubWidth: number,
	HubDepth: number,
	DeadEndBraid: number,
	ExtraOpenings: number,
	Openness: number, -- fraction of the remaining inner walls knocked down (open halls)
	Rooms: number, -- 2x2 rooms carved into the maze
	RoomDoors: boolean,
	SpotCount: number, -- objective items (keys, generators, photos, hearts)
	BatteryCount: number,
	LockerCount: number,
	LampChance: number,
	LampSpacing: number,
	WritingCount: number,
}

export type Lighting = {
	Ambient: Color3,
	FogColor: Color3,
	FogStart: number,
	FogEnd: number,
	Saturation: number,
	Contrast: number,
	Brightness: number,
	Tint: Color3,
	Bloom: number,
	Exposure: number,
	LampColor: Color3,
	Reverb: string,
}

export type Night = {
	index: number,
	id: string,
	name: string,
	place: string, -- short location line for the menu card
	vibe: string,
	accent: Color3, -- menu / UI accent colour
	objective: string, -- "survive" | "keys" | "power" | "collect" | "hearts"
	objectiveText: string,
	objectiveCount: number,
	surviveSeconds: number?, -- survive nights: real seconds from 12 AM to 6 AM
	theme: string,
	monsterKind: string,
	monsterName: string,
	monsterBlurb: string,
	monster: { [string]: any }, -- overrides for Config.Monster
	maze: MazeParams,
	lighting: Lighting,
	ambiencePitch: number,
	intro: { string },
	tips: { string },
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

