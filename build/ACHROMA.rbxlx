			LampSpacing = 3,
			WritingCount = 10,
		},
		lighting = {
			Ambient = rgb(5, 5, 5),
			FogColor = rgb(3, 3, 3),
			FogStart = 5,
			FogEnd = 95,
			Saturation = -1,
			Contrast = 0.22,
			Brightness = 0.01,
			Tint = rgb(255, 255, 255),
			Bloom = 0.7,
			Exposure = 0.15,
			LampColor = rgb(255, 240, 220),
			Reverb = "StoneCorridor",
		},
	},
	{
		index = 2,
		id = "ward",
		name = "THE RED WARD",
		objective = "keys",
		objectiveCount = 4,
		theme = "ward",
		monsterKind = "Crawler",
		monster = {
			WanderSpeed = 10,
			InvestigateSpeed = 14,
			SearchSpeed = 12,
			ChaseSpeed = 16.5,
			ChaseSpeedPerProgress = 0.4,
			SightRange = 52,
			SightRangeFlashlight = 70,
			ViewDot = 0.45,
			LoseSightTime = 1.6,
			LungeRange = 16,
			LungeBonus = 9,
			AwakenAfter = 60,
		},
		maze = {
			CellSize = 12,
