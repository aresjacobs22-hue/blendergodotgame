			Hub = "hall",
			HubWidth = 3,
			HubDepth = 2,
			DeadEndBraid = 1,
			ExtraOpenings = 10,
			Openness = 0.55,
			Rooms = 0,
			RoomDoors = false,
			SpotCount = 6,
			BatteryCount = 2,
			LockerCount = 0,
			LampChance = 0.75,
			LampSpacing = 2,
			WritingCount = 8,
		},
		lighting = {
			Ambient = rgb(20, 22, 28),
			FogColor = rgb(120, 135, 160),
			FogStart = 30,
			FogEnd = 230,
			Saturation = -0.55,
