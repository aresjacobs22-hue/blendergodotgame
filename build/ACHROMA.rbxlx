  <Item class="ServerScriptService" referent="27">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="28">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict
-- Building blocks shared by every map theme: parts, wall slabs, doorways, lamps,
-- signs, notes, writing. One context per map build (cell size and wall height vary
-- per night).

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)

export type Style = { material: Enum.Material, color: Color3, reflect: number? }
export type Note = { part: BasePart, text: string }
export type Lamp = { bulb: BasePart, light: Light, cell: Maze.Cell? }

export type Ctx = {
	layout: Maze.Layout,
	night: Nights.Night,
	C: number, -- cell size
	H: number, -- wall height
	ceiling: number, -- ceiling height
	T: number, -- wall thickness
	doorWidth: number,
	doorHeight: number,
	exitWidth: number,
	exitHeight: number,
	random: Random,
	structure: Folder,
	props: Folder,
	lights: Folder,
	notes: { Note },
	lamps: { Lamp },
	hubOrigin: Vector3, -- world position of the hub's south-west corner

	part: (parent: Instance, name: string, size: Vector3, cframe: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?) -> Part,
	decor: (p: BasePart) -> BasePart,
	vary: (color: Color3, amount: number?) -> Color3,
	styled: (parent: Instance, name: string, size: Vector3, cframe: CFrame, style: Style) -> Part,
	edgeFrame: (x: number, z: number, dir: string) -> CFrame,
	sideFrame: (x: number, z: number, side: string) -> CFrame,
	cellCenter: (x: number, z: number) -> Vector3,
	wallSides: (x: number, z: number) -> { string },
	sign: (frame: CFrame, size: Vector2, text: string, textColor: Color3, background: Color3?, glow: boolean?, font: Enum.Font?) -> Part,
	note: (cframe: CFrame, text: string) -> Part,
	writing: (frame: CFrame, text: string, color: Color3, font: Enum.Font, glow: boolean) -> (),
	addLamp: (bulb: BasePart, light: Light, cell: Maze.Cell?) -> (),
}

local Build = {}

local groupsReady = false

-- The monster walks through furniture (its paths cut through the middle of rooms);
-- players, line of sight and flashlight shadows still treat furniture as solid.
function Build.setupCollisionGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	PhysicsService:RegisterCollisionGroup("Monster")
	PhysicsService:RegisterCollisionGroup("Furniture")
	PhysicsService:CollisionGroupSetCollidable("Monster", "Furniture", false)
end

function Build.markFurniture(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Furniture"
		end
	end
end

function Build.new(layout: Maze.Layout, night: Nights.Night, model: Model): Ctx
	local m = night.maze
	local C = m.CellSize
	local H = m.WallHeight
	local T = Config.Maze.WallThickness
	local random = Random.new(layout.seed)
	local ROT90 = CFrame.Angles(0, math.rad(90), 0)

	local structure = Instance.new("Folder")
	structure.Name = "Structure"
	structure.Parent = model
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = model
	local lights = Instance.new("Folder")
	lights.Name = "Lights"
	lights.Parent = model

	local ctx: Ctx = {} :: any
	ctx.layout = layout
	ctx.night = night
	ctx.C = C
	ctx.H = H
	ctx.ceiling = m.CeilingHeight
	ctx.T = T
	ctx.doorWidth = 5.5
	ctx.doorHeight = math.min(m.DoorHeight, H - 1)
	ctx.exitWidth = 7
	ctx.exitHeight = math.min(m.DoorHeight + 0.5, H - 1)
	ctx.random = random
	ctx.structure = structure
	ctx.props = props
	ctx.lights = lights
	ctx.notes = {}
	ctx.lamps = {}
	ctx.hubOrigin = Vector3.new(layout.hub.x0 * C, 0, layout.hub.z0 * C)

	function ctx.part(parent: Instance, name: string, size: Vector3, cframe: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = cframe
		p.Material = material
		p.Color = color
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		p.Parent = parent
		return p
	end

	-- decorative parts never block movement or line of sight
	function ctx.decor(p: BasePart): BasePart
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		return p
	end

	function ctx.vary(color: Color3, amount: number?): Color3
		local f = 1 + random:NextNumber(-1, 1) * (amount or 0.06)
		return Color3.new(math.clamp(color.R * f, 0, 1), math.clamp(color.G * f, 0, 1), math.clamp(color.B * f, 0, 1))
	end

	function ctx.styled(parent: Instance, name: string, size: Vector3, cframe: CFrame, style: Style): Part
		local p = ctx.part(parent, name, size, cframe, style.material, ctx.vary(style.color), nil)
		if style.reflect then
			p.Reflectance = style.reflect
		end
		return p
	end

	-- Frame on the edge an owner cell holds ("N" or "E"). Its Front face (-Z) looks
	-- into the owner cell, its Back face into the neighbour. Y = floor level.
	function ctx.edgeFrame(x: number, z: number, dir: string): CFrame
		if dir == "N" then
			return CFrame.new((x + 0.5) * C, 0, (z + 1) * C)
		end
		return CFrame.new((x + 1) * C, 0, (z + 0.5) * C) * ROT90
	end

	-- Frame on the inside face of one of a cell's walls, looking into the cell.
	function ctx.sideFrame(x: number, z: number, side: string): CFrame
		local ox, oz = Maze.DX[side], Maze.DZ[side]
		local pos = Vector3.new((x + 0.5 + ox * 0.5) * C - ox * T / 2, 0, (z + 0.5 + oz * 0.5) * C - oz * T / 2)
		return CFrame.lookAt(pos, pos - Vector3.new(ox, 0, oz))
	end

	function ctx.cellCenter(x: number, z: number): Vector3
		return Vector3.new((x + 0.5) * C, 0, (z + 0.5) * C)
	end

	function ctx.wallSides(x: number, z: number): { string }
		local sides = {}
		for _, d in Maze.DIRS do
			if Maze.getEdge(layout, x, z, d) == "wall" then
				table.insert(sides, d)
			end
		end
		return sides
	end

	-- A flat sign (text on a panel). frame looks out from the surface it's mounted on.
	function ctx.sign(frame: CFrame, size: Vector2, text: string, textColor: Color3, background: Color3?, glow: boolean?, font: Enum.Font?): Part
		local panel = ctx.part(props, "Sign", Vector3.new(size.X, size.Y, 0.08), frame, if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic, background or Color3.new(0, 0, 0), nil)
		ctx.decor(panel)
		panel.CastShadow = false
		if not background then
			panel.Transparency = 1
		end
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = if glow then 0 else 1
		gui.Parent = panel
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = font or Enum.Font.GothamBold
		label.Text = text
		label.TextScaled = true
		label.TextColor3 = textColor
		label.Parent = gui
		return panel
	end

	-- A readable note (players get a "Read" prompt on it).
	function ctx.note(cframe: CFrame, text: string): Part
		local p = ctx.part(props, "Note", Vector3.new(1.3, 0.05, 1.7), cframe, Enum.Material.SmoothPlastic, Color3.fromRGB(215, 210, 196), nil)
		p.CanCollide = false
		table.insert(ctx.notes, { part = p :: BasePart, text = text })
		return p
	end

	function ctx.writing(frame: CFrame, text: string, color: Color3, font: Enum.Font, glow: boolean)
		local canvas = ctx.decor(ctx.part(props, "Writing", Vector3.new(9, 4.4, 0.05), frame, Enum.Material.SmoothPlastic, Color3.new(0, 0, 0), nil))
		canvas.Transparency = 1
		canvas.CastShadow = false
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = if glow then 0 else 1 -- normally only readable by flashlight
		gui.Brightness = if glow then 2 else 1
		gui.Parent = canvas
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = font
		label.Text = text
		label.TextScaled = true
		label.TextColor3 = color
		label.TextTransparency = random:NextNumber(0.05, 0.25)
		label.Rotation = random:NextNumber(-7, 7)
		label.Parent = gui
	end

	-- Register a light so clients flicker it and objectives can power it.
	function ctx.addLamp(bulb: BasePart, light: Light, cell: Maze.Cell?)
		bulb:SetAttribute("BaseBrightness", light.Brightness)
		CollectionService:AddTag(bulb, "FlickerLight")
		table.insert(ctx.lamps, { bulb = bulb, light = light, cell = cell })
	end

	return ctx
end

-- Wall slab along an edge. Walls between two styles are two half-thickness layers so
-- each side gets its own material.
function Build.wallBox(ctx: Ctx, parent: Instance, frame: CFrame, length: number, height: number, yBottom: number, xOffset: number, front: Style, back: Style)
	if length <= 0.05 or height <= 0.05 then
		return
	end
	local T = ctx.T
	local y = yBottom + height / 2
	if front == back then
		ctx.styled(parent, "Wall", Vector3.new(length, height, T), frame * CFrame.new(xOffset, y, 0), front)
	else
		ctx.styled(parent, "Wall", Vector3.new(length, height, T / 2), frame * CFrame.new(xOffset, y, -T / 4), front)
		ctx.styled(parent, "Wall", Vector3.new(length, height, T / 2), frame * CFrame.new(xOffset, y, T / 4), back)
	end
end

function Build.wallWithOpening(ctx: Ctx, parent: Instance, frame: CFrame, width: number, height: number, front: Style, back: Style)
	local length = ctx.C - ctx.T
	local side = (length - width) / 2
	Build.wallBox(ctx, parent, frame, side, ctx.H, 0, -(width + side) / 2, front, back)
	Build.wallBox(ctx, parent, frame, side, ctx.H, 0, (width + side) / 2, front, back)
	Build.wallBox(ctx, parent, frame, width, ctx.H - height, height, 0, front, back)
end

function Build.doorTrim(ctx: Ctx, parent: Instance, frame: CFrame, width: number, height: number, style: Style)
	local depth = ctx.T + 0.3
	for _, sx in { -1, 1 } do
		ctx.part(parent, "Trim", Vector3.new(0.45, height, depth), frame * CFrame.new(sx * (width / 2 + 0.2), height / 2, 0), style.material, style.color, nil)
	end
	ctx.part(parent, "Trim", Vector3.new(width + 0.85, 0.45, depth), frame * CFrame.new(0, height + 0.2, 0), style.material, style.color, nil)
end

function Build.brokenWall(ctx: Ctx, parent: Instance, frame: CFrame, front: Style, back: Style)
	local random = ctx.random
	local width, height = 6, math.min(9.5, ctx.H - 1.5)
	Build.wallWithOpening(ctx, parent, frame, width, height, front, back)
	for _ = 1, 5 do
		local sx = if random:NextNumber() < 0.5 then -1 else 1
		local size = Vector3.new(random:NextNumber(0.6, 1.6), random:NextNumber(0.8, 2.4), ctx.T * 0.9)
		local p = ctx.part(parent, "Chunk", size, frame * CFrame.new(sx * (width / 2 - size.X / 2 + 0.3), random:NextNumber(0.5, height), 0) * CFrame.Angles(0, 0, random:NextNumber(-0.5, 0.5)), front.material, ctx.vary(front.color), nil)
		p.CanCollide = false
	end
	for _ = 1, 9 do
		local s = random:NextNumber(0.4, 1.3)
		ctx.decor(ctx.part(parent, "Rubble", Vector3.new(s, s * 0.6, s * random:NextNumber(0.7, 1.3)), frame * CFrame.new(random:NextNumber(-width, width) * 0.6, s * 0.25, random:NextNumber(-3, 3)) * CFrame.Angles(random:NextNumber(-0.4, 0.4), random:NextNumber(0, 6.28), random:NextNumber(-0.4, 0.4)), front.material, ctx.vary(front.color, 0.15), nil))
	end
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Exit</string>
          <string name="Source"><![CDATA[--!strict
-- The way out, in the hub's south wall. Styles:
--   double  two heavy doors that swing outward (house, ward)
--   grand   the same, tall and bronze (atrium)
--   lift    two steel doors that slide apart (sewer)
--   portal  a dark membrane that dissolves (void)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local WorldBuilder = require(script.Parent.WorldBuilder)

type World = WorldBuilder.World

local Exit = {}
Exit.__index = Exit

export type Exit = typeof(setmetatable(
	{} :: {
		world: World,
		style: string,
		frame: CFrame,
		folder: Folder,
		leaves: { { part: BasePart, opened: CFrame } },
		membrane: BasePart?,
		isOpen: boolean,
		width: number,
		height: number,
	},
	Exit
))

function Exit.new(world: World): Exit
	local ctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Exit"
	folder.Parent = world.model
	local style = world.theme.exitStyle
	local frame = world.exitFrame
	local w, h = ctx.exitWidth, ctx.exitHeight

	local self = setmetatable({
		world = world,
		style = style,
		frame = frame,
		folder = folder,
		leaves = {},
		membrane = nil :: BasePart?,
		isOpen = false,
		width = w,
		height = h,
	}, Exit)

	if style == "portal" then
		local membrane = ctx.part(folder, "Membrane", Vector3.new(w, h, 0.3), frame * CFrame.new(0, h / 2, 0), Enum.Material.Neon, Color3.fromRGB(40, 0, 60), nil)
		membrane.Transparency = 0.1
		membrane.CastShadow = true
		self.membrane = membrane
	else
		local material = Enum.Material.DiamondPlate
		local color = Color3.fromRGB(86, 86, 90)
		if style == "grand" then
			material = Enum.Material.Metal
			color = Color3.fromRGB(150, 112, 60)
		elseif style == "lift" then
			material = Enum.Material.Metal
			color = Color3.fromRGB(120, 124, 126)
		elseif world.night.theme == "ward" then
			material = Enum.Material.Metal
			color = Color3.fromRGB(190, 192, 194)
		end
		for _, sx in { -1, 1 } do
			local closed = frame * CFrame.new(sx * w / 4, h / 2 + 0.02, 0)
			local opened: CFrame
			if style == "lift" then
				opened = closed * CFrame.new(sx * (w / 2 - 0.3), 0, 0)
			else
				local hinge = frame * CFrame.new(sx * w / 2, h / 2 + 0.02, 0)
				opened = hinge * CFrame.Angles(0, math.rad(-sx * 95), 0) * hinge:Inverse() * closed
			end
			local leaf = ctx.part(folder, "ExitDoor", Vector3.new(w / 2 - 0.08, h - 0.05, 0.5), closed, material, color, nil)
			if world.night.theme == "ward" then
				-- round porthole windows
				local window = ctx.part(folder, "Porthole", Vector3.new(0.6, 1.3, 1.3), closed * CFrame.new(0, h * 0.18, 0) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Glass, Color3.fromRGB(40, 10, 10), Enum.PartType.Cylinder)
				window.Anchored = false
				window.CanCollide = false
				window.Massless = true
				window.Transparency = 0.3
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = leaf
				weld.Part1 = window
				weld.Parent = window
			end
			table.insert(self.leaves, { part = leaf :: BasePart, opened = opened })
		end
	end
	return self
end

-- Where to hang padlocks / mount a keypad: frame offsets on the hub side.
function Exit.hubSide(self: Exit, x: number, y: number): CFrame
	return self.frame * CFrame.new(x, y, 0.5)
end

function Exit.open(self: Exit)
	if self.isOpen then
		return
	end
	self.isOpen = true
	local anchor = if self.membrane then self.membrane else self.leaves[1].part
	Audio.play("Unlock", anchor, 1.2, 1, 120)
	task.delay(0.6, function()
		if not self.folder.Parent then
			return
		end
		local membrane = self.membrane
		if membrane then
			membrane.CanCollide = false
			TweenService:Create(membrane, TweenInfo.new(2, Enum.EasingStyle.Sine), { Transparency = 1 }):Play()
			Audio.play("HeartShatter", membrane, 1, 0.6, 140)
		else
			for _, leaf in self.leaves do
				TweenService:Create(leaf.part, TweenInfo.new(if self.style == "lift" then 2 else 2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = leaf.opened }):Play()
			end
			Audio.play("DoorOpen", anchor, 1.4, if self.style == "lift" then 0.8 else 0.55, 140)
		end
		self.world.exitLight.Enabled = true
	end)
end

return Exit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">Interactables</string>
          <string name="Source"><![CDATA[--!strict
-- Things every map has: hinged doors, batteries, hiding lockers and readable notes.
-- (The exit lives in Exit.luau; keys, generators, photos and hearts in Objectives.)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes

type Layout = Maze.Layout
type World = WorldBuilder.World

export type Door = {
	part: BasePart,
	closed: CFrame,
	opened: CFrame,
	isOpen: boolean,
	busy: boolean,
	prompt: ProximityPrompt,
}

export type Locker = {
	model: Model,
	anchor: BasePart,
	inside: CFrame,
	outside: CFrame,
	occupant: Player?,
	prompt: ProximityPrompt,
	lastUse: number,
}

export type Hooks = {
	onHide: (player: Player, locker: Locker) -> (),
	onNoise: (position: Vector3, radius: number) -> (),
	isAlive: (player: Player) -> boolean,
}

local Interactables = {}
Interactables.__index = Interactables

export type Interactables = typeof(setmetatable(
	{} :: {
		layout: Layout,
		world: World,
		hooks: Hooks,
		folder: Folder,
		doors: { Door },
		lockers: { Locker },
		connections: { RBXScriptConnection },
	},
	Interactables
))

function Interactables.prompt(parent: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = distance or 8
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end
local prompt = Interactables.prompt

function Interactables.rootOf(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local rootOf = Interactables.rootOf

function Interactables.new(layout: Layout, world: World, hooks: Hooks): Interactables
	local folder = Instance.new("Folder")
	folder.Name = "Interactive"
	folder.Parent = world.model

	local self = setmetatable({
		layout = layout,
		world = world,
		hooks = hooks,
		folder = folder,
		doors = {},
		lockers = {},
		connections = {},
	}, Interactables)

	self:_buildDoors()
	self:_buildBatteries()
	self:_buildLockers()
	self:_buildNotes()

	table.insert(self.connections, Remotes.LeaveHiding.OnServerEvent:Connect(function(player: Player)
		self:leave(player, false)
	end))
	return self
end

-- Doors ------------------------------------------------------------------------

function Interactables._buildDoors(self: Interactables)
	local ctx = self.world.ctx
	for key, kind in self.layout.edges do
		if kind == "door" then
			local x, z, dir = Maze.parseEdgeKey(key)
			local frame = ctx.edgeFrame(x, z, dir)
			local w, h = ctx.doorWidth - 0.2, ctx.doorHeight - 0.15
			local closed = frame * CFrame.new(0, h / 2 + 0.05, 0)
			local hinge = frame * CFrame.new(-w / 2, h / 2 + 0.05, 0)
			local opened = hinge * CFrame.Angles(0, math.rad(-100), 0) * hinge:Inverse() * closed

			local style = self.world.theme.trim
			local door = ctx.part(self.folder, "Door", Vector3.new(w, h, 0.35), closed, if style.material == Enum.Material.Neon then Enum.Material.Basalt else style.material, if style.material == Enum.Material.Neon then Color3.fromRGB(20, 16, 26) else style.color, nil)
			door.CollisionGroup = "Furniture"
			for _, side in { -1, 1 } do
				local knob = ctx.part(self.folder, "Knob", Vector3.new(0.35, 0.35, 0.35), closed * CFrame.new(w / 2 - 0.6, -0.7, side * 0.3), Enum.Material.Metal, Color3.fromRGB(170, 170, 160), Enum.PartType.Ball)
				knob.Anchored = false
				knob.CanCollide = false
				knob.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = door
				weld.Part1 = knob
				weld.Parent = knob
			end

			local entry: Door = {
				part = door,
				closed = closed,
				opened = opened,
				isOpen = false,
				busy = false,
				prompt = prompt(door, "Open", "Door", 0, 9),
			}
			table.insert(self.doors, entry)
			if self.world.random:NextNumber() < 0.35 then
				entry.isOpen = true
				door.CFrame = opened
				entry.prompt.ActionText = "Close"
			end
			entry.prompt.Triggered:Connect(function(player: Player)
				if self.hooks.isAlive(player) then
					self:setDoor(entry, not entry.isOpen, false)
					if not entry.isOpen then
						self.hooks.onNoise(door.Position, 30) -- shutting a door carries
					end
				end
			end)
		end
	end
end

function Interactables.setDoor(self: Interactables, door: Door, open: boolean, slam: boolean)
	if door.busy or door.isOpen == open then
		return
	end
	door.busy = true
	door.isOpen = open
	local info = if slam
		then TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(door.part, info, { CFrame = if open then door.opened else door.closed })
	tween:Play()
	if slam then
		Audio.play("DoorSlam", door.part, 1.3, 1, 110)
	elseif open then
		Audio.play("DoorOpen", door.part, 0.8, 1, 60)
	else
		Audio.play("DoorSlam", door.part, 0.5, 1.25, 60)
	end
	door.prompt.ActionText = if open then "Close" else "Open"
	tween.Completed:Once(function()
		door.busy = false
	end)
end

-- The monster bursts through closed doors in its way.
function Interactables.slamOpenNear(self: Interactables, position: Vector3, radius: number)
	for _, door in self.doors do
		if not door.isOpen and not door.busy and (door.part.Position - position).Magnitude < radius then
			self:setDoor(door, true, true)
		end
	end
end

-- Spot helpers -----------------------------------------------------------------

-- The wall at the back of a cell (opposite its way in), for placing things.
function Interactables.backWallSide(layout: Layout, x: number, z: number): string
	for _, d in Maze.DIRS do
		if Maze.isPassable(Maze.getEdge(layout, x, z, d)) then
			local back = Maze.OPPOSITE[d]
			if Maze.getEdge(layout, x, z, back) == "wall" then
				return back
			end
		end
	end
	for _, d in Maze.DIRS do
		if Maze.getEdge(layout, x, z, d) == "wall" then
			return d
		end
	end
	return "N"
end

-- A frame to put an objective item in a cell: against its back wall if it has one,
-- otherwise on the floor near the middle (open halls).
function Interactables.spotFrame(world: World, cell: Maze.Cell): CFrame
	local ctx = world.ctx
	for _, d in Maze.DIRS do
		if Maze.getEdge(world.ctx.layout, cell.x, cell.z, d) == "wall" then
			return ctx.sideFrame(cell.x, cell.z, Interactables.backWallSide(world.ctx.layout, cell.x, cell.z)) * CFrame.new(0, 0, -1.8)
		end
	end
	local center = ctx.cellCenter(cell.x, cell.z)
	return CFrame.new(center + Vector3.new(ctx.C * 0.2, 0, ctx.C * 0.2)) * CFrame.Angles(0, world.random:NextNumber(0, 6.28), 0)
end

-- Batteries --------------------------------------------------------------------

function Interactables._buildBatteries(self: Interactables)
	local ctx = self.world.ctx
	for _, cell in self.layout.batteries do
		local frame = Interactables.spotFrame(self.world, cell) * CFrame.new(self.world.random:NextNumber(-2.5, 2.5), 0, 1.1)
		local battery = ctx.decor(ctx.part(self.folder, "Battery", Vector3.new(1.1, 0.5, 0.5), frame * CFrame.new(0, 0.26, 0) * CFrame.Angles(0, self.world.random:NextNumber(-0.6, 0.6), 0), Enum.Material.Metal, Color3.fromRGB(70, 70, 70), Enum.PartType.Cylinder))
		battery.CanQuery = true
		ctx.decor(ctx.part(battery, "BatteryCap", Vector3.new(0.12, 0.3, 0.3), battery.CFrame * CFrame.new(0.6, 0, 0), Enum.Material.Metal, Color3.fromRGB(200, 200, 200), Enum.PartType.Cylinder))
		local glint = Instance.new("PointLight")
		glint.Range = 4
		glint.Brightness = 0.5
		glint.Parent = battery
		local p = prompt(battery, "Take", "Battery", 0, 8)
		p.Triggered:Connect(function(player: Player)
			if not self.hooks.isAlive(player) or battery.Parent == nil then
				return
			end
			battery:Destroy()
			Remotes.Battery:FireClient(player, Config.Player.BatteryPickup)
		end)
	end
end

-- Hiding lockers -----------------------------------------------------------------

function Interactables._buildLockers(self: Interactables)
	local ctx = self.world.ctx
	local themeLocker = self.world.theme.locker
	for _, spot in self.layout.lockers do
		local w, h, depth = 4.2, 8.4, 3.4
		local center = ctx.sideFrame(spot.x, spot.z, spot.side) * CFrame.new(0, 0, -depth / 2)
		local material = if spot.house then Enum.Material.Wood else themeLocker.material
		local color = if spot.house then Color3.fromRGB(70, 58, 50) else themeLocker.color

		local model = Instance.new("Model")
		model.Name = if spot.house then "Wardrobe" else "Locker"
		local function panel(name: string, size: Vector3, offset: CFrame)
			local p = ctx.part(model, name, size, center * offset, material, color, nil)
			p.CollisionGroup = "Furniture"
		end
		panel("Back", Vector3.new(w, h, 0.2), CFrame.new(0, h / 2, depth / 2 - 0.1))
		panel("Side", Vector3.new(0.2, h, depth), CFrame.new(-(w / 2 - 0.1), h / 2, 0))
		panel("Side", Vector3.new(0.2, h, depth), CFrame.new(w / 2 - 0.1, h / 2, 0))
		panel("Top", Vector3.new(w, 0.2, depth), CFrame.new(0, h - 0.1, 0))
		panel("Bottom", Vector3.new(w, 0.2, depth), CFrame.new(0, 0.1, 0))
		-- slatted front: you can peek out between the slats
		local y = 0.45
		while y < h - 0.3 do
			panel("Slat", Vector3.new(w - 0.4, 0.44, 0.15), CFrame.new(0, y, -depth / 2 + 0.08))
			y += 0.62
		end
		panel("Handle", Vector3.new(0.18, 1.2, 0.2), CFrame.new(w / 2 - 0.6, 4.2, -depth / 2 - 0.08))

		local anchor = ctx.decor(ctx.part(model, "PromptAnchor", Vector3.new(1, 1, 1), center * CFrame.new(0, 3.5, -depth / 2 - 0.3), Enum.Material.SmoothPlastic, Color3.new(), nil))
		anchor.Transparency = 1
		model.Parent = self.folder

		local locker: Locker = {
			model = model,
			anchor = anchor,
			inside = center * CFrame.new(0, 3.1, 0.15),
			outside = center * CFrame.new(0, 3.1, -(depth / 2 + 2.6)),
			occupant = nil,
			prompt = prompt(anchor, "Hide", if spot.house then "Wardrobe" else "Locker", 0.25, 7),
			lastUse = -math.huge,
		}
		table.insert(self.lockers, locker)
		locker.prompt.Triggered:Connect(function(player: Player)
			self:hide(player, locker)
		end)
	end
end

function Interactables.lockerOf(self: Interactables, player: Player): Locker?
	for _, locker in self.lockers do
		if locker.occupant == player then
			return locker
		end
	end
	return nil
end

function Interactables.hide(self: Interactables, player: Player, locker: Locker)
	if locker.occupant or os.clock() - locker.lastUse < 0.8 then
		return
	end
	if not self.hooks.isAlive(player) or self:lockerOf(player) then
		return
	end
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return
	end
	locker.occupant = player
	locker.lastUse = os.clock()
	root.Anchored = true
	character:PivotTo(locker.inside)
	player:SetAttribute("Hiding", true)
	locker.prompt.Enabled = false
	Audio.play("Locker", locker.anchor, 0.9, 1, 60)
	self.hooks.onHide(player, locker)
end

-- pulled = the monster dragged them out, so they stay frozen for the jumpscare.
function Interactables.leave(self: Interactables, player: Player, pulled: boolean)
	local locker = self:lockerOf(player)
	if not locker then
		return
	end
	if not pulled and os.clock() - locker.lastUse < 0.5 then
		return
	end
	locker.occupant = nil
	locker.lastUse = os.clock()
	locker.prompt.Enabled = true
	player:SetAttribute("Hiding", false)
	local character = player.Character
	local root = rootOf(player)
	if character and root then
		character:PivotTo(locker.outside)
		if not pulled then
			root.Anchored = false
		end
	end
	Audio.play("Locker", locker.anchor, if pulled then 1.4 else 0.8, if pulled then 0.8 else 1.05, 70)
end

function Interactables.release(self: Interactables, player: Player)
	local locker = self:lockerOf(player)
	if locker then
		locker.occupant = nil
		locker.prompt.Enabled = true
	end
	player:SetAttribute("Hiding", false)
end

-- Notes --------------------------------------------------------------------------

function Interactables._buildNotes(self: Interactables)
	for _, note in self.world.notes do
		note.part.CanQuery = true
		local p = prompt(note.part, "Read", "Note", 0, 7)
		p.Triggered:Connect(function(player: Player)
			Remotes.Notify:FireClient(player, note.text, "note")
		end)
	end
end

function Interactables.destroy(self: Interactables)
	for _, c in self.connections do
		c:Disconnect()
	end
	table.clear(self.connections)
	for _, locker in self.lockers do
		if locker.occupant then
			locker.occupant:SetAttribute("Hiding", false)
		end
	end
end

return Interactables
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="32">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
