  <Item class="ServerScriptService" referent="31">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[--!strict
-- Building blocks shared by every map theme: parts, wall slabs, doorways, lamps,
-- signs, notes, writing. One context per map build (cell size and wall height vary
-- per night).

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)

export type Style = { material: Enum.Material, color: Color3, reflect: number? }
export type Lamp = { bulb: BasePart, light: Light, cell: Maze.Cell? }

export type Ctx = {
	layout: Maze.Layout,
	night: Nights.Night,
	C: number, -- cell size
	H: number, -- wall height
	ceiling: number, -- ceiling height
	T: number, -- wall thickness
	doorWidth: number,
	doorHeight: number,
	exitWidth: number,
	exitHeight: number,
	random: Random,
	structure: Folder,
	props: Folder,
	lights: Folder,
	lamps: { Lamp },
	hubOrigin: Vector3, -- world position of the hub's south-west corner

	part: (parent: Instance, name: string, size: Vector3, cframe: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?) -> Part,
	decor: (p: BasePart) -> BasePart,
	vary: (color: Color3, amount: number?) -> Color3,
	styled: (parent: Instance, name: string, size: Vector3, cframe: CFrame, style: Style) -> Part,
	edgeFrame: (x: number, z: number, dir: string) -> CFrame,
	sideFrame: (x: number, z: number, side: string) -> CFrame,
	cellCenter: (x: number, z: number) -> Vector3,
	wallSides: (x: number, z: number) -> { string },
	sign: (frame: CFrame, size: Vector2, text: string, textColor: Color3, background: Color3?, glow: boolean?, font: Enum.Font?) -> Part,
	note: (cframe: CFrame) -> Part,
	writing: (frame: CFrame, text: string, color: Color3, font: Enum.Font, glow: boolean) -> (),
	addLamp: (bulb: BasePart, light: Light, cell: Maze.Cell?) -> (),
}

local Build = {}

local groupsReady = false

-- The monster walks through furniture (its paths cut through the middle of rooms);
-- players, line of sight and flashlight shadows still treat furniture as solid.
function Build.setupCollisionGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	PhysicsService:RegisterCollisionGroup("Monster")
	PhysicsService:RegisterCollisionGroup("Furniture")
	PhysicsService:CollisionGroupSetCollidable("Monster", "Furniture", false)
end

function Build.markFurniture(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Furniture"
		end
	end
end

function Build.new(layout: Maze.Layout, night: Nights.Night, model: Model): Ctx
	local m = night.maze
	local C = m.CellSize
	local H = m.WallHeight
	local T = Config.Maze.WallThickness
	local random = Random.new(layout.seed)
	local ROT90 = CFrame.Angles(0, math.rad(90), 0)

	local structure = Instance.new("Folder")
	structure.Name = "Structure"
	structure.Parent = model
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = model
	local lights = Instance.new("Folder")
	lights.Name = "Lights"
	lights.Parent = model

	local ctx: Ctx = {} :: any
	ctx.layout = layout
	ctx.night = night
	ctx.C = C
	ctx.H = H
	ctx.ceiling = m.CeilingHeight
	ctx.T = T
	ctx.doorWidth = 5.5
	ctx.doorHeight = math.min(m.DoorHeight, H - 1)
	ctx.exitWidth = 7
	ctx.exitHeight = math.min(m.DoorHeight + 0.5, H - 1)
	ctx.random = random
	ctx.structure = structure
	ctx.props = props
	ctx.lights = lights
	ctx.lamps = {}
	ctx.hubOrigin = Vector3.new(layout.hub.x0 * C, 0, layout.hub.z0 * C)

	function ctx.part(parent: Instance, name: string, size: Vector3, cframe: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = cframe
		p.Material = material
		p.Color = color
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		p.Parent = parent
		return p
	end

	-- decorative parts never block movement or line of sight
	function ctx.decor(p: BasePart): BasePart
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		return p
	end

	function ctx.vary(color: Color3, amount: number?): Color3
		local f = 1 + random:NextNumber(-1, 1) * (amount or 0.06)
		return Color3.new(math.clamp(color.R * f, 0, 1), math.clamp(color.G * f, 0, 1), math.clamp(color.B * f, 0, 1))
	end

	function ctx.styled(parent: Instance, name: string, size: Vector3, cframe: CFrame, style: Style): Part
		local p = ctx.part(parent, name, size, cframe, style.material, ctx.vary(style.color), nil)
		if style.reflect then
			p.Reflectance = style.reflect
		end
		return p
	end

	-- Frame on the edge an owner cell holds ("N" or "E"). Its Front face (-Z) looks
	-- into the owner cell, its Back face into the neighbour. Y = floor level.
	function ctx.edgeFrame(x: number, z: number, dir: string): CFrame
		if dir == "N" then
			return CFrame.new((x + 0.5) * C, 0, (z + 1) * C)
		end
		return CFrame.new((x + 1) * C, 0, (z + 0.5) * C) * ROT90
	end

	-- Frame on the inside face of one of a cell's walls, looking into the cell.
	function ctx.sideFrame(x: number, z: number, side: string): CFrame
		local ox, oz = Maze.DX[side], Maze.DZ[side]
		local pos = Vector3.new((x + 0.5 + ox * 0.5) * C - ox * T / 2, 0, (z + 0.5 + oz * 0.5) * C - oz * T / 2)
		return CFrame.lookAt(pos, pos - Vector3.new(ox, 0, oz))
	end

	function ctx.cellCenter(x: number, z: number): Vector3
		return Vector3.new((x + 0.5) * C, 0, (z + 0.5) * C)
	end

	function ctx.wallSides(x: number, z: number): { string }
		local sides = {}
		for _, d in Maze.DIRS do
			if Maze.getEdge(layout, x, z, d) == "wall" then
				table.insert(sides, d)
			end
		end
		return sides
	end

	-- A flat sign (text on a panel). frame looks out from the surface it's mounted on.
	function ctx.sign(frame: CFrame, size: Vector2, text: string, textColor: Color3, background: Color3?, glow: boolean?, font: Enum.Font?): Part
		local panel = ctx.part(props, "Sign", Vector3.new(size.X, size.Y, 0.08), frame, if glow then Enum.Material.Neon else Enum.Material.SmoothPlastic, background or Color3.new(0, 0, 0), nil)
		ctx.decor(panel)
		panel.CastShadow = false
		if not background then
			panel.Transparency = 1
		end
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = if glow then 0 else 1
		gui.Parent = panel
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = font or Enum.Font.GothamBold
		label.Text = text
		label.TextScaled = true
		label.TextColor3 = textColor
		label.Parent = gui
		return panel
	end

	-- A sheet of paper left behind. Whatever was written on it has faded.
	function ctx.note(cframe: CFrame): Part
		local p = ctx.part(props, "Note", Vector3.new(1.3, 0.05, 1.7), cframe, Enum.Material.SmoothPlastic, Color3.fromRGB(215, 210, 196), nil)
		p.CanCollide = false
		return p
	end

	function ctx.writing(frame: CFrame, text: string, color: Color3, font: Enum.Font, glow: boolean)
		local canvas = ctx.decor(ctx.part(props, "Writing", Vector3.new(9, 4.4, 0.05), frame, Enum.Material.SmoothPlastic, Color3.new(0, 0, 0), nil))
		canvas.Transparency = 1
		canvas.CastShadow = false
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = if glow then 0 else 1 -- normally only readable by flashlight
		gui.Brightness = if glow then 2 else 1
		gui.Parent = canvas
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = font
		label.Text = text
		label.TextScaled = true
		label.TextColor3 = color
		label.TextTransparency = random:NextNumber(0.05, 0.25)
		label.Rotation = random:NextNumber(-7, 7)
		label.Parent = gui
	end

	-- Register a light so clients flicker it and objectives can power it.
	function ctx.addLamp(bulb: BasePart, light: Light, cell: Maze.Cell?)
		bulb:SetAttribute("BaseBrightness", light.Brightness)
		CollectionService:AddTag(bulb, "FlickerLight")
		table.insert(ctx.lamps, { bulb = bulb, light = light, cell = cell })
	end

	return ctx
end

-- Wall slab along an edge. Walls between two styles are two half-thickness layers so
-- each side gets its own material.
function Build.wallBox(ctx: Ctx, parent: Instance, frame: CFrame, length: number, height: number, yBottom: number, xOffset: number, front: Style, back: Style)
	if length <= 0.05 or height <= 0.05 then
		return
	end
	local T = ctx.T
	local y = yBottom + height / 2
	if front == back then
		ctx.styled(parent, "Wall", Vector3.new(length, height, T), frame * CFrame.new(xOffset, y, 0), front)
	else
		ctx.styled(parent, "Wall", Vector3.new(length, height, T / 2), frame * CFrame.new(xOffset, y, -T / 4), front)
		ctx.styled(parent, "Wall", Vector3.new(length, height, T / 2), frame * CFrame.new(xOffset, y, T / 4), back)
	end
end

function Build.wallWithOpening(ctx: Ctx, parent: Instance, frame: CFrame, width: number, height: number, front: Style, back: Style)
	local length = ctx.C - ctx.T
	local side = (length - width) / 2
	Build.wallBox(ctx, parent, frame, side, ctx.H, 0, -(width + side) / 2, front, back)
	Build.wallBox(ctx, parent, frame, side, ctx.H, 0, (width + side) / 2, front, back)
	Build.wallBox(ctx, parent, frame, width, ctx.H - height, height, 0, front, back)
end

function Build.doorTrim(ctx: Ctx, parent: Instance, frame: CFrame, width: number, height: number, style: Style)
	local depth = ctx.T + 0.3
	for _, sx in { -1, 1 } do
		ctx.part(parent, "Trim", Vector3.new(0.45, height, depth), frame * CFrame.new(sx * (width / 2 + 0.2), height / 2, 0), style.material, style.color, nil)
	end
	ctx.part(parent, "Trim", Vector3.new(width + 0.85, 0.45, depth), frame * CFrame.new(0, height + 0.2, 0), style.material, style.color, nil)
end

function Build.brokenWall(ctx: Ctx, parent: Instance, frame: CFrame, front: Style, back: Style)
	local random = ctx.random
	local width, height = 6, math.min(9.5, ctx.H - 1.5)
	Build.wallWithOpening(ctx, parent, frame, width, height, front, back)
	for _ = 1, 5 do
		local sx = if random:NextNumber() < 0.5 then -1 else 1
		local size = Vector3.new(random:NextNumber(0.6, 1.6), random:NextNumber(0.8, 2.4), ctx.T * 0.9)
		local p = ctx.part(parent, "Chunk", size, frame * CFrame.new(sx * (width / 2 - size.X / 2 + 0.3), random:NextNumber(0.5, height), 0) * CFrame.Angles(0, 0, random:NextNumber(-0.5, 0.5)), front.material, ctx.vary(front.color), nil)
		p.CanCollide = false
	end
	for _ = 1, 9 do
		local s = random:NextNumber(0.4, 1.3)
		ctx.decor(ctx.part(parent, "Rubble", Vector3.new(s, s * 0.6, s * random:NextNumber(0.7, 1.3)), frame * CFrame.new(random:NextNumber(-width, width) * 0.6, s * 0.25, random:NextNumber(-3, 3)) * CFrame.Angles(random:NextNumber(-0.4, 0.4), random:NextNumber(0, 6.28), random:NextNumber(-0.4, 0.4)), front.material, ctx.vary(front.color, 0.15), nil))
	end
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Chaos</string>
          <string name="Source"><![CDATA[--!strict
-- The curse and the chaos. Every round:
--   * one CURSE bends the rules for the whole night (see Shared/Curses):
--       blackout  most lamps are dead           shifting  walls slide up and down
--       hunted    it hears your heartbeat        phantoms  fake monsters (client side)
--       silent    it makes no sound              fog       you can't see far (lighting)
--   * random EVENTS go off every minute or so: the power fails, a phone rings near
--     you (answer it and you hear where it is, mostly; ignore it and it comes to the
--     phone), every door slams shut, a locker bangs, or you hear it charge at you when
--     nothing's there.
--   * the RAGE: when the way out opens (or at 5 AM) it gets furious.
-- It also listens for players letting their breath out inside a locker.

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Curses = require(ReplicatedStorage.Shared.Curses)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Dressing = require(script.Parent.Dressing)
local Interactables = require(script.Parent.Interactables)
local MonsterAI = require(script.Parent.MonsterAI)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local GameState = ReplicatedStorage.GameState

export type Ctx = {
	night: Nights.Night,
	layout: Maze.Layout,
	world: WorldBuilder.World,
	interactables: Interactables.Interactables,
	monster: MonsterAI.MonsterAI,
	curse: Curses.Curse,
	getPlayers: () -> { Player }, -- players still in the round
	isAlive: (player: Player) -> boolean,
	notifyAll: (text: string, style: string?) -> (),
}

export type Chaos = { destroy: () -> (), shift: () -> (), event: (id: string) -> boolean }

local Chaos = {}

local rootOf = Interactables.rootOf

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function Chaos.start(ctx: Ctx): Chaos
	local layout = ctx.layout
	local world = ctx.world
	local wctx = world.ctx
	local monster = ctx.monster
	local random = Random.new(layout.seed + 31)
	local alive = true
	local connections: { RBXScriptConnection } = {}
	local folder = Instance.new("Folder")
	folder.Name = "Chaos"
	folder.Parent = world.model

	local function loop(first: number, minWait: number, maxWait: number, fn: () -> ())
		task.spawn(function()
			task.wait(first)
			while alive do
				fn()
				task.wait(random:NextNumber(minWait, maxWait))
			end
		end)
	end

	local function visiblePlayers(): { Player }
		local out = {}
		for _, p in ctx.getPlayers() do
			if p:GetAttribute("Hiding") ~= true and rootOf(p) then
				table.insert(out, p)
			end
		end
		return out
	end

	-- Curse: BLACKOUT ------------------------------------------------------------
	local function blackout()
		for _, lamp in world.lamps do
			if lamp.cell and random:NextNumber() < 0.7 then
				lamp.light.Enabled = false
				lamp.bulb:SetAttribute("Dead", true)
				lamp.bulb.Color = lamp.bulb.Color:Lerp(Color3.new(0, 0, 0), 0.85)
			end
		end
	end

	-- Curse: SHIFTING WALLS --------------------------------------------------------
	type Shifter = { key: string, part: BasePart, up: CFrame, down: CFrame, raised: boolean }
	local shifters: { Shifter } = {}

	local function buildShifters()
		local rooms: { [string]: boolean } = {}
		for _, block in layout.roomBlocks do
			for _, c in block do
				rooms[Maze.key(c.x, c.z)] = true
			end
		end
		local edges = Dressing.openEdges(wctx, rooms)
		for i = #edges, 2, -1 do
			local j = random:NextInteger(1, i)
			edges[i], edges[j] = edges[j], edges[i]
		end
		local C, H, T = wctx.C, wctx.H, wctx.T
		local entrance = layout.entrance
		for _, e in edges do
			if #shifters >= 16 then
				break
			end
			local nx, nz = e.x + Maze.DX[e.dir], e.z + Maze.DZ[e.dir]
			local touchesEntrance = (e.x == entrance.x and e.z == entrance.z) or (nx == entrance.x and nz == entrance.z)
			if not touchesEntrance then
				local frame = wctx.edgeFrame(e.x, e.z, e.dir)
				local down = frame * CFrame.new(0, -H / 2 - 0.6, 0)
				local up = frame * CFrame.new(0, H / 2, 0)
				local part: BasePart = wctx.styled(folder, "ShiftingWall", Vector3.new(C - T, H, T), down, world.theme.wall)
				table.insert(shifters, { key = Maze.edgeKey(e.x, e.z, e.dir), part = part, up = up, down = down, raised = false })
			end
		end
	end

	local function everyCellReachable(): boolean
		local count = 0
		for _ in Maze.distances(layout, layout.entrance) do
			count += 1
		end
		return count >= layout.width * layout.depth
	end

	local function someoneIn(s: Shifter): boolean
		local mid = s.up.Position
		local reach = wctx.C * 0.5 + 1.5
		for _, p in ctx.getPlayers() do
			local r = rootOf(p)
			if r and flat(r.Position - mid).Magnitude < reach then
				return true
			end
		end
		return flat(monster.rig.root.Position - mid).Magnitude < reach + 1
	end

	local function moveWall(s: Shifter, raise: boolean)
		s.raised = raise
		layout.edges[s.key] = if raise then "wall" else "open"
		TweenService:Create(s.part, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = if raise then s.up else s.down }):Play()
		Audio.play("WallShift", s.part, 1.5, random:NextNumber(0.9, 1.1), 120)
	end

	local firstShift = true
	local function shift()
		for _, s in shifters do
			if s.raised then
				moveWall(s, false)
			end
		end
		local order = table.clone(shifters)
		for i = #order, 2, -1 do
			local j = random:NextInteger(1, i)
			order[i], order[j] = order[j], order[i]
		end
		local wanted = random:NextInteger(3, 5)
		local raised = 0
		for _, s in order do
			if raised >= wanted then
				break
			end
			if not someoneIn(s) then
				layout.edges[s.key] = "wall"
				if everyCellReachable() then
					raised += 1
					moveWall(s, true)
				else
					layout.edges[s.key] = "open"
				end
			end
		end
		monster:mapChanged()
		if firstShift and raised > 0 then
			firstShift = false
			ctx.notifyAll("You hear stone grinding. The walls are moving.", "danger")
		end
	end

	-- Curse: HUNTED ---------------------------------------------------------------------
	local function heartbeatHeard()
		if not monster.awake then
			return
		end
		local players = visiblePlayers()
		if #players == 0 then
			return
		end
		local p = players[random:NextInteger(1, #players)]
		local r = rootOf(p)
		if r then
			monster:hearNoise(r.Position, 100000)
			Remotes.Chaos:FireClient(p, "hunted")
		end
	end

	-- Events --------------------------------------------------------------------------------
	-- Where the voice on the phone makes you hear it: where it really is, except when the
	-- voice lies (then somewhere random). Nothing while it's still asleep.
	local function phoneHint(): Vector3?
		local mroot = monster.rig.root
		if not monster.awake or mroot.Position.Y < -100 then
			return nil
		end
		if random:NextNumber() < 0.2 then
			local fake = wctx.cellCenter(random:NextInteger(0, layout.width - 1), random:NextInteger(0, layout.depth - 1))
			return fake + Vector3.new(0, 4, 0)
		end
		return mroot.Position
	end

	local function phone(): boolean
		local players = visiblePlayers()
		if #players == 0 then
			return false
		end
		local p = players[random:NextInteger(1, #players)]
		local r = rootOf(p) :: BasePart
		local pc = Maze.cellOf(layout, r.Position.X, r.Position.Z)
		local dist = Maze.distances(layout, pc)
		local options: { { x: number, z: number, side: string } } = {}
		for z = 0, layout.depth - 1 do
			for x = 0, layout.width - 1 do
				local d = dist[Maze.key(x, z)]
				if d and d >= 2 and d <= 5 then
					for _, side in wctx.wallSides(x, z) do
						table.insert(options, { x = x, z = z, side = side })
					end
				end
			end
		end
		if #options == 0 then
			return false
		end
		local spot = options[random:NextInteger(1, #options)]
		local wall = wctx.sideFrame(spot.x, spot.z, spot.side)
		local model = Instance.new("Model")
		model.Name = "Phone"
		model.Parent = folder
		local body = wctx.part(model, "PhoneBody", Vector3.new(1.3, 1.9, 0.5), wall * CFrame.new(random:NextNumber(-2, 2), 5.2, -0.3), Enum.Material.SmoothPlastic, Color3.fromRGB(28, 26, 26), nil)
		local handset = wctx.decor(wctx.part(model, "Handset", Vector3.new(0.4, 1.7, 0.4), body.CFrame * CFrame.new(0.75, 0, -0.1), Enum.Material.SmoothPlastic, Color3.fromRGB(22, 20, 20), nil))
		wctx.decor(wctx.part(model, "Cord", Vector3.new(0.08, 2.2, 0.08), handset.CFrame * CFrame.new(0, -1.9, 0), Enum.Material.SmoothPlastic, Color3.fromRGB(15, 15, 15), nil))
		local bulb = wctx.decor(wctx.part(model, "RingLight", Vector3.new(0.25, 0.25, 0.25), body.CFrame * CFrame.new(0, 0.7, -0.27), Enum.Material.Neon, Color3.fromRGB(255, 60, 40), Enum.PartType.Ball))
		local glow = Instance.new("PointLight")
		glow.Range = 7
		glow.Brightness = 1.2
		glow.Color = Color3.fromRGB(255, 60, 40)
		glow.Parent = bulb
		local ring = Audio.create("PhoneRingLoop", body, 1.5)
		if ring then
			ring.RollOffMode = Enum.RollOffMode.InverseTapered
			ring.RollOffMinDistance = 8
			ring.RollOffMaxDistance = 130
			ring:Play()
		end
		ctx.notifyAll("Somewhere close, a phone is ringing.")
		local answered = false
		local prompt = Interactables.prompt(body, "Answer", "Phone", 0.3, 8)
		local function hangUp()
			answered = true
			prompt.Enabled = false
			glow.Enabled = false
			bulb.Color = Color3.fromRGB(40, 10, 8)
			if ring then
				ring:Destroy()
			end
		end
		prompt.Triggered:Connect(function(player: Player)
			if answered or not alive or not ctx.isAlive(player) then
				return
			end
			hangUp()
			Audio.play("PhonePickup", body, 1, 1, 40)
			Remotes.Chaos:FireClient(player, "phone", phoneHint())
		end)
		task.delay(20, function()
			if answered or not alive then
				return
			end
			hangUp()
			-- nobody picked up. Something else heard it ringing.
			monster:hearNoise(body.Position, 240)
		end)
		Debris:AddItem(model, 90)
		return true
	end

	local function lockerBang(): boolean
		local players = visiblePlayers()
		if #players == 0 or #ctx.interactables.lockers == 0 then
			return false
		end
		local r = rootOf(players[random:NextInteger(1, #players)]) :: BasePart
		local best: Interactables.Locker? = nil
		local bestDist = 60
		for _, l in ctx.interactables.lockers do
			local d = (l.anchor.Position - r.Position).Magnitude
			if not l.occupant and d < bestDist and d > 8 then
				best, bestDist = l, d
			end
		end
		if not best then
			return false
		end
		Audio.play("LockerBang", best.anchor, 1.8, random:NextNumber(0.9, 1.1), 90)
		return true
	end

	local function falseChase(): boolean
		if monster.p.Statue then
			return false
		end
		local players = visiblePlayers()
		if #players == 0 then
			return false
		end
		Remotes.Chaos:FireClient(players[random:NextInteger(1, #players)], "falseChase")
		return true
	end

	local function powerFailure(): boolean
		if GameState:GetAttribute("Blackout") == true then
			return false
		end
		GameState:SetAttribute("Blackout", true)
		ctx.notifyAll("The power is failing...", "danger")
		task.delay(random:NextNumber(8, 12), function()
			if alive then
				GameState:SetAttribute("Blackout", false)
			end
		end)
		return true
	end

	local function slam(): boolean
		if ctx.interactables:slamAll() == 0 then
			return false
		end
		ctx.notifyAll("Every door in the place just slammed shut.", "danger")
		return true
	end

	local EVENTS: { [string]: () -> boolean } = {
		blackout = powerFailure,
		phone = phone,
		slam = slam,
		falseChase = falseChase,
		lockerBang = lockerBang,
	}
	local WEIGHTS: { { id: string, weight: number } } = {
		{ id = "blackout", weight = 3 },
		{ id = "phone", weight = 4 },
		{ id = "slam", weight = 2 },
		{ id = "falseChase", weight = 2 },
		{ id = "lockerBang", weight = 2 },
	}
	local lastEvent = ""

	local function randomEvent()
		local total = 0
		for _, w in WEIGHTS do
			if w.id ~= lastEvent then
				total += w.weight
			end
		end
		for _ = 1, 4 do
			local pick = random:NextNumber() * total
			for _, w in WEIGHTS do
				local id = w.id
				if id ~= lastEvent then
					pick -= w.weight
					if pick <= 0 then
						if EVENTS[id]() then
							lastEvent = id
							return
						end
						break
					end
				end
			end
		end
	end

	-- Rage --------------------------------------------------------------------------------
	local raged = false
	local function rage()
		if raged or not alive then
			return
		end
		raged = true
		GameState:SetAttribute("Rage", true)
		ctx.notifyAll("It's FURIOUS.", "danger")
		monster:frenzy(12, nil)
		if not monster.silent then
			Audio.play("RageSting", monster.rig.head, 2.2, 1, 260)
		end
	end
	table.insert(connections, GameState:GetAttributeChangedSignal("ExitOpen"):Connect(function()
		if GameState:GetAttribute("ExitOpen") == true then
			task.delay(1.5, rage)
		end
	end))
	table.insert(connections, GameState:GetAttributeChangedSignal("Hour"):Connect(function()
		local hour = GameState:GetAttribute("Hour")
		if typeof(hour) == "number" and hour >= 5 then
			rage()
		end
	end))

	-- Holding your breath -----------------------------------------------------------------
	local lastBreath: { [Player]: number } = {}
	table.insert(connections, Remotes.Breath.OnServerEvent:Connect(function(player: Player)
		local now = os.clock()
		if not alive or not ctx.isAlive(player) or now - (lastBreath[player] or -math.huge) < 4 then
			return
		end
		lastBreath[player] = now
		local locker = ctx.interactables:lockerOf(player)
		if locker and monster.awake and (monster.rig.root.Position - locker.inside.Position).Magnitude < 22 then
			monster:revealHider(player, locker)
		end
	end))

	-- Start ---------------------------------------------------------------------------------
	local curse = ctx.curse.id
	if curse == "blackout" then
		blackout()
	elseif curse == "silent" then
		monster:setSilent(true)
	elseif curse == "shifting" then
		buildShifters()
		loop(25, 36, 50, shift)
	elseif curse == "hunted" then
		loop(55, 36, 52, heartbeatHeard)
	end
	loop(random:NextNumber(55, 75), 50, 85, randomEvent)

	return {
		destroy = function()
			alive = false
			for _, c in connections do
				c:Disconnect()
			end
			GameState:SetAttribute("Blackout", false)
			GameState:SetAttribute("Rage", false)
		end,
		shift = shift,
		event = function(id: string): boolean
			local fn = EVENTS[id]
			return fn ~= nil and fn()
		end,
	}
end

return Chaos
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Dressing</string>
          <string name="Source"><![CDATA[--!strict
-- Set dressing shared by the map themes: furniture, landmark rooms and the small
-- touches that make each map feel lived-in (or died-in). Themes.luau decides where
-- these go; this file only knows how to build them.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maze = require(ReplicatedStorage.Shared.Maze)
local Build = require(script.Parent.Build)

type Ctx = Build.Ctx
type Cell = Maze.Cell

local Dressing = {}

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a Cylinder (X axis) upright

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function solid(ctx: Ctx, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	return ctx.part(ctx.props, name, size, cf, material, color, shape)
end

local function deco(ctx: Ctx, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	return ctx.decor(ctx.part(ctx.props, name, size, cf, material, color, shape)) :: Part
end

local function egg(p: BasePart): BasePart
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

-- A small light that flickers with the others (and dies when the monster is near).
local function smallLamp(ctx: Ctx, bulb: BasePart, cell: Cell?, range: number, brightness: number, color: Color3, shadows: boolean)
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = color
	light.Shadows = shadows
	light.Parent = bulb
	ctx.addLamp(bulb, light, cell)
end

Dressing.egg = egg
Dressing.UP = UP

-- Cells ------------------------------------------------------------------------

-- "NS" or "EW" for a plain straight corridor cell, nil for corners and junctions.
function Dressing.straightAxis(ctx: Ctx, x: number, z: number): string?
	local function open(side: string): boolean
		return Maze.isPassable(Maze.getEdge(ctx.layout, x, z, side))
	end
	local n, s, e, w = open("N"), open("S"), open("E"), open("W")
	if n and s and not e and not w then
		return "NS"
	elseif e and w and not n and not s then
		return "EW"
	end
	return nil
end

function Dressing.isBoundary(ctx: Ctx, x: number, z: number, side: string): boolean
	local nx, nz = x + Maze.DX[side], z + Maze.DZ[side]
	return not Maze.inBounds(ctx.layout, nx, nz)
end

-- Every open edge between two plain maze cells (not hub, not inside a room).
function Dressing.openEdges(ctx: Ctx, roomCells: { [string]: boolean }): { { x: number, z: number, dir: string } }
	local out = {}
	local layout = ctx.layout
	for z = 0, layout.depth - 1 do
		for x = 0, layout.width - 1 do
			for _, dir in { "N", "E" } do
				local nx, nz = x + Maze.DX[dir], z + Maze.DZ[dir]
				if Maze.inBounds(layout, nx, nz) and Maze.getEdge(layout, x, z, dir) == "open" then
					local plain = not Maze.isHub(layout, x, z) and not Maze.isHub(layout, nx, nz)
					if plain and not roomCells[Maze.key(x, z)] and not roomCells[Maze.key(nx, nz)] then
						table.insert(out, { x = x, z = z, dir = dir })
					end
				end
			end
		end
	end
	return out
end

function Dressing.blockCenter(ctx: Ctx, block: { Cell }): Vector3
	local sum = Vector3.zero
	for _, c in block do
		sum += ctx.cellCenter(c.x, c.z)
	end
	return sum / #block
end

-- A wall face inside a room block that is still a solid wall (for things to stand against).
function Dressing.roomWall(ctx: Ctx, block: { Cell }): (Cell?, string?)
	for _, c in block do
		local sides = ctx.wallSides(c.x, c.z)
		if #sides > 0 then
			return c, sides[ctx.random:NextInteger(1, #sides)]
		end
	end
	return nil, nil
end

-- Furniture ------------------------------------------------------------------------

-- Something under a white dust sheet. Sometimes it's the shape of a person.
function Dressing.sheeted(ctx: Ctx, at: CFrame, kind: string)
	local sheet = rgb(198, 196, 190)
	local fabric = Enum.Material.Fabric
	if kind == "person" then
		egg(solid(ctx, "Sheet", Vector3.new(2.6, 6.2, 2), at * CFrame.new(0, 3.1, 0), fabric, sheet))
		egg(solid(ctx, "SheetHead", Vector3.new(1.4, 1.7, 1.4), at * CFrame.new(0, 6.6, -0.1) * CFrame.Angles(0.15, 0, 0.12), fabric, sheet))
		deco(ctx, "SheetHem", Vector3.new(3, 0.2, 2.4), at * CFrame.new(0, 0.1, 0), fabric, sheet)
	elseif kind == "tall" then
		solid(ctx, "Sheet", Vector3.new(3.2, 6.5, 2), at * CFrame.new(0, 3.25, 0), fabric, sheet)
		egg(deco(ctx, "SheetTop", Vector3.new(3.4, 1.2, 2.2), at * CFrame.new(0, 6.5, 0), fabric, sheet))
	else
		egg(solid(ctx, "Sheet", Vector3.new(3.4, 3.4, 3.2), at * CFrame.new(0, 1.7, 0), fabric, sheet))
		deco(ctx, "SheetHem", Vector3.new(3.6, 0.8, 3.4), at * CFrame.new(0, 0.4, 0), fabric, sheet)
	end
end

-- A door set into a wall that doesn't open (there's nothing behind it).
function Dressing.fakeDoor(ctx: Ctx, wall: CFrame, color: Color3)
	local dw, dh = 4, 8
	solid(ctx, "DoorFrame", Vector3.new(dw + 0.8, dh + 0.4, 0.3), wall * CFrame.new(0, (dh + 0.4) / 2, -0.15), Enum.Material.Wood, color:Lerp(Color3.new(0, 0, 0), 0.3))
	solid(ctx, "Door", Vector3.new(dw, dh, 0.25), wall * CFrame.new(0, dh / 2, -0.32), Enum.Material.Wood, color)
	for _, py in { 2.2, 5.6 } do
		deco(ctx, "DoorPanel", Vector3.new(dw - 1.2, 2.6, 0.08), wall * CFrame.new(0, py, -0.47), Enum.Material.Wood, color:Lerp(Color3.new(0, 0, 0), 0.15))
	end
	deco(ctx, "Knob", Vector3.new(0.35, 0.35, 0.35), wall * CFrame.new(dw / 2 - 0.5, dh * 0.45, -0.55), Enum.Material.Metal, rgb(160, 150, 120), Enum.PartType.Ball)
end

-- A side table against a wall with a little lamp on it.
function Dressing.tableLamp(ctx: Ctx, wall: CFrame, cell: Cell?, withLight: boolean)
	local wood = Enum.Material.Wood
	local dark = rgb(60, 48, 40)
	local base = wall * CFrame.new(ctx.random:NextNumber(-2.5, 2.5), 0, -1.3)
	solid(ctx, "SideTable", Vector3.new(2.6, 0.25, 1.8), base * CFrame.new(0, 2.6, 0), wood, dark)
	for _, l in { { -1.1, -0.7 }, { 1.1, -0.7 }, { -1.1, 0.7 }, { 1.1, 0.7 } } do
		deco(ctx, "TableLeg", Vector3.new(0.2, 2.5, 0.2), base * CFrame.new(l[1], 1.25, l[2]), wood, dark)
	end
	deco(ctx, "LampStem", Vector3.new(1.3, 0.25, 0.25), base * CFrame.new(0, 3.35, 0) * UP, Enum.Material.Metal, rgb(90, 86, 80), Enum.PartType.Cylinder)
	deco(ctx, "LampShade", Vector3.new(1.2, 1.4, 1.4), base * CFrame.new(0, 4.3, 0) * UP, Enum.Material.Fabric, rgb(170, 164, 150), Enum.PartType.Cylinder)
	local bulb = deco(ctx, "Bulb", Vector3.new(0.5, 0.5, 0.5), base * CFrame.new(0, 3.95, 0), Enum.Material.Neon, rgb(230, 222, 200), Enum.PartType.Ball)
	bulb.CastShadow = false
	if withLight then
		smallLamp(ctx, bulb, cell, 13, 0.9, rgb(255, 236, 205), true)
	else
		bulb.Color = rgb(40, 38, 36)
	end
end

function Dressing.mirror(ctx: Ctx, wall: CFrame)
	local at = wall * CFrame.new(ctx.random:NextNumber(-2, 2), 6, -0.1)
	solid(ctx, "MirrorFrame", Vector3.new(3.4, 4.6, 0.25), at, Enum.Material.Wood, rgb(40, 34, 30))
	local glass = deco(ctx, "Mirror", Vector3.new(2.8, 4, 0.06), at * CFrame.new(0, 0, -0.15), Enum.Material.Glass, rgb(150, 155, 160))
	glass.Reflectance = 0.65
	for _ = 1, 3 do
		deco(ctx, "Crack", Vector3.new(0.04, ctx.random:NextNumber(1, 2.4), 0.02), at * CFrame.new(ctx.random:NextNumber(-0.8, 0.8), ctx.random:NextNumber(-1, 1), -0.2) * CFrame.Angles(0, 0, ctx.random:NextNumber(-1, 1)), Enum.Material.SmoothPlastic, rgb(230, 230, 230)).Transparency = 0.3
	end
end

-- A window in an outside wall: nothing but black outside, curtains half drawn.
function Dressing.window(ctx: Ctx, wall: CFrame, height: number, curtains: Color3?)
	local w, h = 4.4, height
	local at = wall * CFrame.new(0, 3 + h / 2, -0.05)
	local frame = rgb(48, 40, 34)
	for _, sx in { -1, 1 } do
		solid(ctx, "WindowFrame", Vector3.new(0.35, h + 0.7, 0.4), at * CFrame.new(sx * (w / 2 + 0.17), 0, 0), Enum.Material.Wood, frame)
	end
	solid(ctx, "WindowFrame", Vector3.new(w + 0.7, 0.35, 0.4), at * CFrame.new(0, h / 2 + 0.17, 0), Enum.Material.Wood, frame)
	solid(ctx, "Sill", Vector3.new(w + 1, 0.3, 0.8), at * CFrame.new(0, -h / 2 - 0.15, -0.2), Enum.Material.Wood, frame)
	deco(ctx, "Mullion", Vector3.new(0.18, h, 0.3), at, Enum.Material.Wood, frame)
	deco(ctx, "Mullion", Vector3.new(w, 0.18, 0.3), at, Enum.Material.Wood, frame)
	local glass = deco(ctx, "WindowGlass", Vector3.new(w, h, 0.05), at * CFrame.new(0, 0, 0.05), Enum.Material.Glass, rgb(8, 9, 12))
	glass.Reflectance = 0.25
	if curtains then
		for _, sx in { -1, 1 } do
			deco(ctx, "Curtain", Vector3.new(1.4, h + 1.2, 0.15), at * CFrame.new(sx * (w / 2 - 0.4), 0, -0.35) * CFrame.Angles(0, 0, sx * 0.03), Enum.Material.Fabric, curtains)
		end
	end
end

function Dressing.chair(ctx: Ctx, at: CFrame, color: Color3, toppled: boolean?)
	local wood = Enum.Material.Wood
	local base = if toppled then at * CFrame.new(0, 1.1, 0) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.new(0, -1.1, 0) else at
	solid(ctx, "ChairSeat", Vector3.new(2, 0.3, 2), base * CFrame.new(0, 2, 0), wood, color)
	solid(ctx, "ChairBack", Vector3.new(2, 3, 0.3), base * CFrame.new(0, 3.5, 0.85), wood, color)
	for _, l in { { -0.8, -0.8 }, { 0.8, -0.8 }, { -0.8, 0.8 }, { 0.8, 0.8 } } do
		deco(ctx, "ChairLeg", Vector3.new(0.22, 2, 0.22), base * CFrame.new(l[1], 1, l[2]), wood, color)
	end
end

function Dressing.ladder(ctx: Ctx, wall: CFrame, height: number, color: Color3)
	local at = wall * CFrame.new(ctx.random:NextNumber(-3, 3), 0, -0.4)
	for _, sx in { -0.75, 0.75 } do
		deco(ctx, "LadderRail", Vector3.new(0.2, height, 0.2), at * CFrame.new(sx, height / 2, 0), Enum.Material.CorrodedMetal, color)
	end
	for y = 1, height - 0.5, 1.1 do
		deco(ctx, "LadderRung", Vector3.new(1.5, 0.14, 0.14), at * CFrame.new(0, y, 0), Enum.Material.CorrodedMetal, color)
	end
end

function Dressing.rat(ctx: Ctx, at: CFrame)
	local fur = rgb(34, 30, 28)
	local body = egg(deco(ctx, "Rat", Vector3.new(0.55, 0.42, 1.0), at * CFrame.new(0, 0.2, 0), Enum.Material.Fabric, fur))
	egg(deco(ctx, "RatHead", Vector3.new(0.34, 0.3, 0.5), body.CFrame * CFrame.new(0, 0.03, -0.55), Enum.Material.Fabric, fur))
	egg(deco(ctx, "RatTail", Vector3.new(0.07, 0.07, 1.1), body.CFrame * CFrame.new(0.1, -0.12, 0.95) * CFrame.Angles(0, 0.4, 0), Enum.Material.SmoothPlastic, rgb(80, 64, 60)))
end

-- Rooms --------------------------------------------------------------------------

-- Night 1: a dining room laid for a dinner nobody came to.
function Dressing.diningRoom(ctx: Ctx, block: { Cell }, cell: Cell?)
	local c = Dressing.blockCenter(ctx, block)
	local wood = Enum.Material.Wood
	local dark = rgb(56, 44, 36)
	local base = CFrame.new(c)
	deco(ctx, "Rug", Vector3.new(18, 0.08, 12), base * CFrame.new(0, 0.04, 0), Enum.Material.Fabric, rgb(70, 66, 66))
	solid(ctx, "TableTop", Vector3.new(14, 0.4, 4.6), base * CFrame.new(0, 3.1, 0), wood, dark)
	for _, l in { { -6.4, -1.8 }, { 6.4, -1.8 }, { -6.4, 1.8 }, { 6.4, 1.8 } } do
		deco(ctx, "TableLeg", Vector3.new(0.4, 3, 0.4), base * CFrame.new(l[1], 1.5, l[2]), wood, dark)
	end
	deco(ctx, "Runner", Vector3.new(12, 0.05, 1.4), base * CFrame.new(0, 3.33, 0), Enum.Material.Fabric, rgb(170, 168, 160))
	for i = -1, 1 do
		for _, side in { -1, 1 } do
			local seat = base * CFrame.new(i * 4, 0, side * 3.4) * CFrame.Angles(0, if side > 0 then math.pi else 0, 0)
			Dressing.chair(ctx, seat, dark, i == 1 and side == 1)
			deco(ctx, "Plate", Vector3.new(0.08, 1.3, 1.3), base * CFrame.new(i * 4, 3.34, side * 1.4) * UP, Enum.Material.SmoothPlastic, rgb(225, 225, 220), Enum.PartType.Cylinder)
		end
	end
	Dressing.chair(ctx, base * CFrame.new(-8.6, 0, 0) * CFrame.Angles(0, math.rad(-90), 0), dark, false)
	-- candelabra: the only light in the room
	deco(ctx, "Candelabra", Vector3.new(1.6, 0.3, 0.3), base * CFrame.new(0, 4.1, 0) * UP, Enum.Material.Metal, rgb(150, 140, 110), Enum.PartType.Cylinder)
	local flame: BasePart? = nil
	for i = -1, 1 do
		deco(ctx, "Candle", Vector3.new(0.9, 0.22, 0.22), base * CFrame.new(i * 0.7, 5.3, 0) * UP, Enum.Material.SmoothPlastic, rgb(230, 228, 215), Enum.PartType.Cylinder)
		local f = deco(ctx, "Flame", Vector3.new(0.18, 0.35, 0.18), base * CFrame.new(i * 0.7, 5.95, 0), Enum.Material.Neon, rgb(255, 214, 150))
		f.CastShadow = false
		if i == 0 then
			flame = f
		end
	end
	if flame then
		smallLamp(ctx, flame, cell, 18, 0.9, rgb(255, 214, 160), true)
	end
end

-- Night 1: a nursery. The mobile still turns.
function Dressing.nursery(ctx: Ctx, block: { Cell })
	local c = Dressing.blockCenter(ctx, block)
	local base = CFrame.new(c) * CFrame.Angles(0, ctx.random:NextInteger(0, 3) * math.pi / 2, 0)
	local white = rgb(205, 202, 196)
	local wood = Enum.Material.Wood
	-- crib
	local crib = base * CFrame.new(-3, 0, -2)
	solid(ctx, "CribBase", Vector3.new(6, 0.4, 3.4), crib * CFrame.new(0, 1.6, 0), wood, white)
	deco(ctx, "CribMattress", Vector3.new(5.6, 0.4, 3), crib * CFrame.new(0, 2, 0), Enum.Material.Fabric, rgb(180, 178, 174))
	for i = 0, 11 do
		local x = -2.8 + i * (5.6 / 11)
		for _, sz in { -1.6, 1.6 } do
			deco(ctx, "CribBar", Vector3.new(3, 0.14, 0.14), crib * CFrame.new(x, 2.9, sz) * UP, wood, white, Enum.PartType.Cylinder)
		end
	end
	for _, sz in { -1.6, 1.6 } do
		deco(ctx, "CribRail", Vector3.new(6, 0.25, 0.25), crib * CFrame.new(0, 4.4, sz), wood, white)
	end
	for _, sx in { -3, 3 } do
		solid(ctx, "CribEnd", Vector3.new(0.3, 4.6, 3.4), crib * CFrame.new(sx, 2.3, 0), wood, white)
	end
	-- the mobile, hanging over the crib
	local top = ctx.ceiling
	deco(ctx, "MobileString", Vector3.new(0.05, top - 7, 0.05), crib * CFrame.new(0, (top + 7) / 2, 0), Enum.Material.SmoothPlastic, rgb(30, 30, 30))
	local mobile = deco(ctx, "Mobile", Vector3.new(2.4, 0.1, 0.1), crib * CFrame.new(0, 7, 0), wood, white)
	CollectionService:AddTag(mobile, "Spin")
	for i = 0, 3 do
		local a = i * math.pi / 2
		deco(ctx, "MobileToy", Vector3.new(0.4, 0.4, 0.4), crib * CFrame.new(math.cos(a) * 1.1, 6.3, math.sin(a) * 1.1), Enum.Material.SmoothPlastic, rgb(220, 218, 210), if i % 2 == 0 then Enum.PartType.Ball else nil)
	end
	-- rocking chair facing the crib, and blocks on the floor
	local rocker = base * CFrame.new(4, 0, 3) * CFrame.Angles(0, math.rad(200), 0)
	solid(ctx, "RockerSeat", Vector3.new(2.4, 0.3, 2.4), rocker * CFrame.new(0, 1.9, 0), wood, rgb(70, 58, 48))
	solid(ctx, "RockerBack", Vector3.new(2.4, 3.6, 0.3), rocker * CFrame.new(0, 3.8, 1.1) * CFrame.Angles(-0.15, 0, 0), wood, rgb(70, 58, 48))
	for _, sx in { -1, 1 } do
		deco(ctx, "Rocker", Vector3.new(0.2, 0.3, 3.4), rocker * CFrame.new(sx * 1.05, 0.4, 0) * CFrame.Angles(0.12, 0, 0), wood, rgb(70, 58, 48))
		deco(ctx, "RockerLeg", Vector3.new(0.2, 1.6, 0.2), rocker * CFrame.new(sx * 1.05, 1.15, -0.9), wood, rgb(70, 58, 48))
		deco(ctx, "RockerLeg", Vector3.new(0.2, 1.6, 0.2), rocker * CFrame.new(sx * 1.05, 1.15, 0.9), wood, rgb(70, 58, 48))
	end
	for i = 1, 6 do
		local s = 0.9
		deco(ctx, "Block", Vector3.new(s, s, s), base * CFrame.new(ctx.random:NextNumber(-2, 3), s / 2 + (if i == 6 then s else 0), ctx.random:NextNumber(1, 4)) * CFrame.Angles(0, ctx.random:NextNumber(0, 6), 0), wood, rgb(150, 148, 144))
	end
	-- a doll sitting in the corner, facing you
	local doll = base * CFrame.new(-5, 0, 4.5) * CFrame.Angles(0, math.rad(150), 0)
	egg(solid(ctx, "DollBody", Vector3.new(1.1, 1.5, 0.9), doll * CFrame.new(0, 0.75, 0), Enum.Material.Fabric, rgb(150, 146, 140)))
	egg(deco(ctx, "DollHead", Vector3.new(0.9, 1, 0.9), doll * CFrame.new(0, 1.9, 0) * CFrame.Angles(0, 0, 0.35), Enum.Material.SmoothPlastic, rgb(225, 220, 212)))
	for _, sx in { -0.18, 0.18 } do
		deco(ctx, "DollEye", Vector3.new(0.14, 0.14, 0.14), doll * CFrame.new(sx - 0.15, 1.95, -0.42), Enum.Material.SmoothPlastic, rgb(10, 10, 10), Enum.PartType.Ball)
	end
end

-- Night 1: a bathroom. The tub is full. Don't look in the mirror too long.
function Dressing.bathroom(ctx: Ctx, block: { Cell })
	local c = Dressing.blockCenter(ctx, block)
	local base = CFrame.new(c) * CFrame.Angles(0, ctx.random:NextInteger(0, 3) * math.pi / 2, 0)
	local porcelain = rgb(215, 214, 208)
	deco(ctx, "Tiles", Vector3.new(22, 0.06, 22), base * CFrame.new(0, 0.03, 0), Enum.Material.CeramicTiles, rgb(160, 160, 156))
	local tub = base * CFrame.new(-4, 0, -4)
	for _, p in { { 0, -1.6, 7, 0.4 }, { 0, 1.6, 7, 0.4 } } do
		solid(ctx, "TubSide", Vector3.new(p[3], 2.6, p[4]), tub * CFrame.new(p[1], 1.3, p[2]), Enum.Material.SmoothPlastic, porcelain)
	end
	for _, sx in { -3.3, 3.3 } do
		solid(ctx, "TubEnd", Vector3.new(0.4, 2.6, 3.6), tub * CFrame.new(sx, 1.3, 0), Enum.Material.SmoothPlastic, porcelain)
	end
	local water = deco(ctx, "TubWater", Vector3.new(6.2, 0.1, 2.8), tub * CFrame.new(0, 2.1, 0), Enum.Material.Glass, rgb(20, 20, 22))
	water.Reflectance = 0.4
	deco(ctx, "ShowerRail", Vector3.new(7, 0.15, 0.15), tub * CFrame.new(0, 8, 1.6), Enum.Material.Metal, rgb(160, 160, 160), Enum.PartType.Cylinder)
	local curtain = deco(ctx, "ShowerCurtain", Vector3.new(3.2, 6, 0.08), tub * CFrame.new(-1.6, 5, 1.6), Enum.Material.Fabric, rgb(190, 190, 186))
	curtain.Transparency = 0.25
	-- sink + mirror on a wall
	local cell, side = Dressing.roomWall(ctx, block)
	if cell and side then
		local wall = ctx.sideFrame(cell.x, cell.z, side)
		local sink = wall * CFrame.new(0, 0, -1.2)
		solid(ctx, "SinkStand", Vector3.new(1, 3, 1), sink * CFrame.new(0, 1.5, 0), Enum.Material.SmoothPlastic, porcelain)
		egg(solid(ctx, "Sink", Vector3.new(2.4, 0.8, 1.8), sink * CFrame.new(0, 3.2, 0), Enum.Material.SmoothPlastic, porcelain))
		Dressing.mirror(ctx, wall)
	end
	local toilet = base * CFrame.new(4.5, 0, 3.5)
	egg(solid(ctx, "Toilet", Vector3.new(1.6, 1.8, 2.2), toilet * CFrame.new(0, 1, 0), Enum.Material.SmoothPlastic, porcelain))
	solid(ctx, "ToiletTank", Vector3.new(1.8, 2.2, 0.8), toilet * CFrame.new(0, 2.2, 1.2), Enum.Material.SmoothPlastic, porcelain)
end

-- Night 2: an operating theatre. The big lamp still works.
function Dressing.operatingRoom(ctx: Ctx, block: { Cell }, cell: Cell?)
	local c = Dressing.blockCenter(ctx, block)
	local base = CFrame.new(c) * CFrame.Angles(0, ctx.random:NextInteger(0, 1) * math.pi / 2, 0)
	local steel = rgb(170, 175, 178)
	deco(ctx, "FloorTiles", Vector3.new(22, 0.05, 22), base * CFrame.new(0, 0.03, 0), Enum.Material.CeramicTiles, rgb(150, 160, 158))
	solid(ctx, "TableBase", Vector3.new(1.4, 3, 1.4), base * CFrame.new(0, 1.5, 0), Enum.Material.Metal, steel)
	solid(ctx, "OperatingTable", Vector3.new(3, 0.5, 7.5), base * CFrame.new(0, 3.2, 0), Enum.Material.Metal, steel)
	deco(ctx, "TablePad", Vector3.new(2.8, 0.25, 7.2), base * CFrame.new(0, 3.55, 0), Enum.Material.Fabric, rgb(90, 110, 110))
	-- a sheet over a shape on the table
	egg(deco(ctx, "Body", Vector3.new(2.2, 1, 6.4), base * CFrame.new(0, 4, 0.2), Enum.Material.Fabric, rgb(210, 214, 210)))
	egg(deco(ctx, "BodyHead", Vector3.new(1.3, 0.9, 1.4), base * CFrame.new(0, 4.2, -2.9), Enum.Material.Fabric, rgb(210, 214, 210)))
	-- the surgical lamp: a big dish over the table with a spot pointing down
	local H = ctx.ceiling
	deco(ctx, "LampArm", Vector3.new(H - 9, 0.3, 0.3), base * CFrame.new(0, (H + 9) / 2, 0) * UP, Enum.Material.Metal, steel, Enum.PartType.Cylinder)
	local dish = deco(ctx, "SurgicalLamp", Vector3.new(0.8, 3.4, 3.4), base * CFrame.new(0, 8.6, 0) * UP, Enum.Material.Metal, steel, Enum.PartType.Cylinder)
	local face = deco(ctx, "SurgicalLight", Vector3.new(0.1, 2.8, 2.8), dish.CFrame * CFrame.new(-0.42, 0, 0), Enum.Material.Neon, rgb(240, 245, 255), Enum.PartType.Cylinder)
	face.CastShadow = false
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Left
	spot.Angle = 70
	spot.Range = 18
	spot.Brightness = 2.2
	spot.Color = rgb(235, 245, 255)
	spot.Shadows = true
	spot.Parent = face
	ctx.addLamp(face, spot, cell)
	-- tools, gas, monitors
	solid(ctx, "Tray", Vector3.new(2.4, 0.15, 1.4), base * CFrame.new(2.8, 3.6, -1.5), Enum.Material.Metal, steel)
	deco(ctx, "TrayStand", Vector3.new(0.2, 3.5, 0.2), base * CFrame.new(2.8, 1.75, -1.5), Enum.Material.Metal, steel)
	for i = 0, 3 do
		deco(ctx, "Scalpel", Vector3.new(0.08, 0.06, 0.9), base * CFrame.new(2.2 + i * 0.4, 3.72, -1.5) * CFrame.Angles(0, (i - 1.5) * 0.08, 0), Enum.Material.Metal, rgb(210, 210, 215))
	end
	for i = 0, 2 do
		solid(ctx, "GasTank", Vector3.new(4.2, 0.9, 0.9), base * CFrame.new(-4.5, 2.1, 3 + i * 1.1) * UP, Enum.Material.Metal, if i == 1 then rgb(60, 110, 70) else rgb(70, 90, 140), Enum.PartType.Cylinder)
	end
	local monitor = solid(ctx, "Monitor", Vector3.new(2, 1.4, 0.4), base * CFrame.new(-3, 6, -3.5) * CFrame.Angles(0, math.rad(30), 0), Enum.Material.SmoothPlastic, rgb(28, 28, 30))
	ctx.sign(monitor.CFrame * CFrame.new(0, 0, -0.21), Vector2.new(1.8, 1.2), "-- -- --", rgb(90, 255, 140), rgb(4, 16, 8), true, Enum.Font.Code)
	deco(ctx, "MonitorPole", Vector3.new(6, 0.25, 0.25), base * CFrame.new(-3, 3, -3.5) * UP, Enum.Material.Metal, steel, Enum.PartType.Cylinder)
end

-- Night 2: the morgue. One drawer is open.
function Dressing.morgue(ctx: Ctx, block: { Cell })
	local steel = rgb(160, 165, 168)
	local cell, side = Dressing.roomWall(ctx, block)
	if cell and side then
		local wall = ctx.sideFrame(cell.x, cell.z, side)
		local W = ctx.C - ctx.T - 1
		solid(ctx, "DrawerWall", Vector3.new(W, 7.4, 1.2), wall * CFrame.new(0, 3.7, -0.6), Enum.Material.Metal, rgb(120, 124, 126))
		local cols = 4
		local open = ctx.random:NextInteger(1, cols * 3)
		for row = 0, 2 do
			for col = 1, cols do
				local x = -W / 2 + (col - 0.5) * (W / cols)
				local y = 1.4 + row * 2.3
				local i = row * cols + col
				if i == open then
					-- pulled out, with something under a sheet
					local tray = wall * CFrame.new(x, y, -3.4)
					solid(ctx, "DrawerTray", Vector3.new(W / cols - 0.4, 0.3, 5.2), tray, Enum.Material.Metal, steel)
					egg(deco(ctx, "Body", Vector3.new(1.6, 0.9, 4.4), tray * CFrame.new(0, 0.5, 0), Enum.Material.Fabric, rgb(210, 212, 208)))
					deco(ctx, "DrawerHole", Vector3.new(W / cols - 0.5, 1.8, 0.05), wall * CFrame.new(x, y, -1.23), Enum.Material.SmoothPlastic, rgb(4, 4, 4))
				else
					deco(ctx, "DrawerDoor", Vector3.new(W / cols - 0.4, 1.9, 0.12), wall * CFrame.new(x, y, -1.25), Enum.Material.Metal, steel)
					deco(ctx, "DrawerHandle", Vector3.new(1, 0.15, 0.15), wall * CFrame.new(x, y + 0.5, -1.38), Enum.Material.Metal, rgb(200, 200, 200))
					deco(ctx, "DrawerTag", Vector3.new(0.6, 0.35, 0.03), wall * CFrame.new(x, y - 0.3, -1.33), Enum.Material.SmoothPlastic, rgb(220, 218, 205))
				end
			end
		end
	end
	local c = Dressing.blockCenter(ctx, block)
	local tableAt = CFrame.new(c) * CFrame.Angles(0, ctx.random:NextNumber(-0.3, 0.3), 0)
	solid(ctx, "AutopsyTable", Vector3.new(3.2, 0.4, 7.4), tableAt * CFrame.new(0, 3, 0), Enum.Material.Metal, steel)
	solid(ctx, "TablePedestal", Vector3.new(1.2, 2.8, 1.2), tableAt * CFrame.new(0, 1.4, 0), Enum.Material.Metal, steel)
	egg(deco(ctx, "Body", Vector3.new(2, 1, 6.2), tableAt * CFrame.new(0, 3.65, 0), Enum.Material.Fabric, rgb(214, 216, 212)))
	-- a foot sticking out, with a toe tag
	deco(ctx, "Foot", Vector3.new(0.45, 1, 0.5), tableAt * CFrame.new(0.4, 3.7, 3.3), Enum.Material.SmoothPlastic, rgb(190, 176, 166))
	deco(ctx, "ToeTag", Vector3.new(0.5, 0.3, 0.03), tableAt * CFrame.new(0.4, 3.6, 3.62), Enum.Material.SmoothPlastic, rgb(225, 222, 205))
end

-- Night 3: a pump station, long dead.
function Dressing.pumpRoom(ctx: Ctx, block: { Cell })
	local c = Dressing.blockCenter(ctx, block)
	local base = CFrame.new(c) * CFrame.Angles(0, ctx.random:NextInteger(0, 1) * math.pi / 2, 0)
	local rust = rgb(96, 70, 52)
	local H = ctx.ceiling
	solid(ctx, "PumpBase", Vector3.new(9, 1.2, 5), base * CFrame.new(0, 0.6, 0), Enum.Material.Concrete, rgb(80, 82, 78))
	solid(ctx, "Pump", Vector3.new(7.5, 3.6, 3.6), base * CFrame.new(0, 3, 0), Enum.Material.CorrodedMetal, rgb(70, 92, 84), Enum.PartType.Cylinder)
	solid(ctx, "Motor", Vector3.new(3, 2.6, 2.6), base * CFrame.new(-4.6, 2.6, 0), Enum.Material.Metal, rgb(60, 60, 58))
	for _, sx in { -2.4, 2.4 } do
		deco(ctx, "Riser", Vector3.new(H - 4, 1.2, 1.2), base * CFrame.new(sx, (H + 4) / 2, 0) * UP, Enum.Material.CorrodedMetal, rust, Enum.PartType.Cylinder)
		-- valve wheel
		local wheel = base * CFrame.new(sx, 6, -0.9)
		deco(ctx, "ValveWheel", Vector3.new(0.15, 1.8, 1.8), wheel * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Metal, rgb(140, 30, 26), Enum.PartType.Cylinder)
	end
	-- a railing round the pit
	for _, p in { { 0, -4.5, 11, 0.2 }, { 0, 4.5, 11, 0.2 } } do
		deco(ctx, "Rail", Vector3.new(p[3], 0.2, p[4]), base * CFrame.new(p[1], 3.3, p[2]), Enum.Material.Metal, rgb(150, 120, 30))
		for i = -2, 2 do
			deco(ctx, "RailPost", Vector3.new(0.2, 3.3, 0.2), base * CFrame.new(i * 2.6, 1.65, p[2]), Enum.Material.Metal, rgb(150, 120, 30))
		end
	end
	local panel = solid(ctx, "ControlPanel", Vector3.new(4, 5, 1), base * CFrame.new(0, 2.5, 7.5) * CFrame.Angles(0, math.pi, 0), Enum.Material.Metal, rgb(66, 70, 66))
	for i = 0, 2 do
		deco(ctx, "Gauge", Vector3.new(0.12, 0.9, 0.9), panel.CFrame * CFrame.new(-1.2 + i * 1.2, 1, -0.55) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.SmoothPlastic, rgb(210, 205, 190), Enum.PartType.Cylinder)
	end
end

-- Night 3: a cistern, its roof held up by brick pillars standing in black water.
function Dressing.cistern(ctx: Ctx, block: { Cell })
	local c = Dressing.blockCenter(ctx, block)
	local H = ctx.ceiling
	local water = deco(ctx, "DeepWater", Vector3.new(ctx.C * 2 - 2, 0.1, ctx.C * 2 - 2), CFrame.new(c + Vector3.new(0, 0.3, 0)), Enum.Material.Glass, rgb(6, 14, 12))
	water.Reflectance = 0.5
	water.CastShadow = false
	for _, o in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		local p = c + Vector3.new(o[1] * ctx.C * 0.45, 0, o[2] * ctx.C * 0.45)
		solid(ctx, "Pillar", Vector3.new(2.4, H, 2.4), CFrame.new(p + Vector3.new(0, H / 2, 0)), Enum.Material.Brick, rgb(70, 72, 66))
		deco(ctx, "PillarCap", Vector3.new(3.2, 0.8, 3.2), CFrame.new(p + Vector3.new(0, H - 0.4, 0)), Enum.Material.Concrete, rgb(80, 82, 78))
	end
	for _ = 1, 4 do
		local s = ctx.random:NextNumber(0.8, 1.8)
		deco(ctx, "Debris", Vector3.new(s, s * 0.4, s * 1.6), CFrame.new(c + Vector3.new(ctx.random:NextNumber(-8, 8), 0.4, ctx.random:NextNumber(-8, 8))) * CFrame.Angles(0, ctx.random:NextNumber(0, 6), 0), Enum.Material.Wood, rgb(60, 50, 40))
	end
end

-- Night 4: a reflecting pool with a marble rim.
function Dressing.pool(ctx: Ctx, at: CFrame, w: number, d: number)
	local marble = Enum.Material.Marble
	local rim = rgb(214, 214, 210)
	solid(ctx, "PoolRim", Vector3.new(w + 1.2, 0.9, 0.6), at * CFrame.new(0, 0.45, -d / 2 - 0.3), marble, rim)
	solid(ctx, "PoolRim", Vector3.new(w + 1.2, 0.9, 0.6), at * CFrame.new(0, 0.45, d / 2 + 0.3), marble, rim)
	solid(ctx, "PoolRim", Vector3.new(0.6, 0.9, d), at * CFrame.new(-w / 2 - 0.3, 0.45, 0), marble, rim)
	solid(ctx, "PoolRim", Vector3.new(0.6, 0.9, d), at * CFrame.new(w / 2 + 0.3, 0.45, 0), marble, rim)
	local water = deco(ctx, "PoolWater", Vector3.new(w, 0.1, d), at * CFrame.new(0, 0.55, 0), Enum.Material.Glass, rgb(12, 16, 24))
	water.Reflectance = 0.55
	water.CastShadow = false
end

-- Night 4: a glass display case with something old inside.
function Dressing.displayCase(ctx: Ctx, at: CFrame)
	local marble = Enum.Material.Marble
	solid(ctx, "Plinth", Vector3.new(2.4, 3.4, 2.4), at * CFrame.new(0, 1.7, 0), marble, rgb(205, 205, 200))
	local glass = solid(ctx, "Case", Vector3.new(2.2, 2.4, 2.2), at * CFrame.new(0, 4.6, 0), Enum.Material.Glass, rgb(200, 210, 220))
	glass.Transparency = 0.8
	if ctx.random:NextNumber() < 0.5 then
		egg(deco(ctx, "Skull", Vector3.new(0.9, 1, 1.1), at * CFrame.new(0, 4, 0), Enum.Material.SmoothPlastic, rgb(214, 208, 192)))
		deco(ctx, "SkullJaw", Vector3.new(0.6, 0.25, 0.5), at * CFrame.new(0, 3.55, -0.3), Enum.Material.SmoothPlastic, rgb(200, 194, 178))
	else
		deco(ctx, "Vase", Vector3.new(1.8, 0.9, 0.9), at * CFrame.new(0, 4.3, 0) * UP, Enum.Material.Marble, rgb(60, 70, 90), Enum.PartType.Cylinder)
		deco(ctx, "VaseNeck", Vector3.new(0.6, 0.5, 0.5), at * CFrame.new(0, 5.4, 0) * UP, Enum.Material.Marble, rgb(60, 70, 90), Enum.PartType.Cylinder)
	end
end

-- Night 4: a long banner hanging from the far-away ceiling.
function Dressing.banner(ctx: Ctx, at: Vector3, yaw: number, color: Color3)
	local top = ctx.ceiling - 1
	local frame = CFrame.new(at.X, 0, at.Z) * CFrame.Angles(0, yaw, 0)
	deco(ctx, "BannerRod", Vector3.new(3, 0.25, 0.25), frame * CFrame.new(0, top, 0), Enum.Material.Metal, rgb(170, 140, 70), Enum.PartType.Cylinder)
	deco(ctx, "Banner", Vector3.new(2.4, 15, 0.08), frame * CFrame.new(0, top - 7.6, 0), Enum.Material.Fabric, color)
	deco(ctx, "BannerTip", Vector3.new(1.7, 1.7, 0.08), frame * CFrame.new(0, top - 15.1, 0) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.Fabric, color)
end

-- Night 4: moonlight falling through a skylight in a pale shaft.
function Dressing.moonShaft(ctx: Ctx, at: Vector3)
	local top = ctx.ceiling
	local sky = deco(ctx, "Skylight", Vector3.new(7, 0.3, 7), CFrame.new(at.X, top - 0.2, at.Z), Enum.Material.Neon, rgb(170, 190, 230))
	sky.CastShadow = false
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Angle = 24
	spot.Range = top + 6
	spot.Brightness = 2.2
	spot.Color = rgb(190, 210, 255)
	spot.Shadows = true
	spot.Parent = sky
	local haze = deco(ctx, "LightShaft", Vector3.new(top, 7, 7), CFrame.new(at.X, top / 2, at.Z) * UP, Enum.Material.SmoothPlastic, rgb(200, 215, 255), Enum.PartType.Cylinder)
	haze.Transparency = 0.93
	haze.CastShadow = false
end

-- Night 5: something from an earlier night, floating in the dark.
function Dressing.floatingMemory(ctx: Ctx, at: Vector3)
	local r = ctx.random
	local cf = CFrame.new(at) * CFrame.Angles(r:NextNumber(-0.5, 0.5), r:NextNumber(0, 6.28), r:NextNumber(-0.5, 0.5))
	local kind = r:NextInteger(1, 5)
	local parts: { BasePart } = {}
	local function add(p: BasePart)
		table.insert(parts, p)
	end
	if kind == 1 then -- a bed
		add(deco(ctx, "MemoryBed", Vector3.new(4, 1.2, 7), cf, Enum.Material.Wood, rgb(40, 34, 30)))
		add(deco(ctx, "MemoryMattress", Vector3.new(3.6, 0.7, 6.6), cf * CFrame.new(0, 0.9, 0), Enum.Material.Fabric, rgb(120, 118, 114)))
	elseif kind == 2 then -- a gurney
		add(deco(ctx, "MemoryGurney", Vector3.new(2.6, 0.4, 6.4), cf, Enum.Material.Metal, rgb(110, 110, 112)))
		add(egg(deco(ctx, "MemorySheet", Vector3.new(2, 0.9, 5.6), cf * CFrame.new(0, 0.6, 0), Enum.Material.Fabric, rgb(140, 140, 136))))
	elseif kind == 3 then -- a locker
		add(deco(ctx, "MemoryLocker", Vector3.new(2.6, 7, 2.2), cf, Enum.Material.Metal, rgb(70, 72, 76)))
	elseif kind == 4 then -- a statue's head
		add(egg(deco(ctx, "MemoryHead", Vector3.new(2.6, 3.2, 2.8), cf, Enum.Material.Marble, rgb(170, 170, 166))))
		for _, sx in { -0.55, 0.55 } do
			add(deco(ctx, "MemoryEye", Vector3.new(0.6, 0.4, 0.3), cf * CFrame.new(sx, 0.3, -1.3), Enum.Material.SmoothPlastic, rgb(5, 5, 5)))
		end
	else -- a chair
		add(deco(ctx, "MemoryChair", Vector3.new(2, 0.3, 2), cf, Enum.Material.Wood, rgb(50, 42, 36)))
		add(deco(ctx, "MemoryChairBack", Vector3.new(2, 3, 0.3), cf * CFrame.new(0, 1.5, 0.85), Enum.Material.Wood, rgb(50, 42, 36)))
	end
	for _, p in parts do
		CollectionService:AddTag(p, "Float")
	end
end

-- Night 5: a room that remembers one of the earlier nights.
function Dressing.memoryRoom(ctx: Ctx, block: { Cell }, which: number, cell: Cell?)
	local c = Dressing.blockCenter(ctx, block)
	local base = CFrame.new(c) * CFrame.Angles(0, ctx.random:NextNumber(0, 6.28), 0)
	local dim = rgb(110, 106, 120)
	if which == 1 then
		-- the bed you woke up in
		solid(ctx, "BedFrame", Vector3.new(6, 1.6, 8), base * CFrame.new(0, 0.8, 0), Enum.Material.Wood, rgb(36, 30, 28))
		solid(ctx, "Mattress", Vector3.new(5.6, 0.9, 7.4), base * CFrame.new(0, 2.05, 0.2), Enum.Material.Fabric, dim)
		solid(ctx, "Headboard", Vector3.new(6, 4.2, 0.5), base * CFrame.new(0, 2.1, -4.1), Enum.Material.Wood, rgb(36, 30, 28))
		deco(ctx, "Rug", Vector3.new(9, 0.08, 7), base * CFrame.new(0, 0.04, 6), Enum.Material.Fabric, rgb(40, 36, 46))
	elseif which == 2 then
		-- a hospital bed and its curtain
		solid(ctx, "BedFrame", Vector3.new(3.4, 2.2, 7), base * CFrame.new(0, 1.1, 0), Enum.Material.Metal, rgb(90, 90, 96))
		egg(deco(ctx, "Body", Vector3.new(2, 1, 6), base * CFrame.new(0, 2.6, 0), Enum.Material.Fabric, dim))
		local curtain = deco(ctx, "Curtain", Vector3.new(0.1, 7.5, 6), base * CFrame.new(2.6, 3.75, 0), Enum.Material.Fabric, rgb(80, 90, 96))
		curtain.Transparency = 0.3
	else
		-- a plinth with nothing on it
		solid(ctx, "Plinth", Vector3.new(3, 4, 3), base * CFrame.new(0, 2, 0), Enum.Material.Marble, rgb(120, 120, 124))
		ctx.sign(base * CFrame.new(0, 2.6, -1.55), Vector2.new(2.4, 0.8), "IT LEFT", rgb(30, 30, 34), rgb(150, 150, 154), false, Enum.Font.Fondamento)
	end
	-- one cold light over it, like a memory
	local hang = math.min(ctx.ceiling, ctx.H) - 1
	deco(ctx, "MemoryCord", Vector3.new(0.08, ctx.ceiling - hang, 0.08), base * CFrame.new(0, (ctx.ceiling + hang) / 2, 0), Enum.Material.SmoothPlastic, rgb(10, 10, 12))
	local bulb = deco(ctx, "MemoryLight", Vector3.new(0.6, 0.6, 0.6), base * CFrame.new(0, hang, 0), Enum.Material.Neon, rgb(150, 140, 190), Enum.PartType.Ball)
	bulb.CastShadow = false
	local spot = Instance.new("SpotLight")
	spot.Face = Enum.NormalId.Bottom
	spot.Angle = 70
	spot.Range = hang + 8
	spot.Brightness = 1.4
	spot.Color = rgb(170, 160, 220)
	spot.Shadows = true
	spot.Parent = bulb
	ctx.addLamp(bulb, spot, cell)
end

return Dressing
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Exit</string>
          <string name="Source"><![CDATA[--!strict
-- The way out, in the hub's south wall. Styles:
--   double  two heavy doors that swing outward (house, ward)
--   grand   the same, tall and bronze (atrium)
--   lift    two steel doors that slide apart (sewer)
--   portal  a dark membrane that dissolves (void)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local WorldBuilder = require(script.Parent.WorldBuilder)

type World = WorldBuilder.World

local Exit = {}
Exit.__index = Exit

export type Exit = typeof(setmetatable(
	{} :: {
		world: World,
		style: string,
		frame: CFrame,
		folder: Folder,
		leaves: { { part: BasePart, opened: CFrame } },
		membrane: BasePart?,
		isOpen: boolean,
		width: number,
		height: number,
	},
	Exit
))

function Exit.new(world: World): Exit
	local ctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Exit"
	folder.Parent = world.model
	local style = world.theme.exitStyle
	local frame = world.exitFrame
	local w, h = ctx.exitWidth, ctx.exitHeight

	local self = setmetatable({
		world = world,
		style = style,
		frame = frame,
		folder = folder,
		leaves = {},
		membrane = nil :: BasePart?,
		isOpen = false,
		width = w,
		height = h,
	}, Exit)

	if style == "portal" then
		local membrane = ctx.part(folder, "Membrane", Vector3.new(w, h, 0.3), frame * CFrame.new(0, h / 2, 0), Enum.Material.Neon, Color3.fromRGB(40, 0, 60), nil)
		membrane.Transparency = 0.1
		membrane.CastShadow = true
		self.membrane = membrane
	else
		local material = Enum.Material.DiamondPlate
		local color = Color3.fromRGB(86, 86, 90)
		if style == "grand" then
			material = Enum.Material.Metal
			color = Color3.fromRGB(150, 112, 60)
		elseif style == "lift" then
			material = Enum.Material.Metal
			color = Color3.fromRGB(120, 124, 126)
		elseif world.night.theme == "ward" then
			material = Enum.Material.Metal
			color = Color3.fromRGB(190, 192, 194)
		end
		for _, sx in { -1, 1 } do
			local closed = frame * CFrame.new(sx * w / 4, h / 2 + 0.02, 0)
			local opened: CFrame
			if style == "lift" then
				opened = closed * CFrame.new(sx * (w / 2 - 0.3), 0, 0)
			else
				local hinge = frame * CFrame.new(sx * w / 2, h / 2 + 0.02, 0)
				opened = hinge * CFrame.Angles(0, math.rad(-sx * 95), 0) * hinge:Inverse() * closed
			end
			local leaf = ctx.part(folder, "ExitDoor", Vector3.new(w / 2 - 0.08, h - 0.05, 0.5), closed, material, color, nil)
			if world.night.theme == "ward" then
				-- round porthole windows
				local window = ctx.part(folder, "Porthole", Vector3.new(0.6, 1.3, 1.3), closed * CFrame.new(0, h * 0.18, 0) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Glass, Color3.fromRGB(40, 10, 10), Enum.PartType.Cylinder)
				window.Anchored = false
				window.CanCollide = false
				window.Massless = true
				window.Transparency = 0.3
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = leaf
				weld.Part1 = window
				weld.Parent = window
			end
			table.insert(self.leaves, { part = leaf :: BasePart, opened = opened })
		end
	end
	return self
end

-- Where to hang padlocks / mount a keypad: frame offsets on the hub side.
function Exit.hubSide(self: Exit, x: number, y: number): CFrame
	return self.frame * CFrame.new(x, y, 0.5)
end

function Exit.open(self: Exit)
	if self.isOpen then
		return
	end
	self.isOpen = true
	local anchor = if self.membrane then self.membrane else self.leaves[1].part
	Audio.play("Unlock", anchor, 1.2, 1, 120)
	task.delay(0.6, function()
		if not self.folder.Parent then
			return
		end
		local membrane = self.membrane
		if membrane then
			membrane.CanCollide = false
			TweenService:Create(membrane, TweenInfo.new(2, Enum.EasingStyle.Sine), { Transparency = 1 }):Play()
			Audio.play("HeartShatter", membrane, 1, 0.6, 140)
		else
			for _, leaf in self.leaves do
				TweenService:Create(leaf.part, TweenInfo.new(if self.style == "lift" then 2 else 2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = leaf.opened }):Play()
			end
			Audio.play("DoorOpen", anchor, 1.4, if self.style == "lift" then 0.8 else 0.55, 140)
		end
		self.world.exitLight.Enabled = true
	end)
end

return Exit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Interactables</string>
          <string name="Source"><![CDATA[--!strict
-- Things every map has: hinged doors, batteries and hiding lockers.
-- (The exit lives in Exit.luau; keys, generators, photos and hearts in Objectives.)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes

type Layout = Maze.Layout
type World = WorldBuilder.World

export type Door = {
	part: BasePart,
	closed: CFrame,
	opened: CFrame,
	isOpen: boolean,
	busy: boolean,
	prompt: ProximityPrompt,
}

export type Locker = {
	model: Model,
	anchor: BasePart,
	inside: CFrame,
	outside: CFrame,
	occupant: Player?,
	prompt: ProximityPrompt,
	lastUse: number,
}

export type Hooks = {
	onHide: (player: Player, locker: Locker) -> (),
	onNoise: (position: Vector3, radius: number) -> (),
	isAlive: (player: Player) -> boolean,
}

local Interactables = {}
Interactables.__index = Interactables

export type Interactables = typeof(setmetatable(
	{} :: {
		layout: Layout,
		world: World,
		hooks: Hooks,
		folder: Folder,
		doors: { Door },
		lockers: { Locker },
		connections: { RBXScriptConnection },
	},
	Interactables
))

-- Action/object text is never shown (the Custom style is drawn by Client/Prompts as a
-- wordless dot); it only names the prompt for scripts and tests.
function Interactables.prompt(parent: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.Style = Enum.ProximityPromptStyle.Custom
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = distance or 8
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end
local prompt = Interactables.prompt

function Interactables.rootOf(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local rootOf = Interactables.rootOf

function Interactables.new(layout: Layout, world: World, hooks: Hooks): Interactables
	local folder = Instance.new("Folder")
	folder.Name = "Interactive"
	folder.Parent = world.model

	local self = setmetatable({
		layout = layout,
		world = world,
		hooks = hooks,
		folder = folder,
		doors = {},
		lockers = {},
		connections = {},
	}, Interactables)

	self:_buildDoors()
	self:_buildBatteries()
	self:_buildLockers()

	table.insert(self.connections, Remotes.LeaveHiding.OnServerEvent:Connect(function(player: Player)
		self:leave(player, false)
	end))
	return self
end

-- Doors ------------------------------------------------------------------------

function Interactables._buildDoors(self: Interactables)
	local ctx = self.world.ctx
	for key, kind in self.layout.edges do
		if kind == "door" then
			local x, z, dir = Maze.parseEdgeKey(key)
			local frame = ctx.edgeFrame(x, z, dir)
			local w, h = ctx.doorWidth - 0.2, ctx.doorHeight - 0.15
			local closed = frame * CFrame.new(0, h / 2 + 0.05, 0)
			local hinge = frame * CFrame.new(-w / 2, h / 2 + 0.05, 0)
			local opened = hinge * CFrame.Angles(0, math.rad(-100), 0) * hinge:Inverse() * closed

			local style = self.world.theme.trim
			local door = ctx.part(self.folder, "Door", Vector3.new(w, h, 0.35), closed, if style.material == Enum.Material.Neon then Enum.Material.Basalt else style.material, if style.material == Enum.Material.Neon then Color3.fromRGB(20, 16, 26) else style.color, nil)
			door.CollisionGroup = "Furniture"
			for _, side in { -1, 1 } do
				local knob = ctx.part(self.folder, "Knob", Vector3.new(0.35, 0.35, 0.35), closed * CFrame.new(w / 2 - 0.6, -0.7, side * 0.3), Enum.Material.Metal, Color3.fromRGB(170, 170, 160), Enum.PartType.Ball)
				knob.Anchored = false
				knob.CanCollide = false
				knob.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = door
				weld.Part1 = knob
				weld.Parent = knob
			end

			local entry: Door = {
				part = door,
				closed = closed,
				opened = opened,
				isOpen = false,
				busy = false,
				prompt = prompt(door, "Open", "Door", 0, 9),
			}
			table.insert(self.doors, entry)
			if self.world.random:NextNumber() < 0.35 then
				entry.isOpen = true
				door.CFrame = opened
				entry.prompt.ActionText = "Close"
			end
			entry.prompt.Triggered:Connect(function(player: Player)
				if self.hooks.isAlive(player) then
					self:setDoor(entry, not entry.isOpen, false)
					if not entry.isOpen then
						self.hooks.onNoise(door.Position, 30) -- shutting a door carries
					end
				end
			end)
		end
	end
end

function Interactables.setDoor(self: Interactables, door: Door, open: boolean, slam: boolean)
	if door.busy or door.isOpen == open then
		return
	end
	door.busy = true
	door.isOpen = open
	local info = if slam
		then TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(door.part, info, { CFrame = if open then door.opened else door.closed })
	tween:Play()
	if slam then
		Audio.play("DoorSlam", door.part, 1.3, 1, 110)
	elseif open then
		Audio.play("DoorOpen", door.part, 0.8, 1, 60)
	else
		Audio.play("DoorSlam", door.part, 0.5, 1.25, 60)
	end
	door.prompt.ActionText = if open then "Close" else "Open"
	tween.Completed:Once(function()
		door.busy = false
	end)
end

-- The monster bursts through closed doors in its way.
function Interactables.slamOpenNear(self: Interactables, position: Vector3, radius: number)
	for _, door in self.doors do
		if not door.isOpen and not door.busy and (door.part.Position - position).Magnitude < radius then
			self:setDoor(door, true, true)
		end
	end
end

-- Every open door in the place slams shut at once (a chaos event).
function Interactables.slamAll(self: Interactables): number
	local count = 0
	for _, door in self.doors do
		if door.isOpen and not door.busy then
			self:setDoor(door, false, true)
			count += 1
		end
	end
	return count
end

-- Spot helpers -----------------------------------------------------------------

-- The wall at the back of a cell (opposite its way in), for placing things.
function Interactables.backWallSide(layout: Layout, x: number, z: number): string
	for _, d in Maze.DIRS do
		if Maze.isPassable(Maze.getEdge(layout, x, z, d)) then
			local back = Maze.OPPOSITE[d]
			if Maze.getEdge(layout, x, z, back) == "wall" then
				return back
			end
		end
	end
	for _, d in Maze.DIRS do
		if Maze.getEdge(layout, x, z, d) == "wall" then
			return d
		end
	end
	return "N"
end

-- A frame to put an objective item in a cell: against its back wall if it has one,
-- otherwise on the floor near the middle (open halls).
function Interactables.spotFrame(world: World, cell: Maze.Cell): CFrame
	local ctx = world.ctx
	for _, d in Maze.DIRS do
		if Maze.getEdge(world.ctx.layout, cell.x, cell.z, d) == "wall" then
			return ctx.sideFrame(cell.x, cell.z, Interactables.backWallSide(world.ctx.layout, cell.x, cell.z)) * CFrame.new(0, 0, -1.8)
		end
	end
	local center = ctx.cellCenter(cell.x, cell.z)
	return CFrame.new(center + Vector3.new(ctx.C * 0.2, 0, ctx.C * 0.2)) * CFrame.Angles(0, world.random:NextNumber(0, 6.28), 0)
end

-- Batteries --------------------------------------------------------------------

function Interactables._buildBatteries(self: Interactables)
	local ctx = self.world.ctx
	for _, cell in self.layout.batteries do
		local frame = Interactables.spotFrame(self.world, cell) * CFrame.new(self.world.random:NextNumber(-2.5, 2.5), 0, 1.1)
		local battery = ctx.decor(ctx.part(self.folder, "Battery", Vector3.new(1.1, 0.5, 0.5), frame * CFrame.new(0, 0.26, 0) * CFrame.Angles(0, self.world.random:NextNumber(-0.6, 0.6), 0), Enum.Material.Metal, Color3.fromRGB(70, 70, 70), Enum.PartType.Cylinder))
		battery.CanQuery = true
		ctx.decor(ctx.part(battery, "BatteryCap", Vector3.new(0.12, 0.3, 0.3), battery.CFrame * CFrame.new(0.6, 0, 0), Enum.Material.Metal, Color3.fromRGB(200, 200, 200), Enum.PartType.Cylinder))
		local glint = Instance.new("PointLight")
		glint.Range = 4
		glint.Brightness = 0.5
		glint.Parent = battery
		local p = prompt(battery, "Take", "Battery", 0, 8)
		p.Triggered:Connect(function(player: Player)
			if not self.hooks.isAlive(player) or battery.Parent == nil then
				return
			end
			battery:Destroy()
			Remotes.Battery:FireClient(player, Config.Player.BatteryPickup)
		end)
	end
end

-- Hiding lockers -----------------------------------------------------------------

function Interactables._buildLockers(self: Interactables)
	local ctx = self.world.ctx
	local themeLocker = self.world.theme.locker
	for _, spot in self.layout.lockers do
		local w, h, depth = 4.2, 8.4, 3.4
		local center = ctx.sideFrame(spot.x, spot.z, spot.side) * CFrame.new(0, 0, -depth / 2)
		local material = if spot.house then Enum.Material.Wood else themeLocker.material
		local color = if spot.house then Color3.fromRGB(70, 58, 50) else themeLocker.color

		local model = Instance.new("Model")
		model.Name = if spot.house then "Wardrobe" else "Locker"
		local function panel(name: string, size: Vector3, offset: CFrame)
			local p = ctx.part(model, name, size, center * offset, material, color, nil)
			p.CollisionGroup = "Furniture"
		end
		panel("Back", Vector3.new(w, h, 0.2), CFrame.new(0, h / 2, depth / 2 - 0.1))
		panel("Side", Vector3.new(0.2, h, depth), CFrame.new(-(w / 2 - 0.1), h / 2, 0))
		panel("Side", Vector3.new(0.2, h, depth), CFrame.new(w / 2 - 0.1, h / 2, 0))
		panel("Top", Vector3.new(w, 0.2, depth), CFrame.new(0, h - 0.1, 0))
		panel("Bottom", Vector3.new(w, 0.2, depth), CFrame.new(0, 0.1, 0))
		-- slatted front: you can peek out between the slats
		local y = 0.45
		while y < h - 0.3 do
			panel("Slat", Vector3.new(w - 0.4, 0.44, 0.15), CFrame.new(0, y, -depth / 2 + 0.08))
			y += 0.62
		end
		panel("Handle", Vector3.new(0.18, 1.2, 0.2), CFrame.new(w / 2 - 0.6, 4.2, -depth / 2 - 0.08))

		local anchor = ctx.decor(ctx.part(model, "PromptAnchor", Vector3.new(1, 1, 1), center * CFrame.new(0, 3.5, -depth / 2 - 0.3), Enum.Material.SmoothPlastic, Color3.new(), nil))
		anchor.Transparency = 1
		model.Parent = self.folder

		local locker: Locker = {
			model = model,
			anchor = anchor,
			inside = center * CFrame.new(0, 3.1, 0.15),
			outside = center * CFrame.new(0, 3.1, -(depth / 2 + 2.6)),
			occupant = nil,
			prompt = prompt(anchor, "Hide", if spot.house then "Wardrobe" else "Locker", 0.25, 7),
			lastUse = -math.huge,
		}
		table.insert(self.lockers, locker)
		locker.prompt.Triggered:Connect(function(player: Player)
			self:hide(player, locker)
		end)
	end
end

function Interactables.lockerOf(self: Interactables, player: Player): Locker?
	for _, locker in self.lockers do
		if locker.occupant == player then
			return locker
		end
	end
	return nil
end

function Interactables.hide(self: Interactables, player: Player, locker: Locker)
	if locker.occupant or os.clock() - locker.lastUse < 0.8 then
		return
	end
	if not self.hooks.isAlive(player) or self:lockerOf(player) then
		return
	end
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return
	end
	locker.occupant = player
	locker.lastUse = os.clock()
	root.Anchored = true
	character:PivotTo(locker.inside)
	player:SetAttribute("Hiding", true)
	locker.prompt.Enabled = false
	Audio.play("Locker", locker.anchor, 0.9, 1, 60)
	self.hooks.onHide(player, locker)
end

-- pulled = the monster dragged them out, so they stay frozen for the jumpscare.
function Interactables.leave(self: Interactables, player: Player, pulled: boolean)
	local locker = self:lockerOf(player)
	if not locker then
		return
	end
	if not pulled and os.clock() - locker.lastUse < 0.5 then
		return
	end
	locker.occupant = nil
	locker.lastUse = os.clock()
	locker.prompt.Enabled = true
	player:SetAttribute("Hiding", false)
	local character = player.Character
	local root = rootOf(player)
	if character and root then
		character:PivotTo(locker.outside)
		if not pulled then
			root.Anchored = false
		end
	end
	Audio.play("Locker", locker.anchor, if pulled then 1.4 else 0.8, if pulled then 0.8 else 1.05, 70)
end

function Interactables.release(self: Interactables, player: Player)
	local locker = self:lockerOf(player)
	if locker then
		locker.occupant = nil
		locker.prompt.Enabled = true
	end
	player:SetAttribute("Hiding", false)
end

function Interactables.destroy(self: Interactables)
	for _, c in self.connections do
		c:Disconnect()
	end
	table.clear(self.connections)
	for _, locker in self.lockers do
		if locker.occupant then
			locker.occupant:SetAttribute("Hiding", false)
		end
	end
end

return Interactables
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- The lobby: a circle of old stone in the fog, nothing around it but dark. Four doors
-- stand on their own around the edge, each with light leaking from behind it and a
-- square marked out on the ground in front of it. Something tall stands where the fog
-- begins. Every so often it's somewhere else.
--
-- Walk into an empty square and you choose the night and how many of you there'll be.
-- One: you go straight through. More: the sign over the door counts down from 10 and
-- whoever is standing in the square when it reaches 0 goes through with you.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Monsters = require(ReplicatedStorage.Shared.Monsters)
local Nights = require(ReplicatedStorage.Shared.Nights)

local Remotes = ReplicatedStorage.Remotes

local Lobby = {}

Lobby.ORIGIN = Vector3.new(-1200, 0, 0) -- far from where the nights are built
Lobby.RADIUS = 66 -- the stone circle
Lobby.PAD_SIZE = 12
Lobby.COUNTDOWN = 10
Lobby.MAX_PLAYERS = 4

-- The lobby's light: grey dark, fog closing in.
Lobby.LIGHTING = {
	Ambient = Color3.fromRGB(48, 48, 52),
	FogColor = Color3.fromRGB(14, 14, 16),
	FogStart = 25,
	FogEnd = 150,
	Saturation = -1,
	Contrast = 0.25,
	Brightness = 0,
	Tint = Color3.fromRGB(255, 255, 255),
	Bloom = 0.6,
	Exposure = 0,
	LampColor = Color3.fromRGB(230, 222, 205),
	Reverb = "Plain",
} :: Nights.Lighting

export type Hooks = {
	highest: (player: Player) -> number, -- highest night this player may choose
	launch: (players: { Player }, night: number) -> (), -- send them through
	isOpen: () -> boolean, -- false while a night is being played in this server
}

export type Pad = {
	index: number,
	center: Vector3,
	state: string, -- "idle" | "choosing" | "waiting" | "gone"
	leader: Player?,
	night: number,
	capacity: number,
	order: { Player }, -- who's standing in it, in the order they stepped in
	declined: { [Player]: boolean }, -- closed the choice: not asked again until they step out
	deadline: number,
	count: TextLabel,
	timer: TextLabel,
}

export type Lobby = {
	model: Model,
	pads: { Pad },
	spawnCFrame: () -> CFrame,
	choose: (player: Player, index: number, night: number, players: number) -> (),
	cancel: (player: Player, index: number) -> (),
	destroy: () -> (),
}

local PALE = Color3.fromRGB(205, 200, 188)
local STONE = Color3.fromRGB(64, 64, 66)

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Material = material
	p.Color = color
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function deco(p: Part): Part
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function lamp(parent: Instance, at: Vector3, brightness: number, range: number): Part
	local bulb = deco(part(parent, "Bulb", Vector3.new(0.6, 0.6, 0.6), CFrame.new(at), Enum.Material.Neon, Lobby.LIGHTING.LampColor, Enum.PartType.Ball))
	deco(part(parent, "Cord", Vector3.new(0.06, 6, 0.06), CFrame.new(at + Vector3.new(0, 3.3, 0)), Enum.Material.SmoothPlastic, Color3.fromRGB(15, 15, 15)))
	local light = Instance.new("PointLight")
	light.Brightness = brightness
	light.Range = range
	light.Color = Lobby.LIGHTING.LampColor
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("BaseBrightness", brightness)
	CollectionService:AddTag(bulb, "FlickerLight")
	return bulb
end

-- A door standing on its own, slightly open, light coming from the other side.
local function door(parent: Instance, at: CFrame): (TextLabel, TextLabel)
	local wood = Color3.fromRGB(38, 32, 28)
	local W, H = 6, 11
	part(parent, "DoorPost", Vector3.new(0.8, H, 0.9), at * CFrame.new(-W / 2 - 0.4, H / 2, 0), Enum.Material.Wood, wood)
	part(parent, "DoorPost", Vector3.new(0.8, H, 0.9), at * CFrame.new(W / 2 + 0.4, H / 2, 0), Enum.Material.Wood, wood)
	part(parent, "Lintel", Vector3.new(W + 1.6, 0.8, 0.9), at * CFrame.new(0, H + 0.4, 0), Enum.Material.Wood, wood)
	-- the door itself, hinged on the left and open a crack
	local hinge = at * CFrame.new(-W / 2, 0, 0) * CFrame.Angles(0, math.rad(-22), 0)
	part(parent, "Door", Vector3.new(W, H - 0.1, 0.35), hinge * CFrame.new(W / 2, H / 2, 0), Enum.Material.Wood, Color3.fromRGB(30, 26, 23))
	deco(part(parent, "Knob", Vector3.new(0.35, 0.35, 0.35), hinge * CFrame.new(W - 0.6, H * 0.45, -0.3), Enum.Material.Metal, Color3.fromRGB(110, 104, 96), Enum.PartType.Ball))
	-- what leaks out of the gap
	local gap = deco(part(parent, "Gap", Vector3.new(0.25, H - 0.4, 0.2), at * CFrame.new(W / 2 - 0.3, H / 2, 0.2), Enum.Material.Neon, Color3.fromRGB(235, 228, 210)))
	gap.Transparency = 0.15
	local glow = Instance.new("SpotLight")
	glow.Face = Enum.NormalId.Front
	glow.Angle = 80
	glow.Range = 28
	glow.Brightness = 2.4
	glow.Color = Color3.fromRGB(235, 228, 210)
	glow.Parent = gap
	-- the sign above it: how many are going, and how long until they do
	local plate = part(parent, "Sign", Vector3.new(4.4, 2.4, 0.2), at * CFrame.new(0, H + 2.2, -0.1), Enum.Material.SmoothPlastic, Color3.fromRGB(10, 10, 10))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 50
	gui.Parent = plate
	local count = Instance.new("TextLabel")
	count.Name = "Count"
	count.BackgroundTransparency = 1
	count.Size = UDim2.fromScale(1, 0.35)
	count.Font = Enum.Font.Garamond
	count.TextScaled = true
	count.TextColor3 = PALE
	count.TextTransparency = 0.25
	count.Text = ""
	count.Parent = gui
	local timer = Instance.new("TextLabel")
	timer.Name = "Timer"
	timer.BackgroundTransparency = 1
	timer.Position = UDim2.fromScale(0, 0.35)
	timer.Size = UDim2.fromScale(1, 0.65)
	timer.Font = Enum.Font.Garamond
	timer.TextScaled = true
	timer.TextColor3 = PALE
	timer.Text = ""
	timer.Parent = gui
	return count, timer
end

-- The square in front of a door, marked out with faded tape.
local function square(parent: Instance, center: Vector3, facing: CFrame)
	local S = Lobby.PAD_SIZE
	local tape = Color3.fromRGB(150, 146, 136)
	local frame = CFrame.new(center) * facing.Rotation
	for _, e in { { 0, S / 2, S, 0.3 }, { 0, -S / 2, S, 0.3 }, { S / 2, 0, 0.3, S }, { -S / 2, 0, 0.3, S } } do
		local strip = deco(part(parent, "Tape", Vector3.new(e[3], 0.05, e[4]), frame * CFrame.new(e[1], 0.03, e[2]), Enum.Material.SmoothPlastic, tape))
		strip.Transparency = 0.35
	end
end

local function deadTree(parent: Instance, at: Vector3, random: Random)
	local bark = Color3.fromRGB(28, 26, 25)
	local trunkH = 16
	part(parent, "Trunk", Vector3.new(trunkH, 1.6, 1.6), CFrame.new(at + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Wood, bark, Enum.PartType.Cylinder)
	for i = 1, 7 do
		local h = 6 + i * 1.4
		local len = 3 + random:NextNumber() * 5
		local yaw = random:NextNumber(0, math.pi * 2)
		local tilt = math.rad(random:NextNumber(25, 65))
		local base = CFrame.new(at + Vector3.new(0, h, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, -tilt)
		deco(part(parent, "Branch", Vector3.new(0.35 + 0.05 * (8 - i), len, 0.35 + 0.05 * (8 - i)), base * CFrame.new(0, len / 2, 0), Enum.Material.Wood, bark))
	end
end

function Lobby.new(hooks: Hooks): Lobby
	local O = Lobby.ORIGIN
	local random = Random.new()
	local model = Instance.new("Model")
	model.Name = "Lobby"

	-- the stone circle, cracked, and nothing beyond it
	part(model, "Ground", Vector3.new(2, Lobby.RADIUS * 2 + 8, Lobby.RADIUS * 2 + 8), CFrame.new(O + Vector3.new(0, -1, 0)) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Slate, STONE, Enum.PartType.Cylinder)
	for _ = 1, 70 do
		local a, r = random:NextNumber(0, math.pi * 2), random:NextNumber(0, Lobby.RADIUS)
		local s = random:NextNumber(2, 7)
		local tile = deco(part(model, "Flagstone", Vector3.new(s, 0.08, s * random:NextNumber(0.6, 1.4)), CFrame.new(O + Vector3.new(math.cos(a) * r, 0.02, math.sin(a) * r)) * CFrame.Angles(0, random:NextNumber(0, 3), 0), Enum.Material.Slate, STONE:Lerp(Color3.new(0, 0, 0), random:NextNumber(0.1, 0.5))))
		tile.CastShadow = false
	end
	-- an invisible edge so nobody walks off into the dark
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local wall = part(model, "Edge", Vector3.new(19, 30, 2), CFrame.new(O + Vector3.new(math.cos(a) * (Lobby.RADIUS + 3), 15, math.sin(a) * (Lobby.RADIUS + 3))) * CFrame.Angles(0, -a + math.pi / 2, 0), Enum.Material.SmoothPlastic, STONE)
		wall.Transparency = 1
	end
	deadTree(model, O + Vector3.new(9, 0, -6), random)

	-- the four doors, each with its square and a bare bulb over it
	local pads: { Pad } = {}
	for i = 1, 4 do
		local a = (i - 0.5) / 4 * math.pi * 2
		local doorAt = O + Vector3.new(math.cos(a) * 44, 0, math.sin(a) * 44)
		local facing = CFrame.lookAt(doorAt, Vector3.new(O.X, 0, O.Z))
		local count, timer = door(model, facing)
		local center = doorAt + facing.LookVector * (Lobby.PAD_SIZE / 2 + 1.5)
		square(model, center, facing)
		-- an invisible marker of the square, so it's easy to find (and test)
		local marker = deco(part(model, "Pad" .. i, Vector3.new(Lobby.PAD_SIZE, 0.2, Lobby.PAD_SIZE), CFrame.new(center) * facing.Rotation, Enum.Material.SmoothPlastic, STONE))
		marker.Transparency = 1
		lamp(model, center + Vector3.new(0, 9, 0), 1.3, 24)
		table.insert(pads, {
			index = i,
			center = center,
			state = "idle",
			leader = nil,
			night = 1,
			capacity = 1,
			order = {},
			declined = {},
			deadline = 0,
			count = count,
			timer = timer,
		})
	end

	-- the one watching from the fog
	local watcher = Monsters.build("Hollow", { preview = true })
	watcher.model.Name = "Watcher"
	local function moveWatcher()
		local a = random:NextNumber(0, math.pi * 2)
		local at = O + Vector3.new(math.cos(a) * 84, watcher.rootHeight, math.sin(a) * 84)
		watcher.model:PivotTo(CFrame.lookAt(at, Vector3.new(O.X, at.Y, O.Z)))
		Monsters.solve(watcher)
	end
	moveWatcher()
	watcher.model.Parent = model
	model.Parent = workspace

	local function inLobby(player: Player): Vector3?
		if player:GetAttribute("Where") ~= "lobby" then
			return nil
		end
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
		return if root then root.Position else nil
	end

	local function inside(pad: Pad, player: Player): boolean
		local pos = inLobby(player)
		if not pos then
			return false
		end
		local d = pos - pad.center
		local half = Lobby.PAD_SIZE / 2
		return math.abs(d.X) <= half and math.abs(d.Z) <= half and d.Y < 12
	end

	local function reset(pad: Pad)
		pad.state = "idle"
		pad.leader = nil
		pad.capacity = 1
		pad.deadline = 0
	end

	local function members(pad: Pad): { Player }
		local out = {}
		for _, p in pad.order do
			if #out < pad.capacity then
				table.insert(out, p)
			end
		end
		return out
	end

	local function go(pad: Pad, group: { Player })
		pad.state = "gone"
		for _, p in group do
			Remotes.Lobby:FireClient(p, "launch", pad.night)
		end
		hooks.launch(group, pad.night)
		task.delay(2, function()
			if pad.state == "gone" then
				reset(pad)
			end
		end)
	end

	local function sign(pad: Pad)
		if pad.state == "waiting" then
			pad.count.Text = string.format("%d / %d", #members(pad), pad.capacity)
			pad.timer.Text = tostring(math.max(1, math.ceil(pad.deadline - os.clock())))
		elseif pad.state == "choosing" then
			pad.count.Text = ""
			pad.timer.Text = "· · ·"
		else
			pad.count.Text = ""
			pad.timer.Text = ""
		end
	end

	local function update()
		local open = hooks.isOpen()
		for _, pad in pads do
			-- who's standing in it now, keeping the order they came in
			local still = {}
			for _, p in pad.order do
				if inside(pad, p) then
					table.insert(still, p)
				end
			end
			for _, p in Players:GetPlayers() do
				if inside(pad, p) and not table.find(still, p) then
					table.insert(still, p)
				end
			end
			pad.order = still
			for p in pad.declined do
				if not table.find(still, p) then
					pad.declined[p] = nil
				end
			end

			if not open then
				if pad.state == "choosing" and pad.leader then
					Remotes.Lobby:FireClient(pad.leader, "close", pad.index)
				end
				if pad.state ~= "gone" then
					reset(pad)
				end
			elseif pad.state == "idle" then
				for _, p in still do
					if not pad.declined[p] then
						pad.state = "choosing"
						pad.leader = p
						Remotes.Lobby:FireClient(p, "choose", pad.index, math.min(hooks.highest(p), Nights.count))
						break
					end
				end
			elseif pad.state == "choosing" then
				local leader = pad.leader
				if not leader or not table.find(still, leader) then
					if leader then
						Remotes.Lobby:FireClient(leader, "close", pad.index)
					end
					reset(pad)
				end
			elseif pad.state == "waiting" then
				if #still == 0 then
					reset(pad)
				elseif os.clock() >= pad.deadline then
					go(pad, members(pad))
				end
			end
			sign(pad)
		end
	end

	local connections: { RBXScriptConnection } = {}
	local accum = 0
	table.insert(connections, RunService.Heartbeat:Connect(function(dt: number)
		accum += dt
		if accum >= 0.2 then
			accum = 0
			update()
		end
	end))
	local alive = true
	task.spawn(function()
		while alive do
			task.wait(random:NextNumber(45, 90))
			if alive then
				moveWatcher()
			end
		end
	end)

	local lobby: Lobby
	lobby = {
		model = model,
		pads = pads,
		spawnCFrame = function(): CFrame
			local a = random:NextNumber(0, math.pi * 2)
			local at = O + Vector3.new(math.cos(a) * 6, 3.5, math.sin(a) * 6)
			return CFrame.lookAt(at, at + Vector3.new(math.cos(a), 0, math.sin(a)))
		end,
		-- the leader picked a night and how many of them there'll be
		choose = function(player: Player, index: number, night: number, count: number)
			local pad = pads[index]
			if not pad or pad.state ~= "choosing" or pad.leader ~= player then
				return
			end
			pad.night = math.clamp(math.floor(night), 1, math.min(hooks.highest(player), Nights.count))
			pad.capacity = math.clamp(math.floor(count), 1, Lobby.MAX_PLAYERS)
			if pad.capacity == 1 then
				go(pad, { player })
			else
				pad.state = "waiting"
				pad.deadline = os.clock() + Lobby.COUNTDOWN
				sign(pad)
			end
		end,
		cancel = function(player: Player, index: number)
			local pad = pads[index]
			if pad and pad.state == "choosing" and pad.leader == player then
				pad.declined[player] = true
				reset(pad)
			end
		end,
		destroy = function()
			alive = false
			for _, c in connections do
				c:Disconnect()
			end
			model:Destroy()
		end,
	}

	table.insert(connections, Remotes.Lobby.OnServerEvent:Connect(function(player: Player, action: unknown, index: unknown, night: unknown, count: unknown)
		if typeof(index) ~= "number" then
			return
		end
		if action == "choose" and typeof(night) == "number" and typeof(count) == "number" then
			lobby.choose(player, index, night, count)
		elseif action == "cancel" then
			lobby.cancel(player, index)
		end
	end))

	return lobby
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="39">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- ACHROMA server entry point.
local RoundManager = require(script.Parent.RoundManager)

RoundManager.run()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">MonsterAI</string>
          <string name="Source"><![CDATA[--!strict
-- The thing in the halls. Server-side brain, tuned per night (see Nights.luau):
--   Dormant     hidden away; now and then it APPEARS at the end of your corridor,
--               stares, and vanishes when you get close
--   Wander      roams, drifting towards wherever players are
--   Investigate heard something and goes to look
--   Chase       saw (or heard) you. Screams. Runs at you
--   Search      lost you; sniffs around the last place it saw you
--   HuntLocker  watched (or smelled) you climb into a locker, coming to pull you out
--   Kill        caught someone
-- The Statue has its own two states: Frozen (someone is looking) and Stalk.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Monsters = require(ReplicatedStorage.Shared.Monsters)
local Interactables = require(script.Parent.Interactables)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes

type Layout = Maze.Layout
type Locker = Interactables.Locker

export type Hooks = {
	getPlayers: () -> { Player }, -- players still in the round (not caught, not escaped)
	onCaught: (player: Player, monster: Model) -> (),
	onAwake: () -> (),
	getLook: (player: Player) -> Vector3?, -- where that player's camera points
	setBlink: (on: boolean) -> (),
}

local MonsterAI = {}
MonsterAI.__index = MonsterAI

export type MonsterAI = typeof(setmetatable(
	{} :: {
		layout: Layout,
		world: WorldBuilder.World,
		interactables: Interactables.Interactables,
		hooks: Hooks,
		p: { [string]: any },
		rig: Monsters.Rig,
		humanoid: Humanoid,
		state: string,
		path: { Vector3 },
		pathIndex: number,
		pathGoal: Vector3?,
		lastRepath: number,
		target: Player?,
		lastSeenPos: Vector3?,
		lastSeenTime: number,
		aggression: number,
		frenzyUntil: number,
		lungeUntil: number,
		nextLunge: number,
		awake: boolean,
		awakeAt: number,
		nextApparition: number,
		apparitionTarget: Player?,
		apparitionEnds: number,
		sawHide: { [Player]: Locker },
		huntLocker: Locker?,
		pauseUntil: number,
		searchCenter: Vector3,
		searchUntil: number,
		lastScream: number,
		lastContact: number,
		stuckCheckAt: number,
		stuckPos: Vector3,
		stuckCount: number,
		sightParams: RaycastParams,
		moveParams: RaycastParams,
		noise: { position: Vector3, radius: number }?,
		nextBlink: number,
		blinkUntil: number,
		frozen: boolean,
		lastGrind: number,
		thinkAccum: number,
		silent: boolean,
		connection: RBXScriptConnection?,
		destroyed: boolean,
		random: Random,
	},
	MonsterAI
))

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local rootOf = Interactables.rootOf

local function headOf(player: Player): BasePart?
	local character = player.Character
	return if character then character:FindFirstChild("Head") :: BasePart? else nil
end

function MonsterAI.new(layout: Layout, world: WorldBuilder.World, interactables: Interactables.Interactables, params: { [string]: any }, kind: string, hooks: Hooks): MonsterAI
	local rig = Monsters.build(kind, { variant = params.Variant })
	rig.model.Parent = workspace

	local sightParams = RaycastParams.new()
	sightParams.FilterType = Enum.RaycastFilterType.Include
	sightParams.FilterDescendantsInstances = { world.model }

	-- movement checks ignore furniture (it walks through it) and non-collidable decor
	local moveParams = RaycastParams.new()
	moveParams.FilterType = Enum.RaycastFilterType.Include
	moveParams.FilterDescendantsInstances = { world.model }
	moveParams.CollisionGroup = "Monster"
	moveParams.RespectCanCollide = true

	local now = os.clock()
	local random = Random.new(layout.seed + 99)
	local self = setmetatable({
		layout = layout,
		world = world,
		interactables = interactables,
		hooks = hooks,
		p = params,
		rig = rig,
		humanoid = rig.humanoid :: Humanoid,
		state = "Dormant",
		path = {},
		pathIndex = 1,
		pathGoal = nil,
		lastRepath = 0,
		target = nil,
		lastSeenPos = nil,
		lastSeenTime = -math.huge,
		aggression = 0,
		frenzyUntil = 0,
		lungeUntil = 0,
		nextLunge = 0,
		awake = false,
		awakeAt = now + params.AwakenAfter,
		nextApparition = now + random:NextNumber(params.ApparitionMin * 0.5, params.ApparitionMax * 0.6),
		apparitionTarget = nil,
		apparitionEnds = 0,
		sawHide = {},
		huntLocker = nil,
		pauseUntil = 0,
		searchCenter = Vector3.zero,
		searchUntil = 0,
		lastScream = -math.huge,
		lastContact = now,
		stuckCheckAt = 0,
		stuckPos = Vector3.zero,
		stuckCount = 0,
		sightParams = sightParams,
		moveParams = moveParams,
		noise = nil,
		nextBlink = now + random:NextNumber(params.BlinkMin, params.BlinkMax),
		blinkUntil = 0,
		frozen = false,
		lastGrind = 0,
		thinkAccum = 0,
		silent = false,
		connection = nil,
		destroyed = false,
		random = random,
	}, MonsterAI)

	self:_park()
	self:_setState("Dormant")
	return self
end

function MonsterAI.start(self: MonsterAI)
	self.connection = RunService.Heartbeat:Connect(function(dt: number)
		self.thinkAccum += dt
		if self.thinkAccum >= 0.1 then
			self.thinkAccum = 0
			self:_think()
		end
	end)
end

function MonsterAI.destroy(self: MonsterAI)
	self.destroyed = true
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	self.hooks.setBlink(false)
	self.rig.model:Destroy()
end

-- Public hooks -----------------------------------------------------------------

function MonsterAI.setAggression(self: MonsterAI, progress: number)
	self.aggression = progress
	self:_updateSpeed()
end

function MonsterAI.hearNoise(self: MonsterAI, position: Vector3, radius: number)
	if not self.noise or radius > self.noise.radius then
		self.noise = { position = position, radius = radius }
	end
end

function MonsterAI.onPlayerHid(self: MonsterAI, player: Player, locker: Locker)
	-- it only knows which locker you're in if it was watching you a moment ago...
	if self.state == "Chase" and self.target == player and os.clock() - self.lastSeenTime < 0.8 then
		self.sawHide[player] = locker
		return
	end
	-- ...or if it can smell you, in which case it comes straight for the locker
	local sense = self.p.SenseHidden
	if sense > 0 and self.awake and self.state ~= "Kill" and (locker.inside.Position - self.rig.root.Position).Magnitude < sense then
		self.sawHide[player] = locker
		self.huntLocker = locker
		self:_setState("HuntLocker")
		self:_setPathTo(locker.outside.Position)
	end
end

-- It knows where everyone is for a while, and goes for the nearest (or a given) player.
function MonsterAI.frenzy(self: MonsterAI, seconds: number, target: Player?)
	if not self.awake then
		self:awaken()
	end
	self.frenzyUntil = os.clock() + seconds
	if self.p.Statue then
		return
	end
	local root = self.rig.root
	local chosen = target
	if not chosen or chosen:GetAttribute("Hiding") then
		local best = math.huge
		for _, player in self.hooks.getPlayers() do
			local proot = rootOf(player)
			if proot and not player:GetAttribute("Hiding") then
				local d = (proot.Position - root.Position).Magnitude
				if d < best then
					chosen, best = player, d
				end
			end
		end
	end
	if chosen and self.state ~= "Kill" then
		self.lastSeenTime = os.clock()
		self:_startChase(chosen)
	end
	self:_updateSpeed()
end

-- Curse "Dead Silence": no growl, no scream, no grinding. Just there.
function MonsterAI.setSilent(self: MonsterAI, on: boolean)
	self.silent = on
	self.rig.model:SetAttribute("Silent", on)
	if self.rig.growl then
		self.rig.growl.Volume = if on then 0 else 1.2
	end
end

-- A hidden player gave themselves away (they let their breath out while it was close).
function MonsterAI.revealHider(self: MonsterAI, player: Player, locker: Locker)
	if not self.awake or self.state == "Kill" or self.p.Statue then
		return
	end
	self.sawHide[player] = locker
	self.huntLocker = locker
	self:_setState("HuntLocker")
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self:_setPathTo(locker.outside.Position)
end

-- The maze changed under it (shifting walls): re-plan whatever route it was walking.
function MonsterAI.mapChanged(self: MonsterAI)
	local goal = self.pathGoal
	if #self.path > 0 and goal then
		self:_setPathTo(goal)
	end
end

function MonsterAI.onExitOpened(self: MonsterAI)
	self:frenzy(self.p.FrenzyTime, nil)
end

function MonsterAI.forget(self: MonsterAI, player: Player)
	self.sawHide[player] = nil
	if self.target == player then
		self.target = nil
	end
	if self.apparitionTarget == player then
		self.apparitionTarget = nil
	end
end

function MonsterAI.awaken(self: MonsterAI)
	if self.awake or self.destroyed then
		return
	end
	self.awake = true

	-- wake up in the maze cell farthest from every player
	local spawnCell = self.layout.monsterSpawn
	local players = self.hooks.getPlayers()
	if #players > 0 then
		local maps = {}
		for _, player in players do
			local proot = rootOf(player)
			if proot then
				table.insert(maps, Maze.distances(self.layout, Maze.cellOf(self.layout, proot.Position.X, proot.Position.Z)))
			end
		end
		local bestScore = -1
		for z = 0, self.layout.depth - 1 do
			for x = 0, self.layout.width - 1 do
				if not Maze.isHub(self.layout, x, z) then
					local score = math.huge
					for _, dist in maps do
						score = math.min(score, dist[Maze.key(x, z)] or 0)
					end
					if score > bestScore then
						bestScore = score
						spawnCell = { x = x, z = z }
					end
				end
			end
		end
	end
	local cx, cz = Maze.cellCenter(self.layout, spawnCell)
	self.rig.model:PivotTo(CFrame.new(cx, self.rig.rootHeight, cz))
	self:_release()
	self.humanoid:MoveTo(self.rig.root.Position) -- forget the walk target from where it was parked
	if self.rig.growl then
		self.rig.growl:Play()
	end
	if self.p.Statue then
		self:_setState("Stalk")
	else
		self:_setState("Wander")
		self:_pickWanderTarget()
	end
	self.hooks.onAwake()
end

-- Internals ----------------------------------------------------------------------

function MonsterAI._park(self: MonsterAI)
	self.rig.root.Anchored = true
	self.rig.model:PivotTo(self.world.hiddenSpot)
	self.humanoid:MoveTo(self.rig.root.Position)
end

function MonsterAI._release(self: MonsterAI)
	self.rig.root.Anchored = false
	pcall(function()
		self.rig.root:SetNetworkOwner(nil) -- the server drives it, never a nearby client
	end)
end

function MonsterAI._setState(self: MonsterAI, state: string)
	self.state = state
	self.rig.model:SetAttribute("State", state)
	if state ~= "Chase" and state ~= "HuntLocker" and state ~= "Kill" then
		self.rig.model:SetAttribute("TargetUserId", 0)
	end
	self:_updateSpeed()
end

function MonsterAI._chaseSpeed(self: MonsterAI): number
	local p = self.p
	local speed = p.ChaseSpeed + self.aggression * p.ChaseSpeedPerProgress
	local now = os.clock()
	if now < self.frenzyUntil then
		speed += p.FrenzyBonus
	end
	if now < self.lungeUntil then
		speed += p.LungeBonus
	end
	return speed
end

function MonsterAI._updateSpeed(self: MonsterAI)
	local p = self.p
	local s = self.state
	local speed = 0
	if s == "Wander" then
		speed = p.WanderSpeed
	elseif s == "Investigate" then
		speed = p.InvestigateSpeed
	elseif s == "Search" then
		speed = p.SearchSpeed
	elseif s == "Chase" then
		speed = self:_chaseSpeed()
	elseif s == "HuntLocker" then
		speed = self:_chaseSpeed() - 1
	elseif s == "Stalk" then
		speed = p.StatueSpeed + self.aggression * p.StatueSpeedPerProgress
	end
	self.humanoid.WalkSpeed = speed
	local growl = self.rig.growl
	if growl and not self.silent then
		local chasing = s == "Chase" or s == "HuntLocker"
		growl.PlaybackSpeed = if chasing then 1.12 else 0.92
		growl.Volume = if chasing then 1.9 else 1.2
	end
end

function MonsterAI._cellAt(self: MonsterAI, pos: Vector3): Maze.Cell
	return Maze.cellOf(self.layout, pos.X, pos.Z)
end

function MonsterAI._isActive(self: MonsterAI, player: Player): boolean
	for _, p in self.hooks.getPlayers() do
		if p == player then
			return true
		end
	end
	return false
end

-- Waypoints through the maze: edge midpoints (doorways are centred on them) and
-- cell centres, ending exactly at the goal.
function MonsterAI._setPathTo(self: MonsterAI, goal: Vector3): boolean
	local root = self.rig.root
	local cells = Maze.findPath(self.layout, self:_cellAt(root.Position), self:_cellAt(goal))
	self.pathGoal = goal
	self.pathIndex = 1
	if not cells then
		self.path = {}
		return false
	end
	local C = self.layout.cellSize
	local y = root.Position.Y
	local points = {}
	for i = 2, #cells do
		local a, b = cells[i - 1], cells[i]
		table.insert(points, Vector3.new((a.x + b.x + 1) * C / 2, y, (a.z + b.z + 1) * C / 2))
		if i < #cells then
			local cx, cz = Maze.cellCenter(self.layout, b)
			table.insert(points, Vector3.new(cx, y, cz))
		end
	end
	table.insert(points, Vector3.new(goal.X, y, goal.Z))
	self.path = points
	return true
end

-- Returns true once the path is finished.
function MonsterAI._followPath(self: MonsterAI): boolean
	local root = self.rig.root
	local p = self.path[self.pathIndex]
	while p and flat(p - root.Position).Magnitude < 2.2 do
		self.pathIndex += 1
		p = self.path[self.pathIndex]
	end
	if not p then
		self.path = {}
		return true
	end
	self.humanoid:MoveTo(p)
	return false
end

function MonsterAI._clearLine(self: MonsterAI, goal: Vector3): boolean
	local origin = self.rig.root.Position
	local direction = Vector3.new(goal.X, origin.Y, goal.Z) - origin
	if direction.Magnitude < 1 then
		return true
	end
	return workspace:Spherecast(origin, 1.3, direction, self.moveParams) == nil
end

-- Go straight at a point when nothing's in the way, otherwise path to it.
function MonsterAI._moveToward(self: MonsterAI, goal: Vector3, now: number)
	if self:_clearLine(goal) then
		self.path = {}
		self.humanoid:MoveTo(Vector3.new(goal.X, self.rig.root.Position.Y, goal.Z))
	else
		local goalMoved = self.pathGoal == nil or flat((self.pathGoal :: Vector3) - goal).Magnitude > 6
		if #self.path == 0 or goalMoved or now - self.lastRepath > 0.8 then
			self.lastRepath = now
			self:_setPathTo(goal)
		end
		self:_followPath()
	end
end

function MonsterAI._canSee(self: MonsterAI, player: Player, ignoreCone: boolean): (boolean, Vector3?)
	local p = self.p
	if player:GetAttribute("Hiding") then
		return false, nil
	end
	local proot, phead = rootOf(player), headOf(player)
	if not proot or not phead then
		return false, nil
	end
	local eye = self.rig.head.Position
	local toTarget = phead.Position - eye
	local dist = toTarget.Magnitude
	local range = if player:GetAttribute("Flashlight") then p.SightRangeFlashlight else p.SightRange
	local speed = flat(proot.AssemblyLinearVelocity).Magnitude
	if speed > 0.5 and speed < 6.5 then
		range *= p.SneakSightMultiplier
	end
	range = math.max(range, p.CloseSense) -- even a blind thing notices you bump into it
	if dist > range then
		return false, nil
	end
	if not ignoreCone and dist > p.CloseSense then
		local look = flat(self.rig.root.CFrame.LookVector)
		local dir = flat(toTarget)
		if look.Magnitude > 0.01 and dir.Magnitude > 0.01 and look.Unit:Dot(dir.Unit) < p.ViewDot then
			return false, nil
		end
	end
	if workspace:Raycast(eye, toTarget, self.sightParams) then
		return false, nil
	end
	return true, proot.Position
end

function MonsterAI._lookForPlayers(self: MonsterAI): (Player?, Vector3?)
	local best: Player? = nil
	local bestPos: Vector3? = nil
	local bestDist = math.huge
	local root = self.rig.root
	for _, player in self.hooks.getPlayers() do
		local seen, pos = self:_canSee(player, self.state == "Chase" and player == self.target)
		if seen and pos then
			local d = (pos - root.Position).Magnitude
			if player == self.target then
				d *= 0.5 -- stick with the current target
			end
			if d < bestDist then
				best, bestPos, bestDist = player, pos, d
			end
		end
	end
	return best, bestPos
end

-- How far a player's footsteps carry right now (path studs).
function MonsterAI._noiseRadius(self: MonsterAI, player: Player): number
	local proot = rootOf(player)
	if not proot or player:GetAttribute("Hiding") then
		return 0
	end
	local speed = flat(proot.AssemblyLinearVelocity).Magnitude
	return if speed > 14 then self.p.HearSprint elseif speed > 6.5 then self.p.HearWalk else 0
end

-- Returns the loudest thing it can hear: (position, path distance, player?)
function MonsterAI._listen(self: MonsterAI): (Vector3?, number, Player?)
	local dist = Maze.distances(self.layout, self:_cellAt(self.rig.root.Position))
	local C = self.layout.cellSize
	local best: Vector3? = nil
	local bestDist = math.huge
	local bestPlayer: Player? = nil
	local function consider(position: Vector3, radius: number, player: Player?)
		local cell = self:_cellAt(position)
		local d = (dist[Maze.key(cell.x, cell.z)] or math.huge) * C
		if d <= radius and d < bestDist then
			best, bestDist, bestPlayer = position, d, player
		end
	end
	for _, player in self.hooks.getPlayers() do
		local radius = self:_noiseRadius(player)
		local proot = rootOf(player)
		if radius > 0 and proot then
			consider(proot.Position, radius, player)
		end
	end
	local noise = self.noise
	if noise then
		self.noise = nil
		consider(noise.position, noise.radius, nil)
	end
	return best, bestDist, bestPlayer
end

function MonsterAI._pickWanderTarget(self: MonsterAI)
	local W, D = self.layout.width, self.layout.depth
	local cell: Maze.Cell? = nil
	local players = self.hooks.getPlayers()
	local now = os.clock()
	local instinct = self.p.HuntingInstinct
	if #players > 0 then
		local proot = rootOf(players[self.random:NextInteger(1, #players)])
		if proot then
			local pc = self:_cellAt(proot.Position)
			if now - self.lastContact > instinct then
				-- it's been too quiet: it "smells" you and heads straight for where you are
				self.lastContact = now - instinct * 0.5
				cell = pc
			elseif self.random:NextNumber() < 0.7 then
				local r = self.random:NextInteger(1, 4)
				cell = {
					x = math.clamp(pc.x + self.random:NextInteger(-r, r), 0, W - 1),
					z = math.clamp(pc.z + self.random:NextInteger(-r, r), 0, D - 1),
				}
			end
		end
	end
	local chosen = cell or { x = self.random:NextInteger(0, W - 1), z = self.random:NextInteger(0, D - 1) }
	local cx, cz = Maze.cellCenter(self.layout, chosen)
	self:_setPathTo(Vector3.new(cx, 0, cz))
end

function MonsterAI._investigate(self: MonsterAI, position: Vector3)
	if self.state == "Investigate" and self.pathGoal and flat(self.pathGoal - position).Magnitude < 8 then
		return
	end
	self:_setState("Investigate")
	self.pauseUntil = 0
	self:_setPathTo(position)
end

function MonsterAI._beginSearch(self: MonsterAI, around: Vector3, duration: number)
	self:_setState("Search")
	self.searchCenter = around
	self.searchUntil = os.clock() + duration
	self.pauseUntil = 0
	self:_setPathTo(around)
end

function MonsterAI._startChase(self: MonsterAI, player: Player)
	local wasChasing = self.state == "Chase"
	self.target = player
	self.huntLocker = nil
	self:_setState("Chase")
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self.path = {}
	local scream = Monsters.SCREAMS[self.rig.kind]
	if scream and not self.silent and not wasChasing and os.clock() - self.lastScream > 10 then
		self.lastScream = os.clock()
		Audio.play(scream, self.rig.head, 2.2, self.random:NextNumber(0.92, 1.05), 170)
	end
end

function MonsterAI._updateChase(self: MonsterAI, now: number)
	local p = self.p
	local root = self.rig.root
	local target = self.target
	if not target or not self:_isActive(target) then
		self:_beginSearch(self.lastSeenPos or root.Position, p.SearchTime)
		return
	end
	if target:GetAttribute("Hiding") then
		local locker = self.sawHide[target]
		if locker then
			self.huntLocker = locker
			self:_setState("HuntLocker")
			self:_setPathTo(locker.outside.Position)
		else
			self:_beginSearch(self.lastSeenPos or root.Position, p.SearchTime)
		end
		return
	end
	-- blind hunters keep tracking a target while it keeps making noise
	if p.HearChaseRange > 0 then
		local proot = rootOf(target)
		local radius = self:_noiseRadius(target)
		if proot and radius > 0 then
			local dist = Maze.distances(self.layout, self:_cellAt(root.Position))
			local c = self:_cellAt(proot.Position)
			if (dist[Maze.key(c.x, c.z)] or math.huge) * self.layout.cellSize <= radius then
				self.lastSeenPos = proot.Position
				self.lastSeenTime = now
			end
		end
	end
	local frenzy = now < self.frenzyUntil
	if not frenzy and now - self.lastSeenTime > p.LoseSightTime then
		self:_beginSearch(self.lastSeenPos or root.Position, p.SearchTime)
		return
	end
	local proot = rootOf(target)
	if not proot then
		return
	end
	-- lunge when it gets close
	if p.LungeRange > 0 and now >= self.nextLunge and (proot.Position - root.Position).Magnitude < p.LungeRange then
		self.lungeUntil = now + 1.1
		self.nextLunge = now + 4
		self:_updateSpeed()
		task.delay(1.15, function()
			if not self.destroyed then
				self:_updateSpeed()
			end
		end)
	end
	-- for a moment after losing sight it still "knows" where you went
	local goal = if frenzy or now - self.lastSeenTime < 1 then proot.Position else (self.lastSeenPos or proot.Position)
	self:_moveToward(goal, now)
end

function MonsterAI._updateHuntLocker(self: MonsterAI)
	local root = self.rig.root
	local locker = self.huntLocker
	local victim = if locker then locker.occupant else nil
	if not locker or not victim or not self:_isActive(victim) then
		self.huntLocker = nil
		self:_beginSearch(root.Position, 6)
		return
	end
	if flat(locker.outside.Position - root.Position).Magnitude < 4.5 then
		self.huntLocker = nil
		self.interactables:leave(victim, true) -- yank them out
		self:_catch(victim)
		return
	end
	if #self.path == 0 then
		self:_setPathTo(locker.outside.Position)
	end
	self:_followPath()
end

function MonsterAI._updateSearch(self: MonsterAI, now: number)
	if now > self.searchUntil then
		self:_setState("Wander")
		self:_pickWanderTarget()
		return
	end
	if now < self.pauseUntil then
		return
	end
	if self:_followPath() then
		self.pauseUntil = now + self.random:NextNumber(0.8, 2.2) -- stop... listen...
		local c = self:_cellAt(self.searchCenter)
		local nx = math.clamp(c.x + self.random:NextInteger(-2, 2), 0, self.layout.width - 1)
		local nz = math.clamp(c.z + self.random:NextInteger(-2, 2), 0, self.layout.depth - 1)
		local cx, cz = Maze.cellCenter(self.layout, { x = nx, z = nz })
		self:_setPathTo(Vector3.new(cx, 0, cz))
	end
end

function MonsterAI._catch(self: MonsterAI, player: Player)
	local previous = self.state
	self:_setState("Kill")
	self.sawHide[player] = nil
	self.target = nil
	self.path = {}
	local root = self.rig.root
	self.humanoid:MoveTo(root.Position)
	root.Anchored = true
	local proot = rootOf(player)
	if proot then
		proot.Anchored = true
		local facing = flat(proot.Position - root.Position)
		if facing.Magnitude > 0.1 then
			self.rig.model:PivotTo(CFrame.lookAt(root.Position, root.Position + facing))
		end
	end
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self.hooks.onCaught(player, self.rig.model)
	task.delay(2.8, function()
		if self.destroyed then
			return
		end
		if self.p.Statue then
			self.frozen = false
			self:_release()
			self:_setState(if previous == "Frozen" then "Stalk" else previous)
			return
		end
		self:_release()
		self:_beginSearch(root.Position, 6)
	end)
end

function MonsterAI._tryApparition(self: MonsterAI)
	local p = self.p
	local now = os.clock()
	self.nextApparition = now + self.random:NextNumber(p.ApparitionMin, p.ApparitionMax)
	if not p.Apparitions then
		return
	end
	local candidates = {}
	for _, player in self.hooks.getPlayers() do
		if not player:GetAttribute("Hiding") and rootOf(player) then
			table.insert(candidates, player)
		end
	end
	if #candidates == 0 then
		return
	end
	local player = candidates[self.random:NextInteger(1, #candidates)]
	local proot = rootOf(player) :: BasePart
	local pc = self:_cellAt(proot.Position)
	local look = flat(proot.CFrame.LookVector)
	local best: Maze.Cell? = nil
	local bestScore = -math.huge
	-- down a straight corridor, preferably the one they're facing
	for _, d in Maze.DIRS do
		local run = Maze.straightRun(self.layout, pc, d, 7)
		if #run >= 3 then
			local score = look:Dot(Vector3.new(Maze.DX[d], 0, Maze.DZ[d])) + self.random:NextNumber() * 0.4
			if score > bestScore then
				bestScore = score
				best = run[math.min(#run, self.random:NextInteger(3, 6))]
			end
		end
	end
	if not best then
		return
	end
	local cx, cz = Maze.cellCenter(self.layout, best)
	local pos = Vector3.new(cx, self.rig.rootHeight, cz)
	self.rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(proot.Position.X, pos.Y, proot.Position.Z)))
	self.apparitionTarget = player
	self.apparitionEnds = now + 7
	self:_setState("Apparition")
end

function MonsterAI._updateApparition(self: MonsterAI)
	local player = self.apparitionTarget
	local proot = if player then rootOf(player) else nil
	local root = self.rig.root
	if not player or not proot or not self:_isActive(player) or os.clock() > self.apparitionEnds or flat(proot.Position - root.Position).Magnitude < 24 then
		self:_vanish()
		return
	end
	local pos = root.Position
	self.rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(proot.Position.X, pos.Y, proot.Position.Z)))
end

function MonsterAI._vanish(self: MonsterAI)
	Remotes.Apparition:FireAllClients(self.rig.root.Position)
	self.apparitionTarget = nil
	self:_park()
	self:_setState("Dormant")
end

function MonsterAI._checkStuck(self: MonsterAI, now: number)
	if now < self.stuckCheckAt then
		return
	end
	self.stuckCheckAt = now + 2
	local pos = self.rig.root.Position
	local moving = self.humanoid.WalkSpeed > 0 and #self.path > 0 and now >= self.pauseUntil and not self.rig.root.Anchored
	if moving and flat(pos - self.stuckPos).Magnitude < 1.5 then
		self.stuckCount += 1
		if self.stuckCount >= 2 then
			-- still stuck: hop to the next waypoint
			local p = self.path[self.pathIndex]
			if p then
				self.rig.model:PivotTo(CFrame.new(p.X, self.rig.rootHeight, p.Z) * self.rig.root.CFrame.Rotation)
			end
			self.stuckCount = 0
		elseif self.pathGoal then
			self:_setPathTo(self.pathGoal)
		end
	else
		self.stuckCount = 0
	end
	self.stuckPos = pos
end

-- Statue ------------------------------------------------------------------------

-- Is any player looking at it right now? (Camera direction comes from the clients.)
function MonsterAI._isWatched(self: MonsterAI): boolean
	if os.clock() < self.blinkUntil then
		return false -- everyone's eyes are closed
	end
	local head = self.rig.head
	local body = self.rig.root.Position + Vector3.new(0, 1.5, 0)
	for _, player in self.hooks.getPlayers() do
		local phead = headOf(player)
		if phead and not player:GetAttribute("Hiding") then
			local look = self.hooks.getLook(player)
			if not look then
				local proot = rootOf(player)
				look = if proot then proot.CFrame.LookVector else nil
			end
			if look then
				for _, point in { head.Position, body } do
					local to = point - phead.Position
					if to.Magnitude < 170 and look.Unit:Dot(to.Unit) > 0.55 then
						if not workspace:Raycast(phead.Position, to, self.sightParams) then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

function MonsterAI._thinkStatue(self: MonsterAI, now: number)
	local p = self.p
	if not self.awake then
		if now >= self.awakeAt then
			self:awaken()
		end
		return
	end
	if self.state == "Kill" then
		return
	end
	-- every so often, everybody blinks
	if now >= self.nextBlink then
		self.nextBlink = now + self.random:NextNumber(p.BlinkMin, p.BlinkMax) * (if now < self.frenzyUntil then 0.5 else 1)
		self.blinkUntil = now + p.BlinkTime
		self.hooks.setBlink(true)
		task.delay(p.BlinkTime, function()
			if not self.destroyed then
				self.hooks.setBlink(false)
			end
		end)
	end

	local root = self.rig.root
	if self:_isWatched() then
		if not self.frozen then
			self.frozen = true
			self.humanoid:MoveTo(root.Position)
			root.Anchored = true
			self:_setState("Frozen")
		end
		return
	end
	if self.frozen then
		self.frozen = false
		self:_release()
		self.rig.model:SetAttribute("Pose", self.random:NextInteger(1, #Monsters.STATUE_POSES))
		self:_setState("Stalk")
	end

	-- nobody's looking: go for the nearest player
	local best: Player? = nil
	local bestDist = math.huge
	for _, player in self.hooks.getPlayers() do
		local proot = rootOf(player)
		if proot then
			local d = (proot.Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = player, d
			end
		end
	end
	if not best then
		return
	end
	local proot = rootOf(best) :: BasePart
	if bestDist < p.CatchDistance + 0.5 then
		self:_catch(best)
		return
	end
	-- stone grinding when it moves close to someone
	if bestDist < 45 and now - self.lastGrind > 1.6 and not self.silent then
		self.lastGrind = now
		Audio.play("StatueGrind", root, 1.4, self.random:NextNumber(0.85, 1.1), 70)
	end
	self.rig.model:SetAttribute("TargetUserId", best.UserId)
	self:_moveToward(proot.Position, now)
end

-- Main loop ------------------------------------------------------------------------

function MonsterAI._think(self: MonsterAI)
	if self.destroyed then
		return
	end
	local p = self.p
	local now = os.clock()

	if p.Statue then
		self:_thinkStatue(now)
		return
	end

	local state = self.state
	if state == "Dormant" then
		if now >= self.awakeAt then
			self:awaken()
		elseif now >= self.nextApparition then
			self:_tryApparition()
		end
		return
	elseif state == "Apparition" then
		if now >= self.awakeAt then
			self:awaken()
		else
			self:_updateApparition()
		end
		return
	elseif state == "Kill" then
		return
	end

	local root = self.rig.root
	self.interactables:slamOpenNear(root.Position, 8)
	self:_checkStuck(now)

	-- within arm's reach?
	for _, player in self.hooks.getPlayers() do
		if not player:GetAttribute("Hiding") then
			local proot = rootOf(player)
			if proot and flat(proot.Position - root.Position).Magnitude < p.CatchDistance and math.abs(proot.Position.Y - root.Position.Y) < 7 then
				self:_catch(player)
				return
			end
		end
	end

	-- eyes
	local seen, seenPos = self:_lookForPlayers()
	if seen and seenPos and self.state ~= "HuntLocker" then
		if self.state ~= "Chase" or self.target ~= seen then
			self:_startChase(seen)
		end
		self.lastSeenPos = seenPos
		self.lastSeenTime = now
		self.lastContact = now
	end

	local s = self.state
	if s == "Chase" then
		self:_updateChase(now)
	elseif s == "HuntLocker" then
		self:_updateHuntLocker()
	elseif s == "Investigate" then
		if self:_followPath() then
			self:_beginSearch(root.Position, 7)
		end
	elseif s == "Search" then
		self:_updateSearch(now)
	elseif s == "Wander" then
		if now >= self.pauseUntil and self:_followPath() then
			self.pauseUntil = now + self.random:NextNumber(0.5, 2.5)
			self:_pickWanderTarget()
		end
	end

	-- ears (only when it isn't already after someone)
	if self.state == "Wander" or self.state == "Search" or self.state == "Investigate" then
		local heard, heardDist, heardPlayer = self:_listen()
		if heard then
			self.lastContact = now
			if heardPlayer and p.HearChaseRange > 0 and heardDist <= p.HearChaseRange then
				-- blind hunters lock on to close sounds
				self.lastSeenPos = heard
				self.lastSeenTime = now
				self:_startChase(heardPlayer)
			else
				self:_investigate(heard)
			end
		end
	end
end

return MonsterAI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">Objectives</string>
          <string name="Source"><![CDATA[--!strict
-- What each night asks of you:
--   survive  make it from 12 AM to 6 AM
--   keys     find 4 keys (each tag shows a digit), unlock the exit, type the code
--   power    start 3 generators (loud!), then take the service lift
--   collect  take 6 photographs
--   hearts   destroy 3 hearts (it knows each time), then run for the portal
-- What to do right now is the "Objective" on GameState: the client puts it at the top
-- of the screen in red.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Build = require(script.Parent.Build)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Exit = require(script.Parent.Exit)
local Interactables = require(script.Parent.Interactables)
local MonsterAI = require(script.Parent.MonsterAI)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local GameState = ReplicatedStorage.GameState

export type Ctx = {
	night: Nights.Night,
	layout: Maze.Layout,
	world: WorldBuilder.World,
	interactables: Interactables.Interactables,
	monster: MonsterAI.MonsterAI,
	exit: Exit.Exit,
	isAlive: (player: Player) -> boolean,
	notifyAll: (text: string, style: string?) -> (),
	notify: (player: Player, text: string, style: string?) -> (),
	setProgress: (done: number, goal: number) -> (), -- shown as faint dots, never as text
	winAll: (kind: string) -> (),
}

export type Objective = { destroy: () -> () }

local Objectives = {}

local prompt = Interactables.prompt
local rootOf = Interactables.rootOf

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local NUMBERS = { "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE", "TEN" }

local function setObjective(text: string)
	GameState:SetAttribute("Objective", text)
end

-- "FIND THE FOUR KEYS"
local function objective(verb: string, count: number, things: string): string
	return string.format("%s THE %s %s", verb, NUMBERS[count] or tostring(count), things)
end

local function openExit(ctx: Ctx, message: string, goal: string)
	ctx.exit:open()
	GameState:SetAttribute("ExitOpen", true)
	setObjective(goal)
	ctx.notifyAll(message, "danger")
	ctx.monster:onExitOpened()
end

---------------------------------------------------------------------------
-- SURVIVE: 12 AM -> 6 AM

local function survive(ctx: Ctx): Objective
	local total = ctx.night.surviveSeconds or 300
	local started = os.clock()
	local lastHour = 0
	local done = false
	GameState:SetAttribute("Hour", 0)
	ctx.setProgress(0, 6)
	setObjective("SURVIVE UNTIL 6 AM")
	local connection = RunService.Heartbeat:Connect(function()
		if done then
			return
		end
		local minutes = math.clamp(math.floor((os.clock() - started) / total * 360), 0, 360)
		local hour = minutes // 60
		if hour > lastHour then
			lastHour = hour
			GameState:SetAttribute("Hour", hour)
			ctx.setProgress(hour, 6)
			if hour < 6 then
				ctx.monster:setAggression(hour)
				if hour == 1 then
					ctx.monster:awaken()
					ctx.notifyAll("1:00 AM. It's awake.", "danger")
				elseif hour == 3 then
					ctx.notifyAll("3:00 AM. The witching hour. It knows where you are.", "danger")
					ctx.monster:frenzy(15, nil)
				elseif hour == 5 then
					ctx.notifyAll("5:00 AM. One more hour.")
				else
					ctx.notifyAll(string.format("%d:00 AM.", hour))
				end
			end
		end
		if minutes >= 360 then
			done = true
			ctx.winAll("survived")
		end
	end)
	return {
		destroy = function()
			connection:Disconnect()
		end,
	}
end

---------------------------------------------------------------------------
-- KEYS: 4 keys -> padlocks -> keypad code -> exit

local function keys(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Keys"
	folder.Parent = world.model
	local count = #layout.spots
	local found = 0
	local mask = table.create(count, "_")
	local padlocks: { { BasePart } } = {}
	local padlocksLeft = count
	local exitOpen = false
	local lastTry: { [Player]: number } = {}
	local connections: { RBXScriptConnection } = {}
	local metal = rgb(196, 196, 190)

	-- one dot per key, and one for the door
	ctx.setProgress(0, count + 1)
	GameState:SetAttribute("CodeMask", table.concat(mask))
	setObjective(objective("FIND", count, "KEYS"))

	-- padlocks + chain on the exit, keypad beside it
	local exit = ctx.exit
	for i = 0, 12 do
		wctx.decor(wctx.part(folder, "Chain", Vector3.new(0.32, 0.18, 0.18), exit:hubSide(-2.4 + i * 0.4, 5.1 + math.sin(i * 0.5) * 0.15) * CFrame.new(0, 0, -0.08) * CFrame.Angles(i % 2 * math.rad(90), 0, 0), Enum.Material.Metal, rgb(120, 120, 120), nil))
	end
	for i = 1, count do
		local x = -1.05 + (i - 1) * (2.1 / math.max(count - 1, 1))
		local y = 4.4 + (i % 2) * 0.55
		local body = wctx.decor(wctx.part(folder, "Padlock", Vector3.new(0.55, 0.65, 0.25), exit:hubSide(x, y), Enum.Material.Metal, rgb(150, 150, 146), nil))
		local shackle = wctx.decor(wctx.part(folder, "Shackle", Vector3.new(0.38, 0.45, 0.08), exit:hubSide(x, y + 0.5), Enum.Material.Metal, rgb(180, 180, 176), nil))
		table.insert(padlocks, { body, shackle })
	end
	local keypad = wctx.part(folder, "Keypad", Vector3.new(1.2, 1.8, 0.3), exit:hubSide(exit.width / 2 + 1.15, 4.8) * CFrame.new(0, 0, 0.15), Enum.Material.Metal, rgb(40, 40, 42), nil)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.LightInfluence = 0
	gui.Brightness = 1.5
	gui.Parent = keypad
	local screen = Instance.new("TextLabel")
	screen.BackgroundColor3 = rgb(12, 12, 12)
	screen.BorderSizePixel = 0
	screen.Size = UDim2.fromScale(1, 1)
	screen.Font = Enum.Font.Code
	screen.TextScaled = true
	screen.TextColor3 = rgb(210, 210, 210)
	screen.Parent = gui
	local glow = Instance.new("PointLight")
	glow.Range = 7
	glow.Brightness = 0.5
	glow.Parent = keypad

	local function refreshKeypad()
		if exitOpen then
			screen.Text = "OPEN"
		elseif padlocksLeft > 0 then
			screen.Text = string.format("LOCKED\n%d/%d", count - padlocksLeft, count)
		else
			screen.Text = "ENTER\nCODE"
		end
	end
	refreshKeypad()

	local keypadPrompt = prompt(keypad, "Use", "Keypad", 0, 7)
	keypadPrompt.Triggered:Connect(function(player: Player)
		if exitOpen or not ctx.isAlive(player) then
			return
		end
		if padlocksLeft > 0 then
			Audio.play("KeypadError", keypad, 0.8, 1, 50)
			ctx.notify(player, string.format("%d padlocks still hold the door. Find the keys.", padlocksLeft))
			return
		end
		Remotes.OpenKeypad:FireClient(player)
	end)

	table.insert(connections, Remotes.SubmitCode.OnServerEvent:Connect(function(player: Player, code: unknown)
		if typeof(code) ~= "string" or #code > 8 or exitOpen or padlocksLeft > 0 or not ctx.isAlive(player) then
			return
		end
		local now = os.clock()
		local last = lastTry[player]
		if last and now - last < 0.8 then
			return
		end
		lastTry[player] = now
		local root = rootOf(player)
		if not root or (root.Position - keypad.Position).Magnitude > 16 then
			return
		end
		if code == layout.code then
			exitOpen = true
			refreshKeypad()
			ctx.setProgress(count + 1, count + 1)
			openExit(ctx, "The exit is open. RUN.", "GET OUT")
		else
			Audio.play("KeypadError", keypad, 1.3, 1, 100)
			screen.Text = "WRONG"
			task.delay(1.2, function()
				if keypad.Parent then
					refreshKeypad()
				end
			end)
			ctx.notify(player, "Wrong code. That buzzer was loud...")
			ctx.monster:hearNoise(keypad.Position, 70)
		end
	end))

	-- the keys, on crates at the back of dead ends
	for index, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local crate = wctx.part(folder, "KeyCrate", Vector3.new(2.6, 2.6, 2.6), frame * CFrame.new(0, 1.3, 0), Enum.Material.WoodPlanks, rgb(96, 86, 74), nil)
		crate.CollisionGroup = "Furniture"
		local model = Instance.new("Model")
		model.Name = "Key" .. index
		local base = frame * CFrame.new(0, 2.68, 0) * CFrame.Angles(0, world.random:NextNumber(0, math.pi * 2), 0)
		local shaft = wctx.decor(wctx.part(model, "Shaft", Vector3.new(1.6, 0.18, 0.18), base * CFrame.new(0.2, 0, 0), Enum.Material.Metal, metal, nil))
		shaft.CanQuery = true
		shaft.Reflectance = 0.15
		wctx.decor(wctx.part(model, "Bow", Vector3.new(0.12, 0.9, 0.9), base * CFrame.new(-0.85, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Metal, metal, Enum.PartType.Cylinder))
		wctx.decor(wctx.part(model, "Tooth", Vector3.new(0.16, 0.12, 0.4), base * CFrame.new(0.85, 0, 0.22), Enum.Material.Metal, metal, nil))
		wctx.decor(wctx.part(model, "Tooth", Vector3.new(0.16, 0.12, 0.28), base * CFrame.new(0.55, 0, 0.16), Enum.Material.Metal, metal, nil))
		local tag = wctx.decor(wctx.part(model, "Tag", Vector3.new(0.6, 0.03, 0.8), base * CFrame.new(-1.6, 0, 0.3) * CFrame.Angles(0, 0.3, 0), Enum.Material.SmoothPlastic, rgb(220, 214, 198), nil))
		local tagGui = Instance.new("SurfaceGui")
		tagGui.Face = Enum.NormalId.Top
		tagGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		tagGui.PixelsPerStud = 120
		tagGui.Parent = tag
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.SpecialElite
		label.TextScaled = true
		label.TextColor3 = rgb(20, 20, 20)
		local digits = {}
		for i = 1, #layout.code do
			digits[i] = if i == index then string.sub(layout.code, i, i) else "_"
		end
		label.Text = table.concat(digits, " ")
		label.Parent = tagGui
		local glint = Instance.new("PointLight")
		glint.Range = 6
		glint.Brightness = 0.9
		glint.Parent = shaft
		model.PrimaryPart = shaft
		model.Parent = folder

		prompt(shaft, "Take", "Key", 0.5, 8).Triggered:Connect(function(player: Player)
			if not ctx.isAlive(player) or model.Parent == nil then
				return
			end
			Audio.play("KeyPickup", crate, 1, 1, 70)
			model:Destroy()
			found += 1
			mask[index] = string.sub(layout.code, index, index)
			GameState:SetAttribute("CodeMask", table.concat(mask))
			ctx.setProgress(found, count + 1)
			if padlocksLeft > 0 then
				local lock = padlocks[padlocksLeft]
				padlocksLeft -= 1
				for _, p in lock do
					p.Anchored = false
					p.CanCollide = true
				end
				Audio.play("Unlock", keypad, 0.9, 0.9, 120)
				refreshKeypad()
			end
			ctx.notifyAll(string.format("%s found a key. The tag reads   %s", player.DisplayName, table.concat(digits, " ")), "key")
			ctx.monster:setAggression(found)
			ctx.monster:awaken()
			ctx.monster:hearNoise(crate.Position, 45)
			if found >= count then
				setObjective("ENTER THE CODE AT THE EXIT")
				ctx.notifyAll("Every padlock is open. Get to the keypad by the exit.", "key")
			end
		end)
	end

	return {
		destroy = function()
			for _, c in connections do
				c:Disconnect()
			end
		end,
	}
end

---------------------------------------------------------------------------
-- POWER: 3 generators, then the lift

local function power(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Generators"
	folder.Parent = world.model
	local count = #layout.spots
	local running = 0
	ctx.setProgress(0, count)
	setObjective(objective("START", count, "GENERATORS"))

	-- each lamp belongs to the nearest generator
	local maps = {}
	for i, cell in layout.spots do
		maps[i] = Maze.distances(layout, cell)
	end
	local zones: { { Build.Lamp } } = {}
	for i = 1, count do
		zones[i] = {}
	end
	for _, lamp in world.lamps do
		local cell = lamp.cell
		if cell and not lamp.light.Enabled then
			local best, bestDist = 1, math.huge
			for i, dist in maps do
				local d = dist[Maze.key(cell.x, cell.z)] or math.huge
				if d < bestDist then
					best, bestDist = i, d
				end
			end
			table.insert(zones[best], lamp)
		end
	end

	local panelLabel: TextLabel? = nil
	local panel = world.model:FindFirstChild("PowerPanel", true)
	if panel then
		panelLabel = panel:FindFirstChildWhichIsA("TextLabel", true)
	end

	for i, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local model = Instance.new("Model")
		model.Name = "Generator" .. i
		local base = wctx.part(model, "Generator", Vector3.new(4.4, 3.2, 2.8), frame * CFrame.new(0, 1.6, 0), Enum.Material.Metal, rgb(150, 120, 40), nil)
		base.CollisionGroup = "Furniture"
		wctx.part(model, "Engine", Vector3.new(2.6, 1.4, 2.2), frame * CFrame.new(-0.4, 3.9, 0), Enum.Material.Metal, rgb(60, 62, 60), nil).CollisionGroup = "Furniture"
		wctx.decor(wctx.part(model, "Exhaust", Vector3.new(3, 0.5, 0.5), frame * CFrame.new(1.5, 4.6, 0.6) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.CorrodedMetal, rgb(80, 60, 50), Enum.PartType.Cylinder))
		wctx.decor(wctx.part(model, "Fan", Vector3.new(0.2, 2.2, 2.2), frame * CFrame.new(-2.3, 1.7, 0) * CFrame.Angles(0, 0, 0), Enum.Material.Metal, rgb(40, 40, 40), Enum.PartType.Cylinder))
		for s = 0, 3 do
			wctx.decor(wctx.part(model, "Stripe", Vector3.new(0.6, 0.6, 0.05), frame * CFrame.new(-1.6 + s * 1.1, 0.6, -1.43) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.SmoothPlastic, rgb(20, 20, 20), nil))
		end
		local status = wctx.decor(wctx.part(model, "Status", Vector3.new(0.5, 0.5, 0.5), frame * CFrame.new(1.4, 3.45, -0.9), Enum.Material.Neon, rgb(255, 40, 30), Enum.PartType.Ball))
		local statusLight = Instance.new("PointLight")
		statusLight.Range = 8
		statusLight.Brightness = 1
		statusLight.Color = rgb(255, 40, 30)
		statusLight.Parent = status
		model.Parent = folder

		local started = false
		local p = prompt(base, "Start", "Generator", 3.5, 9)
		p.Triggered:Connect(function(player: Player)
			if started or not ctx.isAlive(player) then
				return
			end
			started = true
			p.Enabled = false
			running += 1
			status.Color = rgb(60, 255, 90)
			statusLight.Color = rgb(60, 255, 90)
			Audio.play("GeneratorStart", base, 1.6, 1, 160)
			local hum = Audio.create("GeneratorLoop", base, 1)
			if hum then
				hum.RollOffMinDistance = 8
				hum.RollOffMaxDistance = 70
				task.delay(2.8, function()
					if hum.Parent then
						hum:Play()
					end
				end)
			end
			-- lights come back in this part of the tunnels
			task.delay(1.6, function()
				for _, lamp in zones[i] do
					if lamp.bulb.Parent and lamp.bulb:GetAttribute("Dead") ~= true then
						lamp.light.Enabled = true
						local on = lamp.bulb:GetAttribute("OnColor")
						if typeof(on) == "Color3" then
							lamp.bulb.Color = on
						end
					end
				end
				Audio.play("PowerUp", base, 1.2, 1, 140)
			end)
			ctx.setProgress(running, count)
			if panelLabel then
				panelLabel.Text = string.format("MAIN POWER\n%d/%d", running, count)
			end
			ctx.monster:setAggression(running)
			ctx.monster:hearNoise(base.Position, 400) -- the whole system hears it
			ctx.monster:awaken()
			if running >= count then
				if panelLabel then
					panelLabel.Text = "LIFT\nONLINE"
					panelLabel.TextColor3 = rgb(80, 255, 120)
				end
				openExit(ctx, "The lift has power. GET OUT.", "GET TO THE LIFT")
			else
				ctx.notifyAll(string.format("%s started a generator. That was LOUD. (%d/%d)", player.DisplayName, running, count), "key")
			end
		end)
	end

	return {
		destroy = function() end,
	}
end

---------------------------------------------------------------------------
-- COLLECT: 6 photographs

local PHOTO_LINES = {
	"The photo shows this hall. Someone is standing behind the camera.",
	"A photo of a statue. It's facing the camera. In the next one it isn't.",
	"A group photo. Every face has been scratched out.",
	"The photo shows you. Taken from behind. Tonight.",
	"A photo of the exhibit. One plinth is empty.",
	"The last photograph shows a door that wasn't there before.",
}

local function collect(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Photographs"
	folder.Parent = world.model
	local count = #layout.spots
	local taken = 0
	ctx.setProgress(0, count)
	setObjective(objective("FIND", count, "PHOTOGRAPHS"))

	for i, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local model = Instance.new("Model")
		model.Name = "Photo" .. i
		for _, leg in { -0.8, 0.8 } do
			wctx.decor(wctx.part(model, "EaselLeg", Vector3.new(0.18, 5.2, 0.18), frame * CFrame.new(leg, 2.5, 0) * CFrame.Angles(math.rad(-8), 0, 0), Enum.Material.Wood, rgb(80, 60, 40), nil))
		end
		wctx.decor(wctx.part(model, "EaselBack", Vector3.new(0.18, 5, 0.18), frame * CFrame.new(0, 2.4, 0.8) * CFrame.Angles(math.rad(18), 0, 0), Enum.Material.Wood, rgb(80, 60, 40), nil))
		local photo = wctx.part(model, "Photograph", Vector3.new(2, 2.4, 0.1), frame * CFrame.new(0, 3.9, -0.15) * CFrame.Angles(math.rad(-8), 0, 0), Enum.Material.SmoothPlastic, rgb(230, 228, 220), nil)
		photo.CanCollide = false
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.Parent = photo
		local backdrop = Instance.new("Frame")
		backdrop.Position = UDim2.fromScale(0.08, 0.06)
		backdrop.Size = UDim2.fromScale(0.84, 0.72)
		backdrop.BackgroundColor3 = rgb(70, 72, 76)
		backdrop.BorderSizePixel = 0
		backdrop.Parent = gui
		-- a dark figure in every photograph
		local head = Instance.new("Frame")
		head.AnchorPoint = Vector2.new(0.5, 0.5)
		head.Position = UDim2.fromScale(0.3 + (i % 3) * 0.2, 0.32)
		head.Size = UDim2.fromScale(0.16, 0.16)
		head.BackgroundColor3 = rgb(10, 10, 12)
		head.BorderSizePixel = 0
		head.Parent = backdrop
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(0.5, 0)
		round.Parent = head
		local body = Instance.new("Frame")
		body.AnchorPoint = Vector2.new(0.5, 0)
		body.Position = UDim2.fromScale(0.3 + (i % 3) * 0.2, 0.4)
		body.Size = UDim2.fromScale(0.22, 0.6)
		body.BackgroundColor3 = rgb(10, 10, 12)
		body.BorderSizePixel = 0
		body.Parent = backdrop
		local caption = Instance.new("TextLabel")
		caption.BackgroundTransparency = 1
		caption.Position = UDim2.fromScale(0, 0.8)
		caption.Size = UDim2.fromScale(1, 0.18)
		caption.Font = Enum.Font.SpecialElite
		caption.TextScaled = true
		caption.TextColor3 = rgb(40, 40, 40)
		caption.Text = string.format("no. %d", i)
		caption.Parent = gui
		local glint = Instance.new("PointLight")
		glint.Range = 7
		glint.Brightness = 0.8
		glint.Color = rgb(220, 230, 255)
		glint.Parent = photo
		model.Parent = folder

		prompt(photo, "Take", "Photograph", 0.6, 8).Triggered:Connect(function(player: Player)
			if not ctx.isAlive(player) or model.Parent == nil then
				return
			end
			model:Destroy()
			taken += 1
			Audio.play("PagePickup", nil, 1)
			ctx.setProgress(taken, count)
			ctx.monster:setAggression(taken)
			ctx.notify(player, PHOTO_LINES[math.min(taken, #PHOTO_LINES)], "note")
			if taken >= count then
				ctx.winAll("collected")
			else
				ctx.notifyAll(string.format("%s took a photograph. (%d/%d)", player.DisplayName, taken, count), "key")
			end
		end)
	end

	return {
		destroy = function() end,
	}
end

---------------------------------------------------------------------------
-- HEARTS: 3 hearts, then the portal

local function hearts(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Hearts"
	folder.Parent = world.model
	local count = #layout.spots
	local broken = 0
	ctx.setProgress(0, count)
	setObjective(objective("DESTROY", count, "HEARTS"))
	local CORE = rgb(200, 20, 110)

	for i, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local model = Instance.new("Model")
		model.Name = "Heart" .. i
		local altar = wctx.part(model, "Altar", Vector3.new(5, 2.4, 5), frame * CFrame.new(0, 1.2, 0), Enum.Material.Basalt, rgb(16, 12, 20), nil)
		altar.CollisionGroup = "Furniture"
		local heart = wctx.decor(wctx.part(model, "Heart", Vector3.new(3, 3, 3), frame * CFrame.new(0, 4.6, 0), Enum.Material.Neon, CORE, Enum.PartType.Ball))
		heart.CanQuery = true
		heart:AddTag("Heart")
		for v = 1, 8 do
			local a = v * 0.785
			wctx.decor(wctx.part(model, "Vein", Vector3.new(0.18, 4.6, 0.18), frame * CFrame.new(math.cos(a) * 1.6, 4.4, math.sin(a) * 1.6) * CFrame.Angles(math.cos(a) * 0.35, 0, math.sin(a) * 0.35), Enum.Material.Neon, rgb(120, 20, 160), nil))
		end
		for b = 1, 4 do
			local a = b * 1.57 + 0.4
			wctx.part(model, "Bone", Vector3.new(0.35, 6, 0.35), frame * CFrame.new(math.cos(a) * 2.2, 5, math.sin(a) * 2.2) * CFrame.Angles(math.cos(a) * -0.3, 0, math.sin(a) * 0.3), Enum.Material.SmoothPlastic, rgb(210, 200, 220), nil)
		end
		local light = Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 2
		light.Color = CORE
		light.Parent = heart
		local pulse = Audio.create("HeartPulseLoop", heart, 1.6)
		if pulse then
			pulse.RollOffMinDistance = 6
			pulse.RollOffMaxDistance = 80
			pulse:Play()
		end
		model.Parent = folder

		local p = prompt(heart, "Destroy", "Heart", 3, 9)
		p.Triggered:Connect(function(player: Player)
			if not ctx.isAlive(player) or heart.Parent == nil then
				return
			end
			local where = heart.Position
			heart:Destroy()
			light:Destroy()
			for _ = 1, 14 do
				local shard = wctx.part(folder, "Shard", Vector3.new(0.5, 0.5, 0.5), CFrame.new(where), Enum.Material.Neon, CORE, nil)
				shard.Anchored = false
				shard.CanCollide = true
				shard.AssemblyLinearVelocity = Vector3.new(world.random:NextNumber(-30, 30), world.random:NextNumber(10, 40), world.random:NextNumber(-30, 30))
				TweenService:Create(shard, TweenInfo.new(4), { Transparency = 1 }):Play()
				task.delay(4, function()
					shard:Destroy()
				end)
			end
			Audio.playAt("HeartShatter", where, 2, 1, 400)
			broken += 1
			ctx.setProgress(broken, count)
			ctx.monster:setAggression(broken)
			if broken >= count then
				openExit(ctx, "The last heart is still. The way out is open. RUN.", "GET TO THE PORTAL")
			else
				ctx.notifyAll(string.format("A heart stops beating. IT KNOWS WHERE %s IS. (%d/%d)", string.upper(player.DisplayName), broken, count), "danger")
				ctx.monster:frenzy(14, player)
			end
		end)
	end

	return {
		destroy = function() end,
	}
end

local BY_KIND: { [string]: (Ctx) -> Objective } = {
	survive = survive,
	keys = keys,
	power = power,
	collect = collect,
	hearts = hearts,
}

function Objectives.start(ctx: Ctx): Objective
	local start = BY_KIND[ctx.night.objective] or survive
	return start(ctx)
end

return Objectives
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">Progress</string>
          <string name="Source"><![CDATA[--!strict
-- How far each player has got, saved with DataStores. The value lives on the Player
-- as the "HighestNight" attribute so the menu can read it:
--   1..5 = the first night you haven't beaten yet, 6 = you've beaten all five.
-- With Config.Progress.UnlockAll every night is open anyway; the door's choice just
-- starts on your next unbeaten night.
-- DataStores only work in a published game (or with Studio API access turned on);
-- without them progress just lasts for the session.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Nights = require(ReplicatedStorage.Shared.Nights)

local Progress = {}

local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore(Config.Progress.DataStoreName)
end)

local function key(player: Player): string
	return "u" .. player.UserId
end

function Progress.load(player: Player)
	local highest = 1
	local s = store
	if s then
		local ok, value = pcall(function()
			return s:GetAsync(key(player))
		end)
		if ok and typeof(value) == "number" then
			highest = math.clamp(math.floor(value), 1, Nights.count + 1)
		end
	end
	player:SetAttribute("HighestNight", highest)
end

function Progress.highest(player: Player): number
	local value = player:GetAttribute("HighestNight")
	return if typeof(value) == "number" then value else 1
end

-- The highest night this player may choose.
function Progress.allowed(player: Player): number
	if Config.Progress.UnlockAll or (RunService:IsStudio() and Config.Progress.UnlockAllInStudio) then
		return Nights.count
	end
	return math.min(Progress.highest(player), Nights.count)
end

-- You beat `night`: the next one is yours.
function Progress.beat(player: Player, night: number)
	local unlocked = math.min(night + 1, Nights.count + 1)
	if unlocked <= Progress.highest(player) then
		return
	end
	player:SetAttribute("HighestNight", unlocked)
	local s = store
	if s then
		task.spawn(function()
			pcall(function()
				s:UpdateAsync(key(player), function(old: any)
					return math.max(if typeof(old) == "number" then old else 1, unlocked)
				end)
			end)
		end)
	end
end

return Progress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[--!strict
-- The game, server side. It's one place that runs as two kinds of server:
--
--   a lobby server   (the public ones you join): the lobby. When a group goes through
--                    one of its doors they're teleported to a reserved server of this
--                    same place. In Studio, where teleports don't work, the night is
--                    played right here instead, and the doors stay shut until it's over.
--   a night server   (reserved, one per group): plays the night the group chose
--                    (Playing -> Results), then sends everyone back to a lobby.
--
-- Either way a group is on its own for its night. When you're caught you get two
-- choices: TRY AGAIN (it shows how many of the group want to, like 2 / 4) or BACK TO
-- LOBBY. If the whole group tries again, the night starts over; otherwise everyone goes
-- back to the lobby.
--
-- Each player's "Where" attribute tells their client where they are: "lobby",
-- "night", or "between" (no body: a black screen, a teleport, the results).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TeleportService = game:GetService("TeleportService")

local Config = require(ReplicatedStorage.Shared.Config)
local Curses = require(ReplicatedStorage.Shared.Curses)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Monsters = require(ReplicatedStorage.Shared.Monsters)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Chaos = require(script.Parent.Chaos)
local Exit = require(script.Parent.Exit)
local Interactables = require(script.Parent.Interactables)
local Lobby = require(script.Parent.Lobby)
local MonsterAI = require(script.Parent.MonsterAI)
local Objectives = require(script.Parent.Objectives)
local Progress = require(script.Parent.Progress)
local Throwables = require(script.Parent.Throwables)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local GameState = ReplicatedStorage.GameState

type Round = {
	night: Nights.Night,
	layout: Maze.Layout,
	world: WorldBuilder.World,
	interactables: Interactables.Interactables,
	monster: MonsterAI.MonsterAI,
	exit: Exit.Exit,
	objective: Objectives.Objective,
	chaos: Chaos.Chaos,
	throwables: Throwables.Throwables,
	curse: Curses.Curse,
	startedAt: number,
	spawnIndex: number,
	participants: { [Player]: boolean },
	connections: { RBXScriptConnection },
}

local RoundManager = {}

local status: { [Player]: string } = {} -- "alive" | "caught" | "escaped"
local looks: { [Player]: Vector3 } = {}
local round: Round? = nil
local lobby: Lobby.Lobby? = nil
local nightBusy = false -- a group's night (and its try-again vote) is going on here

-- The group playing here and what each of them chose when they were caught.
local group: { Player } = {}
local groupSize = 0
local votes: { [Player]: string } = {} -- "again" | "lobby"
local goBack: (players: { Player }) -> () = function() end

local function setWhere(player: Player, where: string)
	player:SetAttribute("Where", where)
end

local function isAlive(player: Player): boolean
	return status[player] == "alive" and player.Parent ~= nil
end

local function alivePlayers(): { Player }
	local list = {}
	for player, s in status do
		if s == "alive" and player.Parent ~= nil then
			table.insert(list, player)
		end
	end
	return list
end

local function notifyAll(text: string, style: string?)
	Remotes.Notify:FireAllClients(text, style)
end

local function notify(player: Player, text: string, style: string?)
	Remotes.Notify:FireClient(player, text, style)
end

local function notifyOthers(except: Player, text: string, style: string?)
	for _, p in Players:GetPlayers() do
		if p ~= except then
			Remotes.Notify:FireClient(p, text, style)
		end
	end
end

local function removeCharacter(player: Player)
	local character = player.Character
	if character then
		character:Destroy()
	end
	pcall(function()
		player.Character = nil
	end)
end

local function loadCharacter(player: Player): boolean
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		-- older engines only have the (now deprecated) synchronous version
		ok = pcall(function()
			(player :: any):LoadCharacter()
		end)
	end
	return ok and player.Character ~= nil
end

local function applyLighting(l: Nights.Lighting, curse: Curses.Curse?)
	Lighting.Ambient = l.Ambient
	Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
	Lighting.FogColor = l.FogColor
	Lighting.FogStart = l.FogStart
	Lighting.FogEnd = l.FogEnd
	if curse and curse.id == "fog" then
		-- real fog: pale, close, but not pitch black (or the dark nights are unplayable)
		Lighting.FogColor = l.FogColor:Lerp(Color3.fromRGB(78, 78, 82), 0.35)
		Lighting.FogStart = 4
		Lighting.FogEnd = math.min(l.FogEnd * 0.4, 42)
	end
	Lighting.ExposureCompensation = l.Exposure
	local grade = Lighting:FindFirstChild("Monochrome")
	if grade and grade:IsA("ColorCorrectionEffect") then
		grade.Saturation = l.Saturation
		grade.Contrast = l.Contrast
		grade.Brightness = l.Brightness
		grade.TintColor = l.Tint
	end
	local bloom = Lighting:FindFirstChild("Glow")
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Intensity = l.Bloom
	end
	pcall(function()
		SoundService.AmbientReverb = (Enum.ReverbType :: any)[l.Reverb]
	end)
end

local function spawnPlayer(player: Player)
	local r = round
	if not r or status[player] ~= nil then
		return
	end
	status[player] = "alive"
	r.participants[player] = true
	player:SetAttribute("Hiding", false)
	player:SetAttribute("Flashlight", false)
	player:SetAttribute("Bottles", 0)
	setWhere(player, "night")
	local ok = loadCharacter(player)
	local character = player.Character
	if not ok or not character or round ~= r then
		return
	end
	r.spawnIndex += 1
	character:PivotTo(r.world.spawnPoints[(r.spawnIndex - 1) % #r.world.spawnPoints + 1])
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			if status[player] == "alive" and round == r then
				RoundManager.caught(player, nil)
			end
		end)
	end
end

function RoundManager.caught(player: Player, monster: Model?)
	if status[player] ~= "alive" then
		return
	end
	status[player] = "caught"
	local r = round
	if r then
		r.interactables:release(player)
		r.monster:forget(player)
	end
	if monster then
		Remotes.Jumpscare:FireClient(player, monster)
	end
	notifyOthers(player, player.DisplayName .. " was taken.", "danger")
	task.delay(if monster then 2.7 else 0.5, function()
		if status[player] == "caught" then
			setWhere(player, "between")
			removeCharacter(player)
		end
		-- then the choice (unless someone already got out: that night's won). The night may
		-- already be over by now, if you were the last one.
		local won = false
		for _, s in status do
			if s == "escaped" then
				won = true
			end
		end
		if table.find(group, player) and votes[player] == nil and player.Parent and not won then
			Remotes.Retry:FireClient(player, "open", RoundManager.againCount(), groupSize)
		end
	end)
end

-- kind: "escaped" | "survived" | "collected" | "final"
function RoundManager.escaped(player: Player, kind: string)
	if status[player] ~= "alive" then
		return
	end
	status[player] = "escaped"
	local r = round
	if r then
		r.interactables:release(player)
		r.monster:forget(player)
	end
	Remotes.Escaped:FireClient(player, kind)
	if kind == "escaped" or kind == "final" then
		notifyOthers(player, player.DisplayName .. " made it out.", "key")
	end
	task.delay(4, function()
		if status[player] == "escaped" then
			setWhere(player, "between")
			removeCharacter(player)
		end
	end)
end

local function startRound(night: Nights.Night, players: { Player })
	local seed = Random.new():NextInteger(1, 2 ^ 30)
	local layout = Maze.generate(seed, night.maze)
	local world = WorldBuilder.build(layout, night)
	local curse = Curses.roll(night.monsterKind, Random.new(seed + 5))
	applyLighting(night.lighting, curse)
	local exit = Exit.new(world)

	local monster: MonsterAI.MonsterAI
	local interactables = Interactables.new(layout, world, {
		isAlive = isAlive,
		onHide = function(player: Player, locker: Interactables.Locker)
			monster:onPlayerHid(player, locker)
		end,
		onNoise = function(position: Vector3, radius: number)
			monster:hearNoise(position, radius)
		end,
	})
	local params = Nights.monsterParams(night)
	if night.monsterKind == "Statue" then
		params.Variant = Monsters.STATUE_VARIANTS[Random.new(seed):NextInteger(1, #Monsters.STATUE_VARIANTS)]
	end
	monster = MonsterAI.new(layout, world, interactables, params, night.monsterKind, {
		getPlayers = alivePlayers,
		onCaught = RoundManager.caught,
		onAwake = function()
			GameState:SetAttribute("MonsterAwake", true)
		end,
		getLook = function(player: Player): Vector3?
			return looks[player]
		end,
		setBlink = function(on: boolean)
			GameState:SetAttribute("Blink", on)
		end,
	})

	GameState:SetAttribute("Night", night.index)
	GameState:SetAttribute("NightName", night.name)
	GameState:SetAttribute("Done", 0)
	GameState:SetAttribute("Goal", 0)
	GameState:SetAttribute("CodeMask", "")
	GameState:SetAttribute("Objective", "")
	GameState:SetAttribute("ExitOpen", false)
	GameState:SetAttribute("MonsterAwake", false)
	GameState:SetAttribute("Hour", 0)
	GameState:SetAttribute("Blink", false)
	GameState:SetAttribute("Result", "")
	GameState:SetAttribute("Curse", curse.id)
	GameState:SetAttribute("Blackout", false)
	GameState:SetAttribute("Rage", false)

	local objective = Objectives.start({
		night = night,
		layout = layout,
		world = world,
		interactables = interactables,
		monster = monster,
		exit = exit,
		isAlive = isAlive,
		notifyAll = notifyAll,
		notify = notify,
		setProgress = function(done: number, goal: number)
			GameState:SetAttribute("Goal", goal)
			GameState:SetAttribute("Done", done)
		end,
		winAll = function(kind: string)
			for _, player in alivePlayers() do
				RoundManager.escaped(player, kind)
			end
		end,
	})

	local throwables = Throwables.new(layout, world, {
		isAlive = isAlive,
		onNoise = function(position: Vector3, radius: number)
			monster:hearNoise(position, radius)
		end,
	})
	local chaos = Chaos.start({
		night = night,
		layout = layout,
		world = world,
		interactables = interactables,
		monster = monster,
		curse = curse,
		getPlayers = alivePlayers,
		isAlive = isAlive,
		notifyAll = notifyAll,
	})

	local r: Round = {
		night = night,
		layout = layout,
		world = world,
		interactables = interactables,
		monster = monster,
		exit = exit,
		objective = objective,
		chaos = chaos,
		throwables = throwables,
		curse = curse,
		startedAt = os.clock(),
		spawnIndex = 0,
		participants = {},
		connections = {},
	}
	table.insert(r.connections, world.escapeZone.Touched:Connect(function(hit: BasePart)
		if not exit.isOpen then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if player and isAlive(player) then
			RoundManager.escaped(player, if night.index == Nights.count then "final" else "escaped")
		end
	end))

	table.clear(status)
	round = r
	GameState:SetAttribute("Phase", "Playing")
	for _, player in players do
		task.spawn(spawnPlayer, player)
	end
	monster:start()
end

-- Ends the night and clears it away; returns whether anyone made it out.
local function endRound(): boolean
	local r = round
	if not r then
		return false
	end
	local survivors = {}
	for player, s in status do
		if s == "escaped" then
			table.insert(survivors, player.DisplayName)
		end
	end
	local won = #survivors > 0
	if won then
		-- co-op: everyone who played this night moves on
		for player in r.participants do
			if player.Parent then
				Progress.beat(player, r.night.index)
			end
		end
	end
	GameState:SetAttribute("Result", if won then "Escaped" else "Caught")
	GameState:SetAttribute("Phase", "Results")
	if won then
		task.wait(Config.Round.ResultsTime) -- let the ending play out
	end

	for _, c in r.connections do
		c:Disconnect()
	end
	r.objective.destroy()
	r.chaos.destroy()
	r.throwables.destroy()
	r.monster:destroy()
	r.interactables:destroy()
	r.world.model:Destroy()
	round = nil
	table.clear(status)
	for player in r.participants do
		if player.Parent then
			removeCharacter(player)
			setWhere(player, "between")
			player:SetAttribute("Hiding", false)
			player:SetAttribute("Bottles", 0)
		end
	end
	GameState:SetAttribute("Curse", "")
	return won
end

-- The try-again vote ----------------------------------------------------------------

function RoundManager.againCount(): number
	local n = 0
	for p, v in votes do
		if v == "again" and p.Parent then
			n += 1
		end
	end
	return n
end

local function present(players: { Player }): { Player }
	local out = {}
	for _, p in players do
		if p.Parent then
			table.insert(out, p)
		end
	end
	return out
end

local function tell(players: { Player }, ...: any)
	for _, p in present(players) do
		Remotes.Retry:FireClient(p, ...)
	end
end

-- The group's night, again and again for as long as all of them want to try again.
-- `back` sends players to a lobby (a teleport home, or a respawn in this one).
local function playNight(players: { Player }, nightIndex: number, back: (players: { Player }) -> ())
	nightBusy = true
	group = table.clone(players)
	groupSize = #players
	goBack = back
	while true do
		table.clear(votes)
		startRound(Nights.get(nightIndex), present(group))
		repeat
			task.wait(0.5)
		until #alivePlayers() == 0
		if endRound() then
			tell(group, "close")
			break
		end
		-- caught, all of them: wait for everyone's choice (a minute at most)
		local deadline = os.clock() + 60
		repeat
			task.wait(0.25)
		until RoundManager.againCount() >= groupSize or #present(group) < groupSize or os.clock() > deadline
		tell(group, "close")
		if RoundManager.againCount() < groupSize then
			break
		end
	end
	local remaining = present(group)
	table.clear(group)
	table.clear(votes)
	groupSize = 0
	back(remaining)
	nightBusy = false
end

-- Lobby -----------------------------------------------------------------------------

local function spawnInLobby(player: Player)
	local l = lobby
	if not l or player.Parent == nil or status[player] == "alive" then
		return
	end
	setWhere(player, "lobby")
	player:SetAttribute("Flashlight", false)
	if not loadCharacter(player) then
		return
	end
	local character = player.Character :: Model
	character:PivotTo(l.spawnCFrame())
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			task.wait(3)
			if player:GetAttribute("Where") == "lobby" and player.Character == character then
				spawnInLobby(player)
			end
		end)
	end
end

local function teleportsWork(): boolean
	return not RunService:IsStudio() and game.PlaceId ~= 0
end

-- Send a group to a reserved server of this place to play `night`.
local function sendToNight(group: { Player }, night: number): boolean
	local ok, err = pcall(function()
		local code = TeleportService:ReserveServer(game.PlaceId)
		local options = Instance.new("TeleportOptions")
		options.ReservedServerAccessCode = code
		options:SetTeleportData({ night = night, count = #group })
		TeleportService:TeleportAsync(game.PlaceId, group, options)
	end)
	if not ok then
		warn("ACHROMA: couldn't reach a night server (" .. tostring(err) .. "); playing it here")
	end
	return ok
end

-- Studio (or a failed teleport): play the night in this server, then back to the lobby.
local function playHere(players: { Player }, night: number)
	if nightBusy then
		for _, p in players do
			spawnInLobby(p)
		end
		return
	end
	playNight(players, night, function(back: { Player })
		for _, p in back do
			task.spawn(spawnInLobby, p)
		end
	end)
	applyLighting(Lobby.LIGHTING)
	GameState:SetAttribute("Phase", "Lobby")
	GameState:SetAttribute("Night", 1)
end

local function runLobby()
	GameState:SetAttribute("Phase", "Lobby")
	applyLighting(Lobby.LIGHTING)
	lobby = Lobby.new({
		highest = Progress.allowed,
		isOpen = function(): boolean
			return not nightBusy
		end,
		launch = function(group: { Player }, night: number)
			for _, p in group do
				setWhere(p, "between")
			end
			if not (teleportsWork() and sendToNight(group, night)) then
				task.spawn(playHere, group, night)
			end
		end,
	})
	-- a teleport that fails after it started: back to the lobby
	TeleportService.TeleportInitFailed:Connect(function(player: Player)
		if player:GetAttribute("Where") == "between" and status[player] == nil then
			spawnInLobby(player)
		end
	end)
	local function join(player: Player)
		Progress.load(player)
		spawnInLobby(player)
	end
	Players.PlayerAdded:Connect(join)
	for _, player in Players:GetPlayers() do
		task.spawn(join, player)
	end
end

-- Night server --------------------------------------------------------------------------

-- Everyone back to a (public) lobby server.
local function sendHome(players: { Player })
	for attempt = 1, 3 do
		local ok = pcall(function()
			TeleportService:TeleportAsync(game.PlaceId, players)
		end)
		if ok then
			return
		end
		task.wait(2 * attempt)
	end
end

local function runNightServer()
	GameState:SetAttribute("Phase", "Waiting")
	local planned: number? = nil
	local expected = 1
	local firstArrival: number? = nil
	local function join(player: Player)
		setWhere(player, "between")
		local ok, data = pcall(function()
			return player:GetJoinData().TeleportData
		end)
		if ok and typeof(data) == "table" then
			local n = tonumber((data :: any).night)
			if n and not planned then
				planned = n
				-- so the black screen can already say which night it is
				GameState:SetAttribute("Night", math.clamp(math.floor(n), 1, Nights.count))
			end
			expected = math.max(expected, tonumber((data :: any).count) or 1)
		end
		firstArrival = firstArrival or os.clock()
		Progress.load(player)
		if round then
			spawnPlayer(player) -- late, but the night's still going
		end
	end
	Players.PlayerAdded:Connect(join)
	for _, player in Players:GetPlayers() do
		task.spawn(join, player)
	end

	-- wait for the whole group (or 20 seconds after the first of them)
	repeat
		task.wait(0.25)
	until firstArrival and (#Players:GetPlayers() >= expected or os.clock() - (firstArrival :: number) > 20)
	task.wait(0.5)
	-- nobody gets a night they couldn't have chosen
	local allowed = 1
	for _, player in Players:GetPlayers() do
		allowed = math.max(allowed, Progress.allowed(player))
	end
	local night = math.clamp(math.floor(planned or 1), 1, allowed)
	GameState:SetAttribute("Night", night)
	playNight(Players:GetPlayers(), night, sendHome)
	sendHome(Players:GetPlayers())
	-- anyone who still turns up here goes home too
	Players.PlayerAdded:Connect(function(player: Player)
		sendHome({ player })
	end)
end

function RoundManager.run()
	Players.CharacterAutoLoads = false
	WorldBuilder.setupCollisionGroups()

	GameState:SetAttribute("Phase", "Lobby")
	GameState:SetAttribute("Night", 1)
	GameState:SetAttribute("NightName", Nights.get(1).name)
	GameState:SetAttribute("Done", 0)
	GameState:SetAttribute("Goal", 0)
	GameState:SetAttribute("Objective", "")

	-- where each player's camera is looking (the Statue can't move while watched)
	Remotes.Look.OnServerEvent:Connect(function(player: Player, direction: unknown)
		if typeof(direction) == "Vector3" and direction.Magnitude > 0.5 and direction.Magnitude < 2 then
			looks[player] = direction.Unit
		end
	end)

	-- Everyone else sees your flashlight beam too (and so does the monster).
	Remotes.Flashlight.OnServerEvent:Connect(function(player: Player, on: unknown)
		if typeof(on) ~= "boolean" then
			return
		end
		player:SetAttribute("Flashlight", on)
		local character = player.Character
		local head = if character then character:FindFirstChild("Head") else nil
		if head and head:IsA("BasePart") then
			local existing = head:FindFirstChild("SharedFlashlight")
			local light: SpotLight
			if existing and existing:IsA("SpotLight") then
				light = existing
			else
				light = Instance.new("SpotLight")
				light.Name = "SharedFlashlight"
				light.Face = Enum.NormalId.Front
				light.Shadows = true
				light.Parent = head
			end
			local r = round
			local beam = Nights.flashlight(if r then r.night else Nights.get(1))
			light.Angle = beam.angle + 4
			light.Range = beam.range * 0.85
			light.Brightness = beam.brightness * 0.8
			light.Enabled = on
		end
	end)

	-- what a caught player chose: TRY AGAIN, or BACK TO LOBBY (which leaves right away)
	Remotes.Retry.OnServerEvent:Connect(function(player: Player, choice: unknown)
		if not table.find(group, player) or status[player] == "alive" or votes[player] ~= nil then
			return
		end
		if choice == "again" then
			votes[player] = "again"
			tell(group, "count", RoundManager.againCount(), groupSize)
		elseif choice == "lobby" then
			votes[player] = "lobby"
			table.remove(group, table.find(group, player) :: number)
			Remotes.Retry:FireClient(player, "close")
			goBack({ player })
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		looks[player] = nil
		local r = round
		if r then
			r.interactables:release(player)
			r.monster:forget(player)
		end
		status[player] = nil
	end)

	-- a reserved server is a night server; anything else is a lobby
	if game.PrivateServerId ~= "" and game.PrivateServerOwnerId == 0 then
		runNightServer()
	else
		runLobby()
	end
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">Themes</string>
          <string name="Source"><![CDATA[--!strict
-- The look of each night's map: materials, lamps, props, hub decor, wall writing.
--   house   grey concrete maze around a house                      (night 1)
--   ward    tiled hospital halls in red emergency light            (night 2)
--   sewer   flooded brick tunnels, no power                        (night 3)
--   atrium  a vast marble hall of columns, lamp posts and statues  (night 4)
--   void    black glass, glowing purple veins, floating rocks      (night 5)

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maze = require(ReplicatedStorage.Shared.Maze)
local Monsters = require(ReplicatedStorage.Shared.Monsters)
local Build = require(script.Parent.Build)
local Dressing = require(script.Parent.Dressing)

type Ctx = Build.Ctx
type Style = Build.Style
type Cell = Maze.Cell

export type CellInfo = { spot: boolean, room: boolean }

export type Theme = {
	wall: Style,
	hubWall: Style,
	floor: Style,
	hubFloor: (room: string) -> Style,
	ceiling: Style,
	hubCeiling: Style,
	trim: Style,
	tunnel: Style,
	locker: Style,
	columns: boolean,
	writings: { string },
	writingColor: Color3,
	writingFont: Enum.Font,
	writingGlow: boolean,
	exitStyle: string,
	lamp: (ctx: Ctx, cell: Cell?, position: Vector3) -> (),
	hubLamps: (ctx: Ctx) -> (),
	cell: (ctx: Ctx, x: number, z: number, info: CellInfo) -> (),
	room: (ctx: Ctx, block: { Cell }) -> (),
	hub: (ctx: Ctx) -> (),
	extra: (ctx: Ctx) -> (),
	spawns: (ctx: Ctx) -> { CFrame },
}

local Themes: { [string]: Theme } = {}

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a Cylinder (X axis) upright

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function solid(ctx: Ctx, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	return ctx.part(ctx.props, name, size, cf, material, color, shape)
end

local function deco(ctx: Ctx, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	return ctx.decor(ctx.part(ctx.props, name, size, cf, material, color, shape)) :: Part
end

-- Wall faces of hub cells (except the exit), for hanging hub decor.
local function hubWalls(ctx: Ctx): { { cell: Cell, side: string } }
	local out = {}
	local hub = ctx.layout.hub
	for rz = 0, hub.d - 1 do
		for rx = 0, hub.w - 1 do
			local x, z = hub.x0 + rx, hub.z0 + rz
			for _, side in Maze.DIRS do
				local kind = Maze.getEdge(ctx.layout, x, z, side)
				local nx, nz = x + Maze.DX[side], z + Maze.DZ[side]
				if kind == "wall" and not (Maze.inBounds(ctx.layout, nx, nz) and Maze.isHub(ctx.layout, nx, nz)) then
					table.insert(out, { cell = { x = x, z = z }, side = side })
				end
			end
		end
	end
	return out
end

local function hallSpawns(ctx: Ctx): { CFrame }
	local hub = ctx.layout.hub
	local cx = ctx.hubOrigin.X + hub.w * ctx.C / 2
	local z0 = ctx.hubOrigin.Z + ctx.C * 0.6
	local points = {}
	for i = 0, 5 do
		local pos = Vector3.new(cx + (i % 3 - 1) * 4, 3.5, z0 + math.floor(i / 3) * 4)
		table.insert(points, CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)))
	end
	return points
end

local function hubCellLamps(ctx: Ctx, theme: Theme)
	local hub = ctx.layout.hub
	for rz = 0, hub.d - 1 do
		for rx = 0, hub.w - 1 do
			theme.lamp(ctx, nil, ctx.cellCenter(hub.x0 + rx, hub.z0 + rz))
		end
	end
end

local function noop() end

-- Which of the map's 2x2 rooms this is (1 = first).
local function roomIndex(ctx: Ctx, block: { Cell }): number
	return table.find(ctx.layout.roomBlocks, block) or 1
end

local function randomSide(ctx: Ctx, sides: { string }): string
	return sides[ctx.random:NextInteger(1, #sides)]
end

---------------------------------------------------------------------------
-- NIGHT 1: THE HOUSE

local HOUSE_FLOORS: { [string]: Style } = {
	hall = { material = Enum.Material.WoodPlanks, color = rgb(88, 74, 62) },
	living = { material = Enum.Material.WoodPlanks, color = rgb(98, 82, 68) },
	bedroom = { material = Enum.Material.Carpet, color = rgb(78, 76, 80) },
	kitchen = { material = Enum.Material.CeramicTiles, color = rgb(150, 150, 146) },
	study = { material = Enum.Material.WoodPlanks, color = rgb(80, 68, 58) },
}

local function portrait(ctx: Ctx, frame: CFrame)
	solid(ctx, "PortraitFrame", Vector3.new(3.6, 4.6, 0.3), frame * CFrame.new(0, 0, -0.15), Enum.Material.Wood, rgb(45, 36, 30))
	local canvas = deco(ctx, "Portrait", Vector3.new(3, 4, 0.05), frame * CFrame.new(0, 0, -0.33), Enum.Material.SmoothPlastic, rgb(38, 38, 38))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 1
	gui.Parent = canvas
	local function blob(name: string, pos: UDim2, size: UDim2, color: Color3): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = pos
		f.Size = size
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = f
		f.Parent = gui
		return f
	end
	blob("Body", UDim2.fromScale(0.5, 1.05), UDim2.fromScale(0.95, 0.5), rgb(20, 20, 20))
	local face = blob("Face", UDim2.fromScale(0.5, 0.42), UDim2.fromScale(0.5, 0.5), rgb(205, 200, 190))
	face.Rotation = ctx.random:NextNumber(-8, 8)
	blob("EyeL", UDim2.fromScale(0.41, 0.38), UDim2.fromScale(0.11, 0.09), Color3.new(0, 0, 0))
	blob("EyeR", UDim2.fromScale(0.59, 0.38), UDim2.fromScale(0.11, 0.09), Color3.new(0, 0, 0))
	blob("Mouth", UDim2.fromScale(0.5, 0.55), UDim2.fromScale(0.16, 0.12), Color3.new(0, 0, 0))
end

local function ceilingLamp(ctx: Ctx, cell: Cell?, position: Vector3, color: Color3, brightness: number, range: number)
	local H = ctx.ceiling
	ctx.decor(ctx.part(ctx.lights, "LampBase", Vector3.new(2.8, 0.3, 2.8), CFrame.new(position.X, H - 0.15, position.Z), Enum.Material.Metal, rgb(45, 45, 45), nil))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(1.5, 0.35, 1.5), CFrame.new(position.X, H - 0.45, position.Z), Enum.Material.Neon, rgb(215, 212, 200), nil))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = color
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("Buzz", ctx.random:NextNumber() < 0.4)
	ctx.addLamp(bulb, light, cell)
end

local function hangingLamp(ctx: Ctx, position: Vector3, brightness: number, color: Color3)
	local H = ctx.ceiling
	local bulbY = H - 3.2
	ctx.decor(ctx.part(ctx.lights, "Cord", Vector3.new(0.12, H - bulbY, 0.12), CFrame.new(position.X, (H + bulbY) / 2, position.Z), Enum.Material.Plastic, rgb(20, 20, 20), nil))
	ctx.decor(ctx.part(ctx.lights, "Shade", Vector3.new(2.2, 0.9, 2.2), CFrame.new(position.X, bulbY + 0.55, position.Z), Enum.Material.Fabric, rgb(120, 116, 110), nil))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(0.9, 0.9, 0.9), CFrame.new(position.X, bulbY, position.Z), Enum.Material.Neon, rgb(215, 212, 200), Enum.PartType.Ball))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = brightness
	light.Color = color
	light.Shadows = true
	light.Parent = bulb
	ctx.addLamp(bulb, light, nil)
end

local function houseProps(ctx: Ctx)
	local O = ctx.hubOrigin
	local random = ctx.random
	local function box(name: string, size: Vector3, x: number, yBottom: number, z: number, material: Enum.Material, color: Color3, rotY: number?): Part
		return solid(ctx, name, size, CFrame.new(O + Vector3.new(x, yBottom + size.Y / 2, z)) * CFrame.Angles(0, rotY or 0, 0), material, color)
	end
	local function wallFrame(x: number, y: number, z: number, facing: Vector3): CFrame
		local pos = O + Vector3.new(x, y, z)
		return CFrame.lookAt(pos, pos + facing)
	end
	local function note(x: number, y: number, z: number)
		ctx.note(CFrame.new(O + Vector3.new(x, y + 0.025, z)) * CFrame.Angles(0, random:NextNumber(-0.4, 0.4), 0))
	end
	local wood = Enum.Material.Wood
	local darkWood = rgb(62, 50, 42)
	local fabric = Enum.Material.Fabric

	-- bedroom: you wake up here
	box("BedFrame", Vector3.new(6, 1.6, 8), 3.6, 0, 29.1, wood, darkWood)
	box("Headboard", Vector3.new(6, 4.2, 0.5), 3.6, 0, 24.85, wood, darkWood)
	box("Mattress", Vector3.new(5.6, 0.9, 7.4), 3.6, 1.6, 29.3, fabric, rgb(196, 194, 188))
	box("Pillow", Vector3.new(3.6, 0.6, 1.5), 3.6, 2.5, 26.2, fabric, rgb(220, 218, 214))
	box("Blanket", Vector3.new(5.8, 0.3, 4.6), 3.7, 2.5, 31.0, fabric, rgb(70, 70, 78), 0.06)
	box("Nightstand", Vector3.new(2.2, 2.4, 2), 8, 0, 25.6, wood, darkWood)
	box("BrokenLamp", Vector3.new(0.6, 1.3, 0.6), 8.4, 2.4, 25.4, Enum.Material.Metal, rgb(80, 80, 80), 0.3)
	note(7.7, 2.4, 25.9)
	box("ChairSeat", Vector3.new(2.2, 0.35, 2.2), 21.4, 2.1, 33.6, wood, darkWood, math.rad(45))
	box("ChairBack", Vector3.new(2.2, 3.2, 0.3), 22.2, 2.45, 34.4, wood, darkWood, math.rad(45))
	for _, l in { { 20.7, 33.6 }, { 21.4, 32.9 }, { 22.1, 33.6 }, { 21.4, 34.3 } } do
		box("ChairLeg", Vector3.new(0.3, 2.1, 0.3), l[1], 0, l[2], wood, darkWood)
	end
	portrait(ctx, wallFrame(18, 6.2, 35.5, Vector3.new(0, 0, -1)))

	-- living room
	local couch = rgb(104, 100, 96)
	box("CouchBase", Vector3.new(3.6, 2, 9), 2.9, 0, 12, fabric, couch)
	box("CouchBack", Vector3.new(1.2, 4.2, 9), 1.1, 0, 12, fabric, couch)
	box("CouchArm", Vector3.new(3.6, 3, 1), 2.9, 0, 7, fabric, couch)
	box("CouchArm", Vector3.new(3.6, 3, 1), 2.9, 0, 17, fabric, couch)
	ctx.decor(box("Rug", Vector3.new(10, 0.1, 8), 8, 0.05, 12, fabric, rgb(56, 56, 60)))
	box("CoffeeTable", Vector3.new(3, 1.6, 5), 8.5, 0, 12, wood, darkWood)
	box("TVStand", Vector3.new(2.4, 2.4, 6.4), 22.2, 0, 6, wood, darkWood)
	box("TV", Vector3.new(1, 3.4, 5.4), 22.5, 2.4, 6, Enum.Material.SmoothPlastic, rgb(16, 16, 16))
	local screen = ctx.sign(wallFrame(21.95, 4.1, 6, Vector3.new(-1, 0, 0)), Vector2.new(4.8, 2.9), "NO SIGNAL\n\nSTAY ASLEEP", rgb(150, 150, 150), rgb(46, 46, 46), true, Enum.Font.SpecialElite)
	local tvLight = Instance.new("PointLight")
	tvLight.Range = 10
	tvLight.Brightness = 0.6
	tvLight.Shadows = true
	tvLight.Parent = screen
	ctx.addLamp(screen, tvLight, nil)
	box("Bookshelf", Vector3.new(8, 9, 2), 12, 0, 1.55, wood, darkWood)
	for shelf = 0, 2 do
		local x = 8.6
		while x < 15.2 do
			local w = random:NextNumber(0.35, 0.8)
			local h = random:NextNumber(1.4, 2.2)
			box("Book", Vector3.new(w, h, 1.4), x + w / 2, 1 + shelf * 2.8, 2.0, fabric, ctx.vary(rgb(110, 104, 98), 0.4))
			x += w + random:NextNumber(0.02, 0.4)
		end
	end
	portrait(ctx, wallFrame(0.5, 7, 12, Vector3.new(1, 0, 0)))

	-- hall: the grandfather clock is stuck at midnight
	box("ClockBody", Vector3.new(1.8, 8.6, 1.6), 25.4, 0, 8, wood, darkWood)
	ctx.sign(wallFrame(26.33, 6.8, 8, Vector3.new(1, 0, 0)), Vector2.new(1.3, 1.3), "XII", rgb(30, 30, 30), rgb(200, 196, 186), false, Enum.Font.Fondamento)
	box("CoatRack", Vector3.new(0.4, 7, 0.4), 25.6, 0, 2.2, wood, darkWood)
	ctx.decor(box("Runner", Vector3.new(4, 0.1, 30), 30, 0.05, 18, fabric, rgb(60, 58, 58)))
	portrait(ctx, wallFrame(24.5, 6.5, 24, Vector3.new(1, 0, 0)))
	portrait(ctx, wallFrame(35.5, 6.5, 6, Vector3.new(-1, 0, 0)))

	-- kitchen
	box("Counter", Vector3.new(18, 3.4, 2.6), 47, 0, 1.8, wood, rgb(150, 146, 140))
	box("Countertop", Vector3.new(18.4, 0.3, 2.9), 47, 3.4, 1.8, Enum.Material.Marble, rgb(200, 200, 195))
	box("Cabinets", Vector3.new(18, 3, 1.6), 47, 7.2, 1.3, wood, rgb(140, 136, 130))
	box("Fridge", Vector3.new(3.2, 7.5, 3), 57.9, 0, 14, Enum.Material.Metal, rgb(186, 186, 186))
	box("TableTop", Vector3.new(6, 0.3, 4), 46, 2.9, 13, wood, darkWood)
	for _, l in { { 43.4, 11.4 }, { 48.6, 11.4 }, { 43.4, 14.6 }, { 48.6, 14.6 } } do
		box("TableLeg", Vector3.new(0.3, 2.9, 0.3), l[1], 0, l[2], wood, darkWood)
	end
	box("KitchenChair", Vector3.new(2, 2, 2), 46, 0, 16.2, wood, darkWood)
	box("KitchenChair", Vector3.new(2, 2, 2), 41.6, 0, 13, wood, darkWood, math.rad(70))
	note(46.5, 3.2, 13)

	-- study
	box("Desk", Vector3.new(6, 3, 2.6), 42, 0, 34.2, wood, darkWood)
	box("DeskChair", Vector3.new(2, 2, 2), 42, 0, 31.6, wood, darkWood)
	box("Bookshelf", Vector3.new(2, 9, 8), 58.5, 0, 30, wood, darkWood)
	note(41.2, 3, 34.0)
	portrait(ctx, wallFrame(42, 6.5, 24.5, Vector3.new(0, 0, 1)))
end

-- a lamp on a bracket, halfway up a corridor wall
local function sconce(ctx: Ctx, cell: Cell?, wall: CFrame, color: Color3)
	local at = wall * CFrame.new(0, 7.4, -0.5)
	ctx.decor(ctx.part(ctx.lights, "Bracket", Vector3.new(0.3, 0.3, 1), at * CFrame.new(0, -0.6, 0.25), Enum.Material.Metal, rgb(70, 66, 60), nil))
	ctx.decor(ctx.part(ctx.lights, "Shade", Vector3.new(1.3, 1.2, 1.2), at * UP, Enum.Material.Fabric, rgb(170, 164, 152), Enum.PartType.Cylinder))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(0.6, 0.6, 0.6), at * CFrame.new(0, -0.45, 0), Enum.Material.Neon, rgb(225, 218, 200), Enum.PartType.Ball))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = ctx.random:NextNumber(1.0, 1.4)
	light.Color = color
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("Buzz", ctx.random:NextNumber() < 0.3)
	ctx.addLamp(bulb, light, cell)
end

local function grandfatherClock(ctx: Ctx, wall: CFrame)
	local at = wall * CFrame.new(ctx.random:NextNumber(-3, 3), 0, -1)
	solid(ctx, "ClockBody", Vector3.new(1.8, 8.6, 1.6), at * CFrame.new(0, 4.3, 0), Enum.Material.Wood, rgb(52, 42, 36))
	ctx.sign(at * CFrame.new(0, 6.8, -0.82), Vector2.new(1.3, 1.3), "XII", rgb(30, 30, 30), rgb(200, 196, 186), false, Enum.Font.Fondamento)
	deco(ctx, "Pendulum", Vector3.new(0.15, 2.4, 0.1), at * CFrame.new(0, 3.4, -0.82), Enum.Material.Metal, rgb(160, 150, 110))
end

Themes.house = {
	-- the maze is the house now: papered walls, wood floors, panelling
	wall = { material = Enum.Material.Plaster, color = rgb(128, 124, 118) },
	hubWall = { material = Enum.Material.Plaster, color = rgb(170, 164, 154) },
	floor = { material = Enum.Material.WoodPlanks, color = rgb(64, 56, 50) },
	hubFloor = function(room: string): Style
		return HOUSE_FLOORS[room] or HOUSE_FLOORS.hall
	end,
	ceiling = { material = Enum.Material.Plaster, color = rgb(66, 66, 64) },
	hubCeiling = { material = Enum.Material.Plaster, color = rgb(128, 126, 122) },
	trim = { material = Enum.Material.Wood, color = rgb(70, 58, 50) },
	tunnel = { material = Enum.Material.Plaster, color = rgb(128, 124, 118) },
	locker = { material = Enum.Material.Wood, color = rgb(70, 58, 50) },
	columns = false,
	writings = {
		"WAKE UP", "IIII IIII IIII", "NOT YET", "6", "IT'S STILL HERE", "SHH", "BEHIND", "GREY", "WAKE UP WAKE UP",
		"HOW LONG", "DON'T", "HELP",
	},
	writingColor = rgb(28, 22, 22),
	writingFont = Enum.Font.PermanentMarker,
	writingGlow = false,
	exitStyle = "double",
	lamp = function(ctx: Ctx, cell: Cell?, position: Vector3)
		local sides = if cell then ctx.wallSides(cell.x, cell.z) else {}
		if cell and #sides > 0 and ctx.random:NextNumber() < 0.4 then
			sconce(ctx, cell, ctx.sideFrame(cell.x, cell.z, randomSide(ctx, sides)), ctx.night.lighting.LampColor)
		else
			ceilingLamp(ctx, cell, position, ctx.night.lighting.LampColor, ctx.random:NextNumber(1.1, 1.7), 20)
		end
	end,
	hubLamps = function(ctx: Ctx)
		local O = ctx.hubOrigin
		for _, spot in { { 12, 12, 1.3 }, { 48, 12, 1.4 }, { 12, 30, 0.8 }, { 48, 30, 1.0 }, { 30, 18, 1.2 }, { 30, 5, 0.9 } } do
			hangingLamp(ctx, O + Vector3.new(spot[1], 0, spot[2]), spot[3], ctx.night.lighting.LampColor)
		end
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C, T, H = ctx.C, ctx.T, ctx.H
		local sides = ctx.wallSides(x, z)
		-- panelling and a picture rail on every wall
		for _, side in sides do
			local f = ctx.sideFrame(x, z, side)
			deco(ctx, "Wainscot", Vector3.new(C - T - 0.1, 3.6, 0.14), f * CFrame.new(0, 1.8, -0.07), Enum.Material.Wood, rgb(50, 42, 36))
			deco(ctx, "ChairRail", Vector3.new(C - T - 0.1, 0.3, 0.26), f * CFrame.new(0, 3.7, -0.13), Enum.Material.Wood, rgb(68, 56, 48))
			deco(ctx, "Cornice", Vector3.new(C - T - 0.1, 0.45, 0.3), f * CFrame.new(0, H - 0.25, -0.15), Enum.Material.Plaster, rgb(150, 146, 140))
		end
		if info.room or info.spot or #sides == 0 then
			return
		end
		-- windows in the outside walls, with nothing behind them
		for _, side in sides do
			if Dressing.isBoundary(ctx, x, z, side) and random:NextNumber() < 0.35 then
				Dressing.window(ctx, ctx.sideFrame(x, z, side), 4.6, rgb(84, 80, 78))
				return
			end
		end
		local f = ctx.sideFrame(x, z, randomSide(ctx, sides))
		local roll = random:NextNumber()
		if Maze.passableCount(ctx.layout, x, z) == 1 and roll < 0.55 then
			-- dead ends: furniture under dust sheets. One of them is the shape of a person.
			local kind = if random:NextNumber() < 0.4 then "person" elseif random:NextNumber() < 0.5 then "tall" else "low"
			Dressing.sheeted(ctx, f * CFrame.new(random:NextNumber(-2, 2), 0, -2.6) * CFrame.Angles(0, math.pi, 0), kind)
		elseif roll < 0.12 then
			Dressing.fakeDoor(ctx, f * CFrame.new(random:NextNumber(-2.5, 2.5), 0, 0), rgb(84, 70, 60))
		elseif roll < 0.22 then
			portrait(ctx, f * CFrame.new(random:NextNumber(-2.5, 2.5), 6.4, 0))
		elseif roll < 0.32 then
			Dressing.tableLamp(ctx, f, { x = x, z = z }, #ctx.lamps < 44 and random:NextNumber() < 0.55)
		elseif roll < 0.37 then
			-- a chair, facing the wall
			Dressing.chair(ctx, f * CFrame.new(random:NextNumber(-3, 3), 0, -1.7) * CFrame.Angles(0, math.pi, 0), rgb(56, 46, 40), false)
		elseif roll < 0.42 then
			Dressing.mirror(ctx, f)
		elseif roll < 0.46 then
			grandfatherClock(ctx, f)
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		local i = roomIndex(ctx, block)
		if i % 3 == 1 then
			Dressing.diningRoom(ctx, block, block[1])
		elseif i % 3 == 2 then
			Dressing.nursery(ctx, block)
		else
			Dressing.bathroom(ctx, block)
		end
	end,
	hub = houseProps,
	extra = noop,
	spawns = function(ctx: Ctx): { CFrame }
		local points = {}
		for _, s in { { 10, 33.5 }, { 13, 33.5 }, { 10, 29.5 }, { 13, 29.5 }, { 16, 33.5 }, { 16, 30.5 } } do
			local pos = ctx.hubOrigin + Vector3.new(s[1], 3.5, s[2])
			table.insert(points, CFrame.lookAt(pos, pos + Vector3.new(1, 0, 0)))
		end
		return points
	end,
}

---------------------------------------------------------------------------
-- NIGHT 2: THE RED WARD

local WARD_SIGNS = { "WARD B", "ISOLATION  >", "<  RADIOLOGY", "NO VISITORS", "QUIET PLEASE", "ROOM 13", "STAFF ONLY", "SURGERY  >", "PEDIATRICS", "<  MORGUE" }

local function wardBed(ctx: Ctx, frame: CFrame)
	local metal = Enum.Material.Metal
	local fabric = Enum.Material.Fabric
	solid(ctx, "BedFrame", Vector3.new(3.4, 0.4, 7), frame * CFrame.new(0, 2, 0), metal, rgb(185, 185, 182))
	solid(ctx, "Mattress", Vector3.new(3.1, 0.6, 6.6), frame * CFrame.new(0, 2.5, 0), fabric, rgb(225, 225, 220))
	deco(ctx, "Sheet", Vector3.new(3.3, 0.2, 4.2), frame * CFrame.new(0.1, 2.85, 1.1) * CFrame.Angles(0, ctx.random:NextNumber(-0.15, 0.15), 0), fabric, rgb(200, 205, 200))
	deco(ctx, "Pillow", Vector3.new(2.4, 0.5, 1.2), frame * CFrame.new(0, 3, -2.7), fabric, rgb(235, 235, 230))
	solid(ctx, "Headboard", Vector3.new(3.4, 2.6, 0.25), frame * CFrame.new(0, 2.9, -3.45), metal, rgb(170, 170, 168))
	for _, lx in { -1.5, 1.5 } do
		for _, lz in { -3.2, 3.2 } do
			deco(ctx, "BedLeg", Vector3.new(0.2, 1.8, 0.2), frame * CFrame.new(lx, 0.9, lz), metal, rgb(120, 120, 118))
		end
	end
end

local function wardLamp(ctx: Ctx, cell: Cell?, position: Vector3)
	local random = ctx.random
	local H = ctx.ceiling
	local broken = random:NextNumber() < 0.18
	ctx.decor(ctx.part(ctx.lights, "Fixture", Vector3.new(4.2, 0.25, 1.8), CFrame.new(position.X, H - 0.12, position.Z), Enum.Material.Metal, rgb(160, 160, 160), nil))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(3.8, 0.15, 1.3), CFrame.new(position.X, H - 0.3, position.Z), Enum.Material.Neon, if broken then rgb(240, 240, 230) else rgb(255, 80, 70), nil))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 20
	light.Brightness = if broken then 0.9 else random:NextNumber(1.5, 2.1)
	light.Color = if broken then rgb(255, 250, 240) else ctx.night.lighting.LampColor
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("Buzz", broken)
	ctx.addLamp(bulb, light, cell)
	-- spinning red alarm beacons
	if random:NextNumber() < 0.2 then
		local beacon = ctx.decor(ctx.part(ctx.lights, "Beacon", Vector3.new(0.9, 0.7, 0.9), CFrame.new(position.X + 2.8, H - 0.5, position.Z), Enum.Material.Neon, rgb(255, 30, 20), nil))
		beacon.CastShadow = false
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 40
		spot.Range = 34
		spot.Brightness = 3
		spot.Color = rgb(255, 20, 10)
		spot.Parent = beacon
		CollectionService:AddTag(beacon, "Beacon")
	end
end

Themes.ward = {
	wall = { material = Enum.Material.CeramicTiles, color = rgb(206, 204, 198) },
	hubWall = { material = Enum.Material.Plaster, color = rgb(196, 190, 184) },
	floor = { material = Enum.Material.Marble, color = rgb(165, 162, 158), reflect = 0.08 },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.CeramicTiles, color = rgb(150, 148, 144) }
	end,
	ceiling = { material = Enum.Material.Plaster, color = rgb(175, 172, 168) },
	hubCeiling = { material = Enum.Material.Plaster, color = rgb(175, 172, 168) },
	trim = { material = Enum.Material.Metal, color = rgb(150, 150, 150) },
	tunnel = { material = Enum.Material.CeramicTiles, color = rgb(206, 204, 198) },
	locker = { material = Enum.Material.Metal, color = rgb(176, 186, 192) },
	columns = false,
	writings = {
		"SHH", "ROOM 13", "UNDER", "IIII IIII", "NURSE", "LOOK DOWN", "STAY", "NO", "IT CRAWLS", "WHO",
	},
	writingColor = rgb(110, 8, 8),
	writingFont = Enum.Font.PermanentMarker,
	writingGlow = false,
	exitStyle = "double",
	lamp = wardLamp,
	hubLamps = function(ctx: Ctx)
		hubCellLamps(ctx, Themes.ward)
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		if info.room then
			return
		end
		local random = ctx.random
		local C, T, H = ctx.C, ctx.T, ctx.H
		local center = ctx.cellCenter(x, z)
		local sides = ctx.wallSides(x, z)
		-- a guide line on the floor down the middle of straight corridors
		local axis = Dressing.straightAxis(ctx, x, z)
		if axis then
			local size = if axis == "NS" then Vector3.new(0.4, 0.04, C) else Vector3.new(C, 0.04, 0.4)
			deco(ctx, "GuideLine", size, CFrame.new(center + Vector3.new(0, 0.03, 0)), Enum.Material.SmoothPlastic, rgb(200, 170, 50))
		end
		for _, side in sides do
			local f = ctx.sideFrame(x, z, side)
			if random:NextNumber() < 0.45 then
				deco(ctx, "Handrail", Vector3.new(C - T - 1.5, 0.25, 0.25), f * CFrame.new(0, 3.2, -0.35), Enum.Material.Wood, rgb(150, 120, 90), Enum.PartType.Cylinder)
			end
			deco(ctx, "Kickplate", Vector3.new(C - T - 0.1, 0.8, 0.12), f * CFrame.new(0, 0.4, -0.06), Enum.Material.Metal, rgb(140, 140, 140))
			if random:NextNumber() < 0.07 then
				-- red emergency strip at floor level
				local strip = deco(ctx, "EmergencyStrip", Vector3.new(C - T - 2, 0.12, 0.08), f * CFrame.new(0, 0.95, -0.14), Enum.Material.Neon, rgb(170, 18, 12))
				strip.CastShadow = false
			end
		end
		-- papers everywhere
		if random:NextNumber() < 0.35 then
			for _ = 1, random:NextInteger(2, 5) do
				deco(ctx, "Paper", Vector3.new(0.9, 0.02, 1.2), CFrame.new(center + Vector3.new(random:NextNumber(-4, 4), 0.05, random:NextNumber(-4, 4))) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0), Enum.Material.SmoothPlastic, rgb(216, 214, 204))
			end
		end
		-- a ceiling panel hanging down, wires dangling
		if not info.spot and random:NextNumber() < 0.07 then
			local hang = CFrame.new(center + Vector3.new(random:NextNumber(-2, 2), H - 0.1, random:NextNumber(-2, 2))) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0)
			deco(ctx, "CeilingHole", Vector3.new(4, 0.05, 4), hang * CFrame.new(0, -0.02, 0), Enum.Material.SmoothPlastic, rgb(5, 5, 5))
			deco(ctx, "FallenPanel", Vector3.new(4, 0.15, 4), hang * CFrame.new(0, 0, -2) * CFrame.Angles(math.rad(-55), 0, 0) * CFrame.new(0, 0, -2), Enum.Material.Plaster, rgb(170, 168, 162))
			for _ = 1, 3 do
				local len = random:NextNumber(2.5, 5.5)
				deco(ctx, "Wire", Vector3.new(0.08, len, 0.08), hang * CFrame.new(random:NextNumber(-1.5, 1.5), -len / 2, random:NextNumber(-1.5, 1.5)) * CFrame.Angles(random:NextNumber(-0.2, 0.2), 0, random:NextNumber(-0.2, 0.2)), Enum.Material.SmoothPlastic, rgb(20, 20, 20))
			end
		end
		if #sides == 0 or info.spot then
			return
		end
		local f = ctx.sideFrame(x, z, randomSide(ctx, sides))
		local roll = random:NextNumber()
		if roll < 0.13 then
			-- a gurney left against the wall
			wardBed(ctx, f * CFrame.new(random:NextNumber(-1, 1), -1.2, -2.2) * CFrame.Angles(0, math.rad(90), 0))
		elseif roll < 0.23 then
			-- wheelchair
			local base = f * CFrame.new(random:NextNumber(-3, 3), 0, -2.4) * CFrame.Angles(0, random:NextNumber(-1, 1), 0)
			solid(ctx, "Seat", Vector3.new(2, 0.3, 2), base * CFrame.new(0, 1.8, 0), Enum.Material.Fabric, rgb(40, 40, 44))
			solid(ctx, "Back", Vector3.new(2, 2, 0.3), base * CFrame.new(0, 2.9, 1), Enum.Material.Fabric, rgb(40, 40, 44))
			for _, sx in { -1.15, 1.15 } do
				deco(ctx, "Wheel", Vector3.new(0.15, 2.4, 2.4), base * CFrame.new(sx, 1.2, 0.3), Enum.Material.Metal, rgb(90, 90, 90), Enum.PartType.Cylinder)
			end
		elseif roll < 0.32 then
			-- IV stand
			local base = f * CFrame.new(random:NextNumber(-3, 3), 0, -1.5)
			deco(ctx, "Pole", Vector3.new(7, 0.15, 0.15), base * CFrame.new(0, 3.5, 0) * UP, Enum.Material.Metal, rgb(180, 180, 180), Enum.PartType.Cylinder)
			deco(ctx, "Bag", Vector3.new(0.7, 1.1, 0.25), base * CFrame.new(0.35, 6.2, 0), Enum.Material.Glass, rgb(220, 225, 220)).Transparency = 0.4
			for a = 0, 2 do
				deco(ctx, "Foot", Vector3.new(1.4, 0.12, 0.15), base * CFrame.Angles(0, a * 2.09, 0) * CFrame.new(0.6, 0.1, 0), Enum.Material.Metal, rgb(150, 150, 150))
			end
		elseif roll < 0.4 then
			solid(ctx, "MedCart", Vector3.new(3, 3.2, 1.8), f * CFrame.new(random:NextNumber(-3, 3), 1.6, -1.1), Enum.Material.Metal, rgb(170, 175, 180))
		elseif roll < 0.5 then
			ctx.sign(f * CFrame.new(random:NextNumber(-2, 2), 7.6, -0.08), Vector2.new(4, 1), WARD_SIGNS[random:NextInteger(1, #WARD_SIGNS)], rgb(20, 20, 20), rgb(225, 225, 220), false, Enum.Font.GothamBold)
		elseif roll < 0.56 then
			Dressing.chair(ctx, f * CFrame.new(random:NextNumber(-3, 3), 0, -2.5) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0), rgb(70, 90, 110), true)
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		local i = roomIndex(ctx, block)
		if i == 1 then
			Dressing.operatingRoom(ctx, block, block[1])
			return
		elseif i == 2 then
			Dressing.morgue(ctx, block)
			return
		end
		local random = ctx.random
		for _, c in block do
			local sides = ctx.wallSides(c.x, c.z)
			if #sides > 0 then
				local f = ctx.sideFrame(c.x, c.z, sides[random:NextInteger(1, #sides)])
				local bed = f * CFrame.new(random:NextNumber(-1.5, 1.5), 0, -3.8) * CFrame.Angles(0, math.rad(180), 0)
				wardBed(ctx, bed * CFrame.new(0, -1.2, 0))
				-- privacy curtain beside the bed
				local curtain = deco(ctx, "Curtain", Vector3.new(0.1, 7.5, 5.5), bed * CFrame.new(2.6, 4.5, 0), Enum.Material.Fabric, rgb(170, 195, 190))
				curtain.Transparency = 0.25
				-- heart monitor flatlining (the only green in the ward)
				local monitor = solid(ctx, "Monitor", Vector3.new(1.4, 1.1, 0.8), bed * CFrame.new(-2.4, 4.2, -3), Enum.Material.SmoothPlastic, rgb(30, 30, 32))
				ctx.sign(monitor.CFrame * CFrame.new(0, 0, 0.41) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(1.2, 0.8), "_____", rgb(60, 255, 120), rgb(5, 20, 10), true, Enum.Font.Code)
				solid(ctx, "MonitorStand", Vector3.new(0.6, 3.6, 0.6), bed * CFrame.new(-2.4, 1.8, -3), Enum.Material.Metal, rgb(120, 120, 120))
			end
		end
	end,
	hub = function(ctx: Ctx)
		local hub = ctx.layout.hub
		local O = ctx.hubOrigin
		local C = ctx.C
		local W = hub.w * C
		-- nurse station near the west wall, waiting chairs on the east
		solid(ctx, "Counter", Vector3.new(2.2, 3.6, 9), CFrame.new(O + Vector3.new(6, 1.8, C * 1.4)), Enum.Material.Marble, rgb(200, 196, 190))
		solid(ctx, "Counter", Vector3.new(6, 3.6, 2.2), CFrame.new(O + Vector3.new(8.9, 1.8, C * 1.4 - 3.4)), Enum.Material.Marble, rgb(200, 196, 190))
		solid(ctx, "Monitor", Vector3.new(1.6, 1.2, 0.3), CFrame.new(O + Vector3.new(7, 4.2, C * 1.4)) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.SmoothPlastic, rgb(25, 25, 28))
		for i = 0, 3 do
			local p = O + Vector3.new(W - 2.2, 0, 4 + i * 2.6)
			solid(ctx, "WaitingChair", Vector3.new(2, 0.4, 2), CFrame.new(p + Vector3.new(0, 1.7, 0)), Enum.Material.Plastic, rgb(70, 90, 110))
			solid(ctx, "WaitingChairBack", Vector3.new(0.3, 2.2, 2), CFrame.new(p + Vector3.new(0.9, 2.8, 0)), Enum.Material.Plastic, rgb(70, 90, 110))
		end
		local walls = hubWalls(ctx)
		for i = 1, 2 do
			local w = walls[(i * 3) % #walls + 1]
			ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2))
		end
		for i, w in walls do
			if i % 2 == 0 then
				ctx.sign(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 7.5, -0.08), Vector2.new(4, 1), WARD_SIGNS[i % #WARD_SIGNS + 1], rgb(20, 20, 20), rgb(225, 225, 220), false, Enum.Font.GothamBold)
			end
		end
		-- the clock stopped at 3:33
		local w = walls[1]
		ctx.sign(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(2.5, 9, -0.08), Vector2.new(2, 1), "3:33", rgb(255, 60, 50), rgb(10, 10, 10), true, Enum.Font.Code)
		-- glowing EXIT sign above the doors, facing in
		local e = ctx.layout.exitCell
		ctx.sign(ctx.sideFrame(e.x, e.z, "S") * CFrame.new(0, ctx.exitHeight + 1.1, -0.15), Vector2.new(4, 1.2), "EXIT", rgb(230, 255, 230), rgb(20, 160, 60), true, Enum.Font.GothamBlack)
	end,
	extra = function(ctx: Ctx)
		-- plastic strip curtains hanging across some of the corridors: you see shapes through them
		local rooms: { [string]: boolean } = {}
		for _, block in ctx.layout.roomBlocks do
			for _, c in block do
				rooms[Maze.key(c.x, c.z)] = true
			end
		end
		local C, H = ctx.C, ctx.H
		for _, e in Dressing.openEdges(ctx, rooms) do
			if ctx.random:NextNumber() < 0.1 then
				local frame = ctx.edgeFrame(e.x, e.z, e.dir)
				deco(ctx, "CurtainRail", Vector3.new(C - 1, 0.3, 0.3), frame * CFrame.new(0, H - 1.2, 0), Enum.Material.Metal, rgb(150, 150, 150))
				local n = 12
				for i = 0, n - 1 do
					local strip = deco(ctx, "PlasticStrip", Vector3.new((C - 1) / n + 0.15, H - 1.6, 0.05), frame * CFrame.new(-(C - 1) / 2 + (i + 0.5) * (C - 1) / n, (H - 1.6) / 2 + 0.2, (i % 2) * 0.06) * CFrame.Angles(0, 0, ctx.random:NextNumber(-0.03, 0.03)), Enum.Material.Glass, rgb(210, 225, 220))
					strip.Transparency = 0.55
					strip.CastShadow = false
				end
			end
		end
	end,
	spawns = hallSpawns,
}

---------------------------------------------------------------------------
-- NIGHT 3: THE DROWNED TUNNELS

local function cagedLamp(ctx: Ctx, cell: Cell?, position: Vector3, powered: boolean)
	local H = ctx.ceiling
	local y = H - 1.2
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(1, 1, 1), CFrame.new(position.X, y, position.Z), Enum.Material.Neon, if powered then rgb(200, 255, 220) else rgb(40, 46, 42), Enum.PartType.Ball))
	bulb.CastShadow = false
	for a = 0, 3 do
		ctx.decor(ctx.part(ctx.lights, "Cage", Vector3.new(0.08, 1.5, 0.08), CFrame.new(position.X, y, position.Z) * CFrame.Angles(0, a * math.pi / 2, 0) * CFrame.new(0.6, 0, 0), Enum.Material.Metal, rgb(60, 60, 60), nil))
	end
	ctx.decor(ctx.part(ctx.lights, "Mount", Vector3.new(0.3, 0.9, 0.3), CFrame.new(position.X, H - 0.45, position.Z), Enum.Material.Metal, rgb(50, 50, 50), nil))
	local light = Instance.new("PointLight")
	light.Range = 20
	light.Brightness = if powered then 0.7 else 1.4
	light.Color = ctx.night.lighting.LampColor
	light.Shadows = true
	light.Enabled = powered
	light.Parent = bulb
	bulb:SetAttribute("Buzz", ctx.random:NextNumber() < 0.5)
	bulb:SetAttribute("OnColor", rgb(200, 255, 220))
	ctx.addLamp(bulb, light, cell)
end

Themes.sewer = {
	wall = { material = Enum.Material.Brick, color = rgb(72, 74, 68) },
	hubWall = { material = Enum.Material.Concrete, color = rgb(96, 98, 94) },
	floor = { material = Enum.Material.Concrete, color = rgb(52, 56, 54) },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.DiamondPlate, color = rgb(80, 82, 80) }
	end,
	ceiling = { material = Enum.Material.Concrete, color = rgb(38, 40, 38) },
	hubCeiling = { material = Enum.Material.Concrete, color = rgb(46, 48, 46) },
	trim = { material = Enum.Material.CorrodedMetal, color = rgb(90, 80, 70) },
	tunnel = { material = Enum.Material.Concrete, color = rgb(96, 98, 94) },
	locker = { material = Enum.Material.CorrodedMetal, color = rgb(92, 80, 70) },
	columns = false,
	writings = {
		"SHH", "PETE?", "DON'T", "IIII IIII IIII", "IT LISTENS", "HERE", "DEEPER", "NO",
	},
	writingColor = rgb(190, 196, 186),
	writingFont = Enum.Font.PermanentMarker,
	writingGlow = false,
	exitStyle = "lift",
	lamp = function(ctx: Ctx, cell: Cell?, position: Vector3)
		cagedLamp(ctx, cell, position, false)
	end,
	hubLamps = function(ctx: Ctx)
		local hub = ctx.layout.hub
		for rx = 0, hub.w - 1, 2 do
			cagedLamp(ctx, nil, ctx.cellCenter(hub.x0 + rx, hub.z0), true)
		end
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C, H, T = ctx.C, ctx.H, ctx.T
		local center = ctx.cellCenter(x, z)
		-- ankle-deep water everywhere
		local water = deco(ctx, "Water", Vector3.new(C, 0.25, C), CFrame.new(center + Vector3.new(0, 0.12, 0)), Enum.Material.Glass, if info.room then rgb(16, 32, 28) else rgb(30, 52, 46))
		water.Transparency = 0.35
		water.Reflectance = 0.3
		water.CastShadow = false
		local sides = ctx.wallSides(x, z)
		local axis = Dressing.straightAxis(ctx, x, z)
		if axis and not info.room then
			-- a deeper channel down the middle, with kerbs, and brick ribs across the roof
			local along = if axis == "NS" then CFrame.new() else CFrame.Angles(0, math.rad(90), 0)
			local base = CFrame.new(center) * along
			local channel = deco(ctx, "Channel", Vector3.new(3.4, 0.06, C), base * CFrame.new(0, 0.28, 0), Enum.Material.Glass, rgb(8, 18, 16))
			channel.Reflectance = 0.5
			channel.CastShadow = false
			for _, sx in { -1, 1 } do
				deco(ctx, "Kerb", Vector3.new(0.5, 0.45, C), base * CFrame.new(sx * 1.95, 0.22, 0), Enum.Material.Concrete, rgb(70, 74, 70))
			end
			deco(ctx, "Rib", Vector3.new(C - T, 1.1, 1.3), base * CFrame.new(0, H - 0.55, 0), Enum.Material.Brick, rgb(78, 70, 62))
			for _, sx in { -1, 1 } do
				deco(ctx, "RibFoot", Vector3.new(0.9, H - 1.1, 1.3), base * CFrame.new(sx * (C - T) / 2, (H - 1.1) / 2, 0), Enum.Material.Brick, rgb(78, 70, 62))
			end
		end
		-- glowing algae: the only light you'll get before the power's back
		if not info.room and #sides > 0 and random:NextNumber() < 0.14 then
			local f = ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)])
			local anchor: BasePart? = nil
			for i = 1, random:NextInteger(3, 6) do
				local s = random:NextNumber(0.5, 1.4)
				local patch = Dressing.egg(deco(ctx, "Algae", Vector3.new(s, s * random:NextNumber(0.5, 1), 0.12), f * CFrame.new(random:NextNumber(-3.5, 3.5), random:NextNumber(0.6, 3.5), -0.05), Enum.Material.Neon, rgb(30, 105, 85)))
				patch.CastShadow = false
				if i == 1 then
					anchor = patch
				end
			end
			if anchor then
				local glow = Instance.new("PointLight")
				glow.Range = 13
				glow.Brightness = 0.6
				glow.Color = rgb(90, 255, 200)
				glow.Shadows = false
				glow.Parent = anchor
				CollectionService:AddTag(anchor, "Algae")
			end
		end
		if #sides > 0 and not info.spot and random:NextNumber() < 0.05 then
			Dressing.ladder(ctx, ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)]), H, rgb(100, 70, 50))
		end
		if random:NextNumber() < 0.09 then
			for _ = 1, random:NextInteger(1, 3) do
				Dressing.rat(ctx, CFrame.new(center + Vector3.new(random:NextNumber(-4.5, 4.5), 0.25, random:NextNumber(-4.5, 4.5))) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0))
			end
		end
		if #sides > 0 and random:NextNumber() < 0.55 then
			local f = ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)])
			deco(ctx, "Pipe", Vector3.new(C - T, 1.4, 1.4), f * CFrame.new(0, H - 1.6, -0.9), Enum.Material.CorrodedMetal, ctx.vary(rgb(90, 70, 55), 0.2), Enum.PartType.Cylinder)
			if random:NextNumber() < 0.4 then
				local low = f * CFrame.new(0, 2.6, -0.5)
				deco(ctx, "Pipe", Vector3.new(C - T, 0.6, 0.6), low, Enum.Material.Metal, ctx.vary(rgb(80, 84, 80), 0.2), Enum.PartType.Cylinder)
				deco(ctx, "Valve", Vector3.new(0.15, 1.4, 1.4), low * CFrame.new(random:NextNumber(-2, 2), 0, -0.5) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Metal, rgb(130, 30, 25), Enum.PartType.Cylinder)
			end
		end
		if random:NextNumber() < 0.25 then
			local along = if random:NextNumber() < 0.5 then CFrame.new() else CFrame.Angles(0, math.rad(90), 0)
			deco(ctx, "CeilingPipe", Vector3.new(C, 1, 1), CFrame.new(center + Vector3.new(random:NextNumber(-3, 3), H - 0.8, 0)) * along, Enum.Material.CorrodedMetal, ctx.vary(rgb(80, 66, 52), 0.2), Enum.PartType.Cylinder)
		end
		if #sides > 0 and random:NextNumber() < 0.12 then
			local f = ctx.sideFrame(x, z, sides[1])
			deco(ctx, "GrateHole", Vector3.new(3, 2, 0.1), f * CFrame.new(1, 1.4, -0.06), Enum.Material.SmoothPlastic, rgb(5, 5, 5))
			for i = 0, 5 do
				deco(ctx, "GrateBar", Vector3.new(0.12, 2.1, 0.15), f * CFrame.new(-0.25 + i * 0.5, 1.4, -0.12), Enum.Material.Metal, rgb(70, 70, 70))
			end
		end
		if not info.spot and random:NextNumber() < 0.08 then
			solid(ctx, "Drum", Vector3.new(3.4, 2.2, 2.2), CFrame.new(center + Vector3.new(random:NextNumber(-3.5, 3.5), 1.7, random:NextNumber(-3.5, 3.5))) * UP, Enum.Material.CorrodedMetal, ctx.vary(rgb(110, 60, 40), 0.25), Enum.PartType.Cylinder)
		end
		if random:NextNumber() < 0.08 then
			local top = center + Vector3.new(random:NextNumber(-3, 3), H, random:NextNumber(-3, 3))
			for i = 1, 10 do
				deco(ctx, "Chain", Vector3.new(0.25, 0.45, 0.12), CFrame.new(top - Vector3.new(0, i * 0.42, 0)) * CFrame.Angles(0, (i % 2) * math.rad(90), 0), Enum.Material.Metal, rgb(90, 90, 90))
			end
		end
		if random:NextNumber() < 0.15 then
			local drip = deco(ctx, "Drip", Vector3.new(0.2, 0.2, 0.2), CFrame.new(center + Vector3.new(random:NextNumber(-4, 4), H - 0.2, random:NextNumber(-4, 4))), Enum.Material.SmoothPlastic, rgb(0, 0, 0))
			drip.Transparency = 1
			CollectionService:AddTag(drip, "Drip")
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		if roomIndex(ctx, block) == 1 then
			Dressing.pumpRoom(ctx, block)
		else
			Dressing.cistern(ctx, block)
		end
		-- an outflow pipe pouring into the flooded chamber
		local c = block[1]
		local sides = ctx.wallSides(c.x, c.z)
		if #sides > 0 then
			local f = ctx.sideFrame(c.x, c.z, sides[1])
			deco(ctx, "Outflow", Vector3.new(3, 4, 4), f * CFrame.new(0, 6, -1) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.CorrodedMetal, rgb(80, 66, 52), Enum.PartType.Cylinder)
			local fall = deco(ctx, "Waterfall", Vector3.new(2.6, 5, 0.6), f * CFrame.new(0, 2.5, -2.2), Enum.Material.Glass, rgb(60, 90, 80))
			fall.Transparency = 0.5
			fall.CastShadow = false
		end
	end,
	hub = function(ctx: Ctx)
		local O = ctx.hubOrigin
		local hub = ctx.layout.hub
		local C = ctx.C
		local W = hub.w * C
		for i = 0, 1 do
			solid(ctx, "Pump", Vector3.new(6, 3.2, 3.2), CFrame.new(O + Vector3.new(3.5, 2.2, 6 + i * 9)) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Metal, rgb(70, 90, 80), Enum.PartType.Cylinder)
		end
		local panel = solid(ctx, "Panel", Vector3.new(5, 4.5, 1), CFrame.new(O + Vector3.new(W - 1.2, 2.25, C * 1.5)) * CFrame.Angles(0, math.rad(-90), 0), Enum.Material.Metal, rgb(70, 72, 70))
		local screen = ctx.sign(panel.CFrame * CFrame.new(0, 0.6, -0.55), Vector2.new(4, 2), "MAIN POWER\nOFFLINE", rgb(255, 80, 60), rgb(10, 10, 10), true, Enum.Font.Code)
		screen.Name = "PowerPanel"
		local walls = hubWalls(ctx)
		local w = walls[1]
		ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2))
		local e = ctx.layout.exitCell
		ctx.sign(ctx.sideFrame(e.x, e.z, "S") * CFrame.new(0, ctx.exitHeight + 1, -0.15), Vector2.new(5, 1.1), "SERVICE LIFT", rgb(255, 210, 60), rgb(25, 25, 20), true, Enum.Font.GothamBlack)
	end,
	extra = noop,
	spawns = hallSpawns,
}

---------------------------------------------------------------------------
-- NIGHT 4: THE ATRIUM

local function lampPost(ctx: Ctx, cell: Cell?, position: Vector3)
	local C = ctx.C
	local p = position + Vector3.new(C * 0.28, 0, C * 0.28)
	solid(ctx, "PostBase", Vector3.new(1.6, 1, 1.6), CFrame.new(p + Vector3.new(0, 0.5, 0)), Enum.Material.Marble, rgb(200, 200, 196))
	solid(ctx, "Post", Vector3.new(13, 0.5, 0.5), CFrame.new(p + Vector3.new(0, 7, 0)) * UP, Enum.Material.Metal, rgb(40, 42, 46), Enum.PartType.Cylinder)
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(1.8, 1.8, 1.8), CFrame.new(p + Vector3.new(0, 14, 0)), Enum.Material.Neon, rgb(225, 235, 255), Enum.PartType.Ball))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 48
	light.Brightness = ctx.random:NextNumber(1, 1.4)
	light.Color = ctx.night.lighting.LampColor
	light.Shadows = true
	light.Parent = bulb
	ctx.addLamp(bulb, light, cell)
end

local function bust(ctx: Ctx, at: CFrame)
	solid(ctx, "Plinth", Vector3.new(2.2, 4, 2.2), at * CFrame.new(0, 2, 0), Enum.Material.Marble, rgb(210, 210, 206))
	local marble = Enum.Material.Marble
	solid(ctx, "Shoulders", Vector3.new(1.8, 0.9, 1), at * CFrame.new(0, 4.45, 0), marble, rgb(232, 232, 228))
	local head = solid(ctx, "BustHead", Vector3.new(0.95, 1.2, 1), at * CFrame.new(0, 5.4, 0) * CFrame.Angles(0, ctx.random:NextNumber(-1, 1), 0), marble, rgb(232, 232, 228))
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = head
end

Themes.atrium = {
	wall = { material = Enum.Material.Marble, color = rgb(218, 218, 214) },
	hubWall = { material = Enum.Material.Marble, color = rgb(205, 205, 200) },
	floor = { material = Enum.Material.Marble, color = rgb(228, 228, 224), reflect = 0.12 },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.Marble, color = rgb(200, 196, 188), reflect = 0.1 }
	end,
	ceiling = { material = Enum.Material.Slate, color = rgb(36, 38, 44) },
	hubCeiling = { material = Enum.Material.Slate, color = rgb(36, 38, 44) },
	trim = { material = Enum.Material.Marble, color = rgb(240, 240, 236) },
	tunnel = { material = Enum.Material.Marble, color = rgb(205, 205, 200) },
	locker = { material = Enum.Material.Wood, color = rgb(90, 66, 44) },
	columns = true,
	writings = {
		"DON'T BLINK", "WHICH ONE", "IT MOVED", "IIII IIII", "STILL", "LOOK", "NEVER STONE",
	},
	writingColor = rgb(60, 62, 70),
	writingFont = Enum.Font.PermanentMarker,
	writingGlow = false,
	exitStyle = "grand",
	lamp = lampPost,
	hubLamps = function(ctx: Ctx)
		hubCellLamps(ctx, Themes.atrium)
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C = ctx.C
		local center = ctx.cellCenter(x, z)
		if not info.spot then
			local roll = random:NextNumber()
			local spot = CFrame.new(center + Vector3.new(random:NextNumber(-C * 0.3, C * 0.3), 0, random:NextNumber(-C * 0.3, C * 0.3))) * CFrame.Angles(0, random:NextInteger(0, 3) * math.pi / 2, 0)
			if roll < 0.12 then
				solid(ctx, "Bench", Vector3.new(6, 0.6, 2), spot * CFrame.new(0, 1.6, 0), Enum.Material.Marble, rgb(215, 215, 210))
				for _, sx in { -2.4, 2.4 } do
					solid(ctx, "BenchLeg", Vector3.new(0.8, 1.3, 1.8), spot * CFrame.new(sx, 0.65, 0), Enum.Material.Marble, rgb(200, 200, 196))
				end
			elseif roll < 0.22 then
				bust(ctx, spot)
			elseif roll < 0.28 then
				for i = 0, 2 do
					solid(ctx, "Stanchion", Vector3.new(3.2, 0.3, 0.3), spot * CFrame.new(i * 3 - 3, 1.6, 0) * UP, Enum.Material.Metal, rgb(180, 150, 70), Enum.PartType.Cylinder)
					if i < 2 then
						deco(ctx, "Rope", Vector3.new(3, 0.2, 0.2), spot * CFrame.new(i * 3 - 1.5, 2.8, 0), Enum.Material.Fabric, rgb(120, 20, 25), Enum.PartType.Cylinder)
					end
				end
			elseif roll < 0.34 then
				solid(ctx, "Planter", Vector3.new(2.6, 2.4, 2.6), spot * CFrame.new(0, 1.2, 0), Enum.Material.Marble, rgb(190, 190, 186))
				deco(ctx, "Trunk", Vector3.new(6, 0.5, 0.5), spot * CFrame.new(0, 5, 0) * UP, Enum.Material.Wood, rgb(50, 44, 40), Enum.PartType.Cylinder)
				for _ = 1, 4 do
					deco(ctx, "Branch", Vector3.new(0.2, 3, 0.2), spot * CFrame.new(0, 7.5, 0) * CFrame.Angles(random:NextNumber(-0.8, 0.8), random:NextNumber(0, 6), random:NextNumber(-0.8, 0.8)) * CFrame.new(0, 1.4, 0), Enum.Material.Wood, rgb(50, 44, 40))
				end
			end
		end
		-- huge empty frames on the partition walls
		for _, side in ctx.wallSides(x, z) do
			if random:NextNumber() < 0.25 then
				local f = ctx.sideFrame(x, z, side)
				solid(ctx, "GiltFrame", Vector3.new(9, 7, 0.4), f * CFrame.new(0, 7.5, -0.2), Enum.Material.Wood, rgb(150, 115, 55))
				deco(ctx, "EmptyCanvas", Vector3.new(8, 6, 0.1), f * CFrame.new(0, 7.5, -0.42), Enum.Material.SmoothPlastic, rgb(12, 12, 14))
			end
		end
	end,
	room = noop,
	hub = function(ctx: Ctx)
		local O = ctx.hubOrigin
		local C = ctx.C
		solid(ctx, "TicketBooth", Vector3.new(7, 5, 4), CFrame.new(O + Vector3.new(6, 2.5, C * 1.3)), Enum.Material.Wood, rgb(80, 60, 45))
		local walls = hubWalls(ctx)
		local w = walls[1]
		ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2))
		local w2 = walls[math.min(3, #walls)]
		ctx.sign(ctx.sideFrame(w2.cell.x, w2.cell.z, w2.side) * CFrame.new(0, 8, -0.1), Vector2.new(10, 3), "THE ATRIUM\nPLEASE DO NOT TOUCH THE EXHIBITS", rgb(40, 40, 46), rgb(220, 218, 210), false, Enum.Font.Fondamento)
	end,
	extra = function(ctx: Ctx)
		local layout = ctx.layout
		-- moonlight falling through skylights, spread across the hall
		local shafts: { Vector3 } = {}
		for _ = 1, 40 do
			if #shafts >= 6 then
				break
			end
			local c = ctx.cellCenter(ctx.random:NextInteger(0, layout.width - 1), ctx.random:NextInteger(0, layout.depth - 1))
			local ok = true
			for _, other in shafts do
				if (other - c).Magnitude < ctx.C * 2.5 then
					ok = false
				end
			end
			if ok then
				table.insert(shafts, c)
				Dressing.moonShaft(ctx, c + Vector3.new(ctx.C * 0.25, 0, -ctx.C * 0.25))
			end
		end
		-- the far end: a sealed pair of giant doors up a short flight of steps
		local gx = math.floor(layout.width / 2)
		local gz = layout.depth - 1
		local gate = ctx.sideFrame(gx, gz, "N")
		for i = 0, 2 do
			solid(ctx, "Step", Vector3.new(14 - i * 2, 0.6, 3 - i * 0.6), gate * CFrame.new(0, 0.3 + i * 0.6, -1.5 - (2 - i) * 0.6), Enum.Material.Marble, rgb(215, 215, 210))
		end
		solid(ctx, "GreatDoor", Vector3.new(10, 15, 0.6), gate * CFrame.new(0, 9, -0.3), Enum.Material.Wood, rgb(60, 42, 30))
		deco(ctx, "DoorSeam", Vector3.new(0.15, 15, 0.1), gate * CFrame.new(0, 9, -0.65), Enum.Material.SmoothPlastic, rgb(10, 8, 6))
		for _, sx in { -1, 1 } do
			deco(ctx, "DoorRing", Vector3.new(0.2, 1.2, 1.2), gate * CFrame.new(sx * 1.2, 8, -0.7) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Metal, rgb(170, 140, 70), Enum.PartType.Cylinder)
			solid(ctx, "DoorColumn", Vector3.new(1.6, 17, 1.6), gate * CFrame.new(sx * 6, 8.5, -0.8), Enum.Material.Marble, rgb(225, 225, 220))
		end
		ctx.sign(gate * CFrame.new(0, 17.6, -0.4), Vector2.new(10, 1.6), "THE COLLECTION IS CLOSED", rgb(40, 40, 46), rgb(214, 210, 200), false, Enum.Font.Fondamento)
		-- decoy statues: some of these are just statues
		local spots: { [string]: boolean } = {}
		for _, s in layout.spots do
			spots[Maze.key(s.x, s.z)] = true
		end
		local placed = 0
		local tries = 0
		while placed < 8 and tries < 80 do
			tries += 1
			local x = ctx.random:NextInteger(0, layout.width - 1)
			local z = ctx.random:NextInteger(0, layout.depth - 1)
			local k = Maze.key(x, z)
			if not Maze.isHub(layout, x, z) and not spots[k] and (math.abs(x - layout.entrance.x) + math.abs(z - layout.entrance.z)) > 1 then
				spots[k] = true
				placed += 1
				-- a mix of both kinds, so you can't tell the real one by its shape
				local variant = Monsters.STATUE_VARIANTS[ctx.random:NextInteger(1, #Monsters.STATUE_VARIANTS)]
				local rig = Monsters.build("Statue", { preview = true, decoy = true, variant = variant })
				Monsters.applyStatuePose(rig, ctx.random:NextInteger(1, #Monsters.STATUE_POSES), nil)
				local center = ctx.cellCenter(x, z)
				rig.model:PivotTo(CFrame.new(center + Vector3.new(ctx.random:NextNumber(-3, 3), rig.rootHeight, ctx.random:NextNumber(-3, 3))) * CFrame.Angles(0, ctx.random:NextNumber(0, 6.28), 0))
				Monsters.solve(rig)
				rig.model.Name = "Statue"
				rig.model.Parent = ctx.props
				local blocker = ctx.part(ctx.props, "StatueBase", Vector3.new(2.6, 8, 2.4), rig.root.CFrame * CFrame.new(0, -0.4, 0), Enum.Material.Marble, rgb(200, 200, 196), nil)
				blocker.Transparency = 1
			end
		end
	end,
	spawns = hallSpawns,
}

---------------------------------------------------------------------------
-- NIGHT 5: THE VOID

-- dim veins: the Void is dark now; only the monster glows properly
local VEIN_COLORS = { rgb(70, 26, 110), rgb(90, 30, 90), rgb(56, 30, 110) }

local function crystalLamp(ctx: Ctx, cell: Cell?, position: Vector3)
	local random = ctx.random
	local C = ctx.C
	local base = position + Vector3.new(random:NextNumber(-C * 0.32, C * 0.32), 0, random:NextNumber(-C * 0.32, C * 0.32))
	for _ = 1, 3 do
		local h = random:NextNumber(2.5, 5)
		local shard = deco(ctx, "Crystal", Vector3.new(0.7, h, 0.7), CFrame.new(base + Vector3.new(random:NextNumber(-0.8, 0.8), h / 2 - 0.3, random:NextNumber(-0.8, 0.8))) * CFrame.Angles(random:NextNumber(-0.35, 0.35), random:NextNumber(0, 6), random:NextNumber(-0.35, 0.35)), Enum.Material.Glass, rgb(34, 20, 52))
		shard.Transparency = 0.15
		shard.Reflectance = 0.2
	end
	-- a faint ember inside the cluster
	local bulb = ctx.decor(ctx.part(ctx.lights, "CrystalCore", Vector3.new(0.5, 0.5, 0.5), CFrame.new(base + Vector3.new(0, 1, 0)), Enum.Material.Neon, rgb(110, 50, 170), Enum.PartType.Ball))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 16
	light.Brightness = random:NextNumber(0.5, 0.8)
	light.Color = ctx.night.lighting.LampColor
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("Pulse", true)
	ctx.addLamp(bulb, light, cell)
end

Themes.void = {
	wall = { material = Enum.Material.Basalt, color = rgb(68, 60, 84) },
	hubWall = { material = Enum.Material.Basalt, color = rgb(76, 66, 94) },
	floor = { material = Enum.Material.Glass, color = rgb(30, 26, 40), reflect = 0.3 },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.Glass, color = rgb(34, 28, 46), reflect = 0.4 }
	end,
	ceiling = { material = Enum.Material.SmoothPlastic, color = rgb(0, 0, 0) },
	hubCeiling = { material = Enum.Material.SmoothPlastic, color = rgb(0, 0, 0) },
	trim = { material = Enum.Material.Basalt, color = rgb(44, 36, 56) },
	tunnel = { material = Enum.Material.Basalt, color = rgb(48, 40, 60) },
	locker = { material = Enum.Material.Basalt, color = rgb(50, 42, 62) },
	columns = false,
	writings = {
		"WAKE UP", "YOU CAME BACK", "WE ARE STILL HERE", "IIII IIII IIII IIII", "NO MORNING", "COLOR", "ALL OF THEM",
	},
	writingColor = rgb(170, 110, 220),
	writingFont = Enum.Font.PermanentMarker,
	writingGlow = false,
	exitStyle = "portal",
	lamp = crystalLamp,
	hubLamps = function(ctx: Ctx)
		local hub = ctx.layout.hub
		crystalLamp(ctx, nil, ctx.cellCenter(hub.x0, hub.z0 + 1))
		crystalLamp(ctx, nil, ctx.cellCenter(hub.x0 + hub.w - 1, hub.z0 + 1))
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C, H = ctx.C, ctx.H
		local center = ctx.cellCenter(x, z)
		for _, side in ctx.wallSides(x, z) do
			if random:NextNumber() < 0.1 then
				local f = ctx.sideFrame(x, z, side)
				local vein = deco(ctx, "Vein", Vector3.new(0.14, random:NextNumber(3, 8), 0.05), f * CFrame.new(random:NextNumber(-C * 0.4, C * 0.4), random:NextNumber(2, H - 3), -0.04) * CFrame.Angles(0, 0, random:NextNumber(-0.7, 0.7)), Enum.Material.Neon, VEIN_COLORS[random:NextInteger(1, #VEIN_COLORS)])
				vein.CastShadow = false
			end
		end
		-- black spikes hanging from far above
		if random:NextNumber() < 0.12 then
			for _ = 1, random:NextInteger(1, 3) do
				local len = random:NextNumber(6, 16)
				Dressing.egg(deco(ctx, "Spike", Vector3.new(1.2, len * 2, 1.2), CFrame.new(center + Vector3.new(random:NextNumber(-C / 2.5, C / 2.5), ctx.ceiling, random:NextNumber(-C / 2.5, C / 2.5))), Enum.Material.Basalt, rgb(14, 10, 18)))
			end
		end
		-- pieces of the other nights, drifting
		if not info.spot and random:NextNumber() < 0.1 then
			Dressing.floatingMemory(ctx, center + Vector3.new(random:NextNumber(-3, 3), random:NextNumber(5, 12), random:NextNumber(-3, 3)))
		end
		if random:NextNumber() < 0.25 then
			for _ = 1, random:NextInteger(1, 3) do
				local s = random:NextNumber(1.5, 4.5)
				local rock = deco(ctx, "FloatingRock", Vector3.new(s, s * random:NextNumber(0.6, 1.4), s * random:NextNumber(0.7, 1.3)), CFrame.new(center + Vector3.new(random:NextNumber(-C / 2, C / 2), H + random:NextNumber(3, 18), random:NextNumber(-C / 2, C / 2))) * CFrame.Angles(random:NextNumber(0, 6), random:NextNumber(0, 6), random:NextNumber(0, 6)), Enum.Material.Basalt, rgb(22, 18, 30))
				CollectionService:AddTag(rock, "Float")
			end
		end
		local sides = ctx.wallSides(x, z)
		if #sides > 0 and random:NextNumber() < 0.09 then
			-- something is looking out of the wall
			local f = ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)])
			local eyes = f * CFrame.new(random:NextNumber(-2, 2), random:NextNumber(4, 8), 0)
			for _, sx in { -0.5, 0.5 } do
				local eye = deco(ctx, "WallEye", Vector3.new(0.45, 0.45, 0.45), eyes * CFrame.new(sx, 0, -0.05), Enum.Material.Neon, rgb(240, 230, 255), Enum.PartType.Ball)
				CollectionService:AddTag(eye, "WallEye")
				deco(ctx, "Pupil", Vector3.new(0.18, 0.18, 0.1), eyes * CFrame.new(sx, 0, -0.27), Enum.Material.SmoothPlastic, rgb(0, 0, 0))
			end
		end
		if not info.spot and random:NextNumber() < 0.06 then
			local m = solid(ctx, "Monolith", Vector3.new(2.4, 9, 1), CFrame.new(center + Vector3.new(random:NextNumber(-3, 3), 4.5, random:NextNumber(-3, 3))) * CFrame.Angles(0, random:NextNumber(0, 6), random:NextNumber(-0.1, 0.1)), Enum.Material.Basalt, rgb(10, 8, 14))
			ctx.sign(m.CFrame * CFrame.new(0, 1, -0.55), Vector2.new(2, 5), "◇\n△\n○", rgb(150, 90, 200), nil, false, Enum.Font.Code)
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		-- each room remembers one of the earlier nights
		Dressing.memoryRoom(ctx, block, (roomIndex(ctx, block) - 1) % 3 + 1, block[1])
		local center = Dressing.blockCenter(ctx, block)
		for i = 0, 3 do
			local a = i * math.pi / 2 + math.pi / 4
			local m = solid(ctx, "Monolith", Vector3.new(2, 10, 1), CFrame.new(center + Vector3.new(math.cos(a) * 9, 5, math.sin(a) * 9)) * CFrame.Angles(0, -a + math.pi / 2, 0), Enum.Material.Basalt, rgb(10, 8, 14))
			ctx.sign(m.CFrame * CFrame.new(0, 1.5, -0.55), Vector2.new(1.6, 6), "W\nA\nK\nE", rgb(150, 90, 200), nil, false, Enum.Font.Creepster)
		end
	end,
	hub = function(ctx: Ctx)
		local O = ctx.hubOrigin
		local hub = ctx.layout.hub
		local C = ctx.C
		local center = O + Vector3.new(hub.w * C / 2, 0, hub.d * C / 2 + 2)
		for i = 0, 7 do
			local a = i * math.pi / 4
			solid(ctx, "ThresholdPillar", Vector3.new(1.6, 12, 1.6), CFrame.new(center + Vector3.new(math.cos(a) * 13, 6, math.sin(a) * 13)), Enum.Material.Basalt, rgb(14, 10, 20))
		end
		local walls = hubWalls(ctx)
		local w = walls[1]
		ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2))
	end,
	extra = noop,
	spawns = hallSpawns,
}

return Themes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">Throwables</string>
          <string name="Source"><![CDATA[--!strict
-- Bottles lying around the map. Pick them up (you can carry 3) and throw one with G:
-- it smashes where it lands and the monster goes to look. Blind things hate this.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Interactables = require(script.Parent.Interactables)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes

local Throwables = {}

export type Hooks = {
	isAlive: (player: Player) -> boolean,
	onNoise: (position: Vector3, radius: number) -> (),
}

export type Throwables = { destroy: () -> () }

Throwables.MAX_CARRY = 3
Throwables.RANGE = 55
Throwables.NOISE = 120

local BOTTLE_COLORS = { Color3.fromRGB(40, 90, 50), Color3.fromRGB(90, 60, 30), Color3.fromRGB(150, 160, 160) }

local function bottleModel(world: WorldBuilder.World, parent: Instance, cf: CFrame, color: Color3): BasePart
	local ctx = world.ctx
	local body = ctx.part(parent, "Bottle", Vector3.new(1.0, 0.45, 0.45), cf * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Glass, color, Enum.PartType.Cylinder)
	body.Transparency = 0.15
	body.CanCollide = false
	body.CanTouch = false
	local neck = ctx.decor(ctx.part(body, "Neck", Vector3.new(0.45, 0.18, 0.18), body.CFrame * CFrame.new(0.65, 0, 0), Enum.Material.Glass, color, Enum.PartType.Cylinder))
	neck.Transparency = 0.15
	return body
end

-- Where a throw lands: along the look direction until it hits something, then down to the floor.
local function landingPoint(world: WorldBuilder.World, origin: Vector3, look: Vector3, range: number): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { world.model }
	local flatLook = Vector3.new(look.X, math.clamp(look.Y, -0.5, 0.4), look.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	end
	local dir = flatLook.Unit * range
	local hit = workspace:Raycast(origin, dir, params)
	local point = if hit then hit.Position - dir.Unit * 1.2 else origin + dir
	local down = workspace:Raycast(point + Vector3.new(0, 2, 0), Vector3.new(0, -40, 0), params)
	return if down then down.Position + Vector3.new(0, 0.2, 0) else Vector3.new(point.X, 0.2, point.Z)
end

function Throwables.new(layout: Maze.Layout, world: WorldBuilder.World, hooks: Hooks): Throwables
	local folder = Instance.new("Folder")
	folder.Name = "Bottles"
	folder.Parent = world.model
	local random = Random.new(layout.seed + 7)
	local connections: { RBXScriptConnection } = {}
	local destroyed = false

	-- scatter some bottles through the maze, away from objective spots and lockers
	local avoid: { [string]: boolean } = {}
	for _, s in layout.spots do
		avoid[Maze.key(s.x, s.z)] = true
	end
	for _, l in layout.lockers do
		avoid[Maze.key(l.x, l.z)] = true
	end
	local count = math.clamp(math.floor(layout.width * layout.depth / 16), 6, 12)
	local placed = 0
	local tries = 0
	while placed < count and tries < 200 do
		tries += 1
		local x, z = random:NextInteger(0, layout.width - 1), random:NextInteger(0, layout.depth - 1)
		local k = Maze.key(x, z)
		if not avoid[k] and not Maze.isHub(layout, x, z) then
			avoid[k] = true
			placed += 1
			local c = world.ctx.cellCenter(x, z)
			local cf = CFrame.new(c + Vector3.new(random:NextNumber(-3, 3), 0.23, random:NextNumber(-3, 3))) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0)
			local bottle = bottleModel(world, folder, cf, BOTTLE_COLORS[random:NextInteger(1, #BOTTLE_COLORS)])
			bottle.CanQuery = true
			local p = Interactables.prompt(bottle, "Pick up", "Bottle", 0, 7)
			p.Triggered:Connect(function(player: Player)
				if destroyed or not hooks.isAlive(player) or bottle.Parent == nil then
					return
				end
				local have = player:GetAttribute("Bottles")
				local n = if typeof(have) == "number" then have else 0
				if n >= Throwables.MAX_CARRY then
					Remotes.Notify:FireClient(player, "You can't carry any more.")
					return
				end
				player:SetAttribute("Bottles", n + 1)
				Audio.play("KeypadBeep", bottle, 0.4, 0.5, 30)
				bottle:Destroy()
			end)
		end
	end

	table.insert(connections, Remotes.Throw.OnServerEvent:Connect(function(player: Player, look: unknown)
		if destroyed or typeof(look) ~= "Vector3" or look.Magnitude < 0.5 or look.Magnitude > 2 then
			return
		end
		if not hooks.isAlive(player) or player:GetAttribute("Hiding") == true then
			return
		end
		local have = player:GetAttribute("Bottles")
		local n = if typeof(have) == "number" then have else 0
		if n <= 0 then
			return
		end
		local character = player.Character
		local head = if character then character:FindFirstChild("Head") :: BasePart? else nil
		if not head then
			return
		end
		player:SetAttribute("Bottles", n - 1)
		local dir = look.Unit
		local origin = head.Position + dir * 1.5
		local target = landingPoint(world, origin, dir, Throwables.RANGE)
		local bottle = bottleModel(world, folder, CFrame.new(origin), BOTTLE_COLORS[random:NextInteger(1, #BOTTLE_COLORS)])
		Audio.play("BottleWhoosh", bottle, 0.8, 1, 40)
		local flight = math.clamp((target - origin).Magnitude / 60, 0.25, 0.9)
		local arc = math.clamp((target - origin).Magnitude * 0.12, 1, 6)
		local start = os.clock()
		local spin = random:NextNumber(8, 14)
		local conn: RBXScriptConnection? = nil
		conn = RunService.Heartbeat:Connect(function()
			local a = math.clamp((os.clock() - start) / flight, 0, 1)
			local pos = origin:Lerp(target, a) + Vector3.new(0, math.sin(a * math.pi) * arc, 0)
			bottle.CFrame = CFrame.new(pos) * CFrame.Angles(a * spin, 0, a * spin * 0.5)
			if a >= 1 then
				if conn then
					conn:Disconnect()
				end
				bottle:Destroy()
				Audio.playAt("GlassShatter", target, 1.7, random:NextNumber(0.9, 1.1), 150)
				for _ = 1, 6 do
					local shard = world.ctx.part(folder, "Shard", Vector3.new(0.35, 0.05, 0.25), CFrame.new(target + Vector3.new(random:NextNumber(-1.2, 1.2), 0, random:NextNumber(-1.2, 1.2))) * CFrame.Angles(0, random:NextNumber(0, 6), 0), Enum.Material.Glass, Color3.fromRGB(120, 150, 130), nil)
					shard.CanCollide = false
					shard.CanQuery = false
					shard.Transparency = 0.2
					Debris:AddItem(shard, 12)
				end
				if not destroyed then
					hooks.onNoise(target, Throwables.NOISE)
				end
			end
		end)
		table.insert(connections, conn :: RBXScriptConnection)
	end))

	return {
		destroy = function()
			destroyed = true
			for _, c in connections do
				c:Disconnect()
			end
		end,
	}
end

return Throwables
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a Maze layout into a themed map: floors, walls, doorways, pillars/columns,
-- lamps, props, writing, the hub, and the exit tunnel. Interactive things (doors,
-- lockers, batteries, the exit, objective items) are added afterwards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Build = require(script.Parent.Build)
local Themes = require(script.Parent.Themes)

type Layout = Maze.Layout
type Style = Build.Style

export type World = {
	model: Model,
	ctx: Build.Ctx,
	theme: Themes.Theme,
	night: Nights.Night,
	spawnPoints: { CFrame },
	escapeZone: BasePart,
	exitLight: PointLight,
	exitFrame: CFrame, -- the exit edge; its Back face looks into the hub
	hiddenSpot: CFrame,
	lamps: { Build.Lamp },
	random: Random,
}

local WorldBuilder = {}

WorldBuilder.setupCollisionGroups = Build.setupCollisionGroups

local function buildEdges(ctx: Build.Ctx, theme: Themes.Theme)
	local layout = ctx.layout
	local W, D = layout.width, layout.depth
	local function styleOf(x: number, z: number): Style
		if Maze.inBounds(layout, x, z) and Maze.isHub(layout, x, z) then
			return theme.hubWall
		end
		return theme.wall
	end
	for z = -1, D - 1 do
		for x = -1, W - 1 do
			for _, dir in { "N", "E" } do
				local valid = if dir == "N" then (x >= 0 and x < W) else (z >= 0 and z < D)
				if valid then
					local kind = Maze.getEdge(layout, x, z, dir)
					local front = styleOf(x, z)
					local back = styleOf(x + Maze.DX[dir], z + Maze.DZ[dir])
					local frame = ctx.edgeFrame(x, z, dir)
					if kind == "wall" then
						Build.wallBox(ctx, ctx.structure, frame, ctx.C - ctx.T, ctx.H, 0, 0, front, back)
					elseif kind == "door" or kind == "doorway" then
						Build.wallWithOpening(ctx, ctx.structure, frame, ctx.doorWidth, ctx.doorHeight, front, back)
						Build.doorTrim(ctx, ctx.structure, frame, ctx.doorWidth, ctx.doorHeight, theme.trim)
					elseif kind == "exit" then
						Build.wallWithOpening(ctx, ctx.structure, frame, ctx.exitWidth, ctx.exitHeight, front, back)
						Build.doorTrim(ctx, ctx.structure, frame, ctx.exitWidth, ctx.exitHeight, theme.trim)
					elseif kind == "hole" then
						Build.brokenWall(ctx, ctx.structure, frame, front, back)
					end
				end
			end
		end
	end
end

local function buildPillars(ctx: Build.Ctx, theme: Themes.Theme)
	local layout = ctx.layout
	local W, D = layout.width, layout.depth
	local C, H, T = ctx.C, ctx.H, ctx.T
	for j = 0, D do
		for i = 0, W do
			if theme.columns then
				-- a colonnade: a column at every grid point, up to the far-away ceiling
				local top = ctx.ceiling
				ctx.part(ctx.structure, "Column", Vector3.new(top, 3.4, 3.4), CFrame.new(i * C, top / 2, j * C) * CFrame.Angles(0, 0, math.rad(90)), theme.trim.material, ctx.vary(theme.trim.color, 0.03), Enum.PartType.Cylinder)
				ctx.part(ctx.structure, "ColumnBase", Vector3.new(4.6, 1.4, 4.6), CFrame.new(i * C, 0.7, j * C), theme.wall.material, theme.wall.color, nil)
				ctx.part(ctx.structure, "ColumnCap", Vector3.new(4.6, 1.2, 4.6), CFrame.new(i * C, top - 0.6, j * C), theme.wall.material, theme.wall.color, nil)
			else
				local needed = false
				for _, ex in { i - 1, i } do
					if ex >= 0 and ex < W and Maze.getEdge(layout, ex, j - 1, "N") ~= "open" then
						needed = true
					end
				end
				for _, ez in { j - 1, j } do
					if ez >= 0 and ez < D and Maze.getEdge(layout, i - 1, ez, "E") ~= "open" then
						needed = true
					end
				end
				if needed then
					local hubCount = 0
					for _, c in { { i - 1, j - 1 }, { i, j - 1 }, { i - 1, j }, { i, j } } do
						if Maze.inBounds(layout, c[1], c[2]) and Maze.isHub(layout, c[1], c[2]) then
							hubCount += 1
						end
					end
					local style = if hubCount >= 2 then theme.hubWall else theme.wall
					ctx.part(ctx.structure, "Pillar", Vector3.new(T + 0.5, H, T + 0.5), CFrame.new(i * C, H / 2, j * C), style.material, ctx.vary(style.color, 0.1), nil)
				end
			end
		end
	end
end

local function buildExitTunnel(ctx: Build.Ctx, theme: Themes.Theme): (BasePart, PointLight)
	local layout = ctx.layout
	local x = (layout.exitCell.x + 0.5) * ctx.C
	local width = ctx.exitWidth + 2
	local height = math.min(ctx.H, ctx.exitHeight + 3)
	local length = 28
	local zMid = -length / 2
	ctx.styled(ctx.structure, "TunnelFloor", Vector3.new(width + 2, 1, length), CFrame.new(x, -0.5, zMid), theme.floor)
	ctx.styled(ctx.structure, "TunnelCeiling", Vector3.new(width + 2, 1, length), CFrame.new(x, height + 0.5, zMid), theme.ceiling)
	for _, sx in { -1, 1 } do
		ctx.styled(ctx.structure, "TunnelWall", Vector3.new(1, height, length), CFrame.new(x + sx * (width / 2 + 0.5), height / 2, zMid), theme.tunnel)
	end
	local glow = ctx.part(ctx.structure, "TheOutside", Vector3.new(width + 2, height, 0.5), CFrame.new(x, height / 2, -length), Enum.Material.Neon, Color3.new(1, 1, 1), nil)
	glow.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 45
	light.Brightness = 4
	light.Shadows = true
	light.Enabled = false -- switched on when the exit opens
	light.Parent = glow
	local zone = ctx.decor(ctx.part(ctx.structure, "EscapeZone", Vector3.new(width, 12, 2), CFrame.new(x, 6, -12), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), nil))
	zone.CanTouch = true
	zone.Transparency = 1
	return zone, light
end

function WorldBuilder.build(layout: Layout, night: Nights.Night): World
	Build.setupCollisionGroups()
	local model = Instance.new("Model")
	model.Name = "World"
	local ctx = Build.new(layout, night, model)
	local theme = Themes[night.theme] or Themes.house
	local C = ctx.C
	local W, D = layout.width, layout.depth

	ctx.styled(ctx.structure, "Floor", Vector3.new(W * C + 2, 1, D * C + 2), CFrame.new(W * C / 2, -0.5, D * C / 2), theme.floor)
	ctx.styled(ctx.structure, "Ceiling", Vector3.new(W * C + 2, 1, D * C + 2), CFrame.new(W * C / 2, ctx.ceiling + 0.5, D * C / 2), theme.ceiling)
	for key, room in layout.rooms do
		local xs, zs = string.match(key, "^(%-?%d+),(%-?%d+)$")
		local cx, cz = tonumber(xs) :: number, tonumber(zs) :: number
		ctx.styled(ctx.structure, "HubFloor", Vector3.new(C, 1, C), CFrame.new((cx + 0.5) * C, -0.45, (cz + 0.5) * C), theme.hubFloor(room))
		ctx.styled(ctx.structure, "HubCeiling", Vector3.new(C, 1, C), CFrame.new((cx + 0.5) * C, ctx.ceiling + 0.45, (cz + 0.5) * C), theme.hubCeiling)
	end

	buildEdges(ctx, theme)
	buildPillars(ctx, theme)

	for _, c in layout.lights do
		theme.lamp(ctx, c, ctx.cellCenter(c.x, c.z))
	end
	theme.hubLamps(ctx)

	local texts = table.clone(theme.writings)
	for i = #texts, 2, -1 do
		local j = ctx.random:NextInteger(1, i)
		texts[i], texts[j] = texts[j], texts[i]
	end
	for i, w in layout.writings do
		local frame = ctx.sideFrame(w.x, w.z, w.side) * CFrame.new(ctx.random:NextNumber(-1.2, 1.2), ctx.random:NextNumber(5, math.min(7, ctx.H - 3)), -0.1)
		ctx.writing(frame, texts[(i - 1) % #texts + 1], theme.writingColor, theme.writingFont, theme.writingGlow)
	end

	local spotCells: { [string]: boolean } = {}
	for _, s in layout.spots do
		spotCells[Maze.key(s.x, s.z)] = true
	end
	for _, l in layout.lockers do
		spotCells[Maze.key(l.x, l.z)] = true -- keep clutter out of locker cells too
	end
	local roomCells: { [string]: boolean } = {}
	for _, block in layout.roomBlocks do
		for _, c in block do
			roomCells[Maze.key(c.x, c.z)] = true
		end
	end
	for z = 0, D - 1 do
		for x = 0, W - 1 do
			if not Maze.isHub(layout, x, z) then
				local k = Maze.key(x, z)
				theme.cell(ctx, x, z, { spot = spotCells[k] == true, room = roomCells[k] == true })
			end
		end
	end
	for _, block in layout.roomBlocks do
		theme.room(ctx, block)
	end
	theme.hub(ctx)
	theme.extra(ctx)

	Build.markFurniture(ctx.props)
	Build.markFurniture(ctx.lights)
	local escapeZone, exitLight = buildExitTunnel(ctx, theme)
	local spawnPoints = theme.spawns(ctx)

	model.Parent = workspace

	return {
		model = model,
		ctx = ctx,
		theme = theme,
		night = night,
		spawnPoints = spawnPoints,
		escapeZone = escapeZone,
		exitLight = exitLight,
		exitFrame = ctx.edgeFrame(layout.exitCell.x, layout.exitCell.z - 1, "N"),
		hiddenSpot = CFrame.new(W * C / 2, -300, D * C / 2),
		lamps = ctx.lamps,
		random = ctx.random,
	}
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="47">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">14</token>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
    <Item class="SoundGroup" referent="48">
      <Properties>
        <string name="Name">AchromaMaster</string>
        <float name="Volume">1</float>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="49">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="50">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">0.5</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="51">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="52">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
-- The dread: fear level, heartbeat, camera shake, blur, each night's own background
-- sound and chase music, random sounds behind you, lamps that flicker (and die when
-- *it* walks under them, or when the power fails, or turn red when it's enraged), and
-- each map's own touches: spinning alarm lights, dripping water, glowing algae,
-- floating rocks, eyes in the walls, beating hearts, the hour bell.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Nights = require(Shared:WaitForChild("Nights"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Atmosphere = {}

type Lamp = {
	part: BasePart,
	light: Light?,
	lightColor: Color3,
	base: number,
	litColor: Color3,
	dropUntil: number,
	nextDrop: number,
	buzz: Sound?,
	pulse: boolean,
}

type Floater = { part: BasePart, base: CFrame, phase: number, spin: number }

-- name, weight, min distance, max distance, volume
local STINGERS: { { any } } = {
	{ "StingerCreak", 3, 14, 30, 0.9 },
	{ "StingerBang", 2, 25, 45, 1.0 },
	{ "StingerWhisper", 2, 4, 8, 0.45 },
	{ "StingerScrape", 2, 16, 34, 0.8 },
	{ "StingerDistantScream", 1, 40, 60, 0.8 },
	{ "StingerKnock", 2, 10, 24, 0.9 },
	{ "StingerFootsteps", 2, 10, 20, 0.8 },
	{ "MonsterClicks", 1, 14, 26, 0.7 },
}

local NIGHT_STINGERS: { [string]: { { any } } } = {
	house = { { "FloorCreak", 4, 6, 18, 0.9 }, { "ClockTick", 2, 10, 20, 0.6 }, { "StingerKnock", 2, 10, 24, 0.9 } },
	ward = { { "AlarmBeep", 3, 20, 40, 0.8 }, { "Gurney", 3, 14, 30, 0.8 }, { "MonitorFlatline", 2, 12, 26, 0.6 }, { "Intercom", 2, 20, 40, 0.8 }, { "StingerFootsteps", 2, 8, 16, 0.8 } },
	sewer = { { "Drip", 4, 4, 12, 0.8 }, { "PipeGroan", 3, 14, 30, 0.9 }, { "Splash", 3, 10, 24, 0.8 }, { "StingerScrape", 2, 14, 30, 0.9 } },
	atrium = { { "StatueGrind", 2, 30, 60, 0.7 }, { "MarbleSteps", 3, 14, 34, 0.8 }, { "ChoirHum", 2, 20, 40, 0.7 }, { "StingerWhisper", 2, 4, 8, 0.4 } },
	void = { { "ReverseWhisper", 4, 3, 8, 0.6 }, { "DeepBoom", 2, 30, 60, 0.8 }, { "HeartPulseLoop", 2, 20, 40, 0.6 }, { "AmalgamRoar", 1, 60, 90, 0.5 } },
}

local RAGE_RED = Color3.fromRGB(255, 30, 20)

local lamps: { [BasePart]: Lamp } = {}
local beacons: { [BasePart]: boolean } = {}
local floaters: { [BasePart]: Floater } = {}
local wallEyes: { [BasePart]: number } = {}
local hearts: { [BasePart]: Vector3 } = {}
local drips: { [BasePart]: boolean } = {}
local algae: { [BasePart]: { light: PointLight?, base: number, phase: number } } = {}
local spinners: { [BasePart]: CFrame } = {}
local blur: BlurEffect
local grade: ColorCorrectionEffect
local ambience: Sound? = nil
local ambienceFor = ""
local chase: Sound? = nil
local chaseFor = ""
local fakeChaseUntil = 0
local rage = 0
local heartbeatAt = 0
local nextStinger = 0
local nextDrip = 0
local nextLook = 0
local shakeImpulse = 0
local wasChased = false
local wake = 0

local function currentNight(): Nights.Night
	local n = GameState:GetAttribute("Night")
	return Nights.get(if typeof(n) == "number" then n else 1)
end

local function addLamp(inst: Instance)
	if not inst:IsA("BasePart") or lamps[inst] then
		return
	end
	local light = inst:FindFirstChildWhichIsA("Light")
	local base = inst:GetAttribute("BaseBrightness")
	local onColor = inst:GetAttribute("OnColor")
	local lamp: Lamp = {
		part = inst,
		light = light,
		lightColor = if light then light.Color else Color3.new(1, 1, 1),
		base = if typeof(base) == "number" then base elseif light then light.Brightness else 1,
		litColor = if typeof(onColor) == "Color3" then onColor else inst.Color,
		dropUntil = 0,
		nextDrop = os.clock() + math.random() * 10,
		buzz = nil,
		pulse = inst:GetAttribute("Pulse") == true,
	}
	if inst:GetAttribute("Buzz") == true then
		local buzz = Audio.create("LightBuzzLoop", inst, 0.22)
		if buzz then
			buzz.RollOffMinDistance = 4
			buzz.RollOffMaxDistance = 28
			buzz:Play()
			lamp.buzz = buzz
		end
	end
	lamps[inst] = lamp
end

local function updateLamps(monsterPos: Vector3?)
	local now = os.clock()
	local beat = math.abs(math.sin(now * 2.2)) ^ 6 -- void lamps pulse like a heartbeat
	for part, lamp in lamps do
		if not part.Parent then
			lamps[part] = nil
			continue
		end
		local light = lamp.light
		if not light then
			continue
		end
		if not light.Enabled then
			-- no power
			if lamp.buzz then
				lamp.buzz.Volume = 0
			end
			continue
		end
		local b = lamp.base
		if lamp.pulse then
			b *= 0.55 + beat * 0.9
		end
		if now >= lamp.nextDrop then
			lamp.dropUntil = now + 0.03 + math.random() * 0.25
			lamp.nextDrop = now + 2 + math.random() * 12
		end
		if now < lamp.dropUntil then
			b *= 0.12
		end
		if monsterPos then
			local near = (part.Position - monsterPos).Magnitude
			if near < 14 then
				b = if math.random() < 0.9 then 0 else b
			elseif near < 40 then
				local k = 1 - near / 40
				if math.random() < k * 0.6 then
					b *= math.random() * (1 - k)
				end
			end
		end
		if GameState:GetAttribute("Blink") == true or GameState:GetAttribute("Blackout") == true then
			b = 0
		end
		light.Brightness = b
		light.Color = if rage > 0 then lamp.lightColor:Lerp(RAGE_RED, rage * 0.75) else lamp.lightColor
		local dark = b < lamp.base * 0.3
		local lit = if rage > 0 then lamp.litColor:Lerp(RAGE_RED, rage * 0.75) else lamp.litColor
		part.Color = if dark then lit:Lerp(Color3.new(0, 0, 0), 0.75) else lit
		if lamp.buzz then
			lamp.buzz.Volume = if dark then 0 else 0.22
		end
	end
end

local function updateProps(dt: number, myRoot: BasePart?)
	local t = os.clock()
	for part in beacons do
		if part.Parent then
			part.CFrame *= CFrame.Angles(0, dt * 4.5, 0)
		else
			beacons[part] = nil
		end
	end
	for part, f in floaters do
		if part.Parent then
			part.CFrame = f.base * CFrame.new(0, math.sin(t * 0.6 + f.phase) * 1.2, 0) * CFrame.Angles(0, t * f.spin, 0)
		else
			floaters[part] = nil
		end
	end
	for part, openAt in wallEyes do
		if not part.Parent then
			wallEyes[part] = nil
		elseif t >= openAt then
			part.Transparency = 0
			if math.random() < dt * 0.4 then
				part.Transparency = 1 -- blink
				wallEyes[part] = t + 0.15
			end
		end
	end
	for part, a in algae do
		if part.Parent then
			if a.light then
				a.light.Brightness = a.base * (0.75 + 0.25 * math.sin(t * 0.7 + a.phase))
			end
		else
			algae[part] = nil
		end
	end
	for part, base in spinners do
		if part.Parent then
			part.CFrame = base * CFrame.Angles(0, t * 0.35, 0)
		else
			spinners[part] = nil
		end
	end
	local beat = math.abs(math.sin(t * 2.2)) ^ 6
	for part, size in hearts do
		if part.Parent then
			part.Size = size * (1 + beat * 0.12)
		else
			hearts[part] = nil
		end
	end
	if myRoot and t >= nextDrip then
		nextDrip = t + 0.8 + math.random() * 2.5
		for part in drips do
			if not part.Parent then
				drips[part] = nil
			elseif (part.Position - myRoot.Position).Magnitude < 40 and math.random() < 0.3 then
				Audio.playAt("Drip", part.Position, 0.6, 0.8 + math.random() * 0.5, 50)
				break
			end
		end
	end
end

local function playStinger(origin: BasePart)
	local list = table.clone(STINGERS)
	local extras = NIGHT_STINGERS[currentNight().id]
	if extras then
		for _, extra in extras do
			table.insert(list, extra)
		end
	end
	local total = 0
	for _, s in list do
		total += s[2] :: number
	end
	local pick = math.random() * total
	local chosen = list[1]
	for _, s in list do
		pick -= s[2] :: number
		if pick <= 0 then
			chosen = s
			break
		end
	end
	-- usually behind you
	local back = -origin.CFrame.LookVector
	local angle = math.rad(math.random(-75, 75))
	local dir = (CFrame.Angles(0, angle, 0) * Vector3.new(back.X, 0, back.Z)).Unit
	local dist = (chosen[3] :: number) + math.random() * ((chosen[4] :: number) - (chosen[3] :: number))
	local pos = origin.Position + dir * dist + Vector3.new(0, math.random(1, 5), 0)
	Audio.playAt(chosen[1] :: string, pos, chosen[5] :: number, 0.9 + math.random() * 0.2, 140)
end

local function shake()
	if ClientState.jumpscaring then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or camera.CameraType == Enum.CameraType.Scriptable then
		return
	end
	local amount = ClientState.fear ^ 2 * 0.004 + shakeImpulse * 0.02 + (if ClientState.chased then 0.004 else 0)
	if amount > 0.0002 then
		local t = os.clock()
		camera.CFrame *= CFrame.Angles(math.noise(t * 9, 0.3) * amount * 2, math.noise(t * 9, 4.1) * amount * 2, math.noise(t * 7, 8.7) * amount * 3)
	end
end

local function update(dt: number)
	local t = os.clock()
	local character = player.Character
	local myRoot = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local monster = workspace:FindFirstChild("Monster")
	local monsterRoot = if monster then monster:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local playing = ClientState.roundStatus == "alive" and myRoot ~= nil

	local raw = 0
	local dist = math.huge
	local chased = false
	local monsterPos: Vector3? = nil
	if monster and monsterRoot and monsterRoot.Position.Y > -100 then
		monsterPos = monsterRoot.Position
		local state = monster:GetAttribute("State")
		if myRoot and playing then
			dist = (monsterRoot.Position - myRoot.Position).Magnitude
			if state ~= "Dormant" then
				raw = math.clamp(1 - (dist - 10) / 75, 0, 1)
			end
			chased = (state == "Chase" or state == "HuntLocker" or state == "Kill" or state == "Stalk") and monster:GetAttribute("TargetUserId") == player.UserId
			if chased and state ~= "Stalk" then
				raw = math.max(raw, 0.8)
			end
		end
	end

	local fear = ClientState.fear
	fear += (raw - fear) * math.min(1, dt * (if raw > fear then 2.5 else 0.45))
	ClientState.fear = fear
	ClientState.monsterDistance = dist
	ClientState.chased = chased
	ClientState.interference = math.clamp(1 - (dist - 8) / 34, 0, 1)
	Hud.setFear(fear)

	if chased and not wasChased then
		shakeImpulse = 1
		Hud.glitch(0.9, 0.5)
		Hud.flash(0.2, 0.3)
	end
	wasChased = chased
	shakeImpulse = math.max(0, shakeImpulse - dt * 1.5)

	wake = math.max(0, wake - dt * 0.35)
	blur.Size = fear ^ 2 * 4 + (if chased then (math.sin(t * 9) + 1) * 1.5 else 0) + wake * 18
	grade.Contrast = fear * 0.25
	grade.Brightness = ClientState.brightness - fear * 0.06 + (if math.random() < 0.02 then -0.03 else 0) - wake * 0.1

	if playing and fear > 0.15 and t >= heartbeatAt then
		heartbeatAt = t + (1.15 - fear * 0.8)
		Audio.play("Heartbeat", nil, 0.25 + fear * 1.1)
		Hud.pulse(fear)
	end

	-- each night has its own background sound and its own chase music
	local night = currentNight()
	if night.id ~= ambienceFor then
		ambienceFor = night.id
		if ambience then
			ambience:Destroy()
		end
		ambience = Audio.create("Ambience_" .. night.id, nil, 0)
		if ambience then
			ambience:Play()
		end
	end
	if ambience then
		-- low wind in the lobby, the full thing out there
		local target = if playing then 0.8 elseif ClientState.roundStatus == "lobby" then 0.3 else 0
		ambience.Volume += (target - ambience.Volume) * math.min(1, dt * 0.8)
	end
	if night.id ~= chaseFor then
		chaseFor = night.id
		if chase then
			chase:Destroy()
		end
		chase = Audio.create("Chase_" .. night.id, nil, 0)
		if chase then
			chase:Play()
		end
	end
	local raging = GameState:GetAttribute("Rage") == true and playing
	rage += ((if raging then 1 else 0) - rage) * math.min(1, dt * 1.5)
	Hud.setRage(rage * (0.6 + 0.4 * math.abs(math.sin(t * 2.4))))
	if chase then
		local target = 0
		if playing and (chased or t < fakeChaseUntil) then
			target = if night.monsterKind == "Statue" then 0.5 else 0.95
		elseif raging then
			target = 0.45
		end
		chase.Volume += (target - chase.Volume) * math.min(1, dt * (if target > chase.Volume then 4 else 0.7))
	end

	if playing and myRoot and t >= nextStinger then
		nextStinger = t + 16 + math.random() * 26
		playStinger(myRoot)
	end

	-- tell the server where we're looking (the Statue can't move while watched)
	if playing and t >= nextLook then
		nextLook = t + 0.1
		local camera = workspace.CurrentCamera
		if camera then
			Remotes.Look:FireServer(camera.CFrame.LookVector)
		end
	end

	updateLamps(monsterPos)
	updateProps(dt, if playing then myRoot else nil)
end

function Atmosphere.wakeUp()
	wake = 1
	nextStinger = os.clock() + 20
end

-- A chase that isn't real (a chaos event): the music kicks in and something screams.
function Atmosphere.fakeChase(seconds: number)
	fakeChaseUntil = os.clock() + seconds
	shakeImpulse = 1
	Hud.glitch(0.9, 0.6)
end

local function watchTag(tag: string, add: (BasePart) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") then
			add(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst: Instance)
		if inst:IsA("BasePart") then
			add(inst)
		end
	end)
end

function Atmosphere.init()
	local camera = workspace.CurrentCamera
	blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = camera
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "Fear"
	grade.Parent = camera

	watchTag("FlickerLight", addLamp)
	watchTag("Beacon", function(p: BasePart)
		beacons[p] = true
	end)
	watchTag("Float", function(p: BasePart)
		floaters[p] = { part = p, base = p.CFrame, phase = math.random() * 6, spin = (math.random() - 0.5) * 0.4 }
	end)
	watchTag("WallEye", function(p: BasePart)
		wallEyes[p] = 0
	end)
	watchTag("Heart", function(p: BasePart)
		hearts[p] = p.Size
	end)
	watchTag("Drip", function(p: BasePart)
		drips[p] = true
	end)
	watchTag("Algae", function(p: BasePart)
		local light = p:FindFirstChildWhichIsA("PointLight")
		algae[p] = { light = light, base = if light then light.Brightness else 0, phase = math.random() * 6 }
	end)
	watchTag("Spin", function(p: BasePart)
		spinners[p] = p.CFrame
	end)

	-- the power failing (a chaos event)
	GameState:GetAttributeChangedSignal("Blackout"):Connect(function()
		if ClientState.roundStatus ~= "alive" then
			return
		end
		if GameState:GetAttribute("Blackout") == true then
			Audio.play("PowerDown", nil, 1.1)
			Hud.glitch(0.6, 0.5)
		else
			Audio.play("PowerUp", nil, 0.9)
		end
	end)
	GameState:GetAttributeChangedSignal("Rage"):Connect(function()
		if GameState:GetAttribute("Rage") == true and ClientState.roundStatus == "alive" then
			shakeImpulse = 1
			Hud.flash(0.35, 0.6)
			Hud.glitch(1, 0.8)
		end
	end)

	Remotes.Apparition.OnClientEvent:Connect(function(position: Vector3)
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
		if not root or (root.Position - position).Magnitude > 140 then
			return
		end
		Audio.playAt("StaticBurst", position, 1.3, 1, 140)
		Hud.glitch(0.8, 0.35)
		local now = os.clock()
		for part, lamp in lamps do
			if part.Parent and (part.Position - position).Magnitude < 45 then
				lamp.dropUntil = now + 0.6 + math.random() * 0.4
			end
		end
	end)

	GameState:GetAttributeChangedSignal("MonsterAwake"):Connect(function()
		if GameState:GetAttribute("MonsterAwake") == true and ClientState.roundStatus == "alive" then
			local night = currentNight()
			if night.monsterKind ~= "Statue" then
				Audio.play("StingerDistantScream", nil, 1.1, 0.8)
			end
			Hud.glitch(0.6, 0.4)
			shakeImpulse = 0.7
		end
	end)

	GameState:GetAttributeChangedSignal("Hour"):Connect(function()
		local hour = GameState:GetAttribute("Hour")
		if typeof(hour) == "number" and hour > 0 and ClientState.roundStatus == "alive" then
			Audio.play("ClockChime", nil, if hour >= 6 then 1.4 else 0.9, if hour == 3 then 0.8 else 1)
		end
	end)

	GameState:GetAttributeChangedSignal("Blink"):Connect(function()
		if GameState:GetAttribute("Blink") == true and ClientState.roundStatus == "alive" then
			Audio.play("Blink", nil, 0.8)
		end
	end)

	RunService.RenderStepped:Connect(update)
	RunService:BindToRenderStep("AchromaShake", Enum.RenderPriority.Camera.Value + 2, shake)

	-- keep effects attached if the camera object is ever replaced
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local cam = workspace.CurrentCamera
		if cam then
			blur.Parent = cam
			grade.Parent = cam
		end
	end)
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
-- Small shared blackboard so client controllers can read each other's state
-- without requiring each other.

local ClientState = {
	choosing = false, -- a screen with choices is up (at a lobby door, or after you're caught)
	roundStatus = "none", -- "none" | "lobby" | "alive" | "caught" | "escaped"
	fear = 0, -- 0..1, how close / how angry the monster is
	monsterDistance = math.huge,
	chased = false, -- the monster is chasing *you*
	hiding = false,
	holdingBreath = false, -- hiding and holding your breath while it's close
	jumpscaring = false,
	keypadOpen = false, -- the night 2 keypad screen is up
	flashlightOn = false,
	interference = 0, -- 0..1, makes your flashlight stutter
	sprinting = false,
	crouching = false,
	brightness = 0, -- settings: added to the screen brightness
}

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Endings</string>
            <string name="Source"><![CDATA[--!strict
-- How a night ends for you: the jumpscare when it catches you, or the white-out
-- when you make it through the exit. No words either way.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Endings = {}

local changed = Instance.new("BindableEvent")
Endings.Changed = changed.Event -- fires when a sequence finishes

-- how close the camera ends up to each monster's head (their faces stick out more or less)
local FACE_DISTANCE: { [string]: number } = { Hollow = 2.8, Crawler = 2.0, Listener = 2.9, Statue = 1.7, Amalgam = 2.6 }

local function jumpscare(monster: Model)
	local kind = monster:GetAttribute("Kind")
	ClientState.jumpscaring = true
	ClientState.roundStatus = "caught"
	local camera = workspace.CurrentCamera
	local head = monster:FindFirstChild("Head") :: BasePart?

	Hud.setHudVisible(false)
	Hud.flash(1, 0.12)
	Audio.play("Jumpscare", nil, 2.6)
	camera.CameraType = Enum.CameraType.Scriptable

	local start = os.clock()
	RunService:BindToRenderStep("AchromaJumpscare", Enum.RenderPriority.Last.Value, function()
		local e = os.clock() - start
		if head and head.Parent then
			local hp = head.Position
			local face = head.CFrame.LookVector
			local near = if typeof(kind) == "string" and FACE_DISTANCE[kind] then FACE_DISTANCE[kind] else 1.6
			local dist = near + 3 - math.min(1, e / 0.15) * 3 -- it lunges into your face
			local shake = math.max(0.15, 1 - e / 1.6)
			camera.CFrame = CFrame.lookAt(hp + face * dist - Vector3.new(0, 0.3, 0), hp)
				* CFrame.Angles((math.random() - 0.5) * 0.12 * shake, (math.random() - 0.5) * 0.12 * shake, (math.random() - 0.5) * 0.35 * shake)
			camera.FieldOfView = 62 - math.min(e, 0.4) * 30
		end
		Hud.glitch(0.9, 0.1)
		if e > 1.7 then
			RunService:UnbindFromRenderStep("AchromaJumpscare")
			-- cut to black, and silence
			Hud.fade(0, 0)
			task.delay(3, function()
				camera.FieldOfView = 70
				camera.CameraType = Enum.CameraType.Custom
				ClientState.jumpscaring = false
				Hud.fade(1, 1.2)
				changed:Fire()
			end)
		end
	end)
end

local function escaped(kind: string?)
	ClientState.roundStatus = "escaped"
	ClientState.jumpscaring = true -- freezes input-driven effects for the sequence
	Hud.setHudVisible(false)
	Audio.play(if kind == "survived" then "ClockChime" else "Escape", nil, 1.2)
	Hud.whiteout(0, if kind == "final" then 5 else 2.5)
	if kind == "final" then
		-- the color actually comes back
		local grade = Lighting:FindFirstChild("Monochrome")
		if grade and grade:IsA("ColorCorrectionEffect") then
			TweenService:Create(grade, TweenInfo.new(6, Enum.EasingStyle.Sine), { Saturation = 0.45, TintColor = Color3.new(1, 1, 1), Contrast = 0.1 }):Play()
		end
	end
	task.delay(if kind == "final" then 9 else 6.5, function()
		Hud.whiteout(1, 1.5)
		ClientState.jumpscaring = false
		changed:Fire()
	end)
end

function Endings.init()
	Remotes.Jumpscare.OnClientEvent:Connect(function(monster: Model)
		jumpscare(monster)
	end)
	Remotes.Escaped.OnClientEvent:Connect(function(kind: string?)
		escaped(kind)
	end)
end

return Endings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--!strict
-- The chaos, from your side of the screen:
--   phone       you picked up; a voice, and then you hear IT from where it is (usually)
--   falseChase  the chase music kicks in and something screams behind you... nothing
--   hunted      (curse) your heartbeat gave you away
--   phantoms    (curse) you see it standing down the corridor. It isn't there.
-- Also throwing bottles: G (or the THROW button) when you're carrying any.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Monsters = require(Shared:WaitForChild("Monsters"))
local Nights = require(Shared:WaitForChild("Nights"))
local Atmosphere = require(script.Parent.Atmosphere)
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Events = {}

local phantom: Model? = nil
local phantomUntil = 0
local nextPhantom = 0
local throwBound = false

local function currentNight(): Nights.Night
	local n = GameState:GetAttribute("Night")
	return Nights.get(if typeof(n) == "number" then n else 1)
end

local function myRoot(): BasePart?
	local character = player.Character
	return if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function onEvent(kind: string, data: unknown)
	if ClientState.roundStatus ~= "alive" then
		return
	end
	if kind == "phone" then
		Audio.play("PhoneVoice", nil, 1.2)
		Hud.glitch(0.4, 0.3)
		-- then a whisper from wherever it is (or wherever the voice wants you to think it is)
		if typeof(data) == "Vector3" then
			task.delay(2.2, function()
				if ClientState.roundStatus == "alive" then
					Audio.playAt("StingerWhisper", data, 2.4, 0.85, 400)
				end
			end)
		end
	elseif kind == "falseChase" then
		Atmosphere.fakeChase(4.5)
		local root = myRoot()
		if root then
			local scream = Monsters.SCREAMS[currentNight().monsterKind] or "MonsterScream"
			Audio.playAt(scream, root.Position - root.CFrame.LookVector * 14 + Vector3.new(0, 3, 0), 1.6, 1, 120)
		end
	elseif kind == "hunted" then
		for i = 0, 2 do
			task.delay(i * 0.55, function()
				Audio.play("Heartbeat", nil, 2.2)
				Hud.pulse(1)
			end)
		end
		Hud.glitch(0.6, 0.4)
	end
end

-- PHANTOMS: a copy of the monster that only you can see, down the corridor in front of you.
local function updatePhantom()
	local now = os.clock()
	local root = myRoot()
	local playing = ClientState.roundStatus == "alive" and root ~= nil and not ClientState.hiding
	local p = phantom
	if p then
		local proot = p.PrimaryPart
		local close = root and proot and (proot.Position - root.Position).Magnitude < 18
		if not playing or now > phantomUntil or close then
			if playing then
				Audio.play("StaticBurst", nil, 0.7)
				Hud.glitch(0.8, 0.3)
			end
			p:Destroy()
			phantom = nil
		end
		return
	end
	if not playing or GameState:GetAttribute("Curse") ~= "phantoms" or now < nextPhantom or not root then
		return
	end
	nextPhantom = now + 18 + math.random() * 20
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	look = look.Unit
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Instance }
	local origin = root.Position + Vector3.new(0, 1, 0)
	local hit = workspace:Raycast(origin, look * 80, params)
	local dist = if hit then (hit.Position - origin).Magnitude else 80
	if dist < 26 then
		return
	end
	local night = currentNight()
	local variant = if night.monsterKind == "Statue" then Monsters.STATUE_VARIANTS[math.random(1, #Monsters.STATUE_VARIANTS)] else nil
	local rig = Monsters.build(night.monsterKind, { preview = true, variant = variant })
	if night.monsterKind == "Statue" then
		Monsters.applyStatuePose(rig, math.random(1, #Monsters.STATUE_POSES), nil)
	end
	local at = origin + look * (dist * 0.75)
	local pos = Vector3.new(at.X, rig.rootHeight, at.Z)
	rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(root.Position.X, pos.Y, root.Position.Z)))
	Monsters.solve(rig)
	rig.model.Name = "Phantom"
	rig.model.Parent = workspace
	phantom = rig.model
	phantomUntil = now + 2.5 + math.random() * 3
end

local function setBottles()
	local value = player:GetAttribute("Bottles")
	local n = if typeof(value) == "number" then value else 0
	Hud.setBottles(n)
	if n > 0 and not throwBound then
		throwBound = true
		ContextActionService:BindAction("AchromaThrow", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
			if state == Enum.UserInputState.Begin and ClientState.roundStatus == "alive" and not ClientState.hiding then
				local camera = workspace.CurrentCamera
				if camera then
					Remotes.Throw:FireServer(camera.CFrame.LookVector)
				end
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.G, Enum.KeyCode.DPadUp)
		ContextActionService:SetTitle("AchromaThrow", "THROW")
	elseif n <= 0 and throwBound then
		throwBound = false
		ContextActionService:UnbindAction("AchromaThrow")
	end
end

function Events.init()
	Remotes.Chaos.OnClientEvent:Connect(onEvent)
	player:GetAttributeChangedSignal("Bottles"):Connect(setBottles)
	setBottles()
	RunService.RenderStepped:Connect(updatePhantom)
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Flashlight</string>
            <string name="Source"><![CDATA[--!strict
-- Your flashlight: a shadow-casting spotlight that lags slightly behind your view,
-- drains its battery, stutters when the monster is near, and gives you away.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Config = require(Shared:WaitForChild("Config"))
local Nights = require(Shared:WaitForChild("Nights"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Flashlight = {}

-- this night's beam (the pitch-black maps get a stronger one)
local settings: Nights.FlashlightSettings = Nights.DEFAULT_FLASHLIGHT

local holder: Part
local beam: SpotLight
local spill: SpotLight
local battery = 100
local on = false
local sway: CFrame? = nil
local dropUntil = 0

local function setOn(value: boolean)
	if value and battery <= 0 then
		Audio.play("FlashlightClick", nil, 0.5, 0.8)
		return
	end
	if value == on then
		return
	end
	on = value
	ClientState.flashlightOn = value
	Audio.play("FlashlightClick", nil, 0.7)
	Remotes.Flashlight:FireServer(value)
end

local function alive(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if holder.Parent ~= camera then
		holder.Parent = camera
	end
	local target = camera.CFrame * CFrame.new(0.45, -0.5, -0.4)
	local current = if sway then sway:Lerp(target, math.min(1, dt * 14)) else target
	sway = current
	holder.CFrame = CFrame.new(target.Position) * current.Rotation

	if on and (not alive() or ClientState.hiding or ClientState.jumpscaring) then
		setOn(false)
	end
	if on then
		battery = math.max(0, battery - Config.Player.BatteryDrain * dt)
		if battery <= 0 then
			setOn(false)
		end
	end
	Hud.setBattery(battery / 100)

	-- stutter when the battery is low or the monster is close
	local now = os.clock()
	local instability = ClientState.interference
	if battery < 20 then
		instability = math.max(instability, (20 - battery) / 20 * 0.7)
	end
	if instability > 0 and math.random() < instability * 0.12 then
		dropUntil = now + 0.03 + math.random() * 0.14
	end
	local strong = settings.brightness > Nights.DEFAULT_FLASHLIGHT.brightness
	local brightness = if now < dropUntil then settings.brightness * 0.06 else settings.brightness
	beam.Enabled = on
	spill.Enabled = on
	beam.Brightness = brightness
	beam.Range = settings.range
	beam.Angle = settings.angle
	spill.Brightness = brightness * (if strong then 0.3 else 0.22)
	spill.Range = if strong then 24 else 16

	-- the server puts a copy of your light on your head for other players; hide ours
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local shared = head and head:FindFirstChild("SharedFlashlight")
	if shared and shared:IsA("SpotLight") then
		shared.Enabled = false
	end
end

function Flashlight.init()
	holder = Instance.new("Part")
	holder.Name = "AchromaFlashlight"
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false

	beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Angle = 46
	beam.Range = 48
	beam.Brightness = settings.brightness
	beam.Shadows = true
	beam.Color = Color3.fromRGB(255, 248, 235)
	beam.Enabled = false
	beam.Parent = holder

	spill = Instance.new("SpotLight")
	spill.Face = Enum.NormalId.Front
	spill.Angle = 110
	spill.Range = 16
	spill.Brightness = settings.brightness * 0.22
	spill.Shadows = false
	spill.Enabled = false
	spill.Parent = holder

	ContextActionService:BindAction("AchromaFlashlight", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin and alive() and not ClientState.hiding then
			setOn(not on)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("AchromaFlashlight", "LIGHT")

	Remotes.Battery.OnClientEvent:Connect(function(amount: number)
		battery = math.min(100, battery + amount)
		Audio.play("Battery", nil, 0.8)
	end)

	player.CharacterAdded:Connect(function()
		battery = 100
		on = false
		ClientState.flashlightOn = false
	end)

	local function readNight()
		local n = GameState:GetAttribute("Night")
		settings = Nights.flashlight(Nights.get(if typeof(n) == "number" then n else 1))
	end
	GameState:GetAttributeChangedSignal("Night"):Connect(readNight)
	readNight()

	RunService:BindToRenderStep("AchromaFlashlight", Enum.RenderPriority.Camera.Value + 1, update)
end

return Flashlight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">Hiding</string>
            <string name="Source"><![CDATA[--!strict
-- While you're inside a locker/wardrobe: darker vignette, a "leave" prompt, the E key /
-- touch button to get back out, and holding your breath when it comes close: hold
-- SPACE (R2 / the HOLD BREATH button) while it's right outside. Let go too long, or run
-- out of breath, and it hears you.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Hiding = {}

local NEAR = 10 -- studs: right outside the door, close enough to hear you breathe
local HOLD_FOR = 10 -- seconds of breath
local GRACE = 1.3 -- seconds you can forget to hold it while it's close

local breath = 1
local holding = false
local exposed = 0
local gaveAway = false

local function monsterNear(): boolean
	local monster = workspace:FindFirstChild("Monster")
	local root = if monster then monster:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local character = player.Character
	local me = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	if not monster or not root or not me or root.Position.Y < -100 then
		return false
	end
	local state = monster:GetAttribute("State")
	if state == "Dormant" or state == "Apparition" or state == "Kill" or monster:GetAttribute("Kind") == "Statue" then
		return false
	end
	return (root.Position - me.Position).Magnitude < NEAR
end

local function giveAway()
	gaveAway = true
	holding = false
	ClientState.holdingBreath = false
	Audio.play("Gasp", nil, 1.3)
	Hud.glitch(0.6, 0.4)
	Remotes.Breath:FireServer()
end

local function update(dt: number)
	if not ClientState.hiding then
		Hud.setBreath(false, 1, false)
		return
	end
	local near = monsterNear()
	if holding then
		breath -= dt / HOLD_FOR
		if breath <= 0 then
			breath = 0
			if near and not gaveAway then
				giveAway()
			elseif not near then
				-- it already left: gasp all you like
				holding = false
				ClientState.holdingBreath = false
				Audio.play("Gasp", nil, 0.9)
			end
		end
	else
		breath = math.min(1, breath + dt / 3)
	end
	if near and not holding and not gaveAway then
		exposed += dt
		if exposed > GRACE then
			giveAway()
		end
	elseif holding or not near then
		exposed = math.max(0, exposed - dt * 2)
	end
	local show = (near and not gaveAway) or breath < 1
	Hud.setBreath(show, breath, near and not holding)
end

local function setHolding(on: boolean)
	if on and not holding and breath > 0.05 and not gaveAway then
		Audio.play("BreathHold", nil, 0.8)
	end
	holding = on and breath > 0 and not gaveAway
	ClientState.holdingBreath = holding
end

local function refresh()
	local hiding = player:GetAttribute("Hiding") == true
	if hiding == ClientState.hiding then
		return
	end
	ClientState.hiding = hiding
	Hud.setHiding(hiding)
	breath, exposed, gaveAway = 1, 0, false
	setHolding(false)
	if hiding then
		ContextActionService:BindAction("AchromaLeave", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
			if state == Enum.UserInputState.Begin then
				Remotes.LeaveHiding:FireServer()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:SetTitle("AchromaLeave", "LEAVE")
		ContextActionService:BindAction("AchromaBreath", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
			if state == Enum.UserInputState.Begin then
				setHolding(true)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				setHolding(false)
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonR2)
		ContextActionService:SetTitle("AchromaBreath", "HOLD BREATH")
	else
		ContextActionService:UnbindAction("AchromaLeave")
		ContextActionService:UnbindAction("AchromaBreath")
	end
end

function Hiding.init()
	player:GetAttributeChangedSignal("Hiding"):Connect(refresh)
	refresh()
	RunService.RenderStepped:Connect(update)
end

return Hiding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen everything: film grain, vignette, glitches, what to do (in red at the top),
-- the hour (top right, on nights you have to survive), a few faint dots for how far along
-- you are, stamina, flashlight battery, bottles, the hold-your-breath meter, the night's
-- title, fades, flashes and the red of its rage.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local Nights = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Nights"))

local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Hud = {}

local TEXT = Color3.fromRGB(205, 205, 200)
local BLACK = Color3.new(0, 0, 0)
local DANGER = Color3.fromRGB(220, 70, 60)
local BLOOD = Color3.fromRGB(170, 14, 12)
local BLOOD_FRESH = Color3.fromRGB(225, 25, 20)
Hud.TITLE_FONT = Enum.Font.Garamond
Hud.OBJECTIVE_FONT = Enum.Font.Creepster

local gui: ScreenGui
local pips: Frame
local pipDots: { Frame } = {}
local pipsShownAt = -math.huge
local objectiveLabel: TextLabel
local objectiveShownAt = -math.huge
local clockLabel: TextLabel
local clockShownAt = -math.huge
local hudVisible = false
local blinkFrame: Frame
local staminaFrame: Frame
local staminaFill: Frame
local batteryFrame: Frame
local batterySegments: { Frame } = {}
local bigTitle: TextLabel
local controlsLabel: TextLabel
local fadeFrame: Frame
local flashFrame: Frame
local whiteFrame: Frame
local grain: Frame
local specks: { Frame } = {}
local vignette: { Frame } = {}
local glitchBars: { Frame } = {}
local crosshair: Frame
local bottles: Frame
local bottleMarks: { Frame } = {}
local breathFrame: Frame
local breathFill: Frame
local breathUrgent = false
local rageFrame: Frame

local fearLevel = 0
local glitchAmount = 0
local glitchUntil = 0
local pulse = 0
local staminaShownAt = 0
local hidingDark = false

local function new<T>(className: string, props: { [string]: any }, parent: Instance?): T
	local inst = Instance.new(className :: any)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return (inst :: any) :: T
end

-- "NIGHT 1" -> "N I G H T   1": the only words the game ever shows
function Hud.spaced(text: string): string
	local out = {}
	for _, word in string.split(text, " ") do
		local letters = {}
		for i = 1, #word do
			table.insert(letters, string.sub(word, i, i))
		end
		table.insert(out, table.concat(letters, " "))
	end
	return table.concat(out, "    ")
end

local function corner(parent: Instance, radius: number?)
	new("UICorner", { CornerRadius = UDim.new(radius or 0.5, 0) }, parent)
end

local function edgeShade(name: string, size: UDim2, position: UDim2, anchor: Vector2, rotation: number): Frame
	local f: Frame = new("Frame", {
		Name = name,
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		ZIndex = 2,
	}, gui)
	new("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.45, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	return f
end

function Hud.init()
	gui = new("ScreenGui", {
		Name = "AchromaHud",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	-- film grain + dust
	grain = new("Frame", { Name = "Grain", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.97, BorderSizePixel = 0, ZIndex = 1 }, gui)
	for _ = 1, 36 do
		table.insert(specks, new("Frame", { Size = UDim2.fromOffset(2, 2), BorderSizePixel = 0, ZIndex = 1, BackgroundTransparency = 1 }, gui))
	end

	-- vignette
	table.insert(vignette, edgeShade("Top", UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0), Vector2.zero, 90))
	table.insert(vignette, edgeShade("Bottom", UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 1), Vector2.new(0, 1), 270))
	table.insert(vignette, edgeShade("Left", UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), Vector2.zero, 0))
	table.insert(vignette, edgeShade("Right", UDim2.fromScale(0.3, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180))

	for _ = 1, 8 do
		table.insert(glitchBars, new("Frame", { BorderSizePixel = 0, Visible = false, ZIndex = 4, BackgroundColor3 = Color3.new(1, 1, 1) }, gui))
	end

	crosshair = new("Frame", { Name = "Crosshair", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = TEXT, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 5 }, gui)
	corner(crosshair)

	-- what to do: big red letters across the top
	objectiveLabel = new("TextLabel", { Name = "Objective", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 16), Size = UDim2.new(0.72, 0, 0, 54), BackgroundTransparency = 1, Font = Hud.OBJECTIVE_FONT, TextScaled = true, TextColor3 = BLOOD, Text = "", ZIndex = 6 }, gui)
	new("UITextSizeConstraint", { MaxTextSize = 48, MinTextSize = 18 }, objectiveLabel)
	new("UIStroke", { Color = BLACK, Thickness = 2, Transparency = 0.25 }, objectiveLabel)

	-- the hour (top right), only on nights you have to survive till morning
	clockLabel = new("TextLabel", { Name = "Clock", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 20), Size = UDim2.fromOffset(170, 46), BackgroundTransparency = 1, Font = Hud.TITLE_FONT, TextSize = 40, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = TEXT, Text = "12 AM", Visible = false, ZIndex = 6 }, gui)
	new("UIStroke", { Color = BLACK, Thickness = 1.5, Transparency = 0.35 }, clockLabel)

	-- how far along you are: a row of faint dots (under the objective) that light up one by one
	pips = new("Frame", { Name = "Pips", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 80), Size = UDim2.fromOffset(240, 8), BackgroundTransparency = 1, ZIndex = 5 }, gui)
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, pips)
	blinkFrame = new("Frame", { Name = "Blink", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 8 }, gui)

	-- stamina (bottom centre)
	staminaFrame = new("Frame", { Name = "Stamina", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -34), Size = UDim2.fromOffset(260, 4), BackgroundColor3 = Color3.fromRGB(40, 40, 40), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, gui)
	staminaFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = TEXT, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, staminaFrame)

	-- flashlight battery (bottom right): five faint ticks
	batteryFrame = new("Frame", { Name = "Battery", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -30, 1, -30), Size = UDim2.fromOffset(80, 8), BackgroundTransparency = 1, ZIndex = 5 }, gui)
	for i = 1, 5 do
		table.insert(batterySegments, new("Frame", { Position = UDim2.fromOffset((i - 1) * 16, 0), Size = UDim2.fromOffset(12, 4), BackgroundColor3 = TEXT, BorderSizePixel = 0, ZIndex = 5 }, batteryFrame))
	end

	-- bottles you're carrying (above the battery): one small mark each
	bottles = new("Frame", { Name = "Bottles", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -30, 1, -48), Size = UDim2.fromOffset(80, 14), BackgroundTransparency = 1, ZIndex = 5 }, gui)
	for i = 1, 3 do
		table.insert(bottleMarks, new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(i - 1) * 10, 0, 0), Size = UDim2.fromOffset(4, 14), BackgroundColor3 = TEXT, BackgroundTransparency = 0.45, BorderSizePixel = 0, Visible = false, ZIndex = 5 }, bottles))
	end

	-- hold your breath (centre, only while you're hiding): a thin line that runs out
	breathFrame = new("Frame", { Name = "Breath", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.7), Size = UDim2.fromOffset(240, 3), BackgroundColor3 = Color3.fromRGB(30, 30, 30), BackgroundTransparency = 0.4, BorderSizePixel = 0, Visible = false, ZIndex = 7 }, gui)
	breathFill = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(1, 1), BackgroundColor3 = TEXT, BorderSizePixel = 0, ZIndex = 7 }, breathFrame)

	-- the red wash while it's enraged
	rageFrame = new("Frame", { Name = "Rage", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(150, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2 }, gui)

	bigTitle = new("TextLabel", { Name = "BigTitle", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.new(0.9, 0, 0, 60), BackgroundTransparency = 1, Font = Hud.TITLE_FONT, TextSize = 40, TextColor3 = TEXT, Text = "", TextTransparency = 1, ZIndex = 11 }, gui)
	controlsLabel = new("TextLabel", { Name = "Controls", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.74), Size = UDim2.new(0.9, 0, 0, 56), BackgroundTransparency = 1, Font = Hud.TITLE_FONT, TextSize = 17, LineHeight = 1.5, TextColor3 = TEXT, Text = "", TextTransparency = 1, ZIndex = 11 }, gui)

	fadeFrame = new("Frame", { Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9 }, gui)
	whiteFrame = new("Frame", { Name = "White", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10 }, gui)
	flashFrame = new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10 }, gui)

	-- a developer-only reminder (Studio, never in the published game)
	if RunService:IsStudio() and not Audio.isConfigured() then
		new("TextLabel", { Text = "Audio IDs not set: see README (ReplicatedStorage.Shared.SoundIds)", BackgroundTransparency = 1, Font = Enum.Font.SourceSans, Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(520, 20), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 14, TextColor3 = Color3.fromRGB(150, 150, 150), ZIndex = 12 }, gui)
	end

	local function refreshPips()
		local done = GameState:GetAttribute("Done")
		local goal = GameState:GetAttribute("Goal")
		local d = if typeof(done) == "number" then done else 0
		local g = if typeof(goal) == "number" then goal else 0
		while #pipDots < g do
			local dot: Frame = new("Frame", { Size = UDim2.fromOffset(5, 5), BackgroundColor3 = TEXT, BorderSizePixel = 0, LayoutOrder = #pipDots + 1, ZIndex = 5 }, pips)
			corner(dot)
			table.insert(pipDots, dot)
		end
		for i, dot in pipDots do
			dot.Visible = i <= g
			dot:SetAttribute("Lit", i <= d)
		end
		pipsShownAt = os.clock()
	end
	GameState:GetAttributeChangedSignal("Done"):Connect(refreshPips)
	GameState:GetAttributeChangedSignal("Goal"):Connect(refreshPips)
	refreshPips()

	local function refreshObjective()
		local text = GameState:GetAttribute("Objective")
		objectiveLabel.Text = if typeof(text) == "string" then text else ""
		objectiveShownAt = os.clock()
	end
	GameState:GetAttributeChangedSignal("Objective"):Connect(refreshObjective)
	refreshObjective()

	local function refreshClock()
		local hour = GameState:GetAttribute("Hour")
		local h = if typeof(hour) == "number" then hour else 0
		local text = string.format("%d AM", if h == 0 then 12 else h)
		if clockLabel.Text ~= text then
			clockLabel.Text = text
			clockShownAt = os.clock()
		end
	end
	GameState:GetAttributeChangedSignal("Hour"):Connect(refreshClock)
	GameState:GetAttributeChangedSignal("Night"):Connect(function()
		Hud.setHudVisible(hudVisible)
	end)
	refreshClock()
	-- statue night: everyone blinks
	GameState:GetAttributeChangedSignal("Blink"):Connect(function()
		if GameState:GetAttribute("Blink") == true then
			blinkFrame.BackgroundTransparency = 0
		else
			TweenService:Create(blinkFrame, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
		end
	end)

	Hud.setHudVisible(false)
	RunService.RenderStepped:Connect(Hud._update)
end

function Hud._update(dt: number)
	local t = os.clock()

	-- grain flicker + dust
	grain.BackgroundTransparency = 0.955 + math.random() * 0.03 - fearLevel * 0.02
	for i, s in specks do
		if math.random() < 0.5 then
			s.Position = UDim2.fromScale(math.random(), math.random())
			s.BackgroundColor3 = if i % 3 == 0 then BLACK else Color3.new(1, 1, 1)
			s.BackgroundTransparency = 0.55 + math.random() * 0.4
			s.Size = UDim2.fromOffset(math.random(1, 3), math.random(1, 3))
		end
	end

	-- vignette tightens with fear and pulses with the heartbeat
	pulse = math.max(0, pulse - dt * 3)
	local base = 0.35 - fearLevel * 0.3 - pulse * 0.25 - (if hidingDark then 0.3 else 0)
	for _, v in vignette do
		v.BackgroundTransparency = math.clamp(base, 0, 1)
	end

	-- glitch bars
	local g = math.max(glitchAmount * (if t < glitchUntil then 1 else 0), fearLevel > 0.75 and (fearLevel - 0.75) * 1.6 or 0)
	for _, bar in glitchBars do
		if g > 0 and math.random() < g * 0.9 then
			bar.Visible = true
			bar.Position = UDim2.new(math.random() * 0.1 - 0.05, 0, math.random(), 0)
			bar.Size = UDim2.new(1.1, 0, 0, math.random(2, 4 + math.floor(g * 26)))
			bar.BackgroundColor3 = if math.random() < 0.5 then Color3.new(1, 1, 1) else BLACK
			bar.BackgroundTransparency = 0.35 + math.random() * 0.5
		else
			bar.Visible = false
		end
	end

	-- stamina fades away when full
	local showStamina = t - staminaShownAt < 1.2
	staminaFrame.BackgroundTransparency = if showStamina then 0.4 else 1
	staminaFill.BackgroundTransparency = if showStamina then 0.15 else 1

	-- the dots stand out for a few seconds after they change, then sink back into the dark.
	-- When they're all lit they breathe.
	local since = t - pipsShownAt
	local loud = math.clamp(1 - (since - 4) / 2, 0, 1)
	local all = #pipDots > 0
	for _, dot in pipDots do
		if dot.Visible and dot:GetAttribute("Lit") ~= true then
			all = false
		end
	end
	for _, dot in pipDots do
		local lit = dot:GetAttribute("Lit") == true
		local quiet = if lit then (if all then 0.55 + 0.25 * math.sin(t * 1.6) else 0.75) else 0.93
		local shown = if lit then 0.1 else 0.75
		dot.BackgroundTransparency = quiet + (shown - quiet) * loud
	end

	-- the objective: fresh, bright red when it's new, then it dries darker. It never sits
	-- quite still: it flickers, and twitches more the closer it is.
	local fresh = math.clamp(1 - (t - objectiveShownAt - 5) / 3, 0, 1)
	objectiveLabel.TextColor3 = BLOOD:Lerp(BLOOD_FRESH, fresh)
	objectiveLabel.TextTransparency = if math.random() < 0.01 then 0.35 + math.random() * 0.3 else 0.05 * (1 - fresh)
	local twitch = if math.random() < 0.02 + fearLevel * 0.12 then math.random(-2, 2) else 0
	objectiveLabel.Position = UDim2.new(0.5, twitch, 0, 16)

	-- the hour: when it changes it shows red for a moment, then goes back to grey
	local struck = math.clamp(1 - (t - clockShownAt - 2) / 3, 0, 1)
	clockLabel.TextColor3 = TEXT:Lerp(BLOOD_FRESH, struck)
	clockLabel.TextTransparency = if struck > 0 and math.random() < 0.15 then 0.5 else 0.1

	if breathFrame.Visible then
		breathFill.BackgroundColor3 = if breathUrgent and math.floor(t * 6) % 2 == 0 then DANGER else TEXT
	end
end

-- Is tonight one you survive till 6 AM? Then the hour shows instead of the dots.
local function clockNight(): boolean
	local n = GameState:GetAttribute("Night")
	return Nights.get(if typeof(n) == "number" then n else 1).objective == "survive"
end

function Hud.setHudVisible(visible: boolean)
	hudVisible = visible
	local clock = clockNight()
	objectiveLabel.Visible = visible
	clockLabel.Visible = visible and clock
	pips.Visible = visible and not clock
	batteryFrame.Visible = visible
	bottles.Visible = visible
	staminaFrame.Visible = visible
	crosshair.Visible = visible
end

function Hud.setStamina(fraction: number)
	staminaFill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	if fraction < 0.995 then
		staminaShownAt = os.clock()
	end
end

function Hud.setBattery(fraction: number)
	local lit = math.ceil(math.clamp(fraction, 0, 1) * #batterySegments - 0.001)
	for i, seg in batterySegments do
		seg.BackgroundTransparency = if i <= lit then (if fraction < 0.2 then 0.55 + math.random() * 0.3 else 0.5) else 0.9
	end
end

function Hud.setBottles(n: number)
	for i, mark in bottleMarks do
		mark.Visible = i <= n
	end
end

-- fraction: breath left (0..1). urgent: it's right outside and you're not holding it.
function Hud.setBreath(visible: boolean, fraction: number, urgent: boolean)
	breathFrame.Visible = visible
	breathFill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	breathUrgent = urgent or fraction < 0.25
end

function Hud.setRage(amount: number)
	rageFrame.BackgroundTransparency = 1 - math.clamp(amount, 0, 1) * 0.16
end

function Hud.setFear(f: number)
	fearLevel = f
end

function Hud.pulse(strength: number)
	pulse = math.max(pulse, strength)
end

function Hud.glitch(amount: number, duration: number)
	glitchAmount = amount
	glitchUntil = os.clock() + duration
end

function Hud.setHiding(on: boolean)
	hidingDark = on
end

-- The controls, for the moment before a night: the only instructions the game gives.
Hud.KEYBOARD_CONTROLS = "WASD  move       SHIFT  run       C  crouch       F  light\nE  use · hide       G  throw       SPACE  hold your breath"
Hud.GAMEPAD_CONTROLS = "L3  run       B  crouch       Y  light\nX  use · hide       D-PAD UP  throw       R2  hold your breath"

local function controlsText(): string
	if UserInputService.KeyboardEnabled then
		return Hud.KEYBOARD_CONTROLS
	elseif UserInputService.GamepadEnabled then
		return Hud.GAMEPAD_CONTROLS
	end
	return "" -- touch: the buttons on screen say what they do
end

-- The night's title in the middle of the dark ("NIGHT 3", letter-spaced), with the
-- controls faint underneath. The title's already there (the black screen before showed
-- it while the night loaded); both fade out slowly.
function Hud.showTitle(title: string)
	bigTitle.Text = Hud.spaced(title)
	bigTitle.TextTransparency = 0.05
	controlsLabel.Text = controlsText()
	controlsLabel.TextTransparency = 1
	TweenService:Create(controlsLabel, TweenInfo.new(1.2, Enum.EasingStyle.Sine), { TextTransparency = 0.45 }):Play()
end

function Hud.hideTitle()
	TweenService:Create(bigTitle, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { TextTransparency = 1 }):Play()
	TweenService:Create(controlsLabel, TweenInfo.new(1.6, Enum.EasingStyle.Sine), { TextTransparency = 1 }):Play()
end

-- As you wake up into a night: the objective comes up fresh and red again.
function Hud.revealObjective()
	objectiveShownAt = os.clock() + 2
end

-- 0 = fully black, 1 = clear
function Hud.fade(transparency: number, time: number)
	if time <= 0 then
		fadeFrame.BackgroundTransparency = transparency
	else
		TweenService:Create(fadeFrame, TweenInfo.new(time), { BackgroundTransparency = transparency }):Play()
	end
end

function Hud.whiteout(transparency: number, time: number)
	if time <= 0 then
		whiteFrame.BackgroundTransparency = transparency
	else
		TweenService:Create(whiteFrame, TweenInfo.new(time), { BackgroundTransparency = transparency }):Play()
	end
end

function Hud.flash(strength: number?, time: number?)
	flashFrame.BackgroundTransparency = 1 - (strength or 0.9)
	TweenService:Create(flashFrame, TweenInfo.new(time or 0.25), { BackgroundTransparency = 1 }):Play()
end

function Hud.gui(): ScreenGui
	return gui
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Keypad</string>
            <string name="Source"><![CDATA[--!strict
-- The exit keypad screen: type the four digits from the key tags and press OK.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Keypad = {}

local gui: ScreenGui
local display: TextLabel
local code = ""
local isOpen = false
local openedAt: Vector3? = nil

local DIGIT_KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.Zero] = "0",
	[Enum.KeyCode.One] = "1",
	[Enum.KeyCode.Two] = "2",
	[Enum.KeyCode.Three] = "3",
	[Enum.KeyCode.Four] = "4",
	[Enum.KeyCode.Five] = "5",
	[Enum.KeyCode.Six] = "6",
	[Enum.KeyCode.Seven] = "7",
	[Enum.KeyCode.Eight] = "8",
	[Enum.KeyCode.Nine] = "9",
	[Enum.KeyCode.KeypadZero] = "0",
	[Enum.KeyCode.KeypadOne] = "1",
	[Enum.KeyCode.KeypadTwo] = "2",
	[Enum.KeyCode.KeypadThree] = "3",
	[Enum.KeyCode.KeypadFour] = "4",
	[Enum.KeyCode.KeypadFive] = "5",
	[Enum.KeyCode.KeypadSix] = "6",
	[Enum.KeyCode.KeypadSeven] = "7",
	[Enum.KeyCode.KeypadEight] = "8",
	[Enum.KeyCode.KeypadNine] = "9",
}

-- Digits you've typed, and faintly behind them the ones the keys you found had on
-- their tags (the keypad remembers, so you don't have to read anything).
local function refresh()
	local mask = GameState:GetAttribute("CodeMask")
	local known = if typeof(mask) == "string" then mask else ""
	local shown = {}
	for i = 1, 4 do
		local hint = string.sub(known, i, i)
		if i <= #code then
			shown[i] = string.sub(code, i, i)
		elseif hint ~= "" and hint ~= "_" then
			shown[i] = '<font transparency="0.7">' .. hint .. "</font>"
		else
			shown[i] = '<font transparency="0.7">_</font>'
		end
	end
	display.Text = table.concat(shown, " ")
end

local function close()
	isOpen = false
	ClientState.keypadOpen = false
	gui.Enabled = false
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	return if root then root.Position else nil
end

local function open()
	code = ""
	refresh()
	isOpen = true
	ClientState.keypadOpen = true
	openedAt = rootPosition()
	gui.Enabled = true
end

local function press(key: string)
	if not isOpen then
		return
	end
	if key == "CLR" then
		code = ""
		Audio.play("KeypadBeep", nil, 0.5, 0.8)
	elseif key == "OK" then
		if #code == 4 then
			Audio.play("KeypadBeep", nil, 0.6, 1.2)
			Remotes.SubmitCode:FireServer(code)
			close()
			return
		end
		Audio.play("KeypadError", nil, 0.4)
	elseif #code < 4 then
		code ..= key
		Audio.play("KeypadBeep", nil, 0.55, 1 + #code * 0.04)
	end
	refresh()
end

function Keypad.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "AchromaKeypad"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Modal = true frees the mouse from first-person lock while this is open
	local panel = Instance.new("TextButton")
	panel.Name = "Panel"
	panel.Modal = true
	panel.AutoButtonColor = false
	panel.Text = ""
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(300, 430)
	panel.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(90, 90, 90)
	stroke.Thickness = 2
	stroke.Parent = panel
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = panel

	display = Instance.new("TextLabel")
	display.Position = UDim2.fromOffset(20, 20)
	display.Size = UDim2.new(1, -40, 0, 64)
	display.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	display.BorderSizePixel = 0
	display.Font = Enum.Font.Code
	display.TextSize = 40
	display.TextColor3 = Color3.fromRGB(220, 220, 220)
	display.RichText = true
	display.Parent = panel

	local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "CLR", "0", "OK" }
	for i, key in keys do
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		local b = Instance.new("TextButton")
		b.Name = "Key" .. key
		b.Position = UDim2.fromOffset(20 + col * 90, 100 + row * 78)
		b.Size = UDim2.fromOffset(80, 68)
		b.BackgroundColor3 = Color3.fromRGB(52, 52, 54)
		b.AutoButtonColor = true
		b.BorderSizePixel = 0
		b.Font = Enum.Font.Code
		b.TextSize = if #key > 1 then 22 else 32
		b.TextColor3 = Color3.fromRGB(225, 225, 225)
		b.Text = key
		b.Parent = panel
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 4)
		bc.Parent = b
		b.Activated:Connect(function()
			press(key)
		end)
	end

	local closeButton = Instance.new("TextButton")
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -6, 0, -34)
	closeButton.Size = UDim2.fromOffset(28, 28)
	closeButton.BackgroundTransparency = 1
	closeButton.Font = Enum.Font.SpecialElite
	closeButton.TextSize = 26
	closeButton.TextColor3 = Color3.fromRGB(170, 170, 170)
	closeButton.Text = "×"
	closeButton.Parent = panel
	closeButton.Activated:Connect(close)

	Remotes.OpenKeypad.OnClientEvent:Connect(open)

	UserInputService.InputBegan:Connect(function(input: InputObject, _processed: boolean)
		if not isOpen then
			return
		end
		local digit = DIGIT_KEYS[input.KeyCode]
		if digit then
			press(digit)
		elseif input.KeyCode == Enum.KeyCode.Backspace then
			code = string.sub(code, 1, math.max(0, #code - 1))
			refresh()
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			press("OK")
		elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			close()
		end
	end)

	-- close it if you get dragged away, die, or walk off
	RunService.Heartbeat:Connect(function()
		if not isOpen then
			return
		end
		local pos = rootPosition()
		if not pos or ClientState.jumpscaring or ClientState.hiding or (openedAt and (pos - openedAt).Magnitude > 10) then
			close()
		end
	end)
end

return Keypad
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="61">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- ACHROMA client entry point: hides Roblox's default UI and starts every controller.

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Atmosphere = require(script.Parent.Atmosphere)
local ClientState = require(script.Parent.ClientState)
local Endings = require(script.Parent.Endings)
local Events = require(script.Parent.Events)
local Flashlight = require(script.Parent.Flashlight)
local Hiding = require(script.Parent.Hiding)
local Hud = require(script.Parent.Hud)
local Keypad = require(script.Parent.Keypad)
local Menu = require(script.Parent.Menu)
local MonsterAnimator = require(script.Parent.MonsterAnimator)
local Movement = require(script.Parent.Movement)
local Prompts = require(script.Parent.Prompts)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

for _, coreGui in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.PlayerList } do
	StarterGui:SetCoreGuiEnabled(coreGui, false)
end
task.spawn(function()
	-- resetting your character would be a free escape from the monster
	for _ = 1, 20 do
		if pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end) then
			break
		end
		task.wait(0.5)
	end
end)

Hud.init()
Movement.init()
Flashlight.init()
Atmosphere.init()
MonsterAnimator.init()
Endings.init()
Hiding.init()
Keypad.init()
Events.init()
Prompts.init()
Menu.init()

-- The game never puts words on screen. What the server narrates (who found a key,
-- what the hour is) only goes to the developer console (F9).
Remotes.Notify.OnClientEvent:Connect(function(text: string, _style: string?)
	print("[ACHROMA] " .. text)
end)

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local GameState = ReplicatedStorage:WaitForChild("GameState")

player.CharacterAdded:Connect(function(character: Model)
	ClientState.jumpscaring = false
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	camera.CameraSubject = humanoid
	Hud.whiteout(1, 0)
	Hud.fade(0, 0)

	if player:GetAttribute("Where") == "lobby" then
		-- the lobby: no HUD, just a slow fade up from black into the fog
		ClientState.roundStatus = "lobby"
		Hud.setHudVisible(false)
		Hud.fade(1, 2.5)
		return
	end

	-- a night: black, its number and the controls, black again, and then you're just...
	-- there, with what to do in red at the top
	ClientState.roundStatus = "alive"
	Hud.setHudVisible(true)
	local n = GameState:GetAttribute("Night")
	Audio.play("NightIntro", nil, 0.8)
	Hud.showTitle(string.format("NIGHT %d", if typeof(n) == "number" then n else 1))
	task.delay(3.6, function()
		Hud.hideTitle()
		task.delay(1.4, function()
			if ClientState.roundStatus == "alive" then
				Hud.fade(1, 4)
				Hud.revealObjective()
				Atmosphere.wakeUp()
			end
		end)
	end)
end)

player.CharacterRemoving:Connect(function()
	Hud.setHudVisible(false)
end)

-- The cursor only shows when there's something to click: the choice at a lobby door,
-- TRY AGAIN / BACK TO LOBBY, and the keypad. Otherwise Roblox would leave its arrow in
-- the middle of the screen in first person.
RunService.RenderStepped:Connect(function()
	local wanted = ClientState.choosing or ClientState.keypadOpen
	if UserInputService.MouseIconEnabled ~= wanted then
		UserInputService.MouseIconEnabled = wanted
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">Menu</string>
            <string name="Source"><![CDATA[--!strict
-- Everything between you and the dark that isn't the HUD:
--   * the choice at a door: step into an empty square in the lobby and the screen dims
--     to NIGHT 1..5 (the ones you've reached) and 1 2 3 4 (how many of you). Pick a
--     number and it's decided. A small ring in the corner opens brightness and volume.
--   * black, with the night's number, while you're being sent through (that's also the
--     teleport's loading screen) and black between a night and the lobby.
--   * when you're caught: TRY AGAIN (with how many of your group want to, 1 / 4) or
--     BACK TO LOBBY.
-- The music box plays in the lobby and in the dark.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Nights = require(Shared:WaitForChild("Nights"))
local ClientState = require(script.Parent.ClientState)
local Endings = require(script.Parent.Endings)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Menu = {}

local PALE = Color3.fromRGB(200, 200, 194)
local BLACK = Color3.new(0, 0, 0)
local FONT = Hud.TITLE_FONT
local MAX_PLAYERS = 4

local gui: ScreenGui
local choice: TextButton -- the dimmed screen at a door (a button so it can be Modal)
local nightEntries: { TextButton } = {}
local countEntries: { TextButton } = {}
local settings: Frame
local overlay: Frame
local overlayTitle: TextLabel
local music: Sound? = nil
local pad = 0 -- which door we're choosing at
local highest = 1 -- highest night we may pick
local picked = 1 -- the night that's selected
local launching: number? = nil -- going through, to this night
local death: Frame -- TRY AGAIN / BACK TO LOBBY
local againButton: TextButton
local againCount: TextLabel
local retryOpen = false -- the server offered the choice
local votedAgain = false
local brightness = 0
local volume = 1
local levelBars: { [string]: { Frame } } = {}

local function make<T>(className: string, props: { [string]: any }, parent: Instance?): T
	local inst = Instance.new(className :: any)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return (inst :: any) :: T
end

local function where(): string
	local w = player:GetAttribute("Where")
	return if typeof(w) == "string" then w else ""
end

-- Screen state ------------------------------------------------------------------

local function refresh()
	local w = where()
	-- black whenever you have no body (the endings draw their own screens), or you're
	-- on your way through a door
	local dark = launching ~= nil or (w == "between" and player.Character == nil and not ClientState.jumpscaring)
	overlay.Visible = dark
	death.Visible = retryOpen and not ClientState.jumpscaring and player.Character == nil
	ClientState.choosing = choice.Visible or death.Visible
	-- the night's number: on the way through, and in a night server waiting for the others
	local n = launching
	local waitingNight = GameState:GetAttribute("Night")
	if not n and GameState:GetAttribute("Phase") == "Waiting" and typeof(waitingNight) == "number" then
		n = waitingNight
	end
	local title = if n then Hud.spaced(string.format("NIGHT %d", n)) else ""
	if title ~= overlayTitle.Text then
		overlayTitle.Text = title
		overlayTitle.TextTransparency = 1
		TweenService:Create(overlayTitle, TweenInfo.new(2.2, Enum.EasingStyle.Sine), { TextTransparency = 0.05 }):Play()
	end
	if music then
		local wanted = if dark or w == "lobby" then 0.3 else 0
		TweenService:Create(music, TweenInfo.new(1.5), { Volume = wanted }):Play()
	end
end

local function closeChoice()
	choice.Visible = false
	settings.Visible = false
	ClientState.choosing = death.Visible
end

local function setAgainCount(again: number, size: number)
	againCount.Text = string.format("%d / %d", again, size)
end

local function selectNight(n: number)
	picked = n
	for i, entry in nightEntries do
		entry.TextTransparency = if i > highest then 0.92 elseif i == picked then 0.05 else 0.6
	end
end

local function openChoice(index: number, upTo: number)
	pad = index
	highest = math.clamp(upTo, 1, Nights.count)
	-- start on the first night you haven't beaten
	local reached = player:GetAttribute("HighestNight")
	selectNight(math.clamp(if typeof(reached) == "number" then reached else 1, 1, highest))
	choice.Visible = true
	ClientState.choosing = true
	Audio.play("MenuHover", nil, 0.4, 0.7)
end

-- Settings ----------------------------------------------------------------------

local function applySettings()
	ClientState.brightness = brightness
	local group = SoundService:FindFirstChild("AchromaMaster")
	if group and group:IsA("SoundGroup") then
		group.Volume = volume
	end
	local function fill(name: string, k: number)
		for i, bar in levelBars[name] do
			bar.BackgroundTransparency = if i <= math.floor(k * 10 + 0.5) then 0.2 else 0.85
		end
	end
	fill("brightness", (brightness + 0.09) / 0.39)
	fill("volume", volume / 1.5)
end

-- one row: "-" [ten little bars] "+"
local function settingRow(parent: Instance, y: number, name: string, onChange: (number) -> ())
	make("TextLabel", { Text = name, BackgroundTransparency = 1, Font = FONT, TextSize = 16, TextColor3 = PALE, TextTransparency = 0.5, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(24, y), Size = UDim2.fromOffset(90, 24), ZIndex = 11 }, parent)
	local function step(text: string, x: number, dir: number)
		local b: TextButton = make("TextButton", { Text = text, BackgroundTransparency = 1, Font = FONT, TextSize = 22, TextColor3 = PALE, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(24, 24), ZIndex = 11 }, parent)
		b.Activated:Connect(function()
			onChange(dir)
			Audio.play("MenuHover", nil, 0.4)
			applySettings()
		end)
	end
	step("-", 116, -1)
	local bars = {}
	for i = 1, 10 do
		table.insert(bars, make("Frame", { BackgroundColor3 = PALE, BorderSizePixel = 0, Position = UDim2.fromOffset(146 + (i - 1) * 9, y + 6), Size = UDim2.fromOffset(5, 12), ZIndex = 11 }, parent))
	end
	levelBars[name] = bars
	step("+", 240, 1)
end

-- Build -------------------------------------------------------------------------

function Menu.init()
	gui = make("ScreenGui", { Name = "AchromaMenu", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

	-- the choice at a door: Modal frees the mouse while it's up
	choice = make("TextButton", { Name = "Choice", Visible = false, Modal = true, AutoButtonColor = false, Text = "", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 0.3 }, gui)
	local column: Frame = make("Frame", { Name = "Nights", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(420, Nights.count * 54) }, choice)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, column)
	for _, night in Nights.list do
		local n = night.index
		local entry: TextButton = make("TextButton", { Name = "Night" .. n, LayoutOrder = n, Text = Hud.spaced(string.format("NIGHT %d", n)), Font = FONT, TextSize = 28, TextColor3 = PALE, BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 40) }, column)
		entry.MouseEnter:Connect(function()
			if n <= highest then
				Audio.play("MenuHover", nil, 0.3, 0.9)
			end
		end)
		entry.Activated:Connect(function()
			if n <= highest then
				selectNight(n)
				Audio.play("MenuHover", nil, 0.5, 0.8)
			end
		end)
		table.insert(nightEntries, entry)
	end
	-- how many of you: picking one decides it
	local row: Frame = make("Frame", { Name = "Players", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.42, Nights.count * 27 + 40), Size = UDim2.fromOffset(320, 50) }, choice)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 34), SortOrder = Enum.SortOrder.LayoutOrder }, row)
	for n = 1, MAX_PLAYERS do
		local b: TextButton = make("TextButton", { Name = "Players" .. n, LayoutOrder = n, Text = tostring(n), Font = FONT, TextSize = 34, TextColor3 = PALE, TextTransparency = 0.35, BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromOffset(40, 50) }, row)
		b.MouseEnter:Connect(function()
			b.TextTransparency = 0
			Audio.play("MenuHover", nil, 0.3, 1.1)
		end)
		b.MouseLeave:Connect(function()
			b.TextTransparency = 0.35
		end)
		b.Activated:Connect(function()
			Audio.play("MenuSelect", nil, 0.7, 0.85)
			Remotes.Lobby:FireServer("choose", pad, picked, n)
			closeChoice()
		end)
		table.insert(countEntries, b)
	end
	-- step back from the door: a small cross in the corner
	local back: TextButton = make("TextButton", { Name = "Back", Text = "×", Font = FONT, TextSize = 30, TextColor3 = PALE, TextTransparency = 0.5, BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 18), Size = UDim2.fromOffset(32, 32) }, choice)
	back.Activated:Connect(function()
		Remotes.Lobby:FireServer("cancel", pad)
		closeChoice()
	end)

	-- settings: a small ring in the corner of the choice screen
	local ring: TextButton = make("TextButton", { Name = "SettingsButton", Text = "", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -28, 1, -28), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, AutoButtonColor = false }, choice)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, ring)
	local ringStroke: UIStroke = make("UIStroke", { Color = PALE, Thickness = 1.2, Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ring)
	ring.MouseEnter:Connect(function()
		ringStroke.Transparency = 0.1
	end)
	ring.MouseLeave:Connect(function()
		ringStroke.Transparency = 0.6
	end)
	settings = make("Frame", { Name = "Settings", Visible = false, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -56, 1, -28), Size = UDim2.fromOffset(290, 96), BackgroundColor3 = Color3.fromRGB(6, 6, 6), BorderSizePixel = 0, ZIndex = 10 }, gui)
	make("UIStroke", { Color = PALE, Thickness = 1, Transparency = 0.8 }, settings)
	settingRow(settings, 20, "brightness", function(dir: number)
		brightness = math.clamp(brightness + dir * 0.03, -0.09, 0.3)
	end)
	settingRow(settings, 54, "volume", function(dir: number)
		volume = math.clamp(volume + dir * 0.1, 0, 1.5)
	end)
	ring.Activated:Connect(function()
		settings.Visible = not settings.Visible
	end)
	applySettings()

	-- the dark between places, with the night's number on the way in
	overlay = make("Frame", { Name = "Overlay", Visible = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0 }, gui)
	overlayTitle = make("TextLabel", { Name = "Title", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Size = UDim2.new(0.9, 0, 0, 60), BackgroundTransparency = 1, Font = FONT, TextSize = 40, TextColor3 = PALE, Text = "" }, overlay)

	-- caught: try again (all of you), or go back
	death = make("Frame", { Name = "Death", Visible = false, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 5 }, gui)
	againButton = make("TextButton", { Name = "Again", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(520, 56), BackgroundTransparency = 1, AutoButtonColor = false, Modal = true, Font = FONT, TextSize = 38, TextColor3 = PALE, TextTransparency = 0.25, Text = Hud.spaced("TRY AGAIN"), ZIndex = 5 }, death)
	againCount = make("TextLabel", { Name = "Count", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.42, 34), Size = UDim2.fromOffset(200, 30), BackgroundTransparency = 1, Font = FONT, TextSize = 22, TextColor3 = PALE, TextTransparency = 0.45, Text = "0 / 1", ZIndex = 5 }, death)
	local lobbyButton: TextButton = make("TextButton", { Name = "Lobby", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62), Size = UDim2.fromOffset(520, 44), BackgroundTransparency = 1, AutoButtonColor = false, Font = FONT, TextSize = 24, TextColor3 = PALE, TextTransparency = 0.5, Text = Hud.spaced("BACK TO LOBBY"), ZIndex = 5 }, death)
	for _, b in { againButton, lobbyButton } do
		local rest = b.TextTransparency
		b.MouseEnter:Connect(function()
			if not (b == againButton and votedAgain) then
				b.TextTransparency = 0
				Audio.play("MenuHover", nil, 0.3, 0.9)
			end
		end)
		b.MouseLeave:Connect(function()
			if not (b == againButton and votedAgain) then
				b.TextTransparency = rest
			end
		end)
	end
	againButton.Activated:Connect(function()
		if votedAgain then
			return
		end
		votedAgain = true
		againButton.TextTransparency = 0
		Audio.play("MenuSelect", nil, 0.7, 0.85)
		Remotes.Retry:FireServer("again")
	end)
	lobbyButton.Activated:Connect(function()
		Audio.play("MenuSelect", nil, 0.6, 0.7)
		Remotes.Retry:FireServer("lobby")
		retryOpen = false
		refresh()
	end)

	music = Audio.track("MusicBox", nil, 0.3)
	if music then
		music:Play()
	end

	Remotes.Lobby.OnClientEvent:Connect(function(action: string, a: any, b: any)
		if action == "choose" and typeof(a) == "number" and typeof(b) == "number" then
			openChoice(a, b)
		elseif action == "close" then
			closeChoice()
		elseif action == "launch" and typeof(a) == "number" then
			closeChoice()
			launching = a
			refresh()
			-- the same black screen while the teleport loads
			pcall(function()
				local loading: ScreenGui = make("ScreenGui", { Name = "AchromaTeleport", IgnoreGuiInset = true, DisplayOrder = 100 })
				local copy = overlay:Clone()
				copy.Visible = true
				copy.Parent = loading
				local t = copy:FindFirstChild("Title")
				if t and t:IsA("TextLabel") then
					t.TextTransparency = 0.05
				end
				TeleportService:SetTeleportGui(loading)
			end)
		end
	end)
	Remotes.Retry.OnClientEvent:Connect(function(action: string, again: any, size: any)
		if action == "open" then
			retryOpen = true
			votedAgain = false
			againButton.TextTransparency = 0.25
			setAgainCount(if typeof(again) == "number" then again else 0, if typeof(size) == "number" then size else 1)
		elseif action == "count" and typeof(again) == "number" and typeof(size) == "number" then
			setAgainCount(again, size)
		elseif action == "close" then
			retryOpen = false
		end
		refresh()
	end)
	player:GetAttributeChangedSignal("Where"):Connect(function()
		-- arrived somewhere (or the teleport fell through and we're back in the lobby)
		if where() ~= "between" then
			launching = nil
		end
		if where() ~= "lobby" then
			closeChoice()
		end
		refresh()
	end)
	player.CharacterAdded:Connect(refresh)
	player.CharacterRemoving:Connect(function()
		task.defer(refresh)
	end)
	Endings.Changed:Connect(refresh)

	local accum = 0
	RunService.RenderStepped:Connect(function(dt: number)
		accum += dt
		if accum > 0.5 then
			accum = 0
			refresh()
		end
	end)
	refresh()
end

return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">MonsterAnimator</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural animation for every monster, run locally on each client. Nothing
-- here walks smoothly: heads snap to new angles, jaws hang, limbs twitch.
--   Hollow    lurching gait, arms drag (or reach for you), unhinged jaw
--   Crawler   eight limbs skittering, upside-down face snapping around
--   Listener  head sways side to side listening; it splits open when it charges
--   Statue    no animation at all: a new pose every time it moves while unseen
--   Amalgam   four legs, front arms reaching, back arms writhing, three heads

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Monsters = require(Shared:WaitForChild("Monsters"))

local MonsterAnimator = {}

type Joint = { motor: Motor6D, base: CFrame }
type Rig = {
	model: Model,
	root: BasePart,
	kind: string,
	joints: { [string]: Joint },
	gait: number,
	twitchAt: { [string]: number },
	headTarget: { [string]: CFrame },
	headCurrent: { [string]: CFrame },
	nextClick: number,
	lastStepSign: number,
	pose: number,
	eyeGlow: PointLight?,
}

local current: Rig? = nil

local function collect(model: Model): Rig?
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local joints: { [string]: Joint } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and not joints[d.Name] then
			joints[d.Name] = { motor = d, base = d.C0 }
		end
	end
	if not joints.Neck then
		return nil -- still replicating
	end
	local glow = model:FindFirstChild("EyeGlow", true)
	local kind = model:GetAttribute("Kind")
	return {
		model = model,
		root = root,
		kind = if typeof(kind) == "string" then kind else "Hollow",
		joints = joints,
		gait = 0,
		twitchAt = {},
		headTarget = {},
		headCurrent = {},
		nextClick = os.clock() + 3,
		lastStepSign = 1,
		pose = 0,
		eyeGlow = if glow and glow:IsA("PointLight") then glow else nil,
	}
end

local function set(rig: Rig, name: string, offset: CFrame)
	local j = rig.joints[name]
	if j then
		j.motor.C0 = j.base * offset
	end
end

local function rnd(scale: number): number
	return (math.random() - 0.5) * scale
end

-- A head that holds still, then snaps to a new angle.
local function twitchHead(rig: Rig, name: string, dt: number, interval: number, yaw: number, pitch: number, roll: number, snap: number, extra: CFrame?)
	local t = os.clock()
	if t >= (rig.twitchAt[name] or 0) then
		rig.twitchAt[name] = t + interval * (0.3 + math.random())
		rig.headTarget[name] = CFrame.Angles(rnd(pitch), rnd(yaw), rnd(roll))
	end
	local target = rig.headTarget[name] or CFrame.new()
	if extra then
		target = extra * target:Lerp(CFrame.new(), 0.6)
	end
	local cur = rig.headCurrent[name] or CFrame.new()
	cur = cur:Lerp(target, math.min(1, dt * snap))
	rig.headCurrent[name] = cur
	set(rig, name, cur * CFrame.Angles(rnd(0.04), rnd(0.04), rnd(0.04)))
end

local function footstep(rig: Rig, s: number, speed: number, volume: number, pitch: number)
	local sign = if s >= 0 then 1 else -1
	if sign ~= rig.lastStepSign and speed > 2 and rig.model:GetAttribute("Silent") ~= true then
		Audio.playAt("MonsterStep", rig.root.Position - Vector3.new(0, 4, 0), math.clamp(speed / 11, 0.4, 1.5) * volume, pitch + math.random() * 0.2, 110)
	end
	rig.lastStepSign = sign
end

local function animateHollow(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local staring = state == "Apparition"
	local stride = math.clamp(speed / 14, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)

	twitchHead(rig, "Neck", dt, if chase then 0.25 elseif staring then 2.5 else 1.1, 1.0, 0.7, if staring then 0.4 else 1.4, if chase then 32 else 18, if staring then CFrame.Angles(0.15, 0, 1.1) else nil)
	local jawOpen = if kill then 1.1 + math.random() * 0.2 elseif chase then 0.55 + math.abs(math.sin(t * 14)) * 0.35 elseif staring then 0.7 else 0.12 + (math.sin(t * 1.7) + 1) * 0.08
	set(rig, "Jaw", CFrame.Angles(-jawOpen, 0, 0))
	local lean = if chase then -0.28 elseif kill then -0.2 else 0
	set(rig, "Spine", CFrame.Angles(lean + math.abs(s1) * 0.06 * stride + math.sin(t * 0.8) * 0.03, s1 * 0.08 * stride, math.sin(t * 0.9) * 0.05))
	set(rig, "Waist", CFrame.new(0, math.abs(math.cos(g)) * 0.25 * stride, 0) * CFrame.Angles(0, -s1 * 0.12 * stride, 0))
	set(rig, "LHip", CFrame.Angles(s1 * 0.75 * stride, 0, 0))
	set(rig, "RHip", CFrame.Angles(s2 * 0.75 * stride, 0, 0))
	set(rig, "LKnee", CFrame.Angles(-math.max(0, math.cos(g)) * 0.9 * stride, 0, 0))
	set(rig, "RKnee", CFrame.Angles(-math.max(0, math.cos(g + math.pi)) * 0.9 * stride, 0, 0))
	set(rig, "LAnkle", CFrame.Angles(s1 * 0.3 * stride, 0, 0))
	set(rig, "RAnkle", CFrame.Angles(s2 * 0.3 * stride, 0, 0))
	local reach = if chase or kill then 1.3 else 0
	set(rig, "LShoulder", CFrame.Angles(reach + s2 * 0.4 * stride + math.sin(t * 1.3) * 0.06 + (if math.random() < 0.02 then rnd(0.6) else 0), 0, -0.12 * reach))
	set(rig, "RShoulder", CFrame.Angles(reach + s1 * 0.4 * stride + math.sin(t * 1.1 + 1) * 0.06 + (if math.random() < 0.02 then rnd(0.6) else 0), 0, 0.12 * reach))
	set(rig, "LElbow", CFrame.Angles(-0.15 - reach * 0.25 + math.sin(t * 2.1) * 0.05, 0, 0))
	set(rig, "RElbow", CFrame.Angles(-0.15 - reach * 0.25 + math.sin(t * 2.3 + 2) * 0.05, 0, 0))
	for i = 1, 4 do
		local curl = (math.sin(t * 6 + i * 1.3) + 1) * 0.15 + (if chase or kill then 0.45 else 0) + rnd(0.05)
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
	end
	footstep(rig, s1, speed, 1, 0.85)
end

local function animateCrawler(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local stride = math.clamp(speed / 12, 0, 1.4)
	local g = rig.gait * 1.6
	twitchHead(rig, "Neck", dt, if chase then 0.15 else 0.7, 1.2, 0.6, 1.6, 40, nil)
	set(rig, "Jaw", CFrame.Angles(if kill then 1.0 elseif chase then 0.5 + math.abs(math.sin(t * 18)) * 0.4 else 0.15 + math.abs(math.sin(t * 2)) * 0.1, 0, 0))
	set(rig, "Waist", CFrame.new(0, math.abs(math.sin(g * 2)) * 0.15 * stride, 0) * CFrame.Angles(rnd(0.03), math.sin(g) * 0.06 * stride, rnd(0.03)))
	set(rig, "Tail", CFrame.Angles(math.sin(t * 2.4) * 0.04, math.sin(g) * 0.06 * stride, 0))
	-- tetrapod gait: L1 R2 L3 R4 together, the others opposite
	for i = 1, 4 do
		for _, side in { -1, 1 } do
			local name = (if side < 0 then "L" else "R") .. i
			local phase = if (i % 2 == 1) == (side < 0) then 0 else math.pi
			local s = math.sin(g + phase)
			local lift = math.max(0, math.cos(g + phase))
			set(rig, name .. "Hip", CFrame.Angles(0, s * 0.45 * stride, 0) * CFrame.Angles(0, 0, -side * lift * 0.35 * stride + rnd(0.04)))
			set(rig, name .. "Knee", CFrame.Angles(0, 0, side * lift * 0.25 * stride))
		end
	end
	if math.sin(g) * rig.lastStepSign < 0 and speed > 2 and rig.model:GetAttribute("Silent") ~= true then
		Audio.playAt("MonsterClicks", rig.root.Position, 0.6, 1.4 + math.random() * 0.3, 70)
	end
	rig.lastStepSign = if math.sin(g) >= 0 then 1 else -1
end

local function animateListener(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local hunting = state == "Chase" or state == "HuntLocker" or state == "Investigate"
	local kill = state == "Kill"
	local stride = math.clamp(speed / 12, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)
	-- listening: the head sways slowly side to side, then freezes and points when it hears
	local listen = if hunting then CFrame.Angles(0.2, 0, 0) else CFrame.Angles(math.sin(t * 0.7) * 0.15, math.sin(t * 0.45) * 0.5, math.sin(t * 0.6) * 0.5)
	twitchHead(rig, "Neck", dt, if hunting then 0.4 else 2.2, 0.5, 0.3, 0.6, if hunting then 25 else 6, listen)
	set(rig, "NeckA", CFrame.Angles(math.sin(t * 0.5) * 0.08, math.sin(t * 0.4) * 0.15, 0))
	set(rig, "NeckB", CFrame.Angles(math.sin(t * 0.6 + 1) * 0.08, math.sin(t * 0.5 + 1) * 0.15, 0))
	local open = if kill then 0.9 elseif hunting then 0.35 + math.abs(math.sin(t * 9)) * 0.3 else 0.05 + math.abs(math.sin(t * 1.3)) * 0.05
	-- the two halves of its head swing apart
	set(rig, "JawL", CFrame.Angles(0, open, 0))
	set(rig, "JawR", CFrame.Angles(0, -open, 0))
	set(rig, "EarL", CFrame.Angles(0, 0, math.sin(t * 5) * 0.15 + (if math.random() < 0.03 then rnd(0.6) else 0)))
	set(rig, "EarR", CFrame.Angles(0, 0, math.sin(t * 5.3) * 0.15 + (if math.random() < 0.03 then rnd(0.6) else 0)))
	set(rig, "Spine", CFrame.Angles((if hunting then -0.2 else 0) + math.sin(t * 0.8) * 0.04, s1 * 0.06 * stride, 0))
	set(rig, "LHip", CFrame.Angles(s1 * 0.6 * stride, 0, 0))
	set(rig, "RHip", CFrame.Angles(s2 * 0.6 * stride, 0, 0))
	set(rig, "LKnee", CFrame.Angles(-math.max(0, math.cos(g)) * 0.8 * stride, 0, 0))
	set(rig, "RKnee", CFrame.Angles(-math.max(0, math.cos(g + math.pi)) * 0.8 * stride, 0, 0))
	local reach = if hunting or kill then 0.45 else 0
	set(rig, "LShoulder", CFrame.Angles(reach + math.sin(t * 1.1) * 0.08, 0, 0))
	set(rig, "RShoulder", CFrame.Angles(reach + math.sin(t * 1.2 + 2) * 0.08, 0, 0))
	for i = 1, 3 do
		local curl = (math.sin(t * 4 + i) + 1) * 0.2
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
	end
	footstep(rig, s1, speed, 0.7, 1)
end

local function animateStatue(rig: Rig)
	local pose = rig.model:GetAttribute("Pose")
	local index = if typeof(pose) == "number" then pose else 1
	if index ~= rig.pose then
		rig.pose = index
		local offsets = Monsters.STATUE_POSES[(index - 1) % #Monsters.STATUE_POSES + 1]
		for name, j in rig.joints do
			local offset = offsets[name]
			j.motor.C0 = if offset then j.base * offset else j.base
		end
	end
end

local function animateAmalgam(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local stride = math.clamp(speed / 14, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)
	twitchHead(rig, "Neck", dt, if chase then 0.3 else 1.2, 0.8, 0.5, 1.0, 22, nil)
	twitchHead(rig, "NeckL", dt, 0.5, 1.2, 0.8, 1.4, 30, nil)
	twitchHead(rig, "NeckR", dt, 0.45, 1.2, 0.8, 1.4, 30, nil)
	local jaw = if kill then 1.1 elseif chase then 0.6 + math.abs(math.sin(t * 12)) * 0.3 else 0.2 + math.abs(math.sin(t * 1.4)) * 0.15
	set(rig, "Jaw", CFrame.Angles(-jaw, 0, 0))
	set(rig, "JawL2", CFrame.Angles(-(0.3 + math.abs(math.sin(t * 3.1)) * 0.5), 0, 0))
	set(rig, "JawR2", CFrame.Angles(-(0.3 + math.abs(math.sin(t * 2.7 + 1)) * 0.5), 0, 0))
	set(rig, "Spine", CFrame.Angles((if chase then -0.2 else 0) + math.sin(t * 1.1) * 0.05, s1 * 0.05 * stride, math.sin(t * 0.7) * 0.04))
	set(rig, "Waist", CFrame.new(0, math.abs(math.cos(g)) * 0.3 * stride, 0))
	for _, suffix in { "", "2" } do
		local a, b = if suffix == "" then s1 else s2, if suffix == "" then s2 else s1
		set(rig, "LHip" .. suffix, CFrame.Angles(a * 0.6 * stride, 0, 0))
		set(rig, "RHip" .. suffix, CFrame.Angles(b * 0.6 * stride, 0, 0))
		set(rig, "LKnee" .. suffix, CFrame.Angles(-math.max(0, a) * 0.8 * stride, 0, 0))
		set(rig, "RKnee" .. suffix, CFrame.Angles(-math.max(0, b) * 0.8 * stride, 0, 0))
	end
	local reach = if chase or kill then 1.2 else 0
	set(rig, "LShoulder", CFrame.Angles(reach + s2 * 0.35 * stride + math.sin(t * 1.4) * 0.07, 0, -0.1 * reach))
	set(rig, "RShoulder", CFrame.Angles(reach + s1 * 0.35 * stride + math.sin(t * 1.2 + 1) * 0.07, 0, 0.1 * reach))
	for i = 1, 4 do
		local curl = (math.sin(t * 6 + i * 1.3) + 1) * 0.15 + (if chase or kill then 0.45 else 0)
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
		-- back arms never stop moving
		local speedUp = if chase then 2.2 else 1
		set(rig, "BackArm" .. i, CFrame.Angles(math.sin(t * 1.7 * speedUp + i) * 0.35, math.sin(t * 1.3 * speedUp + i * 2) * 0.3, 0))
		set(rig, "BackElbow" .. i, CFrame.Angles(0, 0, math.sin(t * 2.3 * speedUp + i * 1.7) * 0.4))
	end
	if rig.eyeGlow then
		rig.eyeGlow.Brightness = 1.2 + math.abs(math.sin(t * (if chase then 6 else 2))) * 1.6
	end
	footstep(rig, s1, speed, 1.4, 0.6)
end

local function animate(rig: Rig, dt: number)
	local root = rig.root
	if root.Position.Y < -100 then
		return -- parked out of sight
	end
	local stateAttr = rig.model:GetAttribute("State")
	local state = if typeof(stateAttr) == "string" then stateAttr else "Wander"
	local vel = root.AssemblyLinearVelocity
	local speed = if root.Anchored then 0 else Vector3.new(vel.X, 0, vel.Z).Magnitude
	rig.gait += dt * speed * 0.42

	if rig.kind == "Statue" then
		animateStatue(rig)
		return
	elseif rig.kind == "Crawler" then
		animateCrawler(rig, dt, speed, state)
	elseif rig.kind == "Listener" then
		animateListener(rig, dt, speed, state)
	elseif rig.kind == "Amalgam" then
		animateAmalgam(rig, dt, speed, state)
	else
		animateHollow(rig, dt, speed, state)
	end

	-- clicking while it hunts
	local t = os.clock()
	if t >= rig.nextClick then
		rig.nextClick = t + 4 + math.random() * 7
		if rig.model:GetAttribute("Silent") ~= true and (rig.kind == "Hollow" or rig.kind == "Listener") and (state == "Wander" or state == "Search" or state == "Investigate" or state == "Apparition") then
			local head = rig.model:FindFirstChild("Head")
			if head then
				Audio.play("MonsterClicks", head, 1.1, 0.9 + math.random() * 0.2, 80)
			end
		end
	end
	if rig.eyeGlow and rig.kind ~= "Amalgam" then
		local chase = state == "Chase" or state == "Kill"
		rig.eyeGlow.Brightness = (if chase then 2 else 1.2) * (if math.random() < 0.03 then 0.2 else 1)
	end
end

function MonsterAnimator.init()
	RunService.RenderStepped:Connect(function(dt: number)
		local model = workspace:FindFirstChild("Monster")
		if not model or not model:IsA("Model") then
			current = nil
			return
		end
		if not current or current.model ~= model then
			current = collect(model)
		end
		if current then
			animate(current, dt)
		end
	end)
end

return MonsterAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- Sprinting (with stamina), crouch-walking, head bob, breathing, field of view.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Config = require(Shared:WaitForChild("Config"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local P = Config.Player
local player = Players.LocalPlayer

local Movement = {}

local humanoid: Humanoid? = nil
local stamina = P.StaminaMax
local sprintHeld = false
local exhausted = false
local lastSprint = 0
local bobTime = 0
local crouchOffset = 0
local breath: Sound? = nil

local function onCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	stamina = P.StaminaMax
	exhausted = false
	crouchOffset = 0
	ClientState.crouching = false
	if humanoid then
		humanoid.WalkSpeed = P.WalkSpeed
	end
end

local function update(dt: number)
	local h = humanoid
	if not h or not h.Parent or h.Health <= 0 then
		return
	end
	local now = os.clock()
	local camera = workspace.CurrentCamera

	local frozen = ClientState.hiding or ClientState.jumpscaring
	local moving = not frozen and h.MoveDirection.Magnitude > 0.1
	local wantsSprint = sprintHeld and moving and not ClientState.crouching and not exhausted

	if wantsSprint then
		stamina = math.max(0, stamina - P.StaminaDrain * dt)
		lastSprint = now
		if stamina <= 0 then
			exhausted = true
			Audio.play("Gasp", nil, 0.7, 1.15)
		end
	elseif now - lastSprint > P.StaminaRegenDelay then
		stamina = math.min(P.StaminaMax, stamina + P.StaminaRegen * dt)
	end
	if exhausted and stamina > P.StaminaMax * 0.35 then
		exhausted = false
	end
	ClientState.sprinting = wantsSprint
	Hud.setStamina(stamina / P.StaminaMax)

	local speed = P.WalkSpeed
	if ClientState.crouching then
		speed = P.CrouchSpeed
	elseif wantsSprint then
		speed = P.SprintSpeed
	elseif exhausted then
		speed = P.WalkSpeed * 0.75
	end
	h.WalkSpeed = speed

	-- crouch + head bob through the camera offset
	local crouchTarget = if ClientState.crouching and not frozen then -1.9 else 0
	crouchOffset += (crouchTarget - crouchOffset) * math.min(1, dt * 10)
	local bobX, bobY = 0, 0
	if moving then
		bobTime += dt * speed * 0.75
		local amp = if wantsSprint then 0.16 elseif ClientState.crouching then 0.05 else 0.09
		bobX = math.sin(bobTime) * amp
		bobY = math.abs(math.cos(bobTime)) * amp * 1.4
	end
	h.CameraOffset = Vector3.new(bobX, crouchOffset + bobY, 0)

	if camera and not ClientState.jumpscaring then
		local targetFov = P.FieldOfView + (if wantsSprint then 7 else 0) + ClientState.fear * 6
		camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(1, dt * 5)
	end

	-- heavy breathing when winded or terrified
	if breath then
		local need = math.max(0.65 - stamina / P.StaminaMax, ClientState.fear - 0.45, 0)
		local targetVolume = if ClientState.holdingBreath then 0 elseif frozen and ClientState.hiding then need * 0.6 else need * 1.6
		breath.Volume += (targetVolume - breath.Volume) * math.min(1, dt * 2)
		breath.PlaybackSpeed = 1 + need * 0.3
	end
end

function Movement.init()
	ContextActionService:BindAction("AchromaSprint", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("AchromaSprint", "RUN")

	ContextActionService:BindAction("AchromaCrouch", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin then
			ClientState.crouching = not ClientState.crouching
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("AchromaCrouch", "CROUCH")

	breath = Audio.create("BreathLoop", nil, 0)
	if breath then
		breath:Play()
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.RenderStepped:Connect(update)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Prompts</string>
            <string name="Source"><![CDATA[--!strict
-- Interaction prompts without words: when you're close enough to use something, a small
-- pale dot appears on it with the key to press. Holding fills a ring around it. Tap it
-- on a phone.

local ProximityPromptService = game:GetService("ProximityPromptService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Prompts = {}

local PALE = Color3.fromRGB(215, 215, 208)

type Shown = { gui: BillboardGui, ring: UIStroke, fill: Frame, holdStart: number? }
local shown: { [ProximityPrompt]: Shown } = {}

local function keyFor(prompt: ProximityPrompt, input: Enum.ProximityPromptInputType): string
	if input == Enum.ProximityPromptInputType.Gamepad then
		return string.gsub(prompt.GamepadKeyCode.Name, "^Button", "")
	elseif input == Enum.ProximityPromptInputType.Touch then
		return ""
	end
	return prompt.KeyboardKeyCode.Name
end

local function show(prompt: ProximityPrompt, input: Enum.ProximityPromptInputType)
	local gui = Instance.new("BillboardGui")
	gui.Name = "AchromaPrompt"
	gui.AlwaysOnTop = true
	gui.Size = UDim2.fromOffset(34, 34)
	gui.LightInfluence = 0
	gui.Adornee = prompt.Parent :: Instance
	gui.Active = true

	local dot = Instance.new("TextButton")
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Position = UDim2.fromScale(0.5, 0.5)
	dot.Size = UDim2.fromOffset(22, 22)
	dot.BackgroundColor3 = Color3.new(0, 0, 0)
	dot.BackgroundTransparency = 0.55
	dot.AutoButtonColor = false
	dot.Font = Enum.Font.Garamond
	dot.TextSize = 15
	dot.TextColor3 = PALE
	dot.TextTransparency = 0.25
	dot.Text = keyFor(prompt, input)
	dot.Parent = gui
	local round = Instance.new("UICorner")
	round.CornerRadius = UDim.new(0.5, 0)
	round.Parent = dot
	local ring = Instance.new("UIStroke")
	ring.Color = PALE
	ring.Thickness = 1
	ring.Transparency = 0.55
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = dot

	-- fills from the centre while you hold
	local fill = Instance.new("Frame")
	fill.AnchorPoint = Vector2.new(0.5, 0.5)
	fill.Position = UDim2.fromScale(0.5, 0.5)
	fill.Size = UDim2.fromScale(0, 0)
	fill.BackgroundColor3 = PALE
	fill.BackgroundTransparency = 0.6
	fill.BorderSizePixel = 0
	fill.ZIndex = 0
	fill.Parent = dot
	local fillRound = Instance.new("UICorner")
	fillRound.CornerRadius = UDim.new(0.5, 0)
	fillRound.Parent = fill

	-- touch: press and hold the dot itself
	dot.InputBegan:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldBegin()
		end
	end)
	dot.InputEnded:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.Touch or io.UserInputType == Enum.UserInputType.MouseButton1 then
			prompt:InputHoldEnd()
		end
	end)

	gui.Parent = player:WaitForChild("PlayerGui")
	shown[prompt] = { gui = gui, ring = ring, fill = fill, holdStart = nil }
end

local function hide(prompt: ProximityPrompt)
	local s = shown[prompt]
	if s then
		s.gui:Destroy()
		shown[prompt] = nil
	end
end

function Prompts.init()
	ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt, input: Enum.ProximityPromptInputType)
		if prompt.Style == Enum.ProximityPromptStyle.Custom then
			show(prompt, input)
		end
	end)
	ProximityPromptService.PromptHidden:Connect(hide)
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt: ProximityPrompt)
		local s = shown[prompt]
		if s then
			s.holdStart = os.clock()
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt: ProximityPrompt)
		local s = shown[prompt]
		if s then
			s.holdStart = nil
			s.fill.Size = UDim2.fromScale(0, 0)
		end
	end)
	RunService.RenderStepped:Connect(function()
		for prompt, s in shown do
			if not prompt.Parent or not prompt.Enabled then
				hide(prompt)
			else
				local start = s.holdStart
				if start and prompt.HoldDuration > 0 then
					local k = math.clamp((os.clock() - start) / prompt.HoldDuration, 0, 1)
					s.fill.Size = UDim2.fromScale(k, k)
				end
				-- the dot breathes very slightly so it reads as "something's here"
				s.ring.Transparency = 0.5 + 0.15 * math.sin(os.clock() * 3)
			end
		end
	end)
end

return Prompts
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="66">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>