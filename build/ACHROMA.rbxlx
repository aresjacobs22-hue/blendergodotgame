  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Interactables</string>
          <string name="Source"><![CDATA[--!strict
-- Everything you can interact with: doors, keys, batteries, hiding lockers, notes,
-- the padlocked exit door, its keypad, and the escape zone behind it.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes

type Layout = Maze.Layout
type World = WorldBuilder.World

export type Door = {
	part: BasePart,
	closed: CFrame,
	opened: CFrame,
	isOpen: boolean,
	busy: boolean,
	prompt: ProximityPrompt,
}

export type Locker = {
	model: Model,
	anchor: BasePart,
	inside: CFrame,
	outside: CFrame,
	occupant: Player?,
	prompt: ProximityPrompt,
	lastUse: number,
}

export type Hooks = {
	onKey: (player: Player, index: number) -> (),
	onHide: (player: Player, locker: Locker) -> (),
	onExitOpened: (player: Player) -> (),
	onEscaped: (player: Player) -> (),
	onNoise: (position: Vector3, radius: number) -> (),
	isAlive: (player: Player) -> boolean,
}

local Interactables = {}
Interactables.__index = Interactables

export type Interactables = typeof(setmetatable(
	{} :: {
		layout: Layout,
		world: World,
		hooks: Hooks,
		folder: Folder,
		doors: { Door },
		lockers: { Locker },
		padlocks: { { BasePart } },
		padlocksLeft: number,
		exitLeaves: { { part: BasePart, opened: CFrame } },
		keypad: BasePart,
		keypadText: TextLabel,
		exitOpen: boolean,
		escaped: { [Player]: boolean },
		lastCodeTry: { [Player]: number },
		connections: { RBXScriptConnection },
	},
	Interactables
))

local part = WorldBuilder.part
local decor = WorldBuilder.decor

local function prompt(parent: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = distance or 8
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Interactables.new(layout: Layout, world: World, hooks: Hooks): Interactables
	local folder = Instance.new("Folder")
	folder.Name = "Interactive"
	folder.Parent = world.model

	local self = setmetatable({
		layout = layout,
		world = world,
		hooks = hooks,
		folder = folder,
		doors = {},
		lockers = {},
		padlocks = {},
		padlocksLeft = Config.Maze.KeyCount,
		exitLeaves = {},
		keypad = (nil :: any) :: BasePart,
		keypadText = (nil :: any) :: TextLabel,
		exitOpen = false,
		escaped = {},
		lastCodeTry = {},
		connections = {},
	}, Interactables)

	self:_buildDoors()
	self:_buildKeys()
	self:_buildBatteries()
	self:_buildLockers()
	self:_buildNotes()
	self:_buildExit()

	table.insert(self.connections, Remotes.LeaveHiding.OnServerEvent:Connect(function(player: Player)
		self:leave(player, false)
	end))
	table.insert(self.connections, Remotes.SubmitCode.OnServerEvent:Connect(function(player: Player, code: unknown)
		self:_submitCode(player, code)
	end))
	table.insert(self.connections, world.escapeZone.Touched:Connect(function(hit: BasePart)
		if not self.exitOpen then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if player and not self.escaped[player] and self.hooks.isAlive(player) then
			self.escaped[player] = true
			self.hooks.onEscaped(player)
		end
	end))

	return self
end

-- Doors ------------------------------------------------------------------------

function Interactables._buildDoors(self: Interactables)
	for key, kind in self.layout.edges do
		if kind == "door" then
			local x, z, dir = Maze.parseEdgeKey(key)
			local frame = WorldBuilder.edgeFrame(x, z, dir)
			local w, h = WorldBuilder.DOOR_WIDTH - 0.2, WorldBuilder.DOOR_HEIGHT - 0.15
			local closed = frame * CFrame.new(0, h / 2 + 0.05, 0)
			local hinge = frame * CFrame.new(-w / 2, h / 2 + 0.05, 0)
			local opened = hinge * CFrame.Angles(0, math.rad(-100), 0) * hinge:Inverse() * closed

			local door = part(self.folder, "Door", Vector3.new(w, h, 0.35), closed, Enum.Material.Wood, Color3.fromRGB(80, 68, 58))
			door.CollisionGroup = "Furniture"
			for _, side in { -1, 1 } do
				local knob = part(self.folder, "Knob", Vector3.new(0.35, 0.35, 0.35), closed * CFrame.new(w / 2 - 0.6, -0.7, side * 0.3), Enum.Material.Metal, Color3.fromRGB(170, 170, 160), Enum.PartType.Ball)
				knob.Anchored = false
				knob.CanCollide = false
				knob.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = door
				weld.Part1 = knob
				weld.Parent = knob
			end

			local entry: Door = {
				part = door,
				closed = closed,
				opened = opened,
				isOpen = false,
				busy = false,
				prompt = prompt(door, "Open", "Door", 0, 9),
			}
			table.insert(self.doors, entry)
			-- a couple of doors start ajar
			if self.world.random:NextNumber() < 0.35 then
				entry.isOpen = true
				door.CFrame = opened
				entry.prompt.ActionText = "Close"
			end
			entry.prompt.Triggered:Connect(function(player: Player)
				if self.hooks.isAlive(player) then
					self:setDoor(entry, not entry.isOpen, false)
					if not entry.isOpen then
						self.hooks.onNoise(door.Position, 30) -- shutting a door carries
					end
				end
			end)
		end
	end
end

function Interactables.setDoor(self: Interactables, door: Door, open: boolean, slam: boolean)
	if door.busy or door.isOpen == open then
		return
	end
	door.busy = true
	door.isOpen = open
	local info = if slam
		then TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(door.part, info, { CFrame = if open then door.opened else door.closed })
	tween:Play()
	if slam then
		Audio.play("DoorSlam", door.part, 1.3, 1, 110)
	elseif open then
		Audio.play("DoorOpen", door.part, 0.8, 1, 60)
	else
		Audio.play("DoorSlam", door.part, 0.5, 1.25, 60)
	end
	door.prompt.ActionText = if open then "Close" else "Open"
	tween.Completed:Once(function()
		door.busy = false
	end)
end

-- The monster bursts through closed doors in its way.
function Interactables.slamOpenNear(self: Interactables, position: Vector3, radius: number)
	for _, door in self.doors do
		if not door.isOpen and not door.busy and (door.part.Position - position).Magnitude < radius then
			self:setDoor(door, true, true)
		end
	end
end

-- Keys -------------------------------------------------------------------------

local function backWallSide(layout: Layout, x: number, z: number): string
	for _, d in Maze.DIRS do
		if Maze.isPassable(Maze.getEdge(layout, x, z, d)) then
			local back = Maze.OPPOSITE[d]
			if Maze.getEdge(layout, x, z, back) == "wall" then
				return back
			end
		end
	end
	for _, d in Maze.DIRS do
		if Maze.getEdge(layout, x, z, d) == "wall" then
			return d
		end
	end
	return "N"
end

function Interactables._buildKeys(self: Interactables)
	local metal = Color3.fromRGB(196, 196, 190)
	for index, cell in self.layout.keys do
		local frame = WorldBuilder.sideFrame(cell.x, cell.z, backWallSide(self.layout, cell.x, cell.z))
		local crate = part(self.folder, "KeyCrate", Vector3.new(2.6, 2.6, 2.6), frame * CFrame.new(0, 1.3, -1.7), Enum.Material.WoodPlanks, Color3.fromRGB(96, 86, 74))
		crate.CollisionGroup = "Furniture"

		local model = Instance.new("Model")
		model.Name = "Key" .. index
		local base = frame * CFrame.new(0, 2.68, -1.7) * CFrame.Angles(0, self.world.random:NextNumber(0, math.pi * 2), 0)
		local shaft = decor(part(model, "Shaft", Vector3.new(1.6, 0.18, 0.18), base * CFrame.new(0.2, 0, 0), Enum.Material.Metal, metal))
		shaft.CanQuery = true
		shaft.Reflectance = 0.15
		decor(part(model, "Bow", Vector3.new(0.12, 0.9, 0.9), base * CFrame.new(-0.85, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Metal, metal, Enum.PartType.Cylinder))
		decor(part(model, "Tooth", Vector3.new(0.16, 0.12, 0.4), base * CFrame.new(0.85, 0, 0.22), Enum.Material.Metal, metal))
		decor(part(model, "Tooth", Vector3.new(0.16, 0.12, 0.28), base * CFrame.new(0.55, 0, 0.16), Enum.Material.Metal, metal))
		local tag = decor(part(model, "Tag", Vector3.new(0.6, 0.03, 0.8), base * CFrame.new(-1.6, 0, 0.3) * CFrame.Angles(0, 0.3, 0), Enum.Material.SmoothPlastic, Color3.fromRGB(220, 214, 198)))
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Top
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 120
		gui.Parent = tag
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.SpecialElite
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(20, 20, 20)
		local mask = {}
		for i = 1, #self.layout.code do
			mask[i] = if i == index then string.sub(self.layout.code, i, i) else "_"
		end
		label.Text = table.concat(mask, " ")
		label.Parent = gui
		local glint = Instance.new("PointLight")
		glint.Range = 6
		glint.Brightness = 0.9
		glint.Parent = shaft
		model.PrimaryPart = shaft
		model.Parent = self.folder

		local p = prompt(shaft, "Take", "Key", 0.5, 8)
		p.Triggered:Connect(function(player: Player)
			if not self.hooks.isAlive(player) or model.Parent == nil then
				return
			end
			Audio.play("KeyPickup", crate, 1, 1, 70)
			model:Destroy()
			self.hooks.onKey(player, index)
			self.hooks.onNoise(crate.Position, 45) -- rattling the key loose carries
		end)
	end
end

-- Batteries --------------------------------------------------------------------

function Interactables._buildBatteries(self: Interactables)
	for _, cell in self.layout.batteries do
		local frame = WorldBuilder.sideFrame(cell.x, cell.z, backWallSide(self.layout, cell.x, cell.z))
		local battery = decor(part(self.folder, "Battery", Vector3.new(1.1, 0.5, 0.5), frame * CFrame.new(self.world.random:NextNumber(-2.5, 2.5), 0.26, -0.7) * CFrame.Angles(0, self.world.random:NextNumber(-0.6, 0.6), 0), Enum.Material.Metal, Color3.fromRGB(70, 70, 70), Enum.PartType.Cylinder))
		battery.CanQuery = true
		decor(part(battery, "BatteryCap", Vector3.new(0.12, 0.3, 0.3), battery.CFrame * CFrame.new(0.6, 0, 0), Enum.Material.Metal, Color3.fromRGB(200, 200, 200), Enum.PartType.Cylinder))
		local p = prompt(battery, "Take", "Battery", 0, 8)
		p.Triggered:Connect(function(player: Player)
			if not self.hooks.isAlive(player) or battery.Parent == nil then
				return
			end
			battery:Destroy()
			Remotes.Battery:FireClient(player, Config.Player.BatteryPickup)
		end)
	end
end

-- Hiding lockers -----------------------------------------------------------------

function Interactables._buildLockers(self: Interactables)
	for _, spot in self.layout.lockers do
		local w, h, depth = 4.2, 8.4, 3.4
		local center = WorldBuilder.sideFrame(spot.x, spot.z, spot.side) * CFrame.new(0, 0, -depth / 2)
		local material = if spot.house then Enum.Material.Wood else Enum.Material.Metal
		local color = if spot.house then Color3.fromRGB(70, 58, 50) else Color3.fromRGB(100, 102, 104)

		local model = Instance.new("Model")
		model.Name = if spot.house then "Wardrobe" else "Locker"
		local function panel(name: string, size: Vector3, offset: CFrame)
			local p = part(model, name, size, center * offset, material, color)
			p.CollisionGroup = "Furniture"
		end
		panel("Back", Vector3.new(w, h, 0.2), CFrame.new(0, h / 2, depth / 2 - 0.1))
		panel("Side", Vector3.new(0.2, h, depth), CFrame.new(-(w / 2 - 0.1), h / 2, 0))
		panel("Side", Vector3.new(0.2, h, depth), CFrame.new(w / 2 - 0.1, h / 2, 0))
		panel("Top", Vector3.new(w, 0.2, depth), CFrame.new(0, h - 0.1, 0))
		panel("Bottom", Vector3.new(w, 0.2, depth), CFrame.new(0, 0.1, 0))
		-- slatted front: you can peek out between the slats
		local y = 0.45
		while y < h - 0.3 do
			panel("Slat", Vector3.new(w - 0.4, 0.44, 0.15), CFrame.new(0, y, -depth / 2 + 0.08))
			y += 0.62
		end
		panel("Handle", Vector3.new(0.18, 1.2, 0.2), CFrame.new(w / 2 - 0.6, 4.2, -depth / 2 - 0.08))

		local anchor = decor(part(model, "PromptAnchor", Vector3.new(1, 1, 1), center * CFrame.new(0, 3.5, -depth / 2 - 0.3), Enum.Material.SmoothPlastic, Color3.new()))
		anchor.Transparency = 1
		model.Parent = self.folder

		local locker: Locker = {
			model = model,
			anchor = anchor,
			inside = center * CFrame.new(0, 3.1, 0.15),
			outside = center * CFrame.new(0, 3.1, -(depth / 2 + 2.6)),
			occupant = nil,
			prompt = prompt(anchor, "Hide", if spot.house then "Wardrobe" else "Locker", 0.25, 7),
			lastUse = -math.huge,
		}
		table.insert(self.lockers, locker)
		locker.prompt.Triggered:Connect(function(player: Player)
			self:hide(player, locker)
		end)
	end
end

function Interactables.lockerOf(self: Interactables, player: Player): Locker?
	for _, locker in self.lockers do
		if locker.occupant == player then
			return locker
		end
	end
	return nil
end

function Interactables.hide(self: Interactables, player: Player, locker: Locker)
	if locker.occupant or os.clock() - locker.lastUse < 0.8 then
		return
	end
	if not self.hooks.isAlive(player) or self:lockerOf(player) then
		return
	end
	local character = player.Character
	local root = rootOf(player)
	if not character or not root then
		return
	end
	locker.occupant = player
	locker.lastUse = os.clock()
	root.Anchored = true
	character:PivotTo(locker.inside)
	player:SetAttribute("Hiding", true)
	locker.prompt.Enabled = false
	Audio.play("Locker", locker.anchor, 0.9, 1, 60)
	self.hooks.onHide(player, locker)
end

-- pulled = the monster dragged them out, so they stay frozen for the jumpscare.
function Interactables.leave(self: Interactables, player: Player, pulled: boolean)
	local locker = self:lockerOf(player)
	if not locker then
		return
	end
	if not pulled and os.clock() - locker.lastUse < 0.5 then
		return
	end
	locker.occupant = nil
	locker.lastUse = os.clock()
	locker.prompt.Enabled = true
	player:SetAttribute("Hiding", false)
	local character = player.Character
	local root = rootOf(player)
	if character and root then
		character:PivotTo(locker.outside)
		if not pulled then
			root.Anchored = false
		end
	end
	Audio.play("Locker", locker.anchor, if pulled then 1.4 else 0.8, if pulled then 0.8 else 1.05, 70)
end

function Interactables.release(self: Interactables, player: Player)
	local locker = self:lockerOf(player)
	if locker then
		locker.occupant = nil
		locker.prompt.Enabled = true
	end
	self.lastCodeTry[player] = nil
	player:SetAttribute("Hiding", false)
end

-- Notes --------------------------------------------------------------------------

function Interactables._buildNotes(self: Interactables)
	for _, note in self.world.notes do
		note.part.CanQuery = true
		local p = prompt(note.part, "Read", "Note", 0, 7)
		p.Triggered:Connect(function(player: Player)
			Remotes.Notify:FireClient(player, note.text, "note")
		end)
	end
end

-- Exit door, padlocks, keypad ------------------------------------------------------

function Interactables._buildExit(self: Interactables)
	local e = self.layout.exitCell
	-- the exit edge belongs to the virtual cell south of the hall: Back face = hall side
	local frame = WorldBuilder.edgeFrame(e.x, e.z - 1, "N")
	local w, h = WorldBuilder.EXIT_WIDTH, WorldBuilder.EXIT_HEIGHT
	local steel = Color3.fromRGB(86, 86, 90)

	for _, sx in { -1, 1 } do
		local closed = frame * CFrame.new(sx * w / 4, h / 2 + 0.02, 0)
		local hinge = frame * CFrame.new(sx * w / 2, h / 2 + 0.02, 0)
		local opened = hinge * CFrame.Angles(0, math.rad(-sx * 95), 0) * hinge:Inverse() * closed
		local leaf = part(self.folder, "ExitDoor", Vector3.new(w / 2 - 0.08, h - 0.05, 0.5), closed, Enum.Material.DiamondPlate, steel)
		table.insert(self.exitLeaves, { part = leaf :: BasePart, opened = opened })
	end
	-- a chain across both leaves
	for i = 0, 12 do
		decor(part(self.folder, "Chain", Vector3.new(0.32, 0.18, 0.18), frame * CFrame.new(-2.4 + i * 0.4, 5.1 + math.sin(i * 0.5) * 0.15, 0.42) * CFrame.Angles(i % 2 * math.rad(90), 0, 0), Enum.Material.Metal, Color3.fromRGB(120, 120, 120)))
	end
	for i = 1, Config.Maze.KeyCount do
		local x = -1.05 + (i - 1) * 0.7
		local y = 4.4 + (i % 2) * 0.55
		local body = decor(part(self.folder, "Padlock", Vector3.new(0.55, 0.65, 0.25), frame * CFrame.new(x, y, 0.5), Enum.Material.Metal, Color3.fromRGB(150, 150, 146)))
		local shackle = decor(part(self.folder, "Shackle", Vector3.new(0.38, 0.45, 0.08), frame * CFrame.new(x, y + 0.5, 0.5), Enum.Material.Metal, Color3.fromRGB(180, 180, 176)))
		table.insert(self.padlocks, { body, shackle })
	end

	local keypad = part(self.folder, "Keypad", Vector3.new(1.2, 1.8, 0.3), frame * CFrame.new(w / 2 + 1.15, 4.8, 0.65), Enum.Material.Metal, Color3.fromRGB(40, 40, 42))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.LightInfluence = 0
	gui.Brightness = 1.5
	gui.Parent = keypad
	local text = Instance.new("TextLabel")
	text.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
	text.BorderSizePixel = 0
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.Code
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(210, 210, 210)
	text.Parent = gui
	local glow = Instance.new("PointLight")
	glow.Range = 7
	glow.Brightness = 0.5
	glow.Parent = keypad
	self.keypad = keypad
	self.keypadText = text
	self:_refreshKeypad()

	local p = prompt(keypad, "Use", "Keypad", 0, 7)
	p.Triggered:Connect(function(player: Player)
		if self.exitOpen or not self.hooks.isAlive(player) then
			return
		end
		if self.padlocksLeft > 0 then
			Audio.play("KeypadError", keypad, 0.8, 1, 50)
			Remotes.Notify:FireClient(player, string.format("%d padlocks still hold the door. Find the keys.", self.padlocksLeft))
			return
		end
		Remotes.OpenKeypad:FireClient(player)
	end)
end

function Interactables._refreshKeypad(self: Interactables)
	if self.exitOpen then
		self.keypadText.Text = "OPEN"
	elseif self.padlocksLeft > 0 then
		self.keypadText.Text = string.format("LOCKED\n%d/%d", Config.Maze.KeyCount - self.padlocksLeft, Config.Maze.KeyCount)
	else
		self.keypadText.Text = "ENTER\nCODE"
	end
end

function Interactables.removePadlock(self: Interactables)
	if self.padlocksLeft <= 0 then
		return
	end
	local lock = self.padlocks[self.padlocksLeft]
	self.padlocksLeft -= 1
	for _, p in lock do
		p.Anchored = false
		p.CanCollide = true
	end
	Audio.play("Unlock", self.keypad, 0.9, 0.9, 120)
	self:_refreshKeypad()
end

function Interactables._submitCode(self: Interactables, player: Player, code: unknown)
	if typeof(code) ~= "string" or #code > 8 then
		return
	end
	if self.exitOpen or self.padlocksLeft > 0 or not self.hooks.isAlive(player) then
		return
	end
	local now = os.clock()
	local last = self.lastCodeTry[player]
	if last and now - last < 0.8 then
		return
	end
	self.lastCodeTry[player] = now
	local root = rootOf(player)
	if not root or (root.Position - self.keypad.Position).Magnitude > 16 then
		return
	end
	if code == self.layout.code then
		self:_openExit(player)
	else
		Audio.play("KeypadError", self.keypad, 1.3, 1, 100)
		self.keypadText.Text = "WRONG"
		task.delay(1.2, function()
			if self.keypad.Parent then
				self:_refreshKeypad()
			end
		end)
		Remotes.Notify:FireClient(player, "Wrong code. That buzzer was loud...")
		self.hooks.onNoise(self.keypad.Position, 70)
	end
end

function Interactables._openExit(self: Interactables, player: Player)
	self.exitOpen = true
	self:_refreshKeypad()
	Audio.play("Unlock", self.keypad, 1.2, 1, 120)
	task.delay(0.6, function()
		if not self.keypad.Parent then
			return
		end
		for _, leaf in self.exitLeaves do
			TweenService:Create(leaf.part, TweenInfo.new(2.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = leaf.opened }):Play()
		end
		Audio.play("DoorOpen", self.exitLeaves[1].part, 1.4, 0.55, 140)
		self.world.exitLight.Enabled = true
	end)
	self.hooks.onExitOpened(player)
end

function Interactables.destroy(self: Interactables)
	for _, c in self.connections do
		c:Disconnect()
	end
	table.clear(self.connections)
	for _, locker in self.lockers do
		if locker.occupant then
			locker.occupant:SetAttribute("Hiding", false)
		end
	end
end

return Interactables
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="27">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- ACHROMA server entry point.
local RoundManager = require(script.Parent.RoundManager)

RoundManager.run()
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">MonsterAI</string>
          <string name="Source"><![CDATA[--!strict
-- The thing in the halls. Server-side brain:
--   Dormant     hidden away; now and then it APPEARS at the end of your corridor,
--               stares, and vanishes when you get close
--   Wander      roams, drifting towards wherever players are
--   Investigate heard something (running, a slammed door, a wrong code) and goes to look
--   Chase       saw you. Screams. Runs at you. Gets faster with every key taken
--   Search      lost you; sniffs around the last place it saw you
--   HuntLocker  watched you climb into a locker, and is coming to pull you out
--   Kill        caught someone

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Interactables = require(script.Parent.Interactables)
local MonsterRig = require(script.Parent.MonsterRig)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local M = Config.Monster

type Layout = Maze.Layout
type Locker = Interactables.Locker

export type Hooks = {
	getPlayers: () -> { Player }, -- players still in the round (not caught, not escaped)
	onCaught: (player: Player, monster: Model) -> (),
	onAwake: () -> (),
}

local MonsterAI = {}
MonsterAI.__index = MonsterAI

export type MonsterAI = typeof(setmetatable(
	{} :: {
		layout: Layout,
		world: WorldBuilder.World,
		interactables: Interactables.Interactables,
		hooks: Hooks,
		rig: MonsterRig.Rig,
		state: string,
		path: { Vector3 },
		pathIndex: number,
		pathGoal: Vector3?,
		lastRepath: number,
		target: Player?,
		lastSeenPos: Vector3?,
		lastSeenTime: number,
		aggression: number,
		frenzyUntil: number,
		awake: boolean,
		awakeAt: number,
		nextApparition: number,
		apparitionTarget: Player?,
		apparitionEnds: number,
		sawHide: { [Player]: Locker },
		huntLocker: Locker?,
		pauseUntil: number,
		searchCenter: Vector3,
		searchUntil: number,
		lastScream: number,
		lastContact: number,
		stuckCheckAt: number,
		stuckPos: Vector3,
		stuckCount: number,
		sightParams: RaycastParams,
		moveParams: RaycastParams,
		noise: { position: Vector3, radius: number }?,
		thinkAccum: number,
		connection: RBXScriptConnection?,
		destroyed: boolean,
		random: Random,
	},
	MonsterAI
))

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
end

local function headOf(player: Player): BasePart?
	local character = player.Character
	return if character then character:FindFirstChild("Head") :: BasePart? else nil
end

function MonsterAI.new(layout: Layout, world: WorldBuilder.World, interactables: Interactables.Interactables, hooks: Hooks): MonsterAI
	local rig = MonsterRig.build()
	rig.model.Parent = workspace

	local sightParams = RaycastParams.new()
	sightParams.FilterType = Enum.RaycastFilterType.Include
	sightParams.FilterDescendantsInstances = { world.model }

	-- movement checks ignore furniture (it walks through it) and non-collidable decor
	local moveParams = RaycastParams.new()
	moveParams.FilterType = Enum.RaycastFilterType.Include
	moveParams.FilterDescendantsInstances = { world.model }
	moveParams.CollisionGroup = "Monster"
	moveParams.RespectCanCollide = true

	local now = os.clock()
	local random = Random.new(layout.seed + 99)
	local self = setmetatable({
		layout = layout,
		world = world,
		interactables = interactables,
		hooks = hooks,
		rig = rig,
		state = "Dormant",
		path = {},
		pathIndex = 1,
		pathGoal = nil,
		lastRepath = 0,
		target = nil,
		lastSeenPos = nil,
		lastSeenTime = 0,
		aggression = 0,
		frenzyUntil = 0,
		awake = false,
		awakeAt = now + M.AwakenAfter,
		nextApparition = now + random:NextNumber(M.ApparitionMin * 0.5, M.ApparitionMax * 0.6),
		apparitionTarget = nil,
		apparitionEnds = 0,
		sawHide = {},
		huntLocker = nil,
		pauseUntil = 0,
		searchCenter = Vector3.zero,
		searchUntil = 0,
		lastScream = -math.huge,
		lastContact = now,
		stuckCheckAt = 0,
		stuckPos = Vector3.zero,
		stuckCount = 0,
		sightParams = sightParams,
		moveParams = moveParams,
		noise = nil,
		thinkAccum = 0,
		connection = nil,
		destroyed = false,
		random = random,
	}, MonsterAI)

	self:_park()
	self:_setState("Dormant")
	return self
end

function MonsterAI.start(self: MonsterAI)
	self.connection = RunService.Heartbeat:Connect(function(dt: number)
		self.thinkAccum += dt
		if self.thinkAccum >= 0.1 then
			self.thinkAccum = 0
			self:_think()
		end
	end)
end

function MonsterAI.destroy(self: MonsterAI)
	self.destroyed = true
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	self.rig.model:Destroy()
end

-- Public hooks -----------------------------------------------------------------

function MonsterAI.setAggression(self: MonsterAI, keysFound: number)
	self.aggression = keysFound
	self:_updateSpeed()
end

function MonsterAI.hearNoise(self: MonsterAI, position: Vector3, radius: number)
	if not self.noise or radius > self.noise.radius then
		self.noise = { position = position, radius = radius }
	end
end

function MonsterAI.onPlayerHid(self: MonsterAI, player: Player, locker: Locker)
	-- it only knows which locker you're in if it was watching you a moment ago
	if self.state == "Chase" and self.target == player and os.clock() - self.lastSeenTime < 0.8 then
		self.sawHide[player] = locker
	end
end

function MonsterAI.onExitOpened(self: MonsterAI)
	if not self.awake then
		self:awaken()
	end
	-- final stretch: it knows where everyone is
	self.frenzyUntil = os.clock() + M.FrenzyTime
	local root = self.rig.root
	local nearest: Player? = nil
	local best = math.huge
	for _, player in self.hooks.getPlayers() do
		local proot = rootOf(player)
		if proot and not player:GetAttribute("Hiding") then
			local d = (proot.Position - root.Position).Magnitude
			if d < best then
				nearest, best = player, d
			end
		end
	end
	if nearest and self.state ~= "Kill" then
		self.lastSeenTime = os.clock()
		self:_startChase(nearest)
	end
end

function MonsterAI.forget(self: MonsterAI, player: Player)
	self.sawHide[player] = nil
	if self.target == player then
		self.target = nil
	end
	if self.apparitionTarget == player then
		self.apparitionTarget = nil
	end
end

function MonsterAI.awaken(self: MonsterAI)
	if self.awake or self.destroyed then
		return
	end
	self.awake = true

	-- wake up in the maze cell farthest from every player
	local spawnCell = self.layout.monsterSpawn
	local players = self.hooks.getPlayers()
	if #players > 0 then
		local maps = {}
		for _, player in players do
			local proot = rootOf(player)
			if proot then
				table.insert(maps, Maze.distances(self.layout, Maze.cellOf(self.layout, proot.Position.X, proot.Position.Z)))
			end
		end
		local bestScore = -1
		for z = 0, self.layout.depth - 1 do
			for x = 0, self.layout.width - 1 do
				if not Maze.isHouse(self.layout, x, z) then
					local score = math.huge
					for _, dist in maps do
						score = math.min(score, dist[Maze.key(x, z)] or 0)
					end
					if score > bestScore then
						bestScore = score
						spawnCell = { x = x, z = z }
					end
				end
			end
		end
	end
	local cx, cz = Maze.cellCenter(self.layout, spawnCell)
	self.rig.model:PivotTo(CFrame.new(cx, MonsterRig.ROOT_HEIGHT, cz))
	self:_release()
	if self.rig.growl then
		self.rig.growl:Play()
	end
	self:_setState("Wander")
	self:_pickWanderTarget()
	self.hooks.onAwake()
end

-- Internals ----------------------------------------------------------------------

function MonsterAI._park(self: MonsterAI)
	self.rig.root.Anchored = true
	self.rig.model:PivotTo(self.world.hiddenSpot)
	self.rig.humanoid:MoveTo(self.rig.root.Position)
end

function MonsterAI._release(self: MonsterAI)
	self.rig.root.Anchored = false
	pcall(function()
		self.rig.root:SetNetworkOwner(nil) -- the server drives it, never a nearby client
	end)
end

function MonsterAI._setState(self: MonsterAI, state: string)
	self.state = state
	self.rig.model:SetAttribute("State", state)
	if state ~= "Chase" and state ~= "HuntLocker" and state ~= "Kill" then
		self.rig.model:SetAttribute("TargetUserId", 0)
	end
	self:_updateSpeed()
end

function MonsterAI._chaseSpeed(self: MonsterAI): number
	local speed = M.ChaseSpeed + self.aggression * M.ChaseSpeedPerKey
	if os.clock() < self.frenzyUntil then
		speed += M.FrenzyBonus
	end
	return speed
end

function MonsterAI._updateSpeed(self: MonsterAI)
	local s = self.state
	local speed = 0
	if s == "Wander" then
		speed = M.WanderSpeed
	elseif s == "Investigate" then
		speed = M.InvestigateSpeed
	elseif s == "Search" then
		speed = M.SearchSpeed
	elseif s == "Chase" then
		speed = self:_chaseSpeed()
	elseif s == "HuntLocker" then
		speed = self:_chaseSpeed() - 1
	end
	self.rig.humanoid.WalkSpeed = speed
	local growl = self.rig.growl
	if growl then
		local chasing = s == "Chase" or s == "HuntLocker"
		growl.PlaybackSpeed = if chasing then 1.12 else 0.92
		growl.Volume = if chasing then 1.9 else 1.2
	end
end

function MonsterAI._cellAt(self: MonsterAI, pos: Vector3): Maze.Cell
	return Maze.cellOf(self.layout, pos.X, pos.Z)
end

function MonsterAI._isActive(self: MonsterAI, player: Player): boolean
	for _, p in self.hooks.getPlayers() do
		if p == player then
			return true
		end
	end
	return false
end

-- Build a waypoint list through the maze: edge midpoints (doorways are centred on
-- them) and cell centres, ending exactly at the goal.
function MonsterAI._setPathTo(self: MonsterAI, goal: Vector3): boolean
	local root = self.rig.root
	local cells = Maze.findPath(self.layout, self:_cellAt(root.Position), self:_cellAt(goal))
	self.pathGoal = goal
	self.pathIndex = 1
	if not cells then
		self.path = {}
		return false
	end
	local C = self.layout.cellSize
	local y = root.Position.Y
	local points = {}
	for i = 2, #cells do
		local a, b = cells[i - 1], cells[i]
		table.insert(points, Vector3.new((a.x + b.x + 1) * C / 2, y, (a.z + b.z + 1) * C / 2))
		if i < #cells then
			local cx, cz = Maze.cellCenter(self.layout, b)
			table.insert(points, Vector3.new(cx, y, cz))
		end
	end
	table.insert(points, Vector3.new(goal.X, y, goal.Z))
	self.path = points
	return true
end

-- Returns true once the path is finished.
function MonsterAI._followPath(self: MonsterAI): boolean
	local root = self.rig.root
	local p = self.path[self.pathIndex]
	while p and flat(p - root.Position).Magnitude < 2.2 do
		self.pathIndex += 1
		p = self.path[self.pathIndex]
	end
	if not p then
		self.path = {}
		return true
	end
	self.rig.humanoid:MoveTo(p)
	return false
end

function MonsterAI._clearLine(self: MonsterAI, goal: Vector3): boolean
	local origin = self.rig.root.Position
	local direction = Vector3.new(goal.X, origin.Y, goal.Z) - origin
	if direction.Magnitude < 1 then
		return true
	end
	return workspace:Spherecast(origin, 1.3, direction, self.moveParams) == nil
end

function MonsterAI._canSee(self: MonsterAI, player: Player, ignoreCone: boolean): (boolean, Vector3?)
	if player:GetAttribute("Hiding") then
		return false, nil
	end
	local proot, phead = rootOf(player), headOf(player)
	if not proot or not phead then
		return false, nil
	end
	local eye = self.rig.head.Position
	local toTarget = phead.Position - eye
	local dist = toTarget.Magnitude
	local range = if player:GetAttribute("Flashlight") then M.SightRangeFlashlight else M.SightRange
	local speed = flat(proot.AssemblyLinearVelocity).Magnitude
	if speed > 0.5 and speed < 6.5 then
		range *= M.SneakSightMultiplier
	end
	if dist > range then
		return false, nil
	end
	if not ignoreCone and dist > M.CloseSense then
		local look = flat(self.rig.root.CFrame.LookVector)
		local dir = flat(toTarget)
		if look.Magnitude > 0.01 and dir.Magnitude > 0.01 and look.Unit:Dot(dir.Unit) < M.ViewDot then
			return false, nil
		end
	end
	if workspace:Raycast(eye, toTarget, self.sightParams) then
		return false, nil
	end
	return true, proot.Position
end

function MonsterAI._lookForPlayers(self: MonsterAI): (Player?, Vector3?)
	local best: Player? = nil
	local bestPos: Vector3? = nil
	local bestDist = math.huge
	local root = self.rig.root
	for _, player in self.hooks.getPlayers() do
		local seen, pos = self:_canSee(player, self.state == "Chase" and player == self.target)
		if seen and pos then
			local d = (pos - root.Position).Magnitude
			if player == self.target then
				d *= 0.5 -- stick with the current target
			end
			if d < bestDist then
				best, bestPos, bestDist = player, pos, d
			end
		end
	end
	return best, bestPos
end

function MonsterAI._listen(self: MonsterAI): Vector3?
	local dist = Maze.distances(self.layout, self:_cellAt(self.rig.root.Position))
	local C = self.layout.cellSize
	local best: Vector3? = nil
	local bestDist = math.huge
	local function consider(position: Vector3, radius: number)
		local cell = self:_cellAt(position)
		local d = (dist[Maze.key(cell.x, cell.z)] or math.huge) * C
		if d <= radius and d < bestDist then
			best, bestDist = position, d
		end
	end
	for _, player in self.hooks.getPlayers() do
		local proot = rootOf(player)
		if proot and not player:GetAttribute("Hiding") then
			local speed = flat(proot.AssemblyLinearVelocity).Magnitude
			local radius = if speed > 14 then M.HearSprint elseif speed > 6.5 then M.HearWalk else 0
			if radius > 0 then
				consider(proot.Position, radius)
			end
		end
	end
	local noise = self.noise
	if noise then
		self.noise = nil
		consider(noise.position, noise.radius)
	end
	return best
end

function MonsterAI._pickWanderTarget(self: MonsterAI)
	local W, D = self.layout.width, self.layout.depth
	local cell: Maze.Cell? = nil
	local players = self.hooks.getPlayers()
	local now = os.clock()
	if #players > 0 then
		local proot = rootOf(players[self.random:NextInteger(1, #players)])
		if proot then
			local pc = self:_cellAt(proot.Position)
			if now - self.lastContact > M.HuntingInstinct then
				-- it's been too quiet: it "smells" you and heads straight for where you are
				self.lastContact = now - M.HuntingInstinct * 0.5
				cell = pc
			elseif self.random:NextNumber() < 0.7 then
				local r = self.random:NextInteger(1, 4)
				cell = {
					x = math.clamp(pc.x + self.random:NextInteger(-r, r), 0, W - 1),
					z = math.clamp(pc.z + self.random:NextInteger(-r, r), 0, D - 1),
				}
			end
		end
	end
	local chosen = cell or { x = self.random:NextInteger(0, W - 1), z = self.random:NextInteger(0, D - 1) }
	local cx, cz = Maze.cellCenter(self.layout, chosen)
	self:_setPathTo(Vector3.new(cx, 0, cz))
end

function MonsterAI._investigate(self: MonsterAI, position: Vector3)
	if self.state == "Investigate" and self.pathGoal and flat(self.pathGoal - position).Magnitude < 8 then
		return
	end
	self:_setState("Investigate")
	self.pauseUntil = 0
	self:_setPathTo(position)
end

function MonsterAI._beginSearch(self: MonsterAI, around: Vector3, duration: number)
	self:_setState("Search")
	self.searchCenter = around
	self.searchUntil = os.clock() + duration
	self.pauseUntil = 0
	self:_setPathTo(around)
end

function MonsterAI._startChase(self: MonsterAI, player: Player)
	local wasChasing = self.state == "Chase"
	self.target = player
	self.huntLocker = nil
	self:_setState("Chase")
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self.path = {}
	if not wasChasing and os.clock() - self.lastScream > 10 then
		self.lastScream = os.clock()
		Audio.play("MonsterScream", self.rig.head, 2.2, self.random:NextNumber(0.92, 1.05), 170)
	end
end

function MonsterAI._updateChase(self: MonsterAI, now: number)
	local root = self.rig.root
	local target = self.target
	if not target or not self:_isActive(target) then
		self:_beginSearch(self.lastSeenPos or root.Position, M.SearchTime)
		return
	end
	if target:GetAttribute("Hiding") then
		local locker = self.sawHide[target]
		if locker then
			self.huntLocker = locker
			self:_setState("HuntLocker")
			self:_setPathTo(locker.outside.Position)
		else
			self:_beginSearch(self.lastSeenPos or root.Position, M.SearchTime)
		end
		return
	end
	local frenzy = now < self.frenzyUntil
	if not frenzy and now - self.lastSeenTime > M.LoseSightTime then
		self:_beginSearch(self.lastSeenPos or root.Position, M.SearchTime)
		return
	end
	local proot = rootOf(target)
	if not proot then
		return
	end
	-- for a moment after losing sight it still "knows" where you went
	local goal = if frenzy or now - self.lastSeenTime < 1 then proot.Position else (self.lastSeenPos or proot.Position)
	if self:_clearLine(goal) then
		self.path = {}
		self.rig.humanoid:MoveTo(Vector3.new(goal.X, root.Position.Y, goal.Z))
	else
		local goalMoved = self.pathGoal == nil or flat((self.pathGoal :: Vector3) - goal).Magnitude > 6
		if #self.path == 0 or goalMoved or now - self.lastRepath > 0.8 then
			self.lastRepath = now
			self:_setPathTo(goal)
		end
		self:_followPath()
	end
end

function MonsterAI._updateHuntLocker(self: MonsterAI)
	local root = self.rig.root
	local locker = self.huntLocker
	local victim = if locker then locker.occupant else nil
	if not locker or not victim or not self:_isActive(victim) then
		self.huntLocker = nil
		self:_beginSearch(root.Position, 6)
		return
	end
	if flat(locker.outside.Position - root.Position).Magnitude < 4.5 then
		self.huntLocker = nil
		self.interactables:leave(victim, true) -- yank them out
		self:_catch(victim)
		return
	end
	if #self.path == 0 then
		self:_setPathTo(locker.outside.Position)
	end
	self:_followPath()
end

function MonsterAI._updateSearch(self: MonsterAI, now: number)
	if now > self.searchUntil then
		self:_setState("Wander")
		self:_pickWanderTarget()
		return
	end
	if now < self.pauseUntil then
		return
	end
	if self:_followPath() then
		self.pauseUntil = now + self.random:NextNumber(0.8, 2.2) -- stop... listen...
		local c = self:_cellAt(self.searchCenter)
		local nx = math.clamp(c.x + self.random:NextInteger(-2, 2), 0, self.layout.width - 1)
		local nz = math.clamp(c.z + self.random:NextInteger(-2, 2), 0, self.layout.depth - 1)
		local cx, cz = Maze.cellCenter(self.layout, { x = nx, z = nz })
		self:_setPathTo(Vector3.new(cx, 0, cz))
	end
end

function MonsterAI._catch(self: MonsterAI, player: Player)
	self:_setState("Kill")
	self.sawHide[player] = nil
	self.target = nil
	self.path = {}
	local root = self.rig.root
	self.rig.humanoid:MoveTo(root.Position)
	root.Anchored = true
	local proot = rootOf(player)
	if proot then
		proot.Anchored = true
		local facing = flat(proot.Position - root.Position)
		if facing.Magnitude > 0.1 then
			self.rig.model:PivotTo(CFrame.lookAt(root.Position, root.Position + facing))
		end
	end
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self.hooks.onCaught(player, self.rig.model)
	task.delay(2.8, function()
		if self.destroyed then
			return
		end
		self:_release()
		self:_beginSearch(root.Position, 6)
	end)
end

function MonsterAI._tryApparition(self: MonsterAI)
	local now = os.clock()
	self.nextApparition = now + self.random:NextNumber(M.ApparitionMin, M.ApparitionMax)
	local candidates = {}
	for _, player in self.hooks.getPlayers() do
		if not player:GetAttribute("Hiding") and rootOf(player) then
			table.insert(candidates, player)
		end
	end
	if #candidates == 0 then
		return
	end
	local player = candidates[self.random:NextInteger(1, #candidates)]
	local proot = rootOf(player) :: BasePart
	local pc = self:_cellAt(proot.Position)
	local look = flat(proot.CFrame.LookVector)
	local best: Maze.Cell? = nil
	local bestScore = -math.huge
	-- down a straight corridor, preferably the one they're facing
	for _, d in Maze.DIRS do
		local run = Maze.straightRun(self.layout, pc, d, 7)
		if #run >= 3 then
			local score = look:Dot(Vector3.new(Maze.DX[d], 0, Maze.DZ[d])) + self.random:NextNumber() * 0.4
			if score > bestScore then
				bestScore = score
				best = run[math.min(#run, self.random:NextInteger(3, 6))]
			end
		end
	end
	if not best then
		return
	end
	local cx, cz = Maze.cellCenter(self.layout, best)
	local pos = Vector3.new(cx, MonsterRig.ROOT_HEIGHT, cz)
	self.rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(proot.Position.X, pos.Y, proot.Position.Z)))
	self.apparitionTarget = player
	self.apparitionEnds = now + 7
	self:_setState("Apparition")
end

function MonsterAI._updateApparition(self: MonsterAI)
	local player = self.apparitionTarget
	local proot = if player then rootOf(player) else nil
	local root = self.rig.root
	if not player or not proot or not self:_isActive(player) or os.clock() > self.apparitionEnds or flat(proot.Position - root.Position).Magnitude < 24 then
		self:_vanish()
		return
	end
	local pos = root.Position
	self.rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(proot.Position.X, pos.Y, proot.Position.Z)))
end

function MonsterAI._vanish(self: MonsterAI)
	Remotes.Apparition:FireAllClients(self.rig.root.Position)
	self.apparitionTarget = nil
	self:_park()
	self:_setState("Dormant")
end

function MonsterAI._checkStuck(self: MonsterAI, now: number)
	if now < self.stuckCheckAt then
		return
	end
	self.stuckCheckAt = now + 2
	local pos = self.rig.root.Position
	local moving = self.rig.humanoid.WalkSpeed > 0 and #self.path > 0 and now >= self.pauseUntil
	if moving and flat(pos - self.stuckPos).Magnitude < 1.5 then
		self.stuckCount += 1
		if self.stuckCount >= 2 then
			-- still stuck: hop to the next waypoint
			local p = self.path[self.pathIndex]
			if p then
				self.rig.model:PivotTo(CFrame.new(p.X, MonsterRig.ROOT_HEIGHT, p.Z) * self.rig.root.CFrame.Rotation)
			end
			self.stuckCount = 0
		elseif self.pathGoal then
			self:_setPathTo(self.pathGoal)
		end
	else
		self.stuckCount = 0
	end
	self.stuckPos = pos
end

function MonsterAI._think(self: MonsterAI)
	if self.destroyed then
		return
	end
	local now = os.clock()
	local state = self.state

	if state == "Dormant" then
		if now >= self.awakeAt then
			self:awaken()
		elseif now >= self.nextApparition then
			self:_tryApparition()
		end
		return
	elseif state == "Apparition" then
		if now >= self.awakeAt then
			self:awaken()
		else
			self:_updateApparition()
		end
		return
	elseif state == "Kill" then
		return
	end

	local root = self.rig.root
	self.interactables:slamOpenNear(root.Position, 8)
	self:_checkStuck(now)

	-- within arm's reach?
	for _, player in self.hooks.getPlayers() do
		if not player:GetAttribute("Hiding") then
			local proot = rootOf(player)
			if proot and flat(proot.Position - root.Position).Magnitude < M.CatchDistance and math.abs(proot.Position.Y - root.Position.Y) < 7 then
				self:_catch(player)
				return
			end
		end
	end

	-- eyes
	local seen, seenPos = self:_lookForPlayers()
	if seen and seenPos and self.state ~= "HuntLocker" then
		if self.state ~= "Chase" or self.target ~= seen then
			self:_startChase(seen)
		end
		self.lastSeenPos = seenPos
		self.lastSeenTime = now
		self.lastContact = now
	end

	local s = self.state
	if s == "Chase" then
		self:_updateChase(now)
	elseif s == "HuntLocker" then
		self:_updateHuntLocker()
	elseif s == "Investigate" then
		if self:_followPath() then
			self:_beginSearch(root.Position, 7)
		end
	elseif s == "Search" then
		self:_updateSearch(now)
	elseif s == "Wander" then
		if now >= self.pauseUntil and self:_followPath() then
			self.pauseUntil = now + self.random:NextNumber(0.5, 2.5)
			self:_pickWanderTarget()
		end
	end

	-- ears (only when it isn't already after someone)
	if self.state == "Wander" or self.state == "Search" or self.state == "Investigate" then
		local heard = self:_listen()
		if heard then
			self.lastContact = now
			self:_investigate(heard)
		end
	end
end

return MonsterAI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">MonsterRig</string>
          <string name="Source"><![CDATA[--!strict
-- Builds the monster out of parts: ~10 studs tall, hunched, a visible ribcage, arms
-- that drag along the floor, legs that bend the wrong way, a jaw that unhinges and
-- six glowing eyes. Every limb hangs off a Motor6D that clients animate
-- procedurally (see MonsterAnimator), so it twitches and jerks instead of walking.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Audio = require(ReplicatedStorage.Shared.Audio)

export type Rig = {
	model: Model,
	root: BasePart,
	humanoid: Humanoid,
	head: BasePart,
	growl: Sound?,
}

local MonsterRig = {}

MonsterRig.ROOT_HEIGHT = 5.2 -- HipHeight + half the root's height

local SKIN = Color3.fromRGB(14, 14, 14)
local SKIN_LIGHT = Color3.fromRGB(34, 34, 34)
local BONE = Color3.fromRGB(205, 200, 188)
local EYE = Color3.fromRGB(255, 255, 255)

local function limb(model: Model, name: string, size: Vector3, color: Color3?, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color or SKIN
	p.Material = material or Enum.Material.Slate
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CollisionGroup = "Monster"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = model
	return p
end

-- Joint `child` to `parent`. c0 = joint position in parent space, c1 = in child space.
local function joint(name: string, parent: BasePart, child: BasePart, c0: CFrame, c1: CFrame): Motor6D
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = parent
	m.Part1 = child
	m.C0 = c0
	m.C1 = c1
	child.CFrame = parent.CFrame * c0 * c1:Inverse()
	m.Parent = parent
	return m
end

local function egg(p: BasePart)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
end

local function rad(deg: number): number
	return math.rad(deg)
end

function MonsterRig.build(): Rig
	local model = Instance.new("Model")
	model.Name = "Monster"

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1.5)
	root.Transparency = 1
	root.CanCollide = true
	root.CanQuery = false
	root.CollisionGroup = "Monster"
	root.CFrame = CFrame.new(0, MonsterRig.ROOT_HEIGHT, 0)
	root.Parent = model
	model.PrimaryPart = root

	-- body
	local pelvis = limb(model, "Pelvis", Vector3.new(1.9, 1.1, 1.2))
	joint("Waist", root, pelvis, CFrame.new(0, 0.2, 0), CFrame.new())

	local torso = limb(model, "Torso", Vector3.new(2.5, 3, 1.4))
	joint("Spine", pelvis, torso, CFrame.new(0, 0.5, 0) * CFrame.Angles(rad(-32), 0, 0), CFrame.new(0, -1.5, 0))
	for i, y in { 0.35, -0.2, -0.75 } do
		local rib = limb(model, "Rib", Vector3.new(2.2 - i * 0.2, 0.16, 0.1), BONE, Enum.Material.SmoothPlastic)
		joint("RibJoint", torso, rib, CFrame.new(0, y, -0.72), CFrame.new())
	end
	for i = 0, 3 do
		local spike = limb(model, "Spike", Vector3.new(0.28, 0.9 - i * 0.1, 0.28), BONE, Enum.Material.SmoothPlastic)
		joint("SpikeJoint", torso, spike, CFrame.new(0, 1.1 - i * 0.65, 0.72) * CFrame.Angles(rad(-35), 0, 0), CFrame.new(0, -0.3, 0))
	end

	-- head: an elongated skull with an unhinged jaw
	local head = limb(model, "Head", Vector3.new(1.5, 2.3, 1.8), SKIN_LIGHT)
	egg(head)
	joint("Neck", torso, head, CFrame.new(0, 1.5, -0.2) * CFrame.Angles(rad(27), 0, 0), CFrame.new(0, -0.9, 0.3))

	local gullet = limb(model, "Gullet", Vector3.new(1.05, 0.7, 0.9), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic)
	joint("GulletJoint", head, gullet, CFrame.new(0, -0.55, -0.45), CFrame.new())

	local jaw = limb(model, "Jaw", Vector3.new(1.25, 0.3, 1.3), SKIN_LIGHT)
	joint("Jaw", head, jaw, CFrame.new(0, -0.8, 0.2), CFrame.new(0, 0, 0.6))
	for i = -2, 2 do
		local lower = limb(model, "Tooth", Vector3.new(0.12, 0.38, 0.12), BONE, Enum.Material.SmoothPlastic)
		joint("ToothJoint", jaw, lower, CFrame.new(i * 0.24, 0.3, -0.5 + math.abs(i) * 0.1), CFrame.new())
		local upper = limb(model, "Tooth", Vector3.new(0.12, 0.42, 0.12), BONE, Enum.Material.SmoothPlastic)
		joint("ToothJoint", head, upper, CFrame.new(i * 0.24 + 0.05, -0.85, -0.62 + math.abs(i) * 0.1), CFrame.new())
	end

	local eyes: { { any } } = {
		{ 0.42, Vector3.new(0.32, 0.35, -0.8) },
		{ 0.26, Vector3.new(-0.35, 0.42, -0.78) },
		{ 0.2, Vector3.new(-0.08, 0.68, -0.72) },
		{ 0.22, Vector3.new(0.48, 0.74, -0.6) },
		{ 0.18, Vector3.new(-0.55, 0.08, -0.64) },
		{ 0.16, Vector3.new(0.06, 0.12, -0.86) },
	}
	for i, e in eyes do
		local size = e[1] :: number
		local eye = limb(model, "Eye", Vector3.new(size, size, size), EYE, Enum.Material.Neon, Enum.PartType.Ball)
		eye.CastShadow = false
		joint("EyeJoint", head, eye, CFrame.new(e[2] :: Vector3), CFrame.new())
		if i == 1 then
			local light = Instance.new("PointLight")
			light.Name = "EyeGlow"
			light.Range = 9
			light.Brightness = 1.2
			light.Shadows = false
			light.Parent = eye
		end
	end

	-- arms: long enough to drag their fingers along the floor
	for _, side in { -1, 1 } do
		local prefix = if side < 0 then "L" else "R"
		local upper = limb(model, prefix .. "UpperArm", Vector3.new(0.55, 3.4, 0.55))
		joint(prefix .. "Shoulder", torso, upper, CFrame.new(side * 1.45, 1.2, 0) * CFrame.Angles(rad(32), 0, rad(side * 7)), CFrame.new(0, 1.7, 0))
		local lower = limb(model, prefix .. "LowerArm", Vector3.new(0.45, 3.2, 0.45))
		joint(prefix .. "Elbow", upper, lower, CFrame.new(0, -1.7, 0) * CFrame.Angles(rad(-10), 0, 0), CFrame.new(0, 1.6, 0))
		local hand = limb(model, prefix .. "Hand", Vector3.new(0.65, 0.5, 0.4), SKIN_LIGHT)
		joint(prefix .. "Wrist", lower, hand, CFrame.new(0, -1.6, 0), CFrame.new(0, 0.25, 0))
		for f = 0, 3 do
			local finger = limb(model, prefix .. "Finger", Vector3.new(0.12, 1.5, 0.12), SKIN_LIGHT)
			joint(prefix .. "Finger" .. (f + 1), hand, finger, CFrame.new(-0.24 + f * 0.16, -0.25, 0) * CFrame.Angles(rad(-10), 0, rad(-12 + f * 8)), CFrame.new(0, 0.75, 0))
		end
	end

	-- legs: thigh forward, shin back (digitigrade)
	for _, side in { -1, 1 } do
		local prefix = if side < 0 then "L" else "R"
		local thigh = limb(model, prefix .. "Thigh", Vector3.new(0.8, 2.7, 0.8))
		joint(prefix .. "Hip", pelvis, thigh, CFrame.new(side * 0.65, -0.3, 0) * CFrame.Angles(rad(30), 0, 0), CFrame.new(0, 1.35, 0))
		local shin = limb(model, prefix .. "Shin", Vector3.new(0.6, 3, 0.6))
		joint(prefix .. "Knee", thigh, shin, CFrame.new(0, -1.35, 0) * CFrame.Angles(rad(-65), 0, 0), CFrame.new(0, 1.5, 0))
		local foot = limb(model, prefix .. "Foot", Vector3.new(0.7, 0.35, 1.6), SKIN_LIGHT)
		joint(prefix .. "Ankle", shin, foot, CFrame.new(0, -1.5, 0) * CFrame.Angles(rad(35), 0, 0), CFrame.new(0, 0, 0.6))
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = MonsterRig.ROOT_HEIGHT - root.Size.Y / 2
	humanoid.WalkSpeed = 0
	humanoid.MaxHealth = 1e6
	humanoid.Health = 1e6
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.Parent = model
	for _, s in { Enum.HumanoidStateType.Dead, Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.Climbing, Enum.HumanoidStateType.Swimming, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.Seated } do
		humanoid:SetStateEnabled(s, false)
	end

	local growl = Audio.create("MonsterGrowlLoop", head, 1.2)
	if growl then
		growl.RollOffMode = Enum.RollOffMode.InverseTapered
		growl.RollOffMinDistance = 8
		growl.RollOffMaxDistance = 90
	end

	model:SetAttribute("State", "Dormant")
	model:SetAttribute("TargetUserId", 0)

	return {
		model = model,
		root = root,
		humanoid = humanoid,
		head = head,
		growl = growl,
	}
end

return MonsterRig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[--!strict
-- The round loop: wait for players -> countdown -> build a fresh maze -> play until
-- everyone is caught or out -> show results -> tear down -> repeat.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Interactables = require(script.Parent.Interactables)
local MonsterAI = require(script.Parent.MonsterAI)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local GameState = ReplicatedStorage.GameState

type Round = {
	layout: Maze.Layout,
	world: WorldBuilder.World,
	interactables: Interactables.Interactables,
	monster: MonsterAI.MonsterAI,
	keysFound: number,
	mask: { string },
	startedAt: number,
	spawnIndex: number,
}

local RoundManager = {}

local ready: { [Player]: boolean } = {}
local status: { [Player]: string } = {} -- "alive" | "caught" | "escaped"
local round: Round? = nil

local function isAlive(player: Player): boolean
	return status[player] == "alive" and player.Parent ~= nil
end

local function alivePlayers(): { Player }
	local list = {}
	for player, s in status do
		if s == "alive" and player.Parent ~= nil then
			table.insert(list, player)
		end
	end
	return list
end

local function notifyAll(text: string, style: string?)
	Remotes.Notify:FireAllClients(text, style)
end

local function notifyOthers(except: Player, text: string, style: string?)
	for _, p in Players:GetPlayers() do
		if p ~= except then
			Remotes.Notify:FireClient(p, text, style)
		end
	end
end

local function removeCharacter(player: Player)
	local character = player.Character
	if character then
		character:Destroy()
	end
	pcall(function()
		player.Character = nil
	end)
end

local function spawnPlayer(player: Player)
	local r = round
	if not r or status[player] ~= nil then
		return
	end
	status[player] = "alive"
	player:SetAttribute("Hiding", false)
	player:SetAttribute("Flashlight", false)
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		-- older engines only have the (now deprecated) synchronous version
		ok = pcall(function()
			(player :: any):LoadCharacter()
		end)
	end
	local character = player.Character
	if not ok or not character or round ~= r then
		return
	end
	r.spawnIndex += 1
	character:PivotTo(r.world.spawnPoints[(r.spawnIndex - 1) % #r.world.spawnPoints + 1])
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			if status[player] == "alive" and round == r then
				RoundManager.caught(player, nil)
			end
		end)
	end
end

function RoundManager.caught(player: Player, monster: Model?)
	if status[player] ~= "alive" then
		return
	end
	status[player] = "caught"
	local r = round
	if r then
		r.interactables:release(player)
		r.monster:forget(player)
	end
	if monster then
		Remotes.Jumpscare:FireClient(player, monster)
	end
	notifyOthers(player, player.DisplayName .. " was taken.", "danger")
	task.delay(if monster then 2.7 else 0.5, function()
		if status[player] == "caught" then
			removeCharacter(player)
		end
	end)
end

function RoundManager.escaped(player: Player)
	if status[player] ~= "alive" then
		return
	end
	status[player] = "escaped"
	local r = round
	if r then
		r.monster:forget(player)
	end
	Remotes.Escaped:FireClient(player)
	notifyOthers(player, player.DisplayName .. " made it out.", "key")
	task.delay(4, function()
		if status[player] == "escaped" then
			removeCharacter(player)
		end
	end)
end

local function startRound()
	local seed = Random.new():NextInteger(1, 2 ^ 30)
	local layout = Maze.generate(seed, Config.Maze)
	local world = WorldBuilder.build(layout)

	local monster: MonsterAI.MonsterAI
	local r: Round

	local interactables = Interactables.new(layout, world, {
		isAlive = isAlive,
		onKey = function(player: Player, index: number)
			r.keysFound += 1
			r.mask[index] = string.sub(layout.code, index, index)
			GameState:SetAttribute("KeysFound", r.keysFound)
			GameState:SetAttribute("CodeMask", table.concat(r.mask))
			r.interactables:removePadlock()
			local tag = {}
			for i = 1, #layout.code do
				tag[i] = if i == index then string.sub(layout.code, i, i) else "_"
			end
			notifyAll(string.format("%s found a key. The tag reads   %s", player.DisplayName, table.concat(tag, " ")), "key")
			monster:setAggression(r.keysFound)
			monster:awaken()
			if r.keysFound >= Config.Maze.KeyCount then
				notifyAll("Every padlock is open. Get to the keypad by the exit.", "key")
			end
		end,
		onHide = function(player: Player, locker: Interactables.Locker)
			monster:onPlayerHid(player, locker)
		end,
		onExitOpened = function(player: Player)
			GameState:SetAttribute("ExitOpen", true)
			notifyAll("The exit is open. RUN.", "danger")
			monster:onExitOpened()
		end,
		onEscaped = RoundManager.escaped,
		onNoise = function(position: Vector3, radius: number)
			monster:hearNoise(position, radius)
		end,
	})

	monster = MonsterAI.new(layout, world, interactables, {
		getPlayers = alivePlayers,
		onCaught = RoundManager.caught,
		onAwake = function()
			GameState:SetAttribute("MonsterAwake", true)
		end,
	})

	r = {
		layout = layout,
		world = world,
		interactables = interactables,
		monster = monster,
		keysFound = 0,
		mask = table.create(Config.Maze.KeyCount, "_"),
		startedAt = os.clock(),
		spawnIndex = 0,
	}

	table.clear(status)
	round = r
	GameState:SetAttribute("KeysFound", 0)
	GameState:SetAttribute("KeyCount", Config.Maze.KeyCount)
	GameState:SetAttribute("CodeMask", table.concat(r.mask))
	GameState:SetAttribute("ExitOpen", false)
	GameState:SetAttribute("MonsterAwake", false)
	GameState:SetAttribute("Result", "")
	GameState:SetAttribute("Phase", "Playing")

	for player in ready do
		task.spawn(spawnPlayer, player)
	end
	monster:start()
end

local function endRound()
	local r = round
	if not r then
		return
	end
	local survivors = {}
	for player, s in status do
		if s == "escaped" then
			table.insert(survivors, player.DisplayName)
		end
	end
	local result = if #survivors > 0 then "Escaped" else "Caught"
	GameState:SetAttribute("Result", result)
	GameState:SetAttribute("Phase", "Results")
	Remotes.RoundResult:FireAllClients(result, survivors, math.floor(os.clock() - r.startedAt))

	task.wait(Config.Round.ResultsTime)

	r.monster:destroy()
	r.interactables:destroy()
	r.world.model:Destroy()
	round = nil
	table.clear(status)
	for _, player in Players:GetPlayers() do
		removeCharacter(player)
		player:SetAttribute("Hiding", false)
	end
end

function RoundManager.run()
	Players.CharacterAutoLoads = false
	WorldBuilder.setupCollisionGroups()

	GameState:SetAttribute("Phase", "Waiting")
	GameState:SetAttribute("Countdown", 0)
	GameState:SetAttribute("KeysFound", 0)
	GameState:SetAttribute("KeyCount", Config.Maze.KeyCount)
	GameState:SetAttribute("CodeMask", string.rep("_", Config.Maze.KeyCount))

	Remotes.Ready.OnServerEvent:Connect(function(player: Player)
		if ready[player] then
			return
		end
		ready[player] = true
		if round and GameState:GetAttribute("Phase") == "Playing" then
			task.spawn(spawnPlayer, player)
		end
	end)

	-- Everyone else sees your flashlight beam too (and so does the monster).
	Remotes.Flashlight.OnServerEvent:Connect(function(player: Player, on: unknown)
		if typeof(on) ~= "boolean" then
			return
		end
		player:SetAttribute("Flashlight", on)
		local character = player.Character
		local head = if character then character:FindFirstChild("Head") else nil
		if head and head:IsA("BasePart") then
			local existing = head:FindFirstChild("SharedFlashlight")
			local light: SpotLight
			if existing and existing:IsA("SpotLight") then
				light = existing
			else
				light = Instance.new("SpotLight")
				light.Name = "SharedFlashlight"
				light.Face = Enum.NormalId.Front
				light.Angle = 50
				light.Range = 40
				light.Brightness = 2
				light.Shadows = true
				light.Parent = head
			end
			light.Enabled = on
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		ready[player] = nil
		local r = round
		if r then
			r.interactables:release(player)
			r.monster:forget(player)
		end
		status[player] = nil
	end)

	local first = true
	while true do
		GameState:SetAttribute("Phase", "Waiting")
		while next(ready) == nil do
			task.wait(0.5)
		end

		GameState:SetAttribute("Phase", "Intermission")
		for i = if first then Config.Round.FirstIntermission else Config.Round.Intermission, 1, -1 do
			GameState:SetAttribute("Countdown", i)
			task.wait(1)
		end
		first = false

		startRound()
		repeat
			task.wait(0.5)
		until #alivePlayers() == 0
		endRound()
	end
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a Maze layout into Parts: the grey house, the concrete maze, lamps, props,
-- scrawled writing, and the exit tunnel. Interactive things (doors, keys, lockers,
-- the exit door) are added afterwards by Interactables.

local CollectionService = game:GetService("CollectionService")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)

type Layout = Maze.Layout

export type Note = { part: BasePart, text: string }

export type World = {
	model: Model,
	spawnPoints: { CFrame },
	houseOrigin: Vector3,
	escapeZone: BasePart,
	exitLight: PointLight,
	hiddenSpot: CFrame,
	notes: { Note },
	random: Random,
}

type Style = { material: Enum.Material, color: Color3 }

local C = Config.Maze.CellSize
local H = Config.Maze.WallHeight
local T = Config.Maze.WallThickness
local ROT90 = CFrame.Angles(0, math.rad(90), 0)

local WorldBuilder = {}

WorldBuilder.DOOR_WIDTH = 5.5
WorldBuilder.DOOR_HEIGHT = 10
WorldBuilder.EXIT_WIDTH = 7
WorldBuilder.EXIT_HEIGHT = 10.5
local HOLE_WIDTH = 6
local HOLE_HEIGHT = 9.5

local MAZE_WALL: Style = { material = Enum.Material.Concrete, color = Color3.fromRGB(118, 116, 112) }
local HOUSE_WALL: Style = { material = Enum.Material.Plaster, color = Color3.fromRGB(170, 164, 154) }
local TRIM: Style = { material = Enum.Material.Wood, color = Color3.fromRGB(70, 58, 50) }

local ROOM_FLOORS: { [string]: Style } = {
	hall = { material = Enum.Material.WoodPlanks, color = Color3.fromRGB(88, 74, 62) },
	living = { material = Enum.Material.WoodPlanks, color = Color3.fromRGB(98, 82, 68) },
	bedroom = { material = Enum.Material.Carpet, color = Color3.fromRGB(78, 76, 80) },
	kitchen = { material = Enum.Material.CeramicTiles, color = Color3.fromRGB(150, 150, 146) },
	study = { material = Enum.Material.WoodPlanks, color = Color3.fromRGB(80, 68, 58) },
}

local random = Random.new()

-- The monster walks through furniture (its paths cut through the middle of rooms);
-- players, line of sight and flashlight shadows still treat furniture as solid.
local groupsReady = false
function WorldBuilder.setupCollisionGroups()
	if groupsReady then
		return
	end
	groupsReady = true
	PhysicsService:RegisterCollisionGroup("Monster")
	PhysicsService:RegisterCollisionGroup("Furniture")
	PhysicsService:CollisionGroupSetCollidable("Monster", "Furniture", false)
end

function WorldBuilder.markFurniture(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Furniture"
		end
	end
end

local function vary(color: Color3, amount: number?): Color3
	local f = 1 + random:NextNumber(-1, 1) * (amount or 0.06)
	return Color3.new(math.clamp(color.R * f, 0, 1), math.clamp(color.G * f, 0, 1), math.clamp(color.B * f, 0, 1))
end

local function part(
	parent: Instance,
	name: string,
	size: Vector3,
	cframe: CFrame,
	material: Enum.Material,
	color: Color3,
	shape: Enum.PartType?
): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Material = material
	p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end
WorldBuilder.part = part

-- Decorative parts that should never block movement or line of sight.
local function decor(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end
WorldBuilder.decor = decor

-- Frame on the edge an owner cell holds ("N" or "E"). Its Front face (-Z) looks into
-- the owner cell, its Back face into the neighbour. Y = floor level.
function WorldBuilder.edgeFrame(x: number, z: number, dir: string): CFrame
	if dir == "N" then
		return CFrame.new((x + 0.5) * C, 0, (z + 1) * C)
	end
	return CFrame.new((x + 1) * C, 0, (z + 0.5) * C) * ROT90
end

-- Frame on the inside face of one of a cell's walls, looking into the cell.
function WorldBuilder.sideFrame(x: number, z: number, side: string): CFrame
	local ox, oz = Maze.DX[side], Maze.DZ[side]
	local pos = Vector3.new((x + 0.5 + ox * 0.5) * C - ox * T / 2, 0, (z + 0.5 + oz * 0.5) * C - oz * T / 2)
	return CFrame.lookAt(pos, pos - Vector3.new(ox, 0, oz))
end

function WorldBuilder.cellCenter(x: number, z: number): Vector3
	return Vector3.new((x + 0.5) * C, 0, (z + 0.5) * C)
end

local function styleOf(layout: Layout, x: number, z: number): Style
	if Maze.inBounds(layout, x, z) and Maze.isHouse(layout, x, z) then
		return HOUSE_WALL
	end
	return MAZE_WALL
end

-- A slab of wall along an edge frame. Walls between the house and the maze are two
-- half-thickness layers so each side gets its own material.
local function wallBox(parent: Instance, frame: CFrame, length: number, height: number, yBottom: number, xOffset: number, front: Style, back: Style)
	if length <= 0.05 or height <= 0.05 then
		return
	end
	local y = yBottom + height / 2
	if front == back then
		part(parent, "Wall", Vector3.new(length, height, T), frame * CFrame.new(xOffset, y, 0), front.material, vary(front.color))
	else
		part(parent, "Wall", Vector3.new(length, height, T / 2), frame * CFrame.new(xOffset, y, -T / 4), front.material, vary(front.color))
		part(parent, "Wall", Vector3.new(length, height, T / 2), frame * CFrame.new(xOffset, y, T / 4), back.material, vary(back.color))
	end
end

local function wallWithOpening(parent: Instance, frame: CFrame, width: number, height: number, front: Style, back: Style)
	local length = C - T
	local side = (length - width) / 2
	wallBox(parent, frame, side, H, 0, -(width + side) / 2, front, back)
	wallBox(parent, frame, side, H, 0, (width + side) / 2, front, back)
	wallBox(parent, frame, width, H - height, height, 0, front, back)
end

local function doorTrim(parent: Instance, frame: CFrame, width: number, height: number)
	local depth = T + 0.3
	for _, sx in { -1, 1 } do
		part(parent, "Trim", Vector3.new(0.45, height, depth), frame * CFrame.new(sx * (width / 2 + 0.2), height / 2, 0), TRIM.material, TRIM.color)
	end
	part(parent, "Trim", Vector3.new(width + 0.85, 0.45, depth), frame * CFrame.new(0, height + 0.2, 0), TRIM.material, TRIM.color)
end

local function brokenWall(parent: Instance, frame: CFrame, front: Style, back: Style)
	wallWithOpening(parent, frame, HOLE_WIDTH, HOLE_HEIGHT, front, back)
	-- jagged chunks hanging into the opening
	for _ = 1, 5 do
		local sx = if random:NextNumber() < 0.5 then -1 else 1
		local size = Vector3.new(random:NextNumber(0.6, 1.6), random:NextNumber(0.8, 2.4), T * 0.9)
		local y = random:NextNumber(0.5, HOLE_HEIGHT)
		local p = part(
			parent,
			"Chunk",
			size,
			frame * CFrame.new(sx * (HOLE_WIDTH / 2 - size.X / 2 + 0.3), y, 0) * CFrame.Angles(0, 0, random:NextNumber(-0.5, 0.5)),
			MAZE_WALL.material,
			vary(MAZE_WALL.color)
		)
		p.CanCollide = false
	end
	part(parent, "Chunk", Vector3.new(HOLE_WIDTH + 0.5, 1.2, T * 0.9), frame * CFrame.new(0, HOLE_HEIGHT - 0.2, 0) * CFrame.Angles(0, 0, random:NextNumber(-0.15, 0.15)), MAZE_WALL.material, vary(MAZE_WALL.color)).CanCollide = false
	-- rubble on both sides
	for _ = 1, 9 do
		local s = random:NextNumber(0.4, 1.3)
		local p = part(
			parent,
			"Rubble",
			Vector3.new(s, s * 0.6, s * random:NextNumber(0.7, 1.3)),
			frame * CFrame.new(random:NextNumber(-HOLE_WIDTH, HOLE_WIDTH) * 0.6, s * 0.25, random:NextNumber(-3, 3)) * CFrame.Angles(random:NextNumber(-0.4, 0.4), random:NextNumber(0, 6.28), random:NextNumber(-0.4, 0.4)),
			MAZE_WALL.material,
			vary(MAZE_WALL.color, 0.15)
		)
		decor(p)
	end
end

local function buildEdges(layout: Layout, parent: Instance)
	local W, D = layout.width, layout.depth
	for z = -1, D - 1 do
		for x = -1, W - 1 do
			for _, dir in { "N", "E" } do
				local valid = if dir == "N" then (x >= 0 and x < W) else (z >= 0 and z < D)
				if valid then
					local kind = Maze.getEdge(layout, x, z, dir)
					local nx, nz = x + Maze.DX[dir], z + Maze.DZ[dir]
					local front, back = styleOf(layout, x, z), styleOf(layout, nx, nz)
					local frame = WorldBuilder.edgeFrame(x, z, dir)
					if kind == "wall" then
						wallBox(parent, frame, C - T, H, 0, 0, front, back)
					elseif kind == "door" or kind == "doorway" then
						wallWithOpening(parent, frame, WorldBuilder.DOOR_WIDTH, WorldBuilder.DOOR_HEIGHT, front, back)
						doorTrim(parent, frame, WorldBuilder.DOOR_WIDTH, WorldBuilder.DOOR_HEIGHT)
					elseif kind == "exit" then
						wallWithOpening(parent, frame, WorldBuilder.EXIT_WIDTH, WorldBuilder.EXIT_HEIGHT, front, back)
						doorTrim(parent, frame, WorldBuilder.EXIT_WIDTH, WorldBuilder.EXIT_HEIGHT)
					elseif kind == "hole" then
						brokenWall(parent, frame, front, back)
					end
				end
			end
		end
	end
end

local function buildPillars(layout: Layout, parent: Instance)
	local W, D = layout.width, layout.depth
	for j = 0, D do
		for i = 0, W do
			local needed = false
			-- horizontal edges meeting at this vertex
			for _, ex in { i - 1, i } do
				if ex >= 0 and ex < W and Maze.getEdge(layout, ex, j - 1, "N") ~= "open" then
					needed = true
				end
			end
			-- vertical edges meeting at this vertex
			for _, ez in { j - 1, j } do
				if ez >= 0 and ez < D and Maze.getEdge(layout, i - 1, ez, "E") ~= "open" then
					needed = true
				end
			end
			if needed then
				local houseCount = 0
				for _, c in { { i - 1, j - 1 }, { i, j - 1 }, { i - 1, j }, { i, j } } do
					if Maze.inBounds(layout, c[1], c[2]) and Maze.isHouse(layout, c[1], c[2]) then
						houseCount += 1
					end
				end
				local style = if houseCount >= 2 then HOUSE_WALL else MAZE_WALL
				part(parent, "Pillar", Vector3.new(T + 0.5, H, T + 0.5), CFrame.new(i * C, H / 2, j * C), style.material, vary(style.color, 0.1))
			end
		end
	end
end

local function lamp(parent: Instance, position: Vector3, brightness: number, range: number, hanging: boolean, buzz: boolean): BasePart
	local bulbY = if hanging then H - 3.2 else H - 0.45
	if hanging then
		decor(part(parent, "Cord", Vector3.new(0.12, H - bulbY, 0.12), CFrame.new(position.X, (H + bulbY) / 2, position.Z), Enum.Material.Plastic, Color3.fromRGB(20, 20, 20)))
		decor(part(parent, "Shade", Vector3.new(2.2, 0.9, 2.2), CFrame.new(position.X, bulbY + 0.55, position.Z), Enum.Material.Fabric, Color3.fromRGB(120, 116, 110)))
	else
		decor(part(parent, "LampBase", Vector3.new(2.8, 0.3, 2.8), CFrame.new(position.X, H - 0.15, position.Z), Enum.Material.Metal, Color3.fromRGB(45, 45, 45)))
	end
	local bulb = decor(part(parent, "Bulb", if hanging then Vector3.new(0.9, 0.9, 0.9) else Vector3.new(1.5, 0.35, 1.5), CFrame.new(position.X, bulbY, position.Z), Enum.Material.Neon, Color3.fromRGB(215, 212, 200), if hanging then Enum.PartType.Ball else nil))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = Color3.fromRGB(255, 240, 220)
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("BaseBrightness", brightness)
	bulb:SetAttribute("Buzz", buzz)
	CollectionService:AddTag(bulb, "FlickerLight")
	return bulb
end

local function writing(parent: Instance, frame: CFrame, text: string)
	local canvas = decor(part(parent, "Writing", Vector3.new(9, 4.4, 0.05), frame, Enum.Material.SmoothPlastic, Color3.new(0, 0, 0)))
	canvas.Transparency = 1
	canvas.CastShadow = false
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1 -- only readable when lit, i.e. by your flashlight
	gui.Parent = canvas
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Creepster
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(28, 22, 22)
	label.TextTransparency = random:NextNumber(0.05, 0.25)
	label.Rotation = random:NextNumber(-7, 7)
	label.Parent = gui
end

-- A portrait whose face is drawn with UI frames: pale oval, hollow black eyes.
local function portrait(parent: Instance, frame: CFrame)
	part(parent, "PortraitFrame", Vector3.new(3.6, 4.6, 0.3), frame * CFrame.new(0, 0, -0.15), Enum.Material.Wood, Color3.fromRGB(45, 36, 30))
	local canvas = decor(part(parent, "Portrait", Vector3.new(3, 4, 0.05), frame * CFrame.new(0, 0, -0.33), Enum.Material.SmoothPlastic, Color3.fromRGB(38, 38, 38)))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 1
	gui.Parent = canvas
	local function blob(name: string, pos: UDim2, size: UDim2, color: Color3)
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = pos
		f.Size = size
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = f
		f.Parent = gui
		return f
	end
	blob("Body", UDim2.fromScale(0.5, 1.05), UDim2.fromScale(0.95, 0.5), Color3.fromRGB(20, 20, 20))
	local face = blob("Face", UDim2.fromScale(0.5, 0.42), UDim2.fromScale(0.5, 0.5), Color3.fromRGB(205, 200, 190))
	face.Rotation = random:NextNumber(-8, 8)
	blob("EyeL", UDim2.fromScale(0.41, 0.38), UDim2.fromScale(0.11, 0.09), Color3.new(0, 0, 0))
	blob("EyeR", UDim2.fromScale(0.59, 0.38), UDim2.fromScale(0.11, 0.09), Color3.new(0, 0, 0))
	blob("Mouth", UDim2.fromScale(0.5, 0.55), UDim2.fromScale(0.16, 0.12), Color3.new(0, 0, 0))
end

local function buildHouseProps(layout: Layout, parent: Instance, notes: { Note })
	local O = Vector3.new(layout.house.x0 * C, 0, layout.house.z0 * C)

	local function box(name: string, size: Vector3, x: number, yBottom: number, z: number, material: Enum.Material, color: Color3, rotY: number?): Part
		return part(parent, name, size, CFrame.new(O + Vector3.new(x, yBottom + size.Y / 2, z)) * CFrame.Angles(0, rotY or 0, 0), material, color)
	end
	local function wallFrame(x: number, y: number, z: number, facing: Vector3): CFrame
		local pos = O + Vector3.new(x, y, z)
		return CFrame.lookAt(pos, pos + facing)
	end
	local function note(x: number, y: number, z: number, text: string)
		local p = box("Note", Vector3.new(1.3, 0.05, 1.7), x, y, z, Enum.Material.SmoothPlastic, Color3.fromRGB(215, 210, 196), random:NextNumber(-0.4, 0.4))
		p.CanCollide = false
		table.insert(notes, { part = p :: BasePart, text = text })
	end

	local wood = Enum.Material.Wood
	local darkWood = Color3.fromRGB(62, 50, 42)
	local fabric = Enum.Material.Fabric

	-- Bedroom (x 0..24, z 24..36): you wake up here.
	box("BedFrame", Vector3.new(6, 1.6, 8), 3.6, 0, 29.1, wood, darkWood)
	box("Headboard", Vector3.new(6, 4.2, 0.5), 3.6, 0, 24.85, wood, darkWood)
	box("Mattress", Vector3.new(5.6, 0.9, 7.4), 3.6, 1.6, 29.3, fabric, Color3.fromRGB(196, 194, 188))
	box("Pillow", Vector3.new(3.6, 0.6, 1.5), 3.6, 2.5, 26.2, fabric, Color3.fromRGB(220, 218, 214))
	box("Blanket", Vector3.new(5.8, 0.3, 4.6), 3.7, 2.5, 31.0, fabric, Color3.fromRGB(70, 70, 78), 0.06)
	box("Nightstand", Vector3.new(2.2, 2.4, 2), 8, 0, 25.6, wood, darkWood)
	box("BrokenLamp", Vector3.new(0.6, 1.3, 0.6), 8.4, 2.4, 25.4, Enum.Material.Metal, Color3.fromRGB(80, 80, 80), 0.3)
	note(7.7, 2.4, 25.9, "If you're reading this, you woke up here too.\nThere's no color anymore. Find the 4 KEYS out in the halls.\nEach key has a tag with a number. The door in the hall wants all of it.")
	-- a chair facing the corner
	box("ChairSeat", Vector3.new(2.2, 0.35, 2.2), 21.4, 2.1, 33.6, wood, darkWood, math.rad(45))
	box("ChairBack", Vector3.new(2.2, 3.2, 0.3), 22.2, 2.45, 34.4, wood, darkWood, math.rad(45))
	for _, l in { { 20.7, 33.6 }, { 21.4, 32.9 }, { 22.1, 33.6 }, { 21.4, 34.3 } } do
		box("ChairLeg", Vector3.new(0.3, 2.1, 0.3), l[1], 0, l[2], wood, darkWood)
	end
	portrait(parent, wallFrame(18, 6.2, 35.5, Vector3.new(0, 0, -1)))

	-- Living room (x 0..24, z 0..24)
	local couch = Color3.fromRGB(104, 100, 96)
	box("CouchBase", Vector3.new(3.6, 2, 9), 2.9, 0, 12, fabric, couch)
	box("CouchBack", Vector3.new(1.2, 4.2, 9), 1.1, 0, 12, fabric, couch)
	box("CouchArm", Vector3.new(3.6, 3, 1), 2.9, 0, 7, fabric, couch)
	box("CouchArm", Vector3.new(3.6, 3, 1), 2.9, 0, 17, fabric, couch)
	decor(box("Rug", Vector3.new(10, 0.1, 8), 8, 0.05, 12, fabric, Color3.fromRGB(56, 56, 60)))
	box("CoffeeTable", Vector3.new(3, 1.6, 5), 8.5, 0, 12, wood, darkWood)
	box("TVStand", Vector3.new(2.4, 2.4, 6.4), 22.2, 0, 6, wood, darkWood)
	box("TV", Vector3.new(1, 3.4, 5.4), 22.5, 2.4, 6, Enum.Material.SmoothPlastic, Color3.fromRGB(16, 16, 16))
	local screen = decor(part(parent, "Screen", Vector3.new(4.8, 2.9, 0.05), wallFrame(21.95, 4.1, 6, Vector3.new(-1, 0, 0)), Enum.Material.Neon, Color3.fromRGB(46, 46, 46)))
	local tvGui = Instance.new("SurfaceGui")
	tvGui.Face = Enum.NormalId.Front
	tvGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	tvGui.PixelsPerStud = 40
	tvGui.Parent = screen
	local tvText = Instance.new("TextLabel")
	tvText.BackgroundTransparency = 1
	tvText.Size = UDim2.fromScale(1, 1)
	tvText.Font = Enum.Font.SpecialElite
	tvText.Text = "NO SIGNAL\n\nSTAY ASLEEP"
	tvText.TextScaled = true
	tvText.TextColor3 = Color3.fromRGB(150, 150, 150)
	tvText.Parent = tvGui
	local tvLight = Instance.new("PointLight")
	tvLight.Range = 10
	tvLight.Brightness = 0.6
	tvLight.Shadows = true
	tvLight.Parent = screen
	screen:SetAttribute("BaseBrightness", 0.6)
	CollectionService:AddTag(screen, "FlickerLight")
	box("Bookshelf", Vector3.new(8, 9, 2), 12, 0, 1.55, wood, darkWood)
	for shelf = 0, 2 do
		local x = 8.6
		while x < 15.2 do
			local w = random:NextNumber(0.35, 0.8)
			local h = random:NextNumber(1.4, 2.2)
			box("Book", Vector3.new(w, h, 1.4), x + w / 2, 1 + shelf * 2.8, 2.0, Enum.Material.Fabric, vary(Color3.fromRGB(110, 104, 98), 0.4))
			x += w + random:NextNumber(0.02, 0.4)
		end
	end
	portrait(parent, wallFrame(0.5, 7, 12, Vector3.new(1, 0, 0)))

	-- Hall (x 24..36, z 0..36)
	box("ClockBody", Vector3.new(1.8, 8.6, 1.6), 25.4, 0, 8, wood, darkWood)
	decor(part(parent, "ClockFace", Vector3.new(1.3, 1.3, 0.05), wallFrame(26.33, 6.8, 8, Vector3.new(1, 0, 0)), Enum.Material.SmoothPlastic, Color3.fromRGB(200, 196, 186), Enum.PartType.Block))
	box("CoatRack", Vector3.new(0.4, 7, 0.4), 25.6, 0, 2.2, wood, darkWood)
	decor(box("Runner", Vector3.new(4, 0.1, 30), 30, 0.05, 18, fabric, Color3.fromRGB(60, 58, 58)))
	portrait(parent, wallFrame(24.5, 6.5, 24, Vector3.new(1, 0, 0)))
	portrait(parent, wallFrame(35.5, 6.5, 6, Vector3.new(-1, 0, 0)))

	-- Kitchen (x 36..60, z 0..24)
	box("Counter", Vector3.new(18, 3.4, 2.6), 47, 0, 1.8, wood, Color3.fromRGB(150, 146, 140))
	box("Countertop", Vector3.new(18.4, 0.3, 2.9), 47, 3.4, 1.8, Enum.Material.Marble, Color3.fromRGB(200, 200, 195))
	box("Cabinets", Vector3.new(18, 3, 1.6), 47, 7.2, 1.3, wood, Color3.fromRGB(140, 136, 130))
	box("Fridge", Vector3.new(3.2, 7.5, 3), 57.9, 0, 14, Enum.Material.Metal, Color3.fromRGB(186, 186, 186))
	box("TableTop", Vector3.new(6, 0.3, 4), 46, 2.9, 13, wood, darkWood)
	for _, l in { { 43.4, 11.4 }, { 48.6, 11.4 }, { 43.4, 14.6 }, { 48.6, 14.6 } } do
		box("TableLeg", Vector3.new(0.3, 2.9, 0.3), l[1], 0, l[2], wood, darkWood)
	end
	box("KitchenChair", Vector3.new(2, 2, 2), 46, 0, 16.2, wood, darkWood)
	box("KitchenChair", Vector3.new(2, 2, 2), 41.6, 0, 13, wood, darkWood, math.rad(70)) -- knocked askew
	note(46.5, 3.2, 13, "The lockers saved me twice.\nThe third time it WATCHED me get in.\nIf it's chasing you, break line of sight first.")

	-- Study (x 36..60, z 24..36)
	box("Desk", Vector3.new(6, 3, 2.6), 42, 0, 34.2, wood, darkWood)
	box("DeskChair", Vector3.new(2, 2, 2), 42, 0, 31.6, wood, darkWood)
	box("Bookshelf", Vector3.new(2, 9, 8), 58.5, 0, 30, wood, darkWood)
	note(41.2, 3, 34.0, "Day 14.\nIt doesn't see well in the dark, but it HEARS everything.\nWalk. Crouch. Only run when it's already running at you.\nAnd it likes the light. Turn yours off when it's close.")
	portrait(parent, wallFrame(42, 6.5, 24.5, Vector3.new(0, 0, 1)))
end

local function buildMazeProps(layout: Layout, parent: Instance)
	local keyCells: { [string]: boolean } = {}
	for _, k in layout.keys do
		keyCells[Maze.key(k.x, k.z)] = true
	end
	for z = 0, layout.depth - 1 do
		for x = 0, layout.width - 1 do
			if not Maze.isHouse(layout, x, z) then
				local center = WorldBuilder.cellCenter(x, z)
				-- pipes along a wall, up near the ceiling
				if random:NextNumber() < 0.3 then
					for _, side in Maze.DIRS do
						if Maze.getEdge(layout, x, z, side) == "wall" then
							local f = WorldBuilder.sideFrame(x, z, side)
							decor(part(parent, "Pipe", Vector3.new(C - T, 0.8, 0.8), f * CFrame.new(0, H - 1.6, -0.6), Enum.Material.CorrodedMetal, vary(Color3.fromRGB(96, 96, 96), 0.2), Enum.PartType.Cylinder))
							if random:NextNumber() < 0.5 then
								decor(part(parent, "Pipe", Vector3.new(C - T, 0.45, 0.45), f * CFrame.new(0, H - 2.6, -0.45), Enum.Material.Metal, vary(Color3.fromRGB(70, 70, 70), 0.2), Enum.PartType.Cylinder))
							end
							break
						end
					end
				end
				-- black puddles that catch the flashlight
				if random:NextNumber() < 0.16 then
					local p = decor(part(parent, "Puddle", Vector3.new(random:NextNumber(3, 6), 0.04, random:NextNumber(3, 6)), CFrame.new(center + Vector3.new(random:NextNumber(-2, 2), 0.03, random:NextNumber(-2, 2))) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0), Enum.Material.Glass, Color3.fromRGB(18, 18, 18)))
					p.Transparency = 0.3
					p.Reflectance = 0.3
					p.CastShadow = false
				end
				-- clutter in dead ends that don't hold a key
				if Maze.passableCount(layout, x, z) == 1 and not keyCells[Maze.key(x, z)] and random:NextNumber() < 0.6 then
					for _, side in Maze.DIRS do
						if Maze.getEdge(layout, x, z, side) == "wall" then
							local f = WorldBuilder.sideFrame(x, z, side)
							for i = 1, random:NextInteger(1, 3) do
								local s = random:NextNumber(1.8, 3)
								part(parent, "Crate", Vector3.new(s, s, s), f * CFrame.new(random:NextNumber(-3.5, 3.5), s / 2 + (if i == 3 then 2.4 else 0), -s / 2 - 0.2) * CFrame.Angles(0, random:NextNumber(-0.3, 0.3), 0), Enum.Material.WoodPlanks, vary(Color3.fromRGB(90, 80, 70), 0.2))
							end
							break
						end
					end
				end
			end
		end
	end
end

local function buildExitTunnel(layout: Layout, parent: Instance): (BasePart, PointLight)
	local x = (layout.exitCell.x + 0.5) * C
	local width = WorldBuilder.EXIT_WIDTH + 2
	local length = 28
	local zMid = -length / 2
	part(parent, "TunnelFloor", Vector3.new(width + 2, 1, length), CFrame.new(x, -0.5, zMid), Enum.Material.Concrete, Color3.fromRGB(60, 60, 60))
	part(parent, "TunnelCeiling", Vector3.new(width + 2, 1, length), CFrame.new(x, H + 0.5, zMid), Enum.Material.Concrete, Color3.fromRGB(40, 40, 40))
	for _, sx in { -1, 1 } do
		part(parent, "TunnelWall", Vector3.new(1, H, length), CFrame.new(x + sx * (width / 2 + 0.5), H / 2, zMid), MAZE_WALL.material, MAZE_WALL.color)
	end
	local glow = part(parent, "TheOutside", Vector3.new(width + 2, H, 0.5), CFrame.new(x, H / 2, -length), Enum.Material.Neon, Color3.fromRGB(255, 255, 255))
	glow.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 45
	light.Brightness = 4
	light.Shadows = true
	light.Enabled = false -- switched on when the exit opens
	light.Parent = glow
	local zone = decor(part(parent, "EscapeZone", Vector3.new(width, 12, 2), CFrame.new(x, 6, -12), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1)))
	zone.CanTouch = true
	zone.Transparency = 1
	return zone, light
end

function WorldBuilder.build(layout: Layout): World
	random = Random.new(layout.seed)

	local model = Instance.new("Model")
	model.Name = "World"

	local structure = Instance.new("Folder")
	structure.Name = "Structure"
	structure.Parent = model
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = model
	local lights = Instance.new("Folder")
	lights.Name = "Lights"
	lights.Parent = model

	local W, D = layout.width, layout.depth

	-- floor + ceiling
	part(structure, "Floor", Vector3.new(W * C + 2, 1, D * C + 2), CFrame.new(W * C / 2, -0.5, D * C / 2), Enum.Material.Slate, Color3.fromRGB(54, 54, 54))
	part(structure, "Ceiling", Vector3.new(W * C + 2, 1, D * C + 2), CFrame.new(W * C / 2, H + 0.5, D * C / 2), Enum.Material.Concrete, Color3.fromRGB(42, 42, 42))
	for key, room in layout.rooms do
		local xs, zs = string.match(key, "^(%-?%d+),(%-?%d+)$")
		local cx, cz = tonumber(xs) :: number, tonumber(zs) :: number
		local floorStyle = ROOM_FLOORS[room]
		part(structure, "HouseFloor", Vector3.new(C, 1, C), CFrame.new((cx + 0.5) * C, -0.45, (cz + 0.5) * C), floorStyle.material, floorStyle.color)
		part(structure, "HouseCeiling", Vector3.new(C, 1, C), CFrame.new((cx + 0.5) * C, H + 0.45, (cz + 0.5) * C), Enum.Material.Plaster, Color3.fromRGB(128, 126, 122))
	end

	buildEdges(layout, structure)
	buildPillars(layout, structure)

	-- maze lamps (some buzz) + one lamp per house room
	for _, c in layout.lights do
		lamp(lights, WorldBuilder.cellCenter(c.x, c.z), random:NextNumber(1.1, 1.7), 20, false, random:NextNumber() < 0.4)
	end
	local O = Vector3.new(layout.house.x0 * C, 0, layout.house.z0 * C)
	for _, spot in { { 12, 12, 1.3 }, { 48, 12, 1.4 }, { 12, 30, 0.8 }, { 48, 30, 1.0 }, { 30, 18, 1.2 }, { 30, 5, 0.9 } } do
		lamp(lights, O + Vector3.new(spot[1], 0, spot[2]), spot[3], 24, true, false)
	end

	for _, w in layout.writings do
		writing(props, WorldBuilder.sideFrame(w.x, w.z, w.side) * CFrame.new(random:NextNumber(-1.2, 1.2), random:NextNumber(5, 7), -0.1), w.text)
	end

	local notes: { Note } = {}
	buildHouseProps(layout, props, notes)
	buildMazeProps(layout, props)
	WorldBuilder.setupCollisionGroups()
	WorldBuilder.markFurniture(props)
	local escapeZone, exitLight = buildExitTunnel(layout, structure)

	-- spawn spots in the bedroom, facing the bedroom door
	local spawnPoints = {}
	for _, s in { { 10, 33.5 }, { 13, 33.5 }, { 10, 29.5 }, { 13, 29.5 }, { 16, 33.5 }, { 16, 30.5 } } do
		local pos = O + Vector3.new(s[1], 3.5, s[2])
		table.insert(spawnPoints, CFrame.lookAt(pos, pos + Vector3.new(1, 0, 0)))
	end

	model.Parent = workspace

	return {
		model = model,
		spawnPoints = spawnPoints,
		houseOrigin = O,
		escapeZone = escapeZone,
		exitLight = exitLight,
		hiddenSpot = CFrame.new(W * C / 2, -300, D * C / 2),
		notes = notes,
		random = random,
	}
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="32">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">14</token>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="33">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="34">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">0.5</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="35">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="36">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
-- The dread: fear level, heartbeat, camera shake, blur, ambient drone, random
-- sounds behind you, lamps that flicker (and die when *it* walks under them).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Atmosphere = {}

type Lamp = {
	part: BasePart,
	light: PointLight?,
	base: number,
	baseColor: Color3,
	dropUntil: number,
	nextDrop: number,
	buzz: Sound?,
}

local STINGERS: { { any } } = {
	-- name, weight, min distance, max distance, volume
	{ "StingerCreak", 3, 14, 30, 0.9 },
	{ "StingerBang", 2, 25, 45, 1.0 },
	{ "StingerWhisper", 2, 4, 8, 0.45 },
	{ "StingerScrape", 2, 16, 34, 0.8 },
	{ "StingerDistantScream", 1, 40, 60, 0.8 },
	{ "StingerKnock", 2, 10, 24, 0.9 },
	{ "StingerFootsteps", 2, 10, 20, 0.8 },
	{ "MonsterClicks", 1, 14, 26, 0.7 },
}

local lamps: { [BasePart]: Lamp } = {}
local blur: BlurEffect
local grade: ColorCorrectionEffect
local ambience: Sound? = nil
local heartbeatAt = 0
local nextStinger = 0
local shakeImpulse = 0
local wasChased = false
local wake = 0

local function addLamp(inst: Instance)
	if not inst:IsA("BasePart") or lamps[inst] then
		return
	end
	local light = inst:FindFirstChildOfClass("PointLight")
	local base = inst:GetAttribute("BaseBrightness")
	local lamp: Lamp = {
		part = inst,
		light = light,
		base = if typeof(base) == "number" then base elseif light then light.Brightness else 1,
		baseColor = inst.Color,
		dropUntil = 0,
		nextDrop = os.clock() + math.random() * 10,
		buzz = nil,
	}
	if inst:GetAttribute("Buzz") == true then
		local buzz = Audio.create("LightBuzzLoop", inst, 0.22)
		if buzz then
			buzz.RollOffMinDistance = 4
			buzz.RollOffMaxDistance = 28
			buzz:Play()
			lamp.buzz = buzz
		end
	end
	lamps[inst] = lamp
end

local function updateLamps(monsterPos: Vector3?)
	local now = os.clock()
	for part, lamp in lamps do
		if not part.Parent then
			lamps[part] = nil
			continue
		end
		local light = lamp.light
		if not light then
			continue
		end
		local b = lamp.base
		if now >= lamp.nextDrop then
			lamp.dropUntil = now + 0.03 + math.random() * 0.25
			lamp.nextDrop = now + 2 + math.random() * 12
		end
		if now < lamp.dropUntil then
			b *= 0.12
		end
		if monsterPos then
			local near = (part.Position - monsterPos).Magnitude
			if near < 14 then
				b = if math.random() < 0.9 then 0 else b
			elseif near < 40 then
				local k = 1 - near / 40
				if math.random() < k * 0.6 then
					b *= math.random() * (1 - k)
				end
			end
		end
		light.Brightness = b
		local dark = b < lamp.base * 0.3
		part.Color = if dark then Color3.fromRGB(55, 55, 52) else lamp.baseColor
		if lamp.buzz then
			lamp.buzz.Volume = if dark then 0 else 0.22
		end
	end
end

local function playStinger(origin: BasePart)
	local total = 0
	for _, s in STINGERS do
		total += s[2] :: number
	end
	local pick = math.random() * total
	local chosen = STINGERS[1]
	for _, s in STINGERS do
		pick -= s[2] :: number
		if pick <= 0 then
			chosen = s
			break
		end
	end
	-- usually behind you
	local back = -origin.CFrame.LookVector
	local angle = math.rad(math.random(-75, 75))
	local dir = (CFrame.Angles(0, angle, 0) * Vector3.new(back.X, 0, back.Z)).Unit
	local dist = (chosen[3] :: number) + math.random() * ((chosen[4] :: number) - (chosen[3] :: number))
	local pos = origin.Position + dir * dist + Vector3.new(0, math.random(1, 5), 0)
	Audio.playAt(chosen[1] :: string, pos, chosen[5] :: number, 0.9 + math.random() * 0.2, 140)
end

local function shake()
	if ClientState.jumpscaring then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or camera.CameraType == Enum.CameraType.Scriptable then
		return
	end
	local amount = ClientState.fear ^ 2 * 0.004 + shakeImpulse * 0.02 + (if ClientState.chased then 0.004 else 0)
	if amount > 0.0002 then
		local t = os.clock()
		camera.CFrame *= CFrame.Angles(
			math.noise(t * 9, 0.3) * amount * 2,
			math.noise(t * 9, 4.1) * amount * 2,
			math.noise(t * 7, 8.7) * amount * 3
		)
	end
end

local function update(dt: number)
	local t = os.clock()
	local character = player.Character
	local myRoot = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local monster = workspace:FindFirstChild("Monster")
	local monsterRoot = if monster then monster:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local playing = ClientState.roundStatus == "alive" and myRoot ~= nil

	local raw = 0
	local dist = math.huge
	local chased = false
	local monsterPos: Vector3? = nil
	if monster and monsterRoot and monsterRoot.Position.Y > -100 then
		monsterPos = monsterRoot.Position
		local state = monster:GetAttribute("State")
		if myRoot and playing then
			dist = (monsterRoot.Position - myRoot.Position).Magnitude
			if state ~= "Dormant" then
				raw = math.clamp(1 - (dist - 10) / 75, 0, 1)
			end
			chased = (state == "Chase" or state == "HuntLocker" or state == "Kill") and monster:GetAttribute("TargetUserId") == player.UserId
			if chased then
				raw = math.max(raw, 0.8)
			end
		end
	end

	local fear = ClientState.fear
	fear += (raw - fear) * math.min(1, dt * (if raw > fear then 2.5 else 0.45))
	ClientState.fear = fear
	ClientState.monsterDistance = dist
	ClientState.chased = chased
	ClientState.interference = math.clamp(1 - (dist - 8) / 34, 0, 1)
	Hud.setFear(fear)

	if chased and not wasChased then
		shakeImpulse = 1
		Hud.glitch(0.9, 0.5)
		Hud.flash(0.2, 0.3)
	end
	wasChased = chased
	shakeImpulse = math.max(0, shakeImpulse - dt * 1.5)

	wake = math.max(0, wake - dt * 0.35)
	blur.Size = fear ^ 2 * 4 + (if chased then (math.sin(t * 9) + 1) * 1.5 else 0) + wake * 18
	grade.Contrast = fear * 0.25
	grade.Brightness = -fear * 0.06 + (if math.random() < 0.02 then -0.03 else 0) - wake * 0.1

	if playing and fear > 0.15 and t >= heartbeatAt then
		heartbeatAt = t + (1.15 - fear * 0.8)
		Audio.play("Heartbeat", nil, 0.25 + fear * 1.1)
		Hud.pulse(fear)
	end

	if ambience then
		local target = if playing then 0.75 else 0
		ambience.Volume += (target - ambience.Volume) * math.min(1, dt * 0.8)
	end

	if playing and myRoot and t >= nextStinger then
		nextStinger = t + 16 + math.random() * 26
		playStinger(myRoot)
	end

	updateLamps(monsterPos)
end

function Atmosphere.wakeUp()
	wake = 1
	nextStinger = os.clock() + 20
end

function Atmosphere.init()
	local camera = workspace.CurrentCamera
	blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = camera
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "Fear"
	grade.Parent = camera

	ambience = Audio.track("Ambience", nil, 0)
	if ambience then
		ambience:Play()
	end

	for _, inst in CollectionService:GetTagged("FlickerLight") do
		addLamp(inst)
	end
	CollectionService:GetInstanceAddedSignal("FlickerLight"):Connect(addLamp)

	Remotes.Apparition.OnClientEvent:Connect(function(position: Vector3)
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
		if not root or (root.Position - position).Magnitude > 140 then
			return
		end
		Audio.playAt("StaticBurst", position, 1.3, 1, 140)
		Hud.glitch(0.8, 0.35)
		local now = os.clock()
		for part, lamp in lamps do
			if part.Parent and (part.Position - position).Magnitude < 45 then
				lamp.dropUntil = now + 0.6 + math.random() * 0.4
			end
		end
	end)

	GameState:GetAttributeChangedSignal("MonsterAwake"):Connect(function()
		if GameState:GetAttribute("MonsterAwake") == true and ClientState.roundStatus == "alive" then
			Audio.play("StingerDistantScream", nil, 1.1, 0.8)
			Hud.message("Somewhere in the halls, something wakes up.", "danger")
			shakeImpulse = 0.7
		end
	end)

	RunService.RenderStepped:Connect(update)
	RunService:BindToRenderStep("AchromaShake", Enum.RenderPriority.Camera.Value + 2, shake)

	-- keep effects attached if the camera object is ever replaced
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local cam = workspace.CurrentCamera
		if cam then
			blur.Parent = cam
			grade.Parent = cam
		end
	end)
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
-- Small shared blackboard so client controllers can read each other's state
-- without requiring each other.

local ClientState = {
	started = false, -- clicked "WAKE UP" on the title screen
	roundStatus = "none", -- "none" | "alive" | "caught" | "escaped"
	fear = 0, -- 0..1, how close / how angry the monster is
	monsterDistance = math.huge,
	chased = false, -- the monster is chasing *you*
	hiding = false,
	jumpscaring = false,
	flashlightOn = false,
	interference = 0, -- 0..1, makes your flashlight stutter
	sprinting = false,
	crouching = false,
}

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Endings</string>
            <string name="Source"><![CDATA[--!strict
-- How a night ends for you: the jumpscare when it catches you, or the white-out
-- when you make it through the exit.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Endings = {}

local changed = Instance.new("BindableEvent")
Endings.Changed = changed.Event -- fires when a sequence finishes

local DEATH_LINES = {
	"It was standing behind you the whole time.",
	"You should have stayed quiet.",
	"It saw your light.",
	"Nobody heard you scream.",
	"The grey takes another one.",
}

local function jumpscare(monster: Model)
	ClientState.jumpscaring = true
	ClientState.roundStatus = "caught"
	local camera = workspace.CurrentCamera
	local head = monster:FindFirstChild("Head") :: BasePart?

	Hud.setHudVisible(false)
	Hud.setHint("")
	Hud.flash(1, 0.12)
	Audio.play("Jumpscare", nil, 2.6)
	camera.CameraType = Enum.CameraType.Scriptable

	local start = os.clock()
	RunService:BindToRenderStep("AchromaJumpscare", Enum.RenderPriority.Last.Value, function()
		local e = os.clock() - start
		if head and head.Parent then
			local hp = head.Position
			local face = head.CFrame.LookVector
			local dist = 4.4 - math.min(1, e / 0.15) * 2.9 -- it lunges into your face
			local shake = math.max(0.15, 1 - e / 1.6)
			camera.CFrame = CFrame.lookAt(hp + face * dist - Vector3.new(0, 0.3, 0), hp)
				* CFrame.Angles((math.random() - 0.5) * 0.12 * shake, (math.random() - 0.5) * 0.12 * shake, (math.random() - 0.5) * 0.35 * shake)
			camera.FieldOfView = 62 - math.min(e, 0.4) * 30
		end
		Hud.glitch(0.9, 0.1)
		if e > 1.7 then
			RunService:UnbindFromRenderStep("AchromaJumpscare")
			Hud.fade(0, 0)
			Hud.showBig("IT FOUND YOU", DEATH_LINES[math.random(1, #DEATH_LINES)])
			task.delay(3, function()
				Hud.hideBig()
				camera.FieldOfView = 70
				camera.CameraType = Enum.CameraType.Custom
				ClientState.jumpscaring = false
				Hud.fade(1, 1.2)
				changed:Fire()
			end)
		end
	end)
end

local function escaped()
	ClientState.roundStatus = "escaped"
	ClientState.jumpscaring = true -- freezes input-driven effects for the sequence
	Hud.setHudVisible(false)
	Audio.play("Escape", nil, 1.2)
	Hud.whiteout(0, 2.5)
	task.delay(2, function()
		Hud.setBigColor(Color3.fromRGB(25, 25, 25))
		Hud.showBig("YOU ESCAPED", "For a second, you could swear you saw color again.")
	end)
	task.delay(6.5, function()
		Hud.hideBig(true)
		Hud.setBigColor(Color3.fromRGB(205, 205, 200))
		Hud.whiteout(1, 1.5)
		ClientState.jumpscaring = false
		changed:Fire()
	end)
end

function Endings.init()
	Remotes.Jumpscare.OnClientEvent:Connect(function(monster: Model)
		jumpscare(monster)
	end)
	Remotes.Escaped.OnClientEvent:Connect(escaped)
end

return Endings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Flashlight</string>
            <string name="Source"><![CDATA[--!strict
-- Your flashlight: a shadow-casting spotlight that lags slightly behind your view,
-- drains its battery, stutters when the monster is near, and gives you away.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Config = require(Shared:WaitForChild("Config"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Flashlight = {}

local BRIGHTNESS = 2.6

local holder: Part
local beam: SpotLight
local spill: SpotLight
local battery = 100
local on = false
local sway: CFrame? = nil
local dropUntil = 0
local hinted = false

local function setOn(value: boolean)
	if value and battery <= 0 then
		Audio.play("FlashlightClick", nil, 0.5, 0.8)
		Hud.message("The battery is dead.")
		return
	end
	if value == on then
		return
	end
	on = value
	ClientState.flashlightOn = value
	Audio.play("FlashlightClick", nil, 0.7)
	Remotes.Flashlight:FireServer(value)
end

local function alive(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if holder.Parent ~= camera then
		holder.Parent = camera
	end
	local target = camera.CFrame * CFrame.new(0.45, -0.5, -0.4)
	local current = if sway then sway:Lerp(target, math.min(1, dt * 14)) else target
	sway = current
	holder.CFrame = CFrame.new(target.Position) * current.Rotation

	if on and (not alive() or ClientState.hiding or ClientState.jumpscaring) then
		setOn(false)
	end
	if on then
		battery = math.max(0, battery - Config.Player.BatteryDrain * dt)
		if battery <= 0 then
			setOn(false)
			Hud.message("Your flashlight flickers... and dies.")
		end
	end
	Hud.setBattery(battery / 100)

	-- stutter when the battery is low or the monster is close
	local now = os.clock()
	local instability = ClientState.interference
	if battery < 20 then
		instability = math.max(instability, (20 - battery) / 20 * 0.7)
	end
	if instability > 0 and math.random() < instability * 0.12 then
		dropUntil = now + 0.03 + math.random() * 0.14
	end
	local brightness = if now < dropUntil then BRIGHTNESS * 0.06 else BRIGHTNESS
	beam.Enabled = on
	spill.Enabled = on
	beam.Brightness = brightness
	spill.Brightness = brightness * 0.22

	-- the server puts a copy of your light on your head for other players; hide ours
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local shared = head and head:FindFirstChild("SharedFlashlight")
	if shared and shared:IsA("SpotLight") then
		shared.Enabled = false
	end
end

function Flashlight.init()
	holder = Instance.new("Part")
	holder.Name = "AchromaFlashlight"
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false

	beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Angle = 46
	beam.Range = 48
	beam.Brightness = BRIGHTNESS
	beam.Shadows = true
	beam.Color = Color3.fromRGB(255, 248, 235)
	beam.Enabled = false
	beam.Parent = holder

	spill = Instance.new("SpotLight")
	spill.Face = Enum.NormalId.Front
	spill.Angle = 110
	spill.Range = 16
	spill.Brightness = BRIGHTNESS * 0.22
	spill.Shadows = false
	spill.Enabled = false
	spill.Parent = holder

	ContextActionService:BindAction("AchromaFlashlight", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin and alive() and not ClientState.hiding then
			setOn(not on)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("AchromaFlashlight", "LIGHT")

	Remotes.Battery.OnClientEvent:Connect(function(amount: number)
		battery = math.min(100, battery + amount)
		Audio.play("Battery", nil, 0.8)
		Hud.message("You found a battery.")
	end)

	player.CharacterAdded:Connect(function()
		battery = 100
		on = false
		ClientState.flashlightOn = false
		if not hinted then
			hinted = true
			task.delay(6, function()
				Hud.message("Press F to use your flashlight.  Shift to run, C to crouch.")
			end)
		end
	end)

	RunService:BindToRenderStep("AchromaFlashlight", Enum.RenderPriority.Camera.Value + 1, update)
end

return Flashlight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Hiding</string>
            <string name="Source"><![CDATA[--!strict
-- While you're inside a locker/wardrobe: darker vignette, a "leave" prompt, and
-- the E key / touch button to get back out.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Hiding = {}

local function refresh()
	local hiding = player:GetAttribute("Hiding") == true
	if hiding == ClientState.hiding then
		return
	end
	ClientState.hiding = hiding
	Hud.setHiding(hiding)
	if hiding then
		Hud.message("Hold your breath.")
		ContextActionService:BindAction("AchromaLeave", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
			if state == Enum.UserInputState.Begin then
				Remotes.LeaveHiding:FireServer()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:SetTitle("AchromaLeave", "LEAVE")
	else
		ContextActionService:UnbindAction("AchromaLeave")
	end
end

function Hiding.init()
	player:GetAttributeChangedSignal("Hiding"):Connect(refresh)
	refresh()
end

return Hiding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen everything: film grain, vignette, glitches, keys/code readout, stamina,
-- flashlight battery, typewriter messages, big titles, fades and flashes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))

local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Hud = {}

local TEXT = Color3.fromRGB(205, 205, 200)
local DIM = Color3.fromRGB(120, 120, 116)
local BLACK = Color3.new(0, 0, 0)
local FONT = Enum.Font.SpecialElite

local gui: ScreenGui
local info: Frame
local keyBoxes: { Frame } = {}
local codeLabel: TextLabel
local staminaFrame: Frame
local staminaFill: Frame
local batteryFrame: Frame
local batterySegments: { Frame } = {}
local messages: Frame
local bigTitle: TextLabel
local bigSub: TextLabel
local fadeFrame: Frame
local flashFrame: Frame
local whiteFrame: Frame
local grain: Frame
local specks: { Frame } = {}
local vignette: { Frame } = {}
local glitchBars: { Frame } = {}
local hint: TextLabel
local crosshair: Frame

local fearLevel = 0
local glitchAmount = 0
local glitchUntil = 0
local pulse = 0
local staminaShownAt = 0
local hidingDark = false

local function new<T>(className: string, props: { [string]: any }, parent: Instance?): T
	local inst = Instance.new(className :: any)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return (inst :: any) :: T
end

local function label(props: { [string]: any }, parent: Instance): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = TEXT,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = BLACK,
		TextSize = 20,
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults, parent)
end

local function corner(parent: Instance, radius: number?)
	new("UICorner", { CornerRadius = UDim.new(radius or 0.5, 0) }, parent)
end

local function edgeShade(name: string, size: UDim2, position: UDim2, anchor: Vector2, rotation: number): Frame
	local f: Frame = new("Frame", {
		Name = name,
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		ZIndex = 2,
	}, gui)
	new("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.45, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	return f
end

function Hud.init()
	gui = new("ScreenGui", {
		Name = "AchromaHud",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	-- film grain + dust
	grain = new("Frame", { Name = "Grain", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.97, BorderSizePixel = 0, ZIndex = 1 }, gui)
	for _ = 1, 36 do
		table.insert(specks, new("Frame", { Size = UDim2.fromOffset(2, 2), BorderSizePixel = 0, ZIndex = 1, BackgroundTransparency = 1 }, gui))
	end

	-- vignette
	table.insert(vignette, edgeShade("Top", UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0), Vector2.zero, 90))
	table.insert(vignette, edgeShade("Bottom", UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 1), Vector2.new(0, 1), 270))
	table.insert(vignette, edgeShade("Left", UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), Vector2.zero, 0))
	table.insert(vignette, edgeShade("Right", UDim2.fromScale(0.3, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180))

	for _ = 1, 8 do
		table.insert(glitchBars, new("Frame", { BorderSizePixel = 0, Visible = false, ZIndex = 4, BackgroundColor3 = Color3.new(1, 1, 1) }, gui))
	end

	crosshair = new("Frame", { Name = "Crosshair", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = TEXT, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 5 }, gui)
	corner(crosshair)

	-- keys + code (bottom left)
	info = new("Frame", { Name = "Info", BackgroundTransparency = 1, Position = UDim2.new(0, 28, 1, -96), Size = UDim2.fromOffset(320, 76), ZIndex = 5 }, gui)
	label({ Text = "KEYS", Size = UDim2.fromOffset(60, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = DIM, ZIndex = 5 }, info)
	for i = 1, 4 do
		local box: Frame = new("Frame", { Position = UDim2.fromOffset(64 + (i - 1) * 26, 4), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = TEXT, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, info)
		new("UIStroke", { Color = TEXT, Thickness = 1.5, Transparency = 0.3 }, box)
		table.insert(keyBoxes, box)
	end
	label({ Text = "CODE", Position = UDim2.fromOffset(0, 34), Size = UDim2.fromOffset(60, 24), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = DIM, ZIndex = 5 }, info)
	codeLabel = label({ Text = "_ _ _ _", Position = UDim2.fromOffset(64, 32), Size = UDim2.fromOffset(200, 28), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 26, ZIndex = 5 }, info)

	-- stamina (bottom centre)
	staminaFrame = new("Frame", { Name = "Stamina", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -34), Size = UDim2.fromOffset(260, 4), BackgroundColor3 = Color3.fromRGB(40, 40, 40), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, gui)
	staminaFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = TEXT, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, staminaFrame)

	-- flashlight battery (bottom right)
	batteryFrame = new("Frame", { Name = "Battery", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -28, 1, -28), Size = UDim2.fromOffset(180, 30), BackgroundTransparency = 1, ZIndex = 5 }, gui)
	label({ Text = "LIGHT", Size = UDim2.fromOffset(64, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = DIM, ZIndex = 5 }, batteryFrame)
	for i = 1, 5 do
		table.insert(batterySegments, new("Frame", { Position = UDim2.fromOffset(66 + (i - 1) * 21, 9), Size = UDim2.fromOffset(16, 12), BackgroundColor3 = TEXT, BorderSizePixel = 0, ZIndex = 5 }, batteryFrame))
	end

	hint = label({ Name = "Hint", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -60), Size = UDim2.fromOffset(500, 26), Text = "", TextColor3 = DIM, TextSize = 18, ZIndex = 6 }, gui)

	messages = new("Frame", { Name = "Messages", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.8), Size = UDim2.fromScale(0.62, 0.3), BackgroundTransparency = 1, ZIndex = 6 }, gui)
	new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, messages)

	bigTitle = label({ Name = "BigTitle", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(0.9, 0.2), Font = Enum.Font.Creepster, TextScaled = true, Text = "", TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 11 }, gui)
	bigSub = label({ Name = "BigSub", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.54), Size = UDim2.fromScale(0.8, 0.12), TextWrapped = true, TextSize = 24, Text = "", TextTransparency = 1, TextStrokeTransparency = 1, TextColor3 = DIM, ZIndex = 11 }, gui)

	fadeFrame = new("Frame", { Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9 }, gui)
	whiteFrame = new("Frame", { Name = "White", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10 }, gui)
	flashFrame = new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10 }, gui)

	if RunService:IsStudio() and not Audio.isConfigured() then
		label({ Text = "Audio IDs not set: see README (ReplicatedStorage.Shared.SoundIds)", Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(520, 20), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 14, TextColor3 = Color3.fromRGB(150, 150, 150), ZIndex = 12 }, gui)
	end

	local function refreshKeys()
		local found = (GameState:GetAttribute("KeysFound") :: number?) or 0
		for i, box in keyBoxes do
			box.BackgroundTransparency = if i <= found then 0.1 else 1
		end
	end
	local function refreshCode()
		local mask = (GameState:GetAttribute("CodeMask") :: string?) or "____"
		codeLabel.Text = table.concat(string.split(mask, ""), " ")
	end
	GameState:GetAttributeChangedSignal("KeysFound"):Connect(refreshKeys)
	GameState:GetAttributeChangedSignal("CodeMask"):Connect(refreshCode)
	refreshKeys()
	refreshCode()

	Hud.setHudVisible(false)
	RunService.RenderStepped:Connect(Hud._update)
end

function Hud._update(dt: number)
	local t = os.clock()

	-- grain flicker + dust
	grain.BackgroundTransparency = 0.955 + math.random() * 0.03 - fearLevel * 0.02
	for i, s in specks do
		if math.random() < 0.5 then
			s.Position = UDim2.fromScale(math.random(), math.random())
			s.BackgroundColor3 = if i % 3 == 0 then BLACK else Color3.new(1, 1, 1)
			s.BackgroundTransparency = 0.55 + math.random() * 0.4
			s.Size = UDim2.fromOffset(math.random(1, 3), math.random(1, 3))
		end
	end

	-- vignette tightens with fear and pulses with the heartbeat
	pulse = math.max(0, pulse - dt * 3)
	local base = 0.35 - fearLevel * 0.3 - pulse * 0.25 - (if hidingDark then 0.3 else 0)
	for _, v in vignette do
		v.BackgroundTransparency = math.clamp(base, 0, 1)
	end

	-- glitch bars
	local g = math.max(glitchAmount * (if t < glitchUntil then 1 else 0), fearLevel > 0.75 and (fearLevel - 0.75) * 1.6 or 0)
	for _, bar in glitchBars do
		if g > 0 and math.random() < g * 0.9 then
			bar.Visible = true
			bar.Position = UDim2.new(math.random() * 0.1 - 0.05, 0, math.random(), 0)
			bar.Size = UDim2.new(1.1, 0, 0, math.random(2, 4 + math.floor(g * 26)))
			bar.BackgroundColor3 = if math.random() < 0.5 then Color3.new(1, 1, 1) else BLACK
			bar.BackgroundTransparency = 0.35 + math.random() * 0.5
		else
			bar.Visible = false
		end
	end

	-- stamina fades away when full
	local showStamina = t - staminaShownAt < 1.2
	staminaFrame.BackgroundTransparency = if showStamina then 0.4 else 1
	staminaFill.BackgroundTransparency = if showStamina then 0.15 else 1
end

function Hud.setHudVisible(visible: boolean)
	info.Visible = visible
	batteryFrame.Visible = visible
	staminaFrame.Visible = visible
	crosshair.Visible = visible
end

function Hud.setStamina(fraction: number)
	staminaFill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	if fraction < 0.995 then
		staminaShownAt = os.clock()
	end
end

function Hud.setBattery(fraction: number)
	local lit = math.ceil(math.clamp(fraction, 0, 1) * #batterySegments - 0.001)
	for i, seg in batterySegments do
		seg.BackgroundTransparency = if i <= lit then (if fraction < 0.2 then 0.4 + math.random() * 0.3 else 0.15) else 0.85
	end
end

function Hud.setFear(f: number)
	fearLevel = f
end

function Hud.pulse(strength: number)
	pulse = math.max(pulse, strength)
end

function Hud.glitch(amount: number, duration: number)
	glitchAmount = amount
	glitchUntil = os.clock() + duration
end

function Hud.setHiding(on: boolean)
	hidingDark = on
	Hud.setHint(if on then "[E]  leave hiding spot" else "")
end

function Hud.setHint(text: string)
	hint.Text = text
end

function Hud.message(text: string, style: string?)
	local isNote = style == "note"
	local color = if style == "danger" then Color3.fromRGB(240, 240, 240) elseif style == "key" then Color3.fromRGB(225, 225, 215) else TEXT
	local line = label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		Text = text,
		TextSize = if style == "danger" then 26 elseif isNote then 22 else 21,
		TextColor3 = color,
		TextStrokeTransparency = 0.35,
		MaxVisibleGraphemes = 0,
		LayoutOrder = math.floor(os.clock() * 100),
		ZIndex = 6,
	}, messages)
	if isNote then
		line.BackgroundTransparency = 0.25
		line.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
		new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, line)
	end
	local lifetime = (if isNote then 7 else 3.5) + #text * (if isNote then 0.045 else 0.03)
	task.spawn(function()
		local count = utf8.len(text) or #text
		for i = 1, count do
			if not line.Parent then
				return
			end
			line.MaxVisibleGraphemes = i
			if i % 2 == 0 then
				task.wait()
			end
		end
		line.MaxVisibleGraphemes = -1
		task.wait(lifetime)
		if line.Parent then
			local tween = TweenService:Create(line, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			line:Destroy()
		end
	end)
	if style == "danger" then
		Hud.glitch(0.6, 0.4)
	end
	-- keep at most 4 lines
	local lines = {}
	for _, c in messages:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(lines, c)
		end
	end
	table.sort(lines, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #lines - 4 do
		lines[i]:Destroy()
	end
end

function Hud.showBig(title: string, sub: string?, font: Enum.Font?)
	bigTitle.Text = title
	bigTitle.Font = font or Enum.Font.Creepster
	bigSub.Text = sub or ""
	TweenService:Create(bigTitle, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
	TweenService:Create(bigSub, TweenInfo.new(1.2), { TextTransparency = 0 }):Play()
end

function Hud.setBigColor(color: Color3)
	bigTitle.TextColor3 = color
	bigSub.TextColor3 = color
end

function Hud.hideBig(instant: boolean?)
	if instant then
		bigTitle.TextTransparency = 1
		bigSub.TextTransparency = 1
	else
		TweenService:Create(bigTitle, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
		TweenService:Create(bigSub, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
	end
end

-- 0 = fully black, 1 = clear
function Hud.fade(transparency: number, time: number)
	if time <= 0 then
		fadeFrame.BackgroundTransparency = transparency
	else
		TweenService:Create(fadeFrame, TweenInfo.new(time), { BackgroundTransparency = transparency }):Play()
	end
end

function Hud.whiteout(transparency: number, time: number)
	if time <= 0 then
		whiteFrame.BackgroundTransparency = transparency
	else
		TweenService:Create(whiteFrame, TweenInfo.new(time), { BackgroundTransparency = transparency }):Play()
	end
end

function Hud.flash(strength: number?, time: number?)
	flashFrame.BackgroundTransparency = 1 - (strength or 0.9)
	TweenService:Create(flashFrame, TweenInfo.new(time or 0.25), { BackgroundTransparency = 1 }):Play()
end

function Hud.gui(): ScreenGui
	return gui
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Keypad</string>
            <string name="Source"><![CDATA[--!strict
-- The exit keypad screen: type the four digits from the key tags and press OK.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Keypad = {}

local gui: ScreenGui
local display: TextLabel
local code = ""
local isOpen = false
local openedAt: Vector3? = nil

local DIGIT_KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.Zero] = "0",
	[Enum.KeyCode.One] = "1",
	[Enum.KeyCode.Two] = "2",
	[Enum.KeyCode.Three] = "3",
	[Enum.KeyCode.Four] = "4",
	[Enum.KeyCode.Five] = "5",
	[Enum.KeyCode.Six] = "6",
	[Enum.KeyCode.Seven] = "7",
	[Enum.KeyCode.Eight] = "8",
	[Enum.KeyCode.Nine] = "9",
	[Enum.KeyCode.KeypadZero] = "0",
	[Enum.KeyCode.KeypadOne] = "1",
	[Enum.KeyCode.KeypadTwo] = "2",
	[Enum.KeyCode.KeypadThree] = "3",
	[Enum.KeyCode.KeypadFour] = "4",
	[Enum.KeyCode.KeypadFive] = "5",
	[Enum.KeyCode.KeypadSix] = "6",
	[Enum.KeyCode.KeypadSeven] = "7",
	[Enum.KeyCode.KeypadEight] = "8",
	[Enum.KeyCode.KeypadNine] = "9",
}

local function refresh()
	local shown = {}
	for i = 1, 4 do
		shown[i] = if i <= #code then string.sub(code, i, i) else "_"
	end
	display.Text = table.concat(shown, " ")
end

local function close()
	isOpen = false
	gui.Enabled = false
	UserInputService.MouseIconEnabled = true
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	return if root then root.Position else nil
end

local function open()
	code = ""
	refresh()
	isOpen = true
	openedAt = rootPosition()
	gui.Enabled = true
	UserInputService.MouseIconEnabled = true
end

local function press(key: string)
	if not isOpen then
		return
	end
	if key == "CLR" then
		code = ""
		Audio.play("KeypadBeep", nil, 0.5, 0.8)
	elseif key == "OK" then
		if #code == 4 then
			Audio.play("KeypadBeep", nil, 0.6, 1.2)
			Remotes.SubmitCode:FireServer(code)
			close()
			return
		end
		Audio.play("KeypadError", nil, 0.4)
	elseif #code < 4 then
		code ..= key
		Audio.play("KeypadBeep", nil, 0.55, 1 + #code * 0.04)
	end
	refresh()
end

function Keypad.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "AchromaKeypad"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Modal = true frees the mouse from first-person lock while this is open
	local panel = Instance.new("TextButton")
	panel.Name = "Panel"
	panel.Modal = true
	panel.AutoButtonColor = false
	panel.Text = ""
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(300, 430)
	panel.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(90, 90, 90)
	stroke.Thickness = 2
	stroke.Parent = panel
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = panel

	display = Instance.new("TextLabel")
	display.Position = UDim2.fromOffset(20, 20)
	display.Size = UDim2.new(1, -40, 0, 64)
	display.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	display.BorderSizePixel = 0
	display.Font = Enum.Font.Code
	display.TextSize = 40
	display.TextColor3 = Color3.fromRGB(220, 220, 220)
	display.Parent = panel

	local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "CLR", "0", "OK" }
	for i, key in keys do
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		local b = Instance.new("TextButton")
		b.Name = "Key" .. key
		b.Position = UDim2.fromOffset(20 + col * 90, 100 + row * 78)
		b.Size = UDim2.fromOffset(80, 68)
		b.BackgroundColor3 = Color3.fromRGB(52, 52, 54)
		b.AutoButtonColor = true
		b.BorderSizePixel = 0
		b.Font = Enum.Font.Code
		b.TextSize = if #key > 1 then 22 else 32
		b.TextColor3 = Color3.fromRGB(225, 225, 225)
		b.Text = key
		b.Parent = panel
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 4)
		bc.Parent = b
		b.Activated:Connect(function()
			press(key)
		end)
	end

	local closeButton = Instance.new("TextButton")
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -6, 0, -34)
	closeButton.Size = UDim2.fromOffset(110, 28)
	closeButton.BackgroundTransparency = 1
	closeButton.Font = Enum.Font.SpecialElite
	closeButton.TextSize = 18
	closeButton.TextColor3 = Color3.fromRGB(170, 170, 170)
	closeButton.Text = "[ESC] close"
	closeButton.Parent = panel
	closeButton.Activated:Connect(close)

	Remotes.OpenKeypad.OnClientEvent:Connect(open)

	UserInputService.InputBegan:Connect(function(input: InputObject, _processed: boolean)
		if not isOpen then
			return
		end
		local digit = DIGIT_KEYS[input.KeyCode]
		if digit then
			press(digit)
		elseif input.KeyCode == Enum.KeyCode.Backspace then
			code = string.sub(code, 1, math.max(0, #code - 1))
			refresh()
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			press("OK")
		elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			close()
		end
	end)

	-- close it if you get dragged away, die, or walk off
	RunService.Heartbeat:Connect(function()
		if not isOpen then
			return
		end
		local pos = rootPosition()
		if not pos or ClientState.jumpscaring or ClientState.hiding or (openedAt and (pos - openedAt).Magnitude > 10) then
			close()
		end
	end)
end

return Keypad
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="44">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- ACHROMA client entry point: hides Roblox's default UI and starts every controller.

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Atmosphere = require(script.Parent.Atmosphere)
local ClientState = require(script.Parent.ClientState)
local Endings = require(script.Parent.Endings)
local Flashlight = require(script.Parent.Flashlight)
local Hiding = require(script.Parent.Hiding)
local Hud = require(script.Parent.Hud)
local Keypad = require(script.Parent.Keypad)
local Menu = require(script.Parent.Menu)
local MonsterAnimator = require(script.Parent.MonsterAnimator)
local Movement = require(script.Parent.Movement)
local Spectate = require(script.Parent.Spectate)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

for _, coreGui in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.PlayerList } do
	StarterGui:SetCoreGuiEnabled(coreGui, false)
end
task.spawn(function()
	-- resetting your character would be a free escape from the monster
	for _ = 1, 20 do
		if pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end) then
			break
		end
		task.wait(0.5)
	end
end)

Hud.init()
Movement.init()
Flashlight.init()
Atmosphere.init()
MonsterAnimator.init()
Endings.init()
Hiding.init()
Keypad.init()
Spectate.init()
Menu.init()

Remotes.Notify.OnClientEvent:Connect(function(text: string, style: string?)
	Hud.message(text, style)
end)

local wakeLines = {
	"You wake up. Everything is grey.",
	"You wake up again. The house is quieter this time.",
	"Same bed. Same grey. Same night.",
}
local nights = 0

player.CharacterAdded:Connect(function(character: Model)
	nights += 1
	ClientState.roundStatus = "alive"
	ClientState.jumpscaring = false
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	camera.CameraSubject = humanoid
	Hud.setHudVisible(true)
	Hud.whiteout(1, 0)
	Hud.fade(0, 0)
	Hud.fade(1, 3)
	Atmosphere.wakeUp()
	task.delay(1.5, function()
		Hud.message(wakeLines[math.min(nights, #wakeLines)])
	end)
end)

player.CharacterRemoving:Connect(function()
	Hud.setHudVisible(false)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Menu</string>
            <string name="Source"><![CDATA[--!strict
-- Title screen, "night falls in..." intermission, and the results screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)
local Endings = require(script.Parent.Endings)
local Spectate = require(script.Parent.Spectate)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Menu = {}

local TEXT = Color3.fromRGB(210, 210, 205)
local DIM = Color3.fromRGB(125, 125, 120)

local TIPS = {
	"It hears running. It barely hears walking. It can't hear you crouch.",
	"Your flashlight lets you see. It also lets IT see you.",
	"If it watched you climb into a locker, the locker won't save you.",
	"Each key's tag shows one digit of the exit code.",
	"A wrong code makes the keypad buzz. Something will come to see.",
	"Loops in the maze can save your life. Dead ends won't.",
	"When the lights start flickering, it's close.",
	"Listen for the clicking.",
}

local gui: ScreenGui
local title: Frame
local overlay: Frame
local overlayTitle: TextLabel
local overlaySub: TextLabel
local logo: TextLabel
local music: Sound? = nil
local lastResult: { result: string, survivors: { string }, seconds: number }? = nil
local tip = TIPS[1]

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.SpecialElite
	l.TextColor3 = TEXT
	l.TextSize = 22
	for k, v in props do
		(l :: any)[k] = v
	end
	l.Parent = parent
	return l
end

local function fullscreen(parent: Instance, name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.new(0, 0, 0)
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

local function formatTime(seconds: number): string
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function refresh()
	if not ClientState.started then
		overlay.Visible = false
		return
	end
	local phase = GameState:GetAttribute("Phase")
	local hasCharacter = player.Character ~= nil
	local busy = ClientState.jumpscaring
	local heading: string? = nil
	local sub = ""

	if busy then
		heading = nil
	elseif phase == "Results" and lastResult then
		local r = lastResult
		if ClientState.roundStatus == "escaped" then
			heading = "YOU ESCAPED"
		elseif r.result == "Escaped" then
			heading = "THEY GOT OUT"
		else
			heading = "NOBODY ESCAPED"
		end
		sub = if #r.survivors > 0 then "Survivors: " .. table.concat(r.survivors, ", ") .. "\n" else ""
		sub ..= "Time in the dark: " .. formatTime(r.seconds)
	elseif not hasCharacter and (phase == "Intermission" or phase == "Waiting") then
		local countdown = GameState:GetAttribute("Countdown")
		heading = if phase == "Intermission" and typeof(countdown) == "number" then "NIGHT FALLS IN " .. countdown else "..."
		sub = tip
	elseif not hasCharacter and phase == "Playing" and not Spectate.isActive() then
		heading = "..."
		sub = "Waiting for the others to escape, or not."
	end

	overlay.Visible = heading ~= nil
	if heading then
		overlayTitle.Text = heading
		overlaySub.Text = sub
	end
	if music then
		local target = if heading ~= nil then 0.4 else 0
		TweenService:Create(music, TweenInfo.new(1.5), { Volume = target }):Play()
	end
end

local function start()
	if ClientState.started then
		return
	end
	ClientState.started = true
	tip = TIPS[math.random(1, #TIPS)]
	local fade = TweenService:Create(title, TweenInfo.new(1.2), { BackgroundTransparency = 1 })
	for _, d in title:GetDescendants() do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			TweenService:Create(d, TweenInfo.new(0.8), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		end
		if d:IsA("UIStroke") then
			TweenService:Create(d, TweenInfo.new(0.8), { Transparency = 1 }):Play()
		end
	end
	fade:Play()
	fade.Completed:Once(function()
		title.Visible = false
	end)
	Remotes.Ready:FireServer()
	refresh()
end

function Menu.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "AchromaMenu"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Title screen
	title = fullscreen(gui, "Title")
	logo = text(title, {
		Name = "Logo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromScale(0.8, 0.22),
		Font = Enum.Font.Creepster,
		Text = "ACHROMA",
		TextScaled = true,
	})
	text(title, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.43),
		Size = UDim2.fromScale(0.8, 0.05),
		Text = "You woke up. The color is gone. Something else woke up too.",
		TextColor3 = DIM,
		TextScaled = true,
	})
	local button = Instance.new("TextButton")
	button.Name = "WakeUp"
	button.Modal = true -- frees the mouse while the menu is up
	button.AnchorPoint = Vector2.new(0.5, 0.5)
	button.Position = UDim2.fromScale(0.5, 0.6)
	button.Size = UDim2.fromOffset(280, 60)
	button.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
	button.AutoButtonColor = true
	button.Font = Enum.Font.SpecialElite
	button.TextSize = 30
	button.TextColor3 = TEXT
	button.Text = "WAKE UP"
	button.Parent = title
	local stroke = Instance.new("UIStroke")
	stroke.Color = TEXT
	stroke.Thickness = 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = button
	button.Activated:Connect(start)

	text(title, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.new(0.9, 0, 0, 120),
		TextWrapped = true,
		TextSize = 18,
		TextColor3 = DIM,
		Text = "Find the 4 KEYS hidden in the maze. Each key's tag shows one number of the exit code.\n"
			.. "Bring them back to the exit in the hall and type the code.  Don't let it see you.\n\n"
			.. "WASD move    SHIFT run    C crouch    F flashlight    E interact / hide",
	})

	-- Intermission / results overlay
	overlay = fullscreen(gui, "Overlay")
	overlay.Visible = false
	overlayTitle = text(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.85, 0.16),
		Font = Enum.Font.Creepster,
		TextScaled = true,
	})
	overlaySub = text(overlay, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.54),
		Size = UDim2.fromScale(0.75, 0.2),
		TextWrapped = true,
		TextColor3 = DIM,
		TextYAlignment = Enum.TextYAlignment.Top,
	})

	music = Audio.track("MusicBox", nil, 0.4)
	if music then
		music:Play()
	end

	GameState:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = GameState:GetAttribute("Phase")
		if phase == "Intermission" then
			tip = TIPS[math.random(1, #TIPS)]
			ClientState.roundStatus = "none"
		end
		refresh()
	end)
	GameState:GetAttributeChangedSignal("Countdown"):Connect(refresh)
	Remotes.RoundResult.OnClientEvent:Connect(function(result: string, survivors: { string }, seconds: number)
		lastResult = { result = result, survivors = survivors, seconds = seconds }
		refresh()
	end)
	player.CharacterAdded:Connect(refresh)
	player.CharacterRemoving:Connect(function()
		task.defer(refresh)
	end)
	Endings.Changed:Connect(refresh)

	-- the logo flickers like a dying bulb; overlay refreshes for spectate changes
	local accum = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if title.Visible then
			logo.TextTransparency = if math.random() < 0.04 then 0.2 + math.random() * 0.6 else 0
			logo.Rotation = if math.random() < 0.01 then (math.random() - 0.5) * 3 else 0
		end
		accum += dt
		if accum > 0.5 then
			accum = 0
			if ClientState.started and player.Character == nil then
				refresh()
			end
		end
	end)
end

return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">MonsterAnimator</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural animation for the monster, run locally on every client: a lurching
-- gait, arms dragging (or reaching for you when it chases), a head that snaps to
-- new angles, a jaw that hangs open, fingers that never stop moving. Also plays its
-- footsteps and clicking.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))

local MonsterAnimator = {}

type Joint = { motor: Motor6D, base: CFrame }
type Rig = {
	model: Model,
	root: BasePart,
	joints: { [string]: Joint },
	gait: number,
	twitchAt: number,
	headTarget: CFrame,
	headCurrent: CFrame,
	nextClick: number,
	lastStepSign: number,
	eyeGlow: PointLight?,
}

local current: Rig? = nil

local function collect(model: Model): Rig?
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local joints: { [string]: Joint } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and not joints[d.Name] then
			joints[d.Name] = { motor = d, base = d.C0 }
		end
	end
	if not joints.Neck then
		return nil -- still replicating
	end
	local glow = model:FindFirstChild("EyeGlow", true)
	return {
		model = model,
		root = root,
		joints = joints,
		gait = 0,
		twitchAt = 0,
		headTarget = CFrame.new(),
		headCurrent = CFrame.new(),
		nextClick = os.clock() + 3,
		lastStepSign = 1,
		eyeGlow = if glow and glow:IsA("PointLight") then glow else nil,
	}
end

local function set(rig: Rig, name: string, offset: CFrame)
	local j = rig.joints[name]
	if j then
		j.motor.C0 = j.base * offset
	end
end

local function rnd(scale: number): number
	return (math.random() - 0.5) * scale
end

local function animate(rig: Rig, dt: number)
	local t = os.clock()
	local root = rig.root
	if root.Position.Y < -100 then
		return -- parked out of sight
	end
	local state = rig.model:GetAttribute("State")
	local vel = root.AssemblyLinearVelocity
	local speed = if root.Anchored then 0 else Vector3.new(vel.X, 0, vel.Z).Magnitude
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local staring = state == "Apparition"

	rig.gait += dt * speed * 0.42
	local stride = math.clamp(speed / 14, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)

	-- head: holds still, then SNAPS to a new angle
	if t >= rig.twitchAt then
		rig.twitchAt = t + (if chase then 0.08 + math.random() * 0.35 elseif staring then 1.5 + math.random() * 2 else 0.25 + math.random() * 1.6)
		rig.headTarget = CFrame.Angles(rnd(0.7), rnd(1.0), rnd(if staring then 0.4 else 1.4))
	end
	local target = rig.headTarget
	if staring then
		target = CFrame.Angles(0.15, 0, 1.1) * rig.headTarget:Lerp(CFrame.new(), 0.7) -- head tilted right over, staring
	end
	rig.headCurrent = rig.headCurrent:Lerp(target, math.min(1, dt * (if chase then 32 else 18)))
	local jitterScale = if chase or kill then 0.09 else 0.035
	set(rig, "Neck", rig.headCurrent * CFrame.Angles(rnd(jitterScale), rnd(jitterScale), rnd(jitterScale)))

	local jawOpen = if kill then 1.1 + math.random() * 0.2 elseif chase then 0.55 + math.abs(math.sin(t * 14)) * 0.35 elseif staring then 0.7 else 0.12 + (math.sin(t * 1.7) + 1) * 0.08
	set(rig, "Jaw", CFrame.Angles(-jawOpen, 0, 0))

	local lean = if chase then -0.28 elseif kill then -0.2 else 0
	set(rig, "Spine", CFrame.Angles(lean + math.abs(s1) * 0.06 * stride + math.sin(t * 0.8) * 0.03, s1 * 0.08 * stride, math.sin(t * 0.9) * 0.05))
	set(rig, "Waist", CFrame.new(0, math.abs(math.cos(g)) * 0.25 * stride, 0) * CFrame.Angles(0, -s1 * 0.12 * stride, 0))

	set(rig, "LHip", CFrame.Angles(s1 * 0.75 * stride, 0, 0))
	set(rig, "RHip", CFrame.Angles(s2 * 0.75 * stride, 0, 0))
	set(rig, "LKnee", CFrame.Angles(-math.max(0, math.cos(g)) * 0.9 * stride, 0, 0))
	set(rig, "RKnee", CFrame.Angles(-math.max(0, math.cos(g + math.pi)) * 0.9 * stride, 0, 0))
	set(rig, "LAnkle", CFrame.Angles(s1 * 0.3 * stride, 0, 0))
	set(rig, "RAnkle", CFrame.Angles(s2 * 0.3 * stride, 0, 0))

	-- arms drag and sway; when it chases they reach out in front of it
	local reach = if chase or kill then 1.3 else 0
	local twitchL = if math.random() < 0.02 then rnd(0.6) else 0
	local twitchR = if math.random() < 0.02 then rnd(0.6) else 0
	set(rig, "LShoulder", CFrame.Angles(reach + s2 * 0.4 * stride + math.sin(t * 1.3) * 0.06 + twitchL, 0, -0.12 * reach))
	set(rig, "RShoulder", CFrame.Angles(reach + s1 * 0.4 * stride + math.sin(t * 1.1 + 1) * 0.06 + twitchR, 0, 0.12 * reach))
	set(rig, "LElbow", CFrame.Angles(-0.15 - reach * 0.25 + math.sin(t * 2.1) * 0.05, 0, 0))
	set(rig, "RElbow", CFrame.Angles(-0.15 - reach * 0.25 + math.sin(t * 2.3 + 2) * 0.05, 0, 0))
	for i = 1, 4 do
		local curl = (math.sin(t * 6 + i * 1.3) + 1) * 0.15 + (if chase or kill then 0.45 else 0) + rnd(0.05)
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
	end

	-- footsteps on every foot-fall
	local sign = if s1 >= 0 then 1 else -1
	if sign ~= rig.lastStepSign and speed > 2 then
		Audio.playAt("MonsterStep", root.Position - Vector3.new(0, 4.6, 0), math.clamp(speed / 11, 0.45, 1.5), 0.85 + math.random() * 0.25, 110)
	end
	rig.lastStepSign = sign

	-- clicking while it hunts
	if t >= rig.nextClick then
		rig.nextClick = t + 4 + math.random() * 7
		if state == "Wander" or state == "Search" or state == "Investigate" or staring then
			local head = rig.model:FindFirstChild("Head")
			if head then
				Audio.play("MonsterClicks", head, 1.1, 0.9 + math.random() * 0.2, 80)
			end
		end
	end

	if rig.eyeGlow then
		rig.eyeGlow.Brightness = (if chase or kill then 2 else 1.2) * (if math.random() < 0.03 then 0.2 else 1)
	end
end

function MonsterAnimator.init()
	RunService.RenderStepped:Connect(function(dt: number)
		local model = workspace:FindFirstChild("Monster")
		if not model or not model:IsA("Model") then
			current = nil
			return
		end
		if not current or current.model ~= model then
			current = collect(model)
		end
		if current then
			animate(current, dt)
		end
	end)
end

return MonsterAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- Sprinting (with stamina), crouch-walking, head bob, breathing, field of view.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Config = require(Shared:WaitForChild("Config"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local P = Config.Player
local player = Players.LocalPlayer

local Movement = {}

local humanoid: Humanoid? = nil
local stamina = P.StaminaMax
local sprintHeld = false
local exhausted = false
local lastSprint = 0
local bobTime = 0
local crouchOffset = 0
local breath: Sound? = nil

local function onCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	stamina = P.StaminaMax
	exhausted = false
	crouchOffset = 0
	ClientState.crouching = false
	if humanoid then
		humanoid.WalkSpeed = P.WalkSpeed
	end
end

local function update(dt: number)
	local h = humanoid
	if not h or not h.Parent or h.Health <= 0 then
		return
	end
	local now = os.clock()
	local camera = workspace.CurrentCamera

	local frozen = ClientState.hiding or ClientState.jumpscaring
	local moving = not frozen and h.MoveDirection.Magnitude > 0.1
	local wantsSprint = sprintHeld and moving and not ClientState.crouching and not exhausted

	if wantsSprint then
		stamina = math.max(0, stamina - P.StaminaDrain * dt)
		lastSprint = now
		if stamina <= 0 then
			exhausted = true
			Hud.message("You're out of breath.")
		end
	elseif now - lastSprint > P.StaminaRegenDelay then
		stamina = math.min(P.StaminaMax, stamina + P.StaminaRegen * dt)
	end
	if exhausted and stamina > P.StaminaMax * 0.35 then
		exhausted = false
	end
	ClientState.sprinting = wantsSprint
	Hud.setStamina(stamina / P.StaminaMax)

	local speed = P.WalkSpeed
	if ClientState.crouching then
		speed = P.CrouchSpeed
	elseif wantsSprint then
		speed = P.SprintSpeed
	elseif exhausted then
		speed = P.WalkSpeed * 0.75
	end
	h.WalkSpeed = speed

	-- crouch + head bob through the camera offset
	local crouchTarget = if ClientState.crouching and not frozen then -1.9 else 0
	crouchOffset += (crouchTarget - crouchOffset) * math.min(1, dt * 10)
	local bobX, bobY = 0, 0
	if moving then
		bobTime += dt * speed * 0.75
		local amp = if wantsSprint then 0.16 elseif ClientState.crouching then 0.05 else 0.09
		bobX = math.sin(bobTime) * amp
		bobY = math.abs(math.cos(bobTime)) * amp * 1.4
	end
	h.CameraOffset = Vector3.new(bobX, crouchOffset + bobY, 0)

	if camera and not ClientState.jumpscaring then
		local targetFov = P.FieldOfView + (if wantsSprint then 7 else 0) + ClientState.fear * 6
		camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(1, dt * 5)
	end

	-- heavy breathing when winded or terrified
	if breath then
		local need = math.max(0.65 - stamina / P.StaminaMax, ClientState.fear - 0.45, 0)
		local targetVolume = if frozen and ClientState.hiding then need * 0.6 else need * 1.6
		breath.Volume += (targetVolume - breath.Volume) * math.min(1, dt * 2)
		breath.PlaybackSpeed = 1 + need * 0.3
	end
end

function Movement.init()
	ContextActionService:BindAction("AchromaSprint", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("AchromaSprint", "RUN")

	ContextActionService:BindAction("AchromaCrouch", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin then
			ClientState.crouching = not ClientState.crouching
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("AchromaCrouch", "CROUCH")

	breath = Audio.create("BreathLoop", nil, 0)
	if breath then
		breath:Play()
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.RenderStepped:Connect(update)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[--!strict
-- After you're caught (or escape) while others are still inside, watch over a
-- survivor's shoulder. Click / R1 / tap to switch who you follow.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Spectate = {}

local target: Player? = nil
local active = false
local smoothed: CFrame? = nil

local function survivors(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		local character = p.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if p ~= player and humanoid and humanoid.Health > 0 and character and character:FindFirstChild("Head") then
			table.insert(list, p)
		end
	end
	return list
end

local function nextTarget()
	local list = survivors()
	if #list == 0 then
		target = nil
		return
	end
	local index = table.find(list, target :: any) or 0
	target = list[index % #list + 1]
	smoothed = nil
end

function Spectate.isActive(): boolean
	return active
end

function Spectate.init()
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if not active or processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonR1 then
			nextTarget()
		end
	end)

	RunService:BindToRenderStep("AchromaSpectate", Enum.RenderPriority.Camera.Value + 3, function(dt: number)
		local camera = workspace.CurrentCamera
		local shouldSpectate = ClientState.started
			and not ClientState.jumpscaring
			and player.Character == nil
			and GameState:GetAttribute("Phase") == "Playing"
		if not shouldSpectate then
			if active then
				active = false
				Hud.setHint("")
			end
			return
		end

		local list = survivors()
		if not target or not table.find(list, target) then
			target = nil
			nextTarget()
		end
		local t = target
		local character = if t then t.Character else nil
		local head = if character then character:FindFirstChild("Head") :: BasePart? else nil
		if not t or not head then
			active = false
			Hud.setHint("")
			return
		end
		active = true
		camera.CameraType = Enum.CameraType.Scriptable
		local look = head.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude < 0.01 then
			flatLook = Vector3.new(0, 0, -1)
		end
		local goal = CFrame.lookAt(head.Position - flatLook.Unit * 5 + Vector3.new(0, 2.2, 0), head.Position + flatLook.Unit * 10)
		smoothed = if smoothed then smoothed:Lerp(goal, math.min(1, dt * 6)) else goal
		camera.CFrame = smoothed :: CFrame
		Hud.setHint("SPECTATING  " .. t.DisplayName .. "     [click] next")
	end)
end

return Spectate
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
