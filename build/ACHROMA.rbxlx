      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">MonsterAI</string>
          <string name="Source"><![CDATA[--!strict
-- The thing in the halls. Server-side brain, tuned per night (see Nights.luau):
--   Dormant     hidden away; now and then it APPEARS at the end of your corridor,
--               stares, and vanishes when you get close
--   Wander      roams, drifting towards wherever players are
--   Investigate heard something and goes to look
--   Chase       saw (or heard) you. Screams. Runs at you
--   Search      lost you; sniffs around the last place it saw you
--   HuntLocker  watched (or smelled) you climb into a locker, coming to pull you out
--   Kill        caught someone
-- The Statue has its own two states: Frozen (someone is looking) and Stalk.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Monsters = require(ReplicatedStorage.Shared.Monsters)
local Interactables = require(script.Parent.Interactables)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes

type Layout = Maze.Layout
type Locker = Interactables.Locker

export type Hooks = {
	getPlayers: () -> { Player }, -- players still in the round (not caught, not escaped)
	onCaught: (player: Player, monster: Model) -> (),
	onAwake: () -> (),
	getLook: (player: Player) -> Vector3?, -- where that player's camera points
	setBlink: (on: boolean) -> (),
}

local MonsterAI = {}
MonsterAI.__index = MonsterAI

export type MonsterAI = typeof(setmetatable(
	{} :: {
		layout: Layout,
		world: WorldBuilder.World,
		interactables: Interactables.Interactables,
		hooks: Hooks,
		p: { [string]: any },
		rig: Monsters.Rig,
		humanoid: Humanoid,
		state: string,
		path: { Vector3 },
		pathIndex: number,
		pathGoal: Vector3?,
		lastRepath: number,
		target: Player?,
		lastSeenPos: Vector3?,
		lastSeenTime: number,
		aggression: number,
		frenzyUntil: number,
		lungeUntil: number,
		nextLunge: number,
		awake: boolean,
		awakeAt: number,
		nextApparition: number,
		apparitionTarget: Player?,
		apparitionEnds: number,
		sawHide: { [Player]: Locker },
		huntLocker: Locker?,
		pauseUntil: number,
		searchCenter: Vector3,
		searchUntil: number,
		lastScream: number,
		lastContact: number,
		stuckCheckAt: number,
		stuckPos: Vector3,
		stuckCount: number,
		sightParams: RaycastParams,
		moveParams: RaycastParams,
		noise: { position: Vector3, radius: number }?,
		nextBlink: number,
		blinkUntil: number,
		frozen: boolean,
		lastGrind: number,
		thinkAccum: number,
		connection: RBXScriptConnection?,
		destroyed: boolean,
		random: Random,
	},
	MonsterAI
))

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local rootOf = Interactables.rootOf

local function headOf(player: Player): BasePart?
	local character = player.Character
	return if character then character:FindFirstChild("Head") :: BasePart? else nil
end

function MonsterAI.new(layout: Layout, world: WorldBuilder.World, interactables: Interactables.Interactables, params: { [string]: any }, kind: string, hooks: Hooks): MonsterAI
	local rig = Monsters.build(kind)
	rig.model.Parent = workspace

	local sightParams = RaycastParams.new()
	sightParams.FilterType = Enum.RaycastFilterType.Include
	sightParams.FilterDescendantsInstances = { world.model }

	-- movement checks ignore furniture (it walks through it) and non-collidable decor
	local moveParams = RaycastParams.new()
	moveParams.FilterType = Enum.RaycastFilterType.Include
	moveParams.FilterDescendantsInstances = { world.model }
	moveParams.CollisionGroup = "Monster"
	moveParams.RespectCanCollide = true

	local now = os.clock()
	local random = Random.new(layout.seed + 99)
	local self = setmetatable({
		layout = layout,
		world = world,
		interactables = interactables,
		hooks = hooks,
		p = params,
		rig = rig,
		humanoid = rig.humanoid :: Humanoid,
		state = "Dormant",
		path = {},
		pathIndex = 1,
		pathGoal = nil,
		lastRepath = 0,
		target = nil,
		lastSeenPos = nil,
		lastSeenTime = -math.huge,
		aggression = 0,
		frenzyUntil = 0,
		lungeUntil = 0,
		nextLunge = 0,
		awake = false,
		awakeAt = now + params.AwakenAfter,
		nextApparition = now + random:NextNumber(params.ApparitionMin * 0.5, params.ApparitionMax * 0.6),
		apparitionTarget = nil,
		apparitionEnds = 0,
		sawHide = {},
		huntLocker = nil,
		pauseUntil = 0,
		searchCenter = Vector3.zero,
		searchUntil = 0,
		lastScream = -math.huge,
		lastContact = now,
		stuckCheckAt = 0,
		stuckPos = Vector3.zero,
		stuckCount = 0,
		sightParams = sightParams,
		moveParams = moveParams,
		noise = nil,
		nextBlink = now + random:NextNumber(params.BlinkMin, params.BlinkMax),
		blinkUntil = 0,
		frozen = false,
		lastGrind = 0,
		thinkAccum = 0,
		connection = nil,
		destroyed = false,
		random = random,
	}, MonsterAI)

	self:_park()
	self:_setState("Dormant")
	return self
end

function MonsterAI.start(self: MonsterAI)
	self.connection = RunService.Heartbeat:Connect(function(dt: number)
		self.thinkAccum += dt
		if self.thinkAccum >= 0.1 then
			self.thinkAccum = 0
			self:_think()
		end
	end)
end

function MonsterAI.destroy(self: MonsterAI)
	self.destroyed = true
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	self.hooks.setBlink(false)
	self.rig.model:Destroy()
end

-- Public hooks -----------------------------------------------------------------

function MonsterAI.setAggression(self: MonsterAI, progress: number)
	self.aggression = progress
	self:_updateSpeed()
end

function MonsterAI.hearNoise(self: MonsterAI, position: Vector3, radius: number)
	if not self.noise or radius > self.noise.radius then
		self.noise = { position = position, radius = radius }
	end
end

function MonsterAI.onPlayerHid(self: MonsterAI, player: Player, locker: Locker)
	-- it only knows which locker you're in if it was watching you a moment ago...
	if self.state == "Chase" and self.target == player and os.clock() - self.lastSeenTime < 0.8 then
		self.sawHide[player] = locker
		return
	end
	-- ...or if it can smell you, in which case it comes straight for the locker
	local sense = self.p.SenseHidden
	if sense > 0 and self.awake and self.state ~= "Kill" and (locker.inside.Position - self.rig.root.Position).Magnitude < sense then
		self.sawHide[player] = locker
		self.huntLocker = locker
		self:_setState("HuntLocker")
		self:_setPathTo(locker.outside.Position)
	end
end

-- It knows where everyone is for a while, and goes for the nearest (or a given) player.
function MonsterAI.frenzy(self: MonsterAI, seconds: number, target: Player?)
	if not self.awake then
		self:awaken()
	end
	self.frenzyUntil = os.clock() + seconds
	if self.p.Statue then
		return
	end
	local root = self.rig.root
	local chosen = target
	if not chosen or chosen:GetAttribute("Hiding") then
		local best = math.huge
		for _, player in self.hooks.getPlayers() do
			local proot = rootOf(player)
			if proot and not player:GetAttribute("Hiding") then
				local d = (proot.Position - root.Position).Magnitude
				if d < best then
					chosen, best = player, d
				end
			end
		end
	end
	if chosen and self.state ~= "Kill" then
		self.lastSeenTime = os.clock()
		self:_startChase(chosen)
	end
	self:_updateSpeed()
end

function MonsterAI.onExitOpened(self: MonsterAI)
	self:frenzy(self.p.FrenzyTime, nil)
end

function MonsterAI.forget(self: MonsterAI, player: Player)
	self.sawHide[player] = nil
	if self.target == player then
		self.target = nil
	end
	if self.apparitionTarget == player then
		self.apparitionTarget = nil
	end
end

function MonsterAI.awaken(self: MonsterAI)
	if self.awake or self.destroyed then
		return
	end
	self.awake = true

	-- wake up in the maze cell farthest from every player
	local spawnCell = self.layout.monsterSpawn
	local players = self.hooks.getPlayers()
	if #players > 0 then
		local maps = {}
		for _, player in players do
			local proot = rootOf(player)
			if proot then
				table.insert(maps, Maze.distances(self.layout, Maze.cellOf(self.layout, proot.Position.X, proot.Position.Z)))
			end
		end
		local bestScore = -1
		for z = 0, self.layout.depth - 1 do
			for x = 0, self.layout.width - 1 do
				if not Maze.isHub(self.layout, x, z) then
					local score = math.huge
					for _, dist in maps do
						score = math.min(score, dist[Maze.key(x, z)] or 0)
					end
					if score > bestScore then
						bestScore = score
						spawnCell = { x = x, z = z }
					end
				end
			end
		end
	end
	local cx, cz = Maze.cellCenter(self.layout, spawnCell)
	self.rig.model:PivotTo(CFrame.new(cx, self.rig.rootHeight, cz))
	self:_release()
	self.humanoid:MoveTo(self.rig.root.Position) -- forget the walk target from where it was parked
	if self.rig.growl then
		self.rig.growl:Play()
	end
	if self.p.Statue then
		self:_setState("Stalk")
	else
		self:_setState("Wander")
		self:_pickWanderTarget()
	end
	self.hooks.onAwake()
end

-- Internals ----------------------------------------------------------------------

function MonsterAI._park(self: MonsterAI)
	self.rig.root.Anchored = true
	self.rig.model:PivotTo(self.world.hiddenSpot)
	self.humanoid:MoveTo(self.rig.root.Position)
end

function MonsterAI._release(self: MonsterAI)
	self.rig.root.Anchored = false
	pcall(function()
		self.rig.root:SetNetworkOwner(nil) -- the server drives it, never a nearby client
	end)
end

function MonsterAI._setState(self: MonsterAI, state: string)
	self.state = state
	self.rig.model:SetAttribute("State", state)
	if state ~= "Chase" and state ~= "HuntLocker" and state ~= "Kill" then
		self.rig.model:SetAttribute("TargetUserId", 0)
	end
	self:_updateSpeed()
end

function MonsterAI._chaseSpeed(self: MonsterAI): number
	local p = self.p
	local speed = p.ChaseSpeed + self.aggression * p.ChaseSpeedPerProgress
	local now = os.clock()
	if now < self.frenzyUntil then
		speed += p.FrenzyBonus
	end
	if now < self.lungeUntil then
		speed += p.LungeBonus
	end
	return speed
end

function MonsterAI._updateSpeed(self: MonsterAI)
	local p = self.p
	local s = self.state
	local speed = 0
	if s == "Wander" then
		speed = p.WanderSpeed
	elseif s == "Investigate" then
		speed = p.InvestigateSpeed
	elseif s == "Search" then
		speed = p.SearchSpeed
	elseif s == "Chase" then
		speed = self:_chaseSpeed()
	elseif s == "HuntLocker" then
		speed = self:_chaseSpeed() - 1
	elseif s == "Stalk" then
		speed = p.StatueSpeed + self.aggression * p.StatueSpeedPerProgress
	end
	self.humanoid.WalkSpeed = speed
	local growl = self.rig.growl
	if growl then
		local chasing = s == "Chase" or s == "HuntLocker"
		growl.PlaybackSpeed = if chasing then 1.12 else 0.92
		growl.Volume = if chasing then 1.9 else 1.2
	end
end

function MonsterAI._cellAt(self: MonsterAI, pos: Vector3): Maze.Cell
	return Maze.cellOf(self.layout, pos.X, pos.Z)
end

function MonsterAI._isActive(self: MonsterAI, player: Player): boolean
	for _, p in self.hooks.getPlayers() do
		if p == player then
			return true
		end
	end
	return false
end

-- Waypoints through the maze: edge midpoints (doorways are centred on them) and
-- cell centres, ending exactly at the goal.
function MonsterAI._setPathTo(self: MonsterAI, goal: Vector3): boolean
	local root = self.rig.root
	local cells = Maze.findPath(self.layout, self:_cellAt(root.Position), self:_cellAt(goal))
	self.pathGoal = goal
	self.pathIndex = 1
	if not cells then
		self.path = {}
		return false
	end
	local C = self.layout.cellSize
	local y = root.Position.Y
	local points = {}
	for i = 2, #cells do
		local a, b = cells[i - 1], cells[i]
		table.insert(points, Vector3.new((a.x + b.x + 1) * C / 2, y, (a.z + b.z + 1) * C / 2))
		if i < #cells then
			local cx, cz = Maze.cellCenter(self.layout, b)
			table.insert(points, Vector3.new(cx, y, cz))
		end
	end
	table.insert(points, Vector3.new(goal.X, y, goal.Z))
	self.path = points
	return true
end

-- Returns true once the path is finished.
function MonsterAI._followPath(self: MonsterAI): boolean
	local root = self.rig.root
	local p = self.path[self.pathIndex]
	while p and flat(p - root.Position).Magnitude < 2.2 do
		self.pathIndex += 1
		p = self.path[self.pathIndex]
	end
	if not p then
		self.path = {}
		return true
	end
	self.humanoid:MoveTo(p)
	return false
end

function MonsterAI._clearLine(self: MonsterAI, goal: Vector3): boolean
	local origin = self.rig.root.Position
	local direction = Vector3.new(goal.X, origin.Y, goal.Z) - origin
	if direction.Magnitude < 1 then
		return true
	end
	return workspace:Spherecast(origin, 1.3, direction, self.moveParams) == nil
end

-- Go straight at a point when nothing's in the way, otherwise path to it.
function MonsterAI._moveToward(self: MonsterAI, goal: Vector3, now: number)
	if self:_clearLine(goal) then
		self.path = {}
		self.humanoid:MoveTo(Vector3.new(goal.X, self.rig.root.Position.Y, goal.Z))
	else
		local goalMoved = self.pathGoal == nil or flat((self.pathGoal :: Vector3) - goal).Magnitude > 6
		if #self.path == 0 or goalMoved or now - self.lastRepath > 0.8 then
			self.lastRepath = now
			self:_setPathTo(goal)
		end
		self:_followPath()
	end
end

function MonsterAI._canSee(self: MonsterAI, player: Player, ignoreCone: boolean): (boolean, Vector3?)
	local p = self.p
	if player:GetAttribute("Hiding") then
		return false, nil
	end
	local proot, phead = rootOf(player), headOf(player)
	if not proot or not phead then
		return false, nil
	end
	local eye = self.rig.head.Position
	local toTarget = phead.Position - eye
	local dist = toTarget.Magnitude
	local range = if player:GetAttribute("Flashlight") then p.SightRangeFlashlight else p.SightRange
	local speed = flat(proot.AssemblyLinearVelocity).Magnitude
	if speed > 0.5 and speed < 6.5 then
		range *= p.SneakSightMultiplier
	end
	range = math.max(range, p.CloseSense) -- even a blind thing notices you bump into it
	if dist > range then
		return false, nil
	end
	if not ignoreCone and dist > p.CloseSense then
		local look = flat(self.rig.root.CFrame.LookVector)
		local dir = flat(toTarget)
		if look.Magnitude > 0.01 and dir.Magnitude > 0.01 and look.Unit:Dot(dir.Unit) < p.ViewDot then
			return false, nil
		end
	end
	if workspace:Raycast(eye, toTarget, self.sightParams) then
		return false, nil
	end
	return true, proot.Position
end

function MonsterAI._lookForPlayers(self: MonsterAI): (Player?, Vector3?)
	local best: Player? = nil
	local bestPos: Vector3? = nil
	local bestDist = math.huge
	local root = self.rig.root
	for _, player in self.hooks.getPlayers() do
		local seen, pos = self:_canSee(player, self.state == "Chase" and player == self.target)
		if seen and pos then
			local d = (pos - root.Position).Magnitude
			if player == self.target then
				d *= 0.5 -- stick with the current target
			end
			if d < bestDist then
				best, bestPos, bestDist = player, pos, d
			end
		end
	end
	return best, bestPos
end

-- How far a player's footsteps carry right now (path studs).
function MonsterAI._noiseRadius(self: MonsterAI, player: Player): number
	local proot = rootOf(player)
	if not proot or player:GetAttribute("Hiding") then
		return 0
	end
	local speed = flat(proot.AssemblyLinearVelocity).Magnitude
	return if speed > 14 then self.p.HearSprint elseif speed > 6.5 then self.p.HearWalk else 0
end

-- Returns the loudest thing it can hear: (position, path distance, player?)
function MonsterAI._listen(self: MonsterAI): (Vector3?, number, Player?)
	local dist = Maze.distances(self.layout, self:_cellAt(self.rig.root.Position))
	local C = self.layout.cellSize
	local best: Vector3? = nil
	local bestDist = math.huge
	local bestPlayer: Player? = nil
	local function consider(position: Vector3, radius: number, player: Player?)
		local cell = self:_cellAt(position)
		local d = (dist[Maze.key(cell.x, cell.z)] or math.huge) * C
		if d <= radius and d < bestDist then
			best, bestDist, bestPlayer = position, d, player
		end
	end
	for _, player in self.hooks.getPlayers() do
		local radius = self:_noiseRadius(player)
		local proot = rootOf(player)
		if radius > 0 and proot then
			consider(proot.Position, radius, player)
		end
	end
	local noise = self.noise
	if noise then
		self.noise = nil
		consider(noise.position, noise.radius, nil)
	end
	return best, bestDist, bestPlayer
end

function MonsterAI._pickWanderTarget(self: MonsterAI)
	local W, D = self.layout.width, self.layout.depth
	local cell: Maze.Cell? = nil
	local players = self.hooks.getPlayers()
	local now = os.clock()
	local instinct = self.p.HuntingInstinct
	if #players > 0 then
		local proot = rootOf(players[self.random:NextInteger(1, #players)])
		if proot then
			local pc = self:_cellAt(proot.Position)
			if now - self.lastContact > instinct then
				-- it's been too quiet: it "smells" you and heads straight for where you are
				self.lastContact = now - instinct * 0.5
				cell = pc
			elseif self.random:NextNumber() < 0.7 then
				local r = self.random:NextInteger(1, 4)
				cell = {
					x = math.clamp(pc.x + self.random:NextInteger(-r, r), 0, W - 1),
					z = math.clamp(pc.z + self.random:NextInteger(-r, r), 0, D - 1),
				}
			end
		end
	end
	local chosen = cell or { x = self.random:NextInteger(0, W - 1), z = self.random:NextInteger(0, D - 1) }
	local cx, cz = Maze.cellCenter(self.layout, chosen)
	self:_setPathTo(Vector3.new(cx, 0, cz))
end

function MonsterAI._investigate(self: MonsterAI, position: Vector3)
	if self.state == "Investigate" and self.pathGoal and flat(self.pathGoal - position).Magnitude < 8 then
		return
	end
	self:_setState("Investigate")
	self.pauseUntil = 0
	self:_setPathTo(position)
end

function MonsterAI._beginSearch(self: MonsterAI, around: Vector3, duration: number)
	self:_setState("Search")
	self.searchCenter = around
	self.searchUntil = os.clock() + duration
	self.pauseUntil = 0
	self:_setPathTo(around)
end

function MonsterAI._startChase(self: MonsterAI, player: Player)
	local wasChasing = self.state == "Chase"
	self.target = player
	self.huntLocker = nil
	self:_setState("Chase")
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self.path = {}
	local scream = Monsters.SCREAMS[self.rig.kind]
	if scream and not wasChasing and os.clock() - self.lastScream > 10 then
		self.lastScream = os.clock()
		Audio.play(scream, self.rig.head, 2.2, self.random:NextNumber(0.92, 1.05), 170)
	end
end

function MonsterAI._updateChase(self: MonsterAI, now: number)
	local p = self.p
	local root = self.rig.root
	local target = self.target
	if not target or not self:_isActive(target) then
		self:_beginSearch(self.lastSeenPos or root.Position, p.SearchTime)
		return
	end
	if target:GetAttribute("Hiding") then
		local locker = self.sawHide[target]
		if locker then
			self.huntLocker = locker
			self:_setState("HuntLocker")
			self:_setPathTo(locker.outside.Position)
		else
			self:_beginSearch(self.lastSeenPos or root.Position, p.SearchTime)
		end
		return
	end
	-- blind hunters keep tracking a target while it keeps making noise
	if p.HearChaseRange > 0 then
		local proot = rootOf(target)
		local radius = self:_noiseRadius(target)
		if proot and radius > 0 then
			local dist = Maze.distances(self.layout, self:_cellAt(root.Position))
			local c = self:_cellAt(proot.Position)
			if (dist[Maze.key(c.x, c.z)] or math.huge) * self.layout.cellSize <= radius then
				self.lastSeenPos = proot.Position
				self.lastSeenTime = now
			end
		end
	end
	local frenzy = now < self.frenzyUntil
	if not frenzy and now - self.lastSeenTime > p.LoseSightTime then
		self:_beginSearch(self.lastSeenPos or root.Position, p.SearchTime)
		return
	end
	local proot = rootOf(target)
	if not proot then
		return
	end
	-- lunge when it gets close
	if p.LungeRange > 0 and now >= self.nextLunge and (proot.Position - root.Position).Magnitude < p.LungeRange then
		self.lungeUntil = now + 1.1
		self.nextLunge = now + 4
		self:_updateSpeed()
		task.delay(1.15, function()
			if not self.destroyed then
				self:_updateSpeed()
			end
		end)
	end
	-- for a moment after losing sight it still "knows" where you went
	local goal = if frenzy or now - self.lastSeenTime < 1 then proot.Position else (self.lastSeenPos or proot.Position)
	self:_moveToward(goal, now)
end

function MonsterAI._updateHuntLocker(self: MonsterAI)
	local root = self.rig.root
	local locker = self.huntLocker
	local victim = if locker then locker.occupant else nil
	if not locker or not victim or not self:_isActive(victim) then
		self.huntLocker = nil
		self:_beginSearch(root.Position, 6)
		return
	end
	if flat(locker.outside.Position - root.Position).Magnitude < 4.5 then
		self.huntLocker = nil
		self.interactables:leave(victim, true) -- yank them out
		self:_catch(victim)
		return
	end
	if #self.path == 0 then
		self:_setPathTo(locker.outside.Position)
	end
	self:_followPath()
end

function MonsterAI._updateSearch(self: MonsterAI, now: number)
	if now > self.searchUntil then
		self:_setState("Wander")
		self:_pickWanderTarget()
		return
	end
	if now < self.pauseUntil then
		return
	end
	if self:_followPath() then
		self.pauseUntil = now + self.random:NextNumber(0.8, 2.2) -- stop... listen...
		local c = self:_cellAt(self.searchCenter)
		local nx = math.clamp(c.x + self.random:NextInteger(-2, 2), 0, self.layout.width - 1)
		local nz = math.clamp(c.z + self.random:NextInteger(-2, 2), 0, self.layout.depth - 1)
		local cx, cz = Maze.cellCenter(self.layout, { x = nx, z = nz })
		self:_setPathTo(Vector3.new(cx, 0, cz))
	end
end

function MonsterAI._catch(self: MonsterAI, player: Player)
	local previous = self.state
	self:_setState("Kill")
	self.sawHide[player] = nil
	self.target = nil
	self.path = {}
	local root = self.rig.root
	self.humanoid:MoveTo(root.Position)
	root.Anchored = true
	local proot = rootOf(player)
	if proot then
		proot.Anchored = true
		local facing = flat(proot.Position - root.Position)
		if facing.Magnitude > 0.1 then
			self.rig.model:PivotTo(CFrame.lookAt(root.Position, root.Position + facing))
		end
	end
	self.rig.model:SetAttribute("TargetUserId", player.UserId)
	self.hooks.onCaught(player, self.rig.model)
	task.delay(2.8, function()
		if self.destroyed then
			return
		end
		if self.p.Statue then
			self.frozen = false
			self:_release()
			self:_setState(if previous == "Frozen" then "Stalk" else previous)
			return
		end
		self:_release()
		self:_beginSearch(root.Position, 6)
	end)
end

function MonsterAI._tryApparition(self: MonsterAI)
	local p = self.p
	local now = os.clock()
	self.nextApparition = now + self.random:NextNumber(p.ApparitionMin, p.ApparitionMax)
	if not p.Apparitions then
		return
	end
	local candidates = {}
	for _, player in self.hooks.getPlayers() do
		if not player:GetAttribute("Hiding") and rootOf(player) then
			table.insert(candidates, player)
		end
	end
	if #candidates == 0 then
		return
	end
	local player = candidates[self.random:NextInteger(1, #candidates)]
	local proot = rootOf(player) :: BasePart
	local pc = self:_cellAt(proot.Position)
	local look = flat(proot.CFrame.LookVector)
	local best: Maze.Cell? = nil
	local bestScore = -math.huge
	-- down a straight corridor, preferably the one they're facing
	for _, d in Maze.DIRS do
		local run = Maze.straightRun(self.layout, pc, d, 7)
		if #run >= 3 then
			local score = look:Dot(Vector3.new(Maze.DX[d], 0, Maze.DZ[d])) + self.random:NextNumber() * 0.4
			if score > bestScore then
				bestScore = score
				best = run[math.min(#run, self.random:NextInteger(3, 6))]
			end
		end
	end
	if not best then
		return
	end
	local cx, cz = Maze.cellCenter(self.layout, best)
	local pos = Vector3.new(cx, self.rig.rootHeight, cz)
	self.rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(proot.Position.X, pos.Y, proot.Position.Z)))
	self.apparitionTarget = player
	self.apparitionEnds = now + 7
	self:_setState("Apparition")
end

function MonsterAI._updateApparition(self: MonsterAI)
	local player = self.apparitionTarget
	local proot = if player then rootOf(player) else nil
	local root = self.rig.root
	if not player or not proot or not self:_isActive(player) or os.clock() > self.apparitionEnds or flat(proot.Position - root.Position).Magnitude < 24 then
		self:_vanish()
		return
	end
	local pos = root.Position
	self.rig.model:PivotTo(CFrame.lookAt(pos, Vector3.new(proot.Position.X, pos.Y, proot.Position.Z)))
end

function MonsterAI._vanish(self: MonsterAI)
	Remotes.Apparition:FireAllClients(self.rig.root.Position)
	self.apparitionTarget = nil
	self:_park()
	self:_setState("Dormant")
end

function MonsterAI._checkStuck(self: MonsterAI, now: number)
	if now < self.stuckCheckAt then
		return
	end
	self.stuckCheckAt = now + 2
	local pos = self.rig.root.Position
	local moving = self.humanoid.WalkSpeed > 0 and #self.path > 0 and now >= self.pauseUntil and not self.rig.root.Anchored
	if moving and flat(pos - self.stuckPos).Magnitude < 1.5 then
		self.stuckCount += 1
		if self.stuckCount >= 2 then
			-- still stuck: hop to the next waypoint
			local p = self.path[self.pathIndex]
			if p then
				self.rig.model:PivotTo(CFrame.new(p.X, self.rig.rootHeight, p.Z) * self.rig.root.CFrame.Rotation)
			end
			self.stuckCount = 0
		elseif self.pathGoal then
			self:_setPathTo(self.pathGoal)
		end
	else
		self.stuckCount = 0
	end
	self.stuckPos = pos
end

-- Statue ------------------------------------------------------------------------

-- Is any player looking at it right now? (Camera direction comes from the clients.)
function MonsterAI._isWatched(self: MonsterAI): boolean
	if os.clock() < self.blinkUntil then
		return false -- everyone's eyes are closed
	end
	local head = self.rig.head
	local body = self.rig.root.Position + Vector3.new(0, 1.5, 0)
	for _, player in self.hooks.getPlayers() do
		local phead = headOf(player)
		if phead and not player:GetAttribute("Hiding") then
			local look = self.hooks.getLook(player)
			if not look then
				local proot = rootOf(player)
				look = if proot then proot.CFrame.LookVector else nil
			end
			if look then
				for _, point in { head.Position, body } do
					local to = point - phead.Position
					if to.Magnitude < 170 and look.Unit:Dot(to.Unit) > 0.55 then
						if not workspace:Raycast(phead.Position, to, self.sightParams) then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

function MonsterAI._thinkStatue(self: MonsterAI, now: number)
	local p = self.p
	if not self.awake then
		if now >= self.awakeAt then
			self:awaken()
		end
		return
	end
	if self.state == "Kill" then
		return
	end
	-- every so often, everybody blinks
	if now >= self.nextBlink then
		self.nextBlink = now + self.random:NextNumber(p.BlinkMin, p.BlinkMax) * (if now < self.frenzyUntil then 0.5 else 1)
		self.blinkUntil = now + p.BlinkTime
		self.hooks.setBlink(true)
		task.delay(p.BlinkTime, function()
			if not self.destroyed then
				self.hooks.setBlink(false)
			end
		end)
	end

	local root = self.rig.root
	if self:_isWatched() then
		if not self.frozen then
			self.frozen = true
			self.humanoid:MoveTo(root.Position)
			root.Anchored = true
			self:_setState("Frozen")
		end
		return
	end
	if self.frozen then
		self.frozen = false
		self:_release()
		self.rig.model:SetAttribute("Pose", self.random:NextInteger(1, #Monsters.STATUE_POSES))
		self:_setState("Stalk")
	end

	-- nobody's looking: go for the nearest player
	local best: Player? = nil
	local bestDist = math.huge
	for _, player in self.hooks.getPlayers() do
		local proot = rootOf(player)
		if proot then
			local d = (proot.Position - root.Position).Magnitude
			if d < bestDist then
				best, bestDist = player, d
			end
		end
	end
	if not best then
		return
	end
	local proot = rootOf(best) :: BasePart
	if bestDist < p.CatchDistance + 0.5 then
		self:_catch(best)
		return
	end
	-- stone grinding when it moves close to someone
	if bestDist < 45 and now - self.lastGrind > 1.6 then
		self.lastGrind = now
		Audio.play("StatueGrind", root, 1.4, self.random:NextNumber(0.85, 1.1), 70)
	end
	self.rig.model:SetAttribute("TargetUserId", best.UserId)
	self:_moveToward(proot.Position, now)
end

-- Main loop ------------------------------------------------------------------------

function MonsterAI._think(self: MonsterAI)
	if self.destroyed then
		return
	end
	local p = self.p
	local now = os.clock()

	if p.Statue then
		self:_thinkStatue(now)
		return
	end

	local state = self.state
	if state == "Dormant" then
		if now >= self.awakeAt then
			self:awaken()
		elseif now >= self.nextApparition then
			self:_tryApparition()
		end
		return
	elseif state == "Apparition" then
		if now >= self.awakeAt then
			self:awaken()
		else
			self:_updateApparition()
		end
		return
	elseif state == "Kill" then
		return
	end

	local root = self.rig.root
	self.interactables:slamOpenNear(root.Position, 8)
	self:_checkStuck(now)

	-- within arm's reach?
	for _, player in self.hooks.getPlayers() do
		if not player:GetAttribute("Hiding") then
			local proot = rootOf(player)
			if proot and flat(proot.Position - root.Position).Magnitude < p.CatchDistance and math.abs(proot.Position.Y - root.Position.Y) < 7 then
				self:_catch(player)
				return
			end
		end
	end

	-- eyes
	local seen, seenPos = self:_lookForPlayers()
	if seen and seenPos and self.state ~= "HuntLocker" then
		if self.state ~= "Chase" or self.target ~= seen then
			self:_startChase(seen)
		end
		self.lastSeenPos = seenPos
		self.lastSeenTime = now
		self.lastContact = now
	end

	local s = self.state
	if s == "Chase" then
		self:_updateChase(now)
	elseif s == "HuntLocker" then
		self:_updateHuntLocker()
	elseif s == "Investigate" then
		if self:_followPath() then
			self:_beginSearch(root.Position, 7)
		end
	elseif s == "Search" then
		self:_updateSearch(now)
	elseif s == "Wander" then
		if now >= self.pauseUntil and self:_followPath() then
			self.pauseUntil = now + self.random:NextNumber(0.5, 2.5)
			self:_pickWanderTarget()
		end
	end

	-- ears (only when it isn't already after someone)
	if self.state == "Wander" or self.state == "Search" or self.state == "Investigate" then
		local heard, heardDist, heardPlayer = self:_listen()
		if heard then
			self.lastContact = now
			if heardPlayer and p.HearChaseRange > 0 and heardDist <= p.HearChaseRange then
				-- blind hunters lock on to close sounds
				self.lastSeenPos = heard
				self.lastSeenTime = now
				self:_startChase(heardPlayer)
			else
				self:_investigate(heard)
			end
		end
	end
end

return MonsterAI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Objectives</string>
          <string name="Source"><![CDATA[--!strict
-- What each night asks of you:
--   survive  make it from 12 AM to 6 AM
--   keys     find 4 keys (each tag shows a digit), unlock the exit, type the code
--   power    start 3 generators (loud!), then take the service lift
--   collect  take 6 photographs
--   hearts   destroy 3 hearts (it knows each time), then run for the portal

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage.Shared.Audio)
local Build = require(script.Parent.Build)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Exit = require(script.Parent.Exit)
local Interactables = require(script.Parent.Interactables)
local MonsterAI = require(script.Parent.MonsterAI)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local GameState = ReplicatedStorage.GameState

export type Ctx = {
	night: Nights.Night,
	layout: Maze.Layout,
	world: WorldBuilder.World,
	interactables: Interactables.Interactables,
	monster: MonsterAI.MonsterAI,
	exit: Exit.Exit,
	isAlive: (player: Player) -> boolean,
	notifyAll: (text: string, style: string?) -> (),
	notify: (player: Player, text: string, style: string?) -> (),
	setProgress: (text: string) -> (),
	winAll: (kind: string) -> (),
}

export type Objective = { destroy: () -> () }

local Objectives = {}

local prompt = Interactables.prompt
local rootOf = Interactables.rootOf

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function openExit(ctx: Ctx, message: string)
	ctx.exit:open()
	GameState:SetAttribute("ExitOpen", true)
	ctx.notifyAll(message, "danger")
	ctx.monster:onExitOpened()
end

---------------------------------------------------------------------------
-- SURVIVE: 12 AM -> 6 AM

local function survive(ctx: Ctx): Objective
	local total = ctx.night.surviveSeconds or 300
	local started = os.clock()
	local lastHour = 0
	local lastText = ""
	local done = false
	GameState:SetAttribute("Hour", 0)
	ctx.setProgress("12:00 AM")
	local connection = RunService.Heartbeat:Connect(function()
		if done then
			return
		end
		local minutes = math.clamp(math.floor((os.clock() - started) / total * 360), 0, 360)
		local hour = minutes // 60
		local text = string.format("%d:%02d AM", if hour == 0 then 12 else hour, minutes % 60)
		if text ~= lastText then
			lastText = text
			ctx.setProgress(text)
		end
		if hour > lastHour then
			lastHour = hour
			GameState:SetAttribute("Hour", hour)
			if hour < 6 then
				ctx.monster:setAggression(hour)
				if hour == 1 then
					ctx.monster:awaken()
					ctx.notifyAll("1:00 AM. It's awake.", "danger")
				elseif hour == 3 then
					ctx.notifyAll("3:00 AM. The witching hour. It knows where you are.", "danger")
					ctx.monster:frenzy(15, nil)
				elseif hour == 5 then
					ctx.notifyAll("5:00 AM. One more hour.")
				else
					ctx.notifyAll(string.format("%d:00 AM.", hour))
				end
			end
		end
		if minutes >= 360 then
			done = true
			ctx.winAll("survived")
		end
	end)
	return {
		destroy = function()
			connection:Disconnect()
		end,
	}
end

---------------------------------------------------------------------------
-- KEYS: 4 keys -> padlocks -> keypad code -> exit

local function keys(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Keys"
	folder.Parent = world.model
	local count = #layout.spots
	local found = 0
	local mask = table.create(count, "_")
	local padlocks: { { BasePart } } = {}
	local padlocksLeft = count
	local exitOpen = false
	local lastTry: { [Player]: number } = {}
	local connections: { RBXScriptConnection } = {}
	local metal = rgb(196, 196, 190)

	local function progressText(): string
		return string.format("KEYS %d/%d     CODE  %s", found, count, table.concat(mask, " "))
	end
	ctx.setProgress(progressText())
	GameState:SetAttribute("CodeMask", table.concat(mask))

	-- padlocks + chain on the exit, keypad beside it
	local exit = ctx.exit
	for i = 0, 12 do
		wctx.decor(wctx.part(folder, "Chain", Vector3.new(0.32, 0.18, 0.18), exit:hubSide(-2.4 + i * 0.4, 5.1 + math.sin(i * 0.5) * 0.15) * CFrame.new(0, 0, -0.08) * CFrame.Angles(i % 2 * math.rad(90), 0, 0), Enum.Material.Metal, rgb(120, 120, 120), nil))
	end
	for i = 1, count do
		local x = -1.05 + (i - 1) * (2.1 / math.max(count - 1, 1))
		local y = 4.4 + (i % 2) * 0.55
		local body = wctx.decor(wctx.part(folder, "Padlock", Vector3.new(0.55, 0.65, 0.25), exit:hubSide(x, y), Enum.Material.Metal, rgb(150, 150, 146), nil))
		local shackle = wctx.decor(wctx.part(folder, "Shackle", Vector3.new(0.38, 0.45, 0.08), exit:hubSide(x, y + 0.5), Enum.Material.Metal, rgb(180, 180, 176), nil))
		table.insert(padlocks, { body, shackle })
	end
	local keypad = wctx.part(folder, "Keypad", Vector3.new(1.2, 1.8, 0.3), exit:hubSide(exit.width / 2 + 1.15, 4.8) * CFrame.new(0, 0, 0.15), Enum.Material.Metal, rgb(40, 40, 42), nil)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.LightInfluence = 0
	gui.Brightness = 1.5
	gui.Parent = keypad
	local screen = Instance.new("TextLabel")
	screen.BackgroundColor3 = rgb(12, 12, 12)
	screen.BorderSizePixel = 0
	screen.Size = UDim2.fromScale(1, 1)
	screen.Font = Enum.Font.Code
	screen.TextScaled = true
	screen.TextColor3 = rgb(210, 210, 210)
	screen.Parent = gui
	local glow = Instance.new("PointLight")
	glow.Range = 7
	glow.Brightness = 0.5
	glow.Parent = keypad

	local function refreshKeypad()
		if exitOpen then
			screen.Text = "OPEN"
		elseif padlocksLeft > 0 then
			screen.Text = string.format("LOCKED\n%d/%d", count - padlocksLeft, count)
		else
			screen.Text = "ENTER\nCODE"
		end
	end
	refreshKeypad()

	local keypadPrompt = prompt(keypad, "Use", "Keypad", 0, 7)
	keypadPrompt.Triggered:Connect(function(player: Player)
		if exitOpen or not ctx.isAlive(player) then
			return
		end
		if padlocksLeft > 0 then
			Audio.play("KeypadError", keypad, 0.8, 1, 50)
			ctx.notify(player, string.format("%d padlocks still hold the door. Find the keys.", padlocksLeft))
			return
		end
		Remotes.OpenKeypad:FireClient(player)
	end)

	table.insert(connections, Remotes.SubmitCode.OnServerEvent:Connect(function(player: Player, code: unknown)
		if typeof(code) ~= "string" or #code > 8 or exitOpen or padlocksLeft > 0 or not ctx.isAlive(player) then
			return
		end
		local now = os.clock()
		local last = lastTry[player]
		if last and now - last < 0.8 then
			return
		end
		lastTry[player] = now
		local root = rootOf(player)
		if not root or (root.Position - keypad.Position).Magnitude > 16 then
			return
		end
		if code == layout.code then
			exitOpen = true
			refreshKeypad()
			ctx.setProgress("THE EXIT IS OPEN")
			openExit(ctx, "The exit is open. RUN.")
		else
			Audio.play("KeypadError", keypad, 1.3, 1, 100)
			screen.Text = "WRONG"
			task.delay(1.2, function()
				if keypad.Parent then
					refreshKeypad()
				end
			end)
			ctx.notify(player, "Wrong code. That buzzer was loud...")
			ctx.monster:hearNoise(keypad.Position, 70)
		end
	end))

	-- the keys, on crates at the back of dead ends
	for index, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local crate = wctx.part(folder, "KeyCrate", Vector3.new(2.6, 2.6, 2.6), frame * CFrame.new(0, 1.3, 0), Enum.Material.WoodPlanks, rgb(96, 86, 74), nil)
		crate.CollisionGroup = "Furniture"
		local model = Instance.new("Model")
		model.Name = "Key" .. index
		local base = frame * CFrame.new(0, 2.68, 0) * CFrame.Angles(0, world.random:NextNumber(0, math.pi * 2), 0)
		local shaft = wctx.decor(wctx.part(model, "Shaft", Vector3.new(1.6, 0.18, 0.18), base * CFrame.new(0.2, 0, 0), Enum.Material.Metal, metal, nil))
		shaft.CanQuery = true
		shaft.Reflectance = 0.15
		wctx.decor(wctx.part(model, "Bow", Vector3.new(0.12, 0.9, 0.9), base * CFrame.new(-0.85, 0, 0) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.Metal, metal, Enum.PartType.Cylinder))
		wctx.decor(wctx.part(model, "Tooth", Vector3.new(0.16, 0.12, 0.4), base * CFrame.new(0.85, 0, 0.22), Enum.Material.Metal, metal, nil))
		wctx.decor(wctx.part(model, "Tooth", Vector3.new(0.16, 0.12, 0.28), base * CFrame.new(0.55, 0, 0.16), Enum.Material.Metal, metal, nil))
		local tag = wctx.decor(wctx.part(model, "Tag", Vector3.new(0.6, 0.03, 0.8), base * CFrame.new(-1.6, 0, 0.3) * CFrame.Angles(0, 0.3, 0), Enum.Material.SmoothPlastic, rgb(220, 214, 198), nil))
		local tagGui = Instance.new("SurfaceGui")
		tagGui.Face = Enum.NormalId.Top
		tagGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		tagGui.PixelsPerStud = 120
		tagGui.Parent = tag
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.SpecialElite
		label.TextScaled = true
		label.TextColor3 = rgb(20, 20, 20)
		local digits = {}
		for i = 1, #layout.code do
			digits[i] = if i == index then string.sub(layout.code, i, i) else "_"
		end
		label.Text = table.concat(digits, " ")
		label.Parent = tagGui
		local glint = Instance.new("PointLight")
		glint.Range = 6
		glint.Brightness = 0.9
		glint.Parent = shaft
		model.PrimaryPart = shaft
		model.Parent = folder

		prompt(shaft, "Take", "Key", 0.5, 8).Triggered:Connect(function(player: Player)
			if not ctx.isAlive(player) or model.Parent == nil then
				return
			end
			Audio.play("KeyPickup", crate, 1, 1, 70)
			model:Destroy()
			found += 1
			mask[index] = string.sub(layout.code, index, index)
			GameState:SetAttribute("CodeMask", table.concat(mask))
			ctx.setProgress(progressText())
			if padlocksLeft > 0 then
				local lock = padlocks[padlocksLeft]
				padlocksLeft -= 1
				for _, p in lock do
					p.Anchored = false
					p.CanCollide = true
				end
				Audio.play("Unlock", keypad, 0.9, 0.9, 120)
				refreshKeypad()
			end
			ctx.notifyAll(string.format("%s found a key. The tag reads   %s", player.DisplayName, table.concat(digits, " ")), "key")
			ctx.monster:setAggression(found)
			ctx.monster:awaken()
			ctx.monster:hearNoise(crate.Position, 45)
			if found >= count then
				ctx.notifyAll("Every padlock is open. Get to the keypad by the exit.", "key")
			end
		end)
	end

	return {
		destroy = function()
			for _, c in connections do
				c:Disconnect()
			end
		end,
	}
end

---------------------------------------------------------------------------
-- POWER: 3 generators, then the lift

local function power(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Generators"
	folder.Parent = world.model
	local count = #layout.spots
	local running = 0
	ctx.setProgress(string.format("GENERATORS 0/%d", count))

	-- each lamp belongs to the nearest generator
	local maps = {}
	for i, cell in layout.spots do
		maps[i] = Maze.distances(layout, cell)
	end
	local zones: { { Build.Lamp } } = {}
	for i = 1, count do
		zones[i] = {}
	end
	for _, lamp in world.lamps do
		local cell = lamp.cell
		if cell and not lamp.light.Enabled then
			local best, bestDist = 1, math.huge
			for i, dist in maps do
				local d = dist[Maze.key(cell.x, cell.z)] or math.huge
				if d < bestDist then
					best, bestDist = i, d
				end
			end
			table.insert(zones[best], lamp)
		end
	end

	local panelLabel: TextLabel? = nil
	local panel = world.model:FindFirstChild("PowerPanel", true)
	if panel then
		panelLabel = panel:FindFirstChildWhichIsA("TextLabel", true)
	end

	for i, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local model = Instance.new("Model")
		model.Name = "Generator" .. i
		local base = wctx.part(model, "Generator", Vector3.new(4.4, 3.2, 2.8), frame * CFrame.new(0, 1.6, 0), Enum.Material.Metal, rgb(150, 120, 40), nil)
		base.CollisionGroup = "Furniture"
		wctx.part(model, "Engine", Vector3.new(2.6, 1.4, 2.2), frame * CFrame.new(-0.4, 3.9, 0), Enum.Material.Metal, rgb(60, 62, 60), nil).CollisionGroup = "Furniture"
		wctx.decor(wctx.part(model, "Exhaust", Vector3.new(3, 0.5, 0.5), frame * CFrame.new(1.5, 4.6, 0.6) * CFrame.Angles(0, 0, math.rad(90)), Enum.Material.CorrodedMetal, rgb(80, 60, 50), Enum.PartType.Cylinder))
		wctx.decor(wctx.part(model, "Fan", Vector3.new(0.2, 2.2, 2.2), frame * CFrame.new(-2.3, 1.7, 0) * CFrame.Angles(0, 0, 0), Enum.Material.Metal, rgb(40, 40, 40), Enum.PartType.Cylinder))
		for s = 0, 3 do
			wctx.decor(wctx.part(model, "Stripe", Vector3.new(0.6, 0.6, 0.05), frame * CFrame.new(-1.6 + s * 1.1, 0.6, -1.43) * CFrame.Angles(0, 0, math.rad(45)), Enum.Material.SmoothPlastic, rgb(20, 20, 20), nil))
		end
		local status = wctx.decor(wctx.part(model, "Status", Vector3.new(0.5, 0.5, 0.5), frame * CFrame.new(1.4, 3.45, -0.9), Enum.Material.Neon, rgb(255, 40, 30), Enum.PartType.Ball))
		local statusLight = Instance.new("PointLight")
		statusLight.Range = 8
		statusLight.Brightness = 1
		statusLight.Color = rgb(255, 40, 30)
		statusLight.Parent = status
		model.Parent = folder

		local started = false
		local p = prompt(base, "Start", "Generator", 3.5, 9)
		p.Triggered:Connect(function(player: Player)
			if started or not ctx.isAlive(player) then
				return
			end
			started = true
			p.Enabled = false
			running += 1
			status.Color = rgb(60, 255, 90)
			statusLight.Color = rgb(60, 255, 90)
			Audio.play("GeneratorStart", base, 1.6, 1, 160)
			local hum = Audio.create("GeneratorLoop", base, 1)
			if hum then
				hum.RollOffMinDistance = 8
				hum.RollOffMaxDistance = 70
				task.delay(2.8, function()
					if hum.Parent then
						hum:Play()
					end
				end)
			end
			-- lights come back in this part of the tunnels
			task.delay(1.6, function()
				for _, lamp in zones[i] do
					if lamp.bulb.Parent then
						lamp.light.Enabled = true
						local on = lamp.bulb:GetAttribute("OnColor")
						if typeof(on) == "Color3" then
							lamp.bulb.Color = on
						end
					end
				end
				Audio.play("PowerUp", base, 1.2, 1, 140)
			end)
			ctx.setProgress(string.format("GENERATORS %d/%d", running, count))
			if panelLabel then
				panelLabel.Text = string.format("MAIN POWER\n%d/%d", running, count)
			end
			ctx.monster:setAggression(running)
			ctx.monster:hearNoise(base.Position, 400) -- the whole system hears it
			ctx.monster:awaken()
			if running >= count then
				if panelLabel then
					panelLabel.Text = "LIFT\nONLINE"
					panelLabel.TextColor3 = rgb(80, 255, 120)
				end
				ctx.setProgress("THE LIFT HAS POWER")
				openExit(ctx, "The lift has power. GET OUT.")
			else
				ctx.notifyAll(string.format("%s started a generator. That was LOUD. (%d/%d)", player.DisplayName, running, count), "key")
			end
		end)
	end

	return {
		destroy = function() end,
	}
end

---------------------------------------------------------------------------
-- COLLECT: 6 photographs

local PHOTO_LINES = {
	"The photo shows this hall. Someone is standing behind the camera.",
	"A photo of a statue. It's facing the camera. In the next one it isn't.",
	"A group photo. Every face has been scratched out.",
	"The photo shows you. Taken from behind. Tonight.",
	"A photo of the exhibit. One plinth is empty.",
	"The last photograph shows a door that wasn't there before.",
}

local function collect(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Photographs"
	folder.Parent = world.model
	local count = #layout.spots
	local taken = 0
	ctx.setProgress(string.format("PHOTOGRAPHS 0/%d", count))

	for i, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local model = Instance.new("Model")
		model.Name = "Photo" .. i
		for _, leg in { -0.8, 0.8 } do
			wctx.decor(wctx.part(model, "EaselLeg", Vector3.new(0.18, 5.2, 0.18), frame * CFrame.new(leg, 2.5, 0) * CFrame.Angles(math.rad(-8), 0, 0), Enum.Material.Wood, rgb(80, 60, 40), nil))
		end
		wctx.decor(wctx.part(model, "EaselBack", Vector3.new(0.18, 5, 0.18), frame * CFrame.new(0, 2.4, 0.8) * CFrame.Angles(math.rad(18), 0, 0), Enum.Material.Wood, rgb(80, 60, 40), nil))
		local photo = wctx.part(model, "Photograph", Vector3.new(2, 2.4, 0.1), frame * CFrame.new(0, 3.9, -0.15) * CFrame.Angles(math.rad(-8), 0, 0), Enum.Material.SmoothPlastic, rgb(230, 228, 220), nil)
		photo.CanCollide = false
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 60
		gui.Parent = photo
		local backdrop = Instance.new("Frame")
		backdrop.Position = UDim2.fromScale(0.08, 0.06)
		backdrop.Size = UDim2.fromScale(0.84, 0.72)
		backdrop.BackgroundColor3 = rgb(70, 72, 76)
		backdrop.BorderSizePixel = 0
		backdrop.Parent = gui
		-- a dark figure in every photograph
		local head = Instance.new("Frame")
		head.AnchorPoint = Vector2.new(0.5, 0.5)
		head.Position = UDim2.fromScale(0.3 + (i % 3) * 0.2, 0.32)
		head.Size = UDim2.fromScale(0.16, 0.16)
		head.BackgroundColor3 = rgb(10, 10, 12)
		head.BorderSizePixel = 0
		head.Parent = backdrop
		local round = Instance.new("UICorner")
		round.CornerRadius = UDim.new(0.5, 0)
		round.Parent = head
		local body = Instance.new("Frame")
		body.AnchorPoint = Vector2.new(0.5, 0)
		body.Position = UDim2.fromScale(0.3 + (i % 3) * 0.2, 0.4)
		body.Size = UDim2.fromScale(0.22, 0.6)
		body.BackgroundColor3 = rgb(10, 10, 12)
		body.BorderSizePixel = 0
		body.Parent = backdrop
		local caption = Instance.new("TextLabel")
		caption.BackgroundTransparency = 1
		caption.Position = UDim2.fromScale(0, 0.8)
		caption.Size = UDim2.fromScale(1, 0.18)
		caption.Font = Enum.Font.SpecialElite
		caption.TextScaled = true
		caption.TextColor3 = rgb(40, 40, 40)
		caption.Text = string.format("no. %d", i)
		caption.Parent = gui
		local glint = Instance.new("PointLight")
		glint.Range = 7
		glint.Brightness = 0.8
		glint.Color = rgb(220, 230, 255)
		glint.Parent = photo
		model.Parent = folder

		prompt(photo, "Take", "Photograph", 0.6, 8).Triggered:Connect(function(player: Player)
			if not ctx.isAlive(player) or model.Parent == nil then
				return
			end
			model:Destroy()
			taken += 1
			Audio.play("PagePickup", nil, 1)
			ctx.setProgress(string.format("PHOTOGRAPHS %d/%d", taken, count))
			ctx.monster:setAggression(taken)
			ctx.notify(player, PHOTO_LINES[math.min(taken, #PHOTO_LINES)], "note")
			if taken >= count then
				ctx.winAll("collected")
			else
				ctx.notifyAll(string.format("%s took a photograph. (%d/%d)", player.DisplayName, taken, count), "key")
			end
		end)
	end

	return {
		destroy = function() end,
	}
end

---------------------------------------------------------------------------
-- HEARTS: 3 hearts, then the portal

local function hearts(ctx: Ctx): Objective
	local world = ctx.world
	local layout = ctx.layout
	local wctx = world.ctx
	local folder = Instance.new("Folder")
	folder.Name = "Hearts"
	folder.Parent = world.model
	local count = #layout.spots
	local broken = 0
	ctx.setProgress(string.format("HEARTS 0/%d", count))
	local CORE = rgb(200, 20, 110)

	for i, cell in layout.spots do
		local frame = Interactables.spotFrame(world, cell)
		local model = Instance.new("Model")
		model.Name = "Heart" .. i
		local altar = wctx.part(model, "Altar", Vector3.new(5, 2.4, 5), frame * CFrame.new(0, 1.2, 0), Enum.Material.Basalt, rgb(16, 12, 20), nil)
		altar.CollisionGroup = "Furniture"
		local heart = wctx.decor(wctx.part(model, "Heart", Vector3.new(3, 3, 3), frame * CFrame.new(0, 4.6, 0), Enum.Material.Neon, CORE, Enum.PartType.Ball))
		heart.CanQuery = true
		heart:AddTag("Heart")
		for v = 1, 8 do
			local a = v * 0.785
			wctx.decor(wctx.part(model, "Vein", Vector3.new(0.18, 4.6, 0.18), frame * CFrame.new(math.cos(a) * 1.6, 4.4, math.sin(a) * 1.6) * CFrame.Angles(math.cos(a) * 0.35, 0, math.sin(a) * 0.35), Enum.Material.Neon, rgb(120, 20, 160), nil))
		end
		for b = 1, 4 do
			local a = b * 1.57 + 0.4
			wctx.part(model, "Bone", Vector3.new(0.35, 6, 0.35), frame * CFrame.new(math.cos(a) * 2.2, 5, math.sin(a) * 2.2) * CFrame.Angles(math.cos(a) * -0.3, 0, math.sin(a) * 0.3), Enum.Material.SmoothPlastic, rgb(210, 200, 220), nil)
		end
		local light = Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 2
		light.Color = CORE
		light.Parent = heart
		local pulse = Audio.create("HeartPulseLoop", heart, 1.6)
		if pulse then
			pulse.RollOffMinDistance = 6
			pulse.RollOffMaxDistance = 80
			pulse:Play()
		end
		model.Parent = folder

		local p = prompt(heart, "Destroy", "Heart", 3, 9)
		p.Triggered:Connect(function(player: Player)
			if not ctx.isAlive(player) or heart.Parent == nil then
				return
			end
			local where = heart.Position
			heart:Destroy()
			light:Destroy()
			for _ = 1, 14 do
				local shard = wctx.part(folder, "Shard", Vector3.new(0.5, 0.5, 0.5), CFrame.new(where), Enum.Material.Neon, CORE, nil)
				shard.Anchored = false
				shard.CanCollide = true
				shard.AssemblyLinearVelocity = Vector3.new(world.random:NextNumber(-30, 30), world.random:NextNumber(10, 40), world.random:NextNumber(-30, 30))
				TweenService:Create(shard, TweenInfo.new(4), { Transparency = 1 }):Play()
				task.delay(4, function()
					shard:Destroy()
				end)
			end
			Audio.playAt("HeartShatter", where, 2, 1, 400)
			broken += 1
			ctx.setProgress(string.format("HEARTS %d/%d", broken, count))
			ctx.monster:setAggression(broken)
			if broken >= count then
				ctx.setProgress("THE WAY OUT IS OPEN")
				openExit(ctx, "The last heart is still. The way out is open. RUN.")
			else
				ctx.notifyAll(string.format("A heart stops beating. IT KNOWS WHERE %s IS. (%d/%d)", string.upper(player.DisplayName), broken, count), "danger")
				ctx.monster:frenzy(14, player)
			end
		end)
	end

	return {
		destroy = function() end,
	}
end

local BY_KIND: { [string]: (Ctx) -> Objective } = {
	survive = survive,
	keys = keys,
	power = power,
	collect = collect,
	hearts = hearts,
}

function Objectives.start(ctx: Ctx): Objective
	local start = BY_KIND[ctx.night.objective] or survive
	return start(ctx)
end

return Objectives
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Progress</string>
          <string name="Source"><![CDATA[--!strict
-- Which nights each player has unlocked, saved with DataStores. The value lives on
-- the Player as the "HighestNight" attribute so the menu can read it:
--   1..5 = highest night you may play, 6 = you've beaten all five.
-- DataStores only work in a published game (or with Studio API access turned on);
-- without them progress just lasts for the session.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Nights = require(ReplicatedStorage.Shared.Nights)

local Progress = {}

local store: DataStore? = nil
pcall(function()
	store = DataStoreService:GetDataStore(Config.Progress.DataStoreName)
end)

local function key(player: Player): string
	return "u" .. player.UserId
end

function Progress.load(player: Player)
	local highest = 1
	local s = store
	if s then
		local ok, value = pcall(function()
			return s:GetAsync(key(player))
		end)
		if ok and typeof(value) == "number" then
			highest = math.clamp(math.floor(value), 1, Nights.count + 1)
		end
	end
	if RunService:IsStudio() and Config.Progress.UnlockAllInStudio then
		highest = math.max(highest, Nights.count)
	end
	player:SetAttribute("HighestNight", highest)
end

function Progress.highest(player: Player): number
	local value = player:GetAttribute("HighestNight")
	return if typeof(value) == "number" then value else 1
end

-- You beat `night`: unlock the next one.
function Progress.beat(player: Player, night: number)
	local unlocked = math.min(night + 1, Nights.count + 1)
	if unlocked <= Progress.highest(player) then
		return
	end
	player:SetAttribute("HighestNight", unlocked)
	local s = store
	if s then
		task.spawn(function()
			pcall(function()
				s:UpdateAsync(key(player), function(old: any)
					return math.max(if typeof(old) == "number" then old else 1, unlocked)
				end)
			end)
		end)
	end
end

return Progress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">RoundManager</string>
          <string name="Source"><![CDATA[--!strict
-- The game loop:
--   Lobby         everyone is on the main menu, picking a night
--   Intermission  someone pressed PLAY; short countdown (others can join / vote)
--   Playing       the chosen night: build its map, monster and objective
--   Results       who made it; beating a night unlocks the next one
-- ...then everyone goes back to the menu.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Exit = require(script.Parent.Exit)
local Interactables = require(script.Parent.Interactables)
local MonsterAI = require(script.Parent.MonsterAI)
local Objectives = require(script.Parent.Objectives)
local Progress = require(script.Parent.Progress)
local WorldBuilder = require(script.Parent.WorldBuilder)

local Remotes = ReplicatedStorage.Remotes
local GameState = ReplicatedStorage.GameState

type Round = {
	night: Nights.Night,
	layout: Maze.Layout,
	world: WorldBuilder.World,
	interactables: Interactables.Interactables,
	monster: MonsterAI.MonsterAI,
	exit: Exit.Exit,
	objective: Objectives.Objective,
	startedAt: number,
	spawnIndex: number,
	participants: { [Player]: boolean },
	connections: { RBXScriptConnection },
}

local RoundManager = {}

local ready: { [Player]: number } = {} -- player -> the night they picked
local status: { [Player]: string } = {} -- "alive" | "caught" | "escaped"
local looks: { [Player]: Vector3 } = {}
local round: Round? = nil

local function isAlive(player: Player): boolean
	return status[player] == "alive" and player.Parent ~= nil
end

local function alivePlayers(): { Player }
	local list = {}
	for player, s in status do
		if s == "alive" and player.Parent ~= nil then
			table.insert(list, player)
		end
	end
	return list
end

local function notifyAll(text: string, style: string?)
	Remotes.Notify:FireAllClients(text, style)
end

local function notify(player: Player, text: string, style: string?)
	Remotes.Notify:FireClient(player, text, style)
end

local function notifyOthers(except: Player, text: string, style: string?)
	for _, p in Players:GetPlayers() do
		if p ~= except then
			Remotes.Notify:FireClient(p, text, style)
		end
	end
end

local function removeCharacter(player: Player)
	local character = player.Character
	if character then
		character:Destroy()
	end
	pcall(function()
		player.Character = nil
	end)
end

local function countReady(): number
	local n = 0
	for _ in ready do
		n += 1
	end
	return n
end

-- Most-voted night among the ready players (ties go to the earliest night).
local function chosenNight(): number
	local votes: { [number]: number } = {}
	for _, n in ready do
		votes[n] = (votes[n] or 0) + 1
	end
	local best, bestVotes = 1, 0
	for n = 1, Nights.count do
		local v = votes[n] or 0
		if v > bestVotes then
			best, bestVotes = n, v
		end
	end
	return best
end

local function applyLighting(l: Nights.Lighting)
	Lighting.Ambient = l.Ambient
	Lighting.OutdoorAmbient = Color3.new(0, 0, 0)
	Lighting.FogColor = l.FogColor
	Lighting.FogStart = l.FogStart
	Lighting.FogEnd = l.FogEnd
	Lighting.ExposureCompensation = l.Exposure
	local grade = Lighting:FindFirstChild("Monochrome")
	if grade and grade:IsA("ColorCorrectionEffect") then
		grade.Saturation = l.Saturation
		grade.Contrast = l.Contrast
		grade.Brightness = l.Brightness
		grade.TintColor = l.Tint
	end
	local bloom = Lighting:FindFirstChild("Glow")
	if bloom and bloom:IsA("BloomEffect") then
		bloom.Intensity = l.Bloom
	end
	pcall(function()
		SoundService.AmbientReverb = (Enum.ReverbType :: any)[l.Reverb]
	end)
end

local function spawnPlayer(player: Player)
	local r = round
	if not r or status[player] ~= nil then
		return
	end
	status[player] = "alive"
	r.participants[player] = true
	player:SetAttribute("Hiding", false)
	player:SetAttribute("Flashlight", false)
	local ok = pcall(function()
		player:LoadCharacterAsync()
	end)
	if not ok then
		-- older engines only have the (now deprecated) synchronous version
		ok = pcall(function()
			(player :: any):LoadCharacter()
		end)
	end
	local character = player.Character
	if not ok or not character or round ~= r then
		return
	end
	r.spawnIndex += 1
	character:PivotTo(r.world.spawnPoints[(r.spawnIndex - 1) % #r.world.spawnPoints + 1])
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			if status[player] == "alive" and round == r then
				RoundManager.caught(player, nil)
			end
		end)
	end
end

function RoundManager.caught(player: Player, monster: Model?)
	if status[player] ~= "alive" then
		return
	end
	status[player] = "caught"
	local r = round
	if r then
		r.interactables:release(player)
		r.monster:forget(player)
	end
	if monster then
		Remotes.Jumpscare:FireClient(player, monster)
	end
	notifyOthers(player, player.DisplayName .. " was taken.", "danger")
	task.delay(if monster then 2.7 else 0.5, function()
		if status[player] == "caught" then
			removeCharacter(player)
		end
	end)
end

-- kind: "escaped" | "survived" | "collected" | "final"
function RoundManager.escaped(player: Player, kind: string)
	if status[player] ~= "alive" then
		return
	end
	status[player] = "escaped"
	local r = round
	if r then
		r.interactables:release(player)
		r.monster:forget(player)
	end
	Remotes.Escaped:FireClient(player, kind)
	if kind == "escaped" or kind == "final" then
		notifyOthers(player, player.DisplayName .. " made it out.", "key")
	end
	task.delay(4, function()
		if status[player] == "escaped" then
			removeCharacter(player)
		end
	end)
end

local function startRound(night: Nights.Night)
	local seed = Random.new():NextInteger(1, 2 ^ 30)
	local layout = Maze.generate(seed, night.maze)
	local world = WorldBuilder.build(layout, night)
	applyLighting(night.lighting)
	local exit = Exit.new(world)

	local monster: MonsterAI.MonsterAI
	local interactables = Interactables.new(layout, world, {
		isAlive = isAlive,
		onHide = function(player: Player, locker: Interactables.Locker)
			monster:onPlayerHid(player, locker)
		end,
		onNoise = function(position: Vector3, radius: number)
			monster:hearNoise(position, radius)
		end,
	})
	monster = MonsterAI.new(layout, world, interactables, Nights.monsterParams(night), night.monsterKind, {
		getPlayers = alivePlayers,
		onCaught = RoundManager.caught,
		onAwake = function()
			GameState:SetAttribute("MonsterAwake", true)
		end,
		getLook = function(player: Player): Vector3?
			return looks[player]
		end,
		setBlink = function(on: boolean)
			GameState:SetAttribute("Blink", on)
		end,
	})

	GameState:SetAttribute("Night", night.index)
	GameState:SetAttribute("NightName", night.name)
	GameState:SetAttribute("Objective", night.objectiveText)
	GameState:SetAttribute("Progress", "")
	GameState:SetAttribute("CodeMask", "")
	GameState:SetAttribute("ExitOpen", false)
	GameState:SetAttribute("MonsterAwake", false)
	GameState:SetAttribute("Hour", 0)
	GameState:SetAttribute("Blink", false)
	GameState:SetAttribute("Result", "")

	local objective = Objectives.start({
		night = night,
		layout = layout,
		world = world,
		interactables = interactables,
		monster = monster,
		exit = exit,
		isAlive = isAlive,
		notifyAll = notifyAll,
		notify = notify,
		setProgress = function(text: string)
			GameState:SetAttribute("Progress", text)
		end,
		winAll = function(kind: string)
			for _, player in alivePlayers() do
				RoundManager.escaped(player, kind)
			end
		end,
	})

	local r: Round = {
		night = night,
		layout = layout,
		world = world,
		interactables = interactables,
		monster = monster,
		exit = exit,
		objective = objective,
		startedAt = os.clock(),
		spawnIndex = 0,
		participants = {},
		connections = {},
	}
	table.insert(r.connections, world.escapeZone.Touched:Connect(function(hit: BasePart)
		if not exit.isOpen then
			return
		end
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if player and isAlive(player) then
			RoundManager.escaped(player, if night.index == Nights.count then "final" else "escaped")
		end
	end))

	table.clear(status)
	round = r
	GameState:SetAttribute("Phase", "Playing")
	for player in ready do
		task.spawn(spawnPlayer, player)
	end
	monster:start()
end

local function endRound()
	local r = round
	if not r then
		return
	end
	local survivors = {}
	for player, s in status do
		if s == "escaped" then
			table.insert(survivors, player.DisplayName)
		end
	end
	local won = #survivors > 0
	if won then
		-- co-op: everyone who played this night moves on
		for player in r.participants do
			if player.Parent then
				Progress.beat(player, r.night.index)
			end
		end
	end
	local result = if won then "Escaped" else "Caught"
	GameState:SetAttribute("Result", result)
	GameState:SetAttribute("Phase", "Results")
	Remotes.RoundResult:FireAllClients(result, survivors, math.floor(os.clock() - r.startedAt), r.night.index)

	task.wait(Config.Round.ResultsTime)

	for _, c in r.connections do
		c:Disconnect()
	end
	r.objective.destroy()
	r.monster:destroy()
	r.interactables:destroy()
	r.world.model:Destroy()
	round = nil
	table.clear(status)
	table.clear(ready) -- everyone goes back to the menu
	GameState:SetAttribute("ReadyCount", 0)
	for _, player in Players:GetPlayers() do
		removeCharacter(player)
		player:SetAttribute("Hiding", false)
	end
end

function RoundManager.run()
	Players.CharacterAutoLoads = false
	WorldBuilder.setupCollisionGroups()
	applyLighting(Nights.get(1).lighting)

	GameState:SetAttribute("Phase", "Lobby")
	GameState:SetAttribute("Countdown", 0)
	GameState:SetAttribute("Night", 1)
	GameState:SetAttribute("NightName", Nights.get(1).name)
	GameState:SetAttribute("ReadyCount", 0)
	GameState:SetAttribute("Progress", "")

	Players.PlayerAdded:Connect(Progress.load)
	for _, player in Players:GetPlayers() do
		task.spawn(Progress.load, player)
	end

	Remotes.Ready.OnServerEvent:Connect(function(player: Player, night: unknown)
		local wanted = if typeof(night) == "number" then math.floor(night) else 1
		local allowed = math.min(Progress.highest(player), Nights.count)
		ready[player] = math.clamp(wanted, 1, allowed)
		GameState:SetAttribute("ReadyCount", countReady())
		if round and GameState:GetAttribute("Phase") == "Playing" then
			task.spawn(spawnPlayer, player)
		end
	end)

	-- where each player's camera is looking (the Statue can't move while watched)
	Remotes.Look.OnServerEvent:Connect(function(player: Player, direction: unknown)
		if typeof(direction) == "Vector3" and direction.Magnitude > 0.5 and direction.Magnitude < 2 then
			looks[player] = direction.Unit
		end
	end)

	-- Everyone else sees your flashlight beam too (and so does the monster).
	Remotes.Flashlight.OnServerEvent:Connect(function(player: Player, on: unknown)
		if typeof(on) ~= "boolean" then
			return
		end
		player:SetAttribute("Flashlight", on)
		local character = player.Character
		local head = if character then character:FindFirstChild("Head") else nil
		if head and head:IsA("BasePart") then
			local existing = head:FindFirstChild("SharedFlashlight")
			local light: SpotLight
			if existing and existing:IsA("SpotLight") then
				light = existing
			else
				light = Instance.new("SpotLight")
				light.Name = "SharedFlashlight"
				light.Face = Enum.NormalId.Front
				light.Angle = 50
				light.Range = 40
				light.Brightness = 2
				light.Shadows = true
				light.Parent = head
			end
			light.Enabled = on
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		ready[player] = nil
		looks[player] = nil
		GameState:SetAttribute("ReadyCount", countReady())
		local r = round
		if r then
			r.interactables:release(player)
			r.monster:forget(player)
		end
		status[player] = nil
	end)

	local first = true
	while true do
		GameState:SetAttribute("Phase", "Lobby")
		applyLighting(Nights.get(1).lighting)
		while next(ready) == nil do
			task.wait(0.25)
		end

		GameState:SetAttribute("Phase", "Intermission")
		for i = if first then Config.Round.FirstIntermission else Config.Round.Intermission, 1, -1 do
			local n = chosenNight()
			GameState:SetAttribute("Night", n)
			GameState:SetAttribute("NightName", Nights.get(n).name)
			GameState:SetAttribute("Countdown", i)
			task.wait(1)
		end
		first = false

		if next(ready) ~= nil then
			startRound(Nights.get(chosenNight()))
			repeat
				task.wait(0.5)
			until #alivePlayers() == 0
			endRound()
		end
	end
end

return RoundManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Themes</string>
          <string name="Source"><![CDATA[--!strict
-- The look of each night's map: materials, lamps, props, hub decor, wall writing.
--   house   grey concrete maze around a house                      (night 1)
--   ward    tiled hospital halls in red emergency light            (night 2)
--   sewer   flooded brick tunnels, no power                        (night 3)
--   atrium  a vast marble hall of columns, lamp posts and statues  (night 4)
--   void    black glass, glowing purple veins, floating rocks      (night 5)

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maze = require(ReplicatedStorage.Shared.Maze)
local Monsters = require(ReplicatedStorage.Shared.Monsters)
local Build = require(script.Parent.Build)

type Ctx = Build.Ctx
type Style = Build.Style
type Cell = Maze.Cell

export type CellInfo = { spot: boolean, room: boolean }

export type Theme = {
	wall: Style,
	hubWall: Style,
	floor: Style,
	hubFloor: (room: string) -> Style,
	ceiling: Style,
	hubCeiling: Style,
	trim: Style,
	tunnel: Style,
	locker: Style,
	columns: boolean,
	writings: { string },
	writingColor: Color3,
	writingFont: Enum.Font,
	writingGlow: boolean,
	exitStyle: string,
	lamp: (ctx: Ctx, cell: Cell?, position: Vector3) -> (),
	hubLamps: (ctx: Ctx) -> (),
	cell: (ctx: Ctx, x: number, z: number, info: CellInfo) -> (),
	room: (ctx: Ctx, block: { Cell }) -> (),
	hub: (ctx: Ctx) -> (),
	extra: (ctx: Ctx) -> (),
	spawns: (ctx: Ctx) -> { CFrame },
}

local Themes: { [string]: Theme } = {}

local UP = CFrame.Angles(0, 0, math.rad(90)) -- turns a Cylinder (X axis) upright

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function solid(ctx: Ctx, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	return ctx.part(ctx.props, name, size, cf, material, color, shape)
end

local function deco(ctx: Ctx, name: string, size: Vector3, cf: CFrame, material: Enum.Material, color: Color3, shape: Enum.PartType?): Part
	return ctx.decor(ctx.part(ctx.props, name, size, cf, material, color, shape)) :: Part
end

-- Wall faces of hub cells (except the exit), for hanging hub decor.
local function hubWalls(ctx: Ctx): { { cell: Cell, side: string } }
	local out = {}
	local hub = ctx.layout.hub
	for rz = 0, hub.d - 1 do
		for rx = 0, hub.w - 1 do
			local x, z = hub.x0 + rx, hub.z0 + rz
			for _, side in Maze.DIRS do
				local kind = Maze.getEdge(ctx.layout, x, z, side)
				local nx, nz = x + Maze.DX[side], z + Maze.DZ[side]
				if kind == "wall" and not (Maze.inBounds(ctx.layout, nx, nz) and Maze.isHub(ctx.layout, nx, nz)) then
					table.insert(out, { cell = { x = x, z = z }, side = side })
				end
			end
		end
	end
	return out
end

local function hallSpawns(ctx: Ctx): { CFrame }
	local hub = ctx.layout.hub
	local cx = ctx.hubOrigin.X + hub.w * ctx.C / 2
	local z0 = ctx.hubOrigin.Z + ctx.C * 0.6
	local points = {}
	for i = 0, 5 do
		local pos = Vector3.new(cx + (i % 3 - 1) * 4, 3.5, z0 + math.floor(i / 3) * 4)
		table.insert(points, CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1)))
	end
	return points
end

local function hubCellLamps(ctx: Ctx, theme: Theme)
	local hub = ctx.layout.hub
	for rz = 0, hub.d - 1 do
		for rx = 0, hub.w - 1 do
			theme.lamp(ctx, nil, ctx.cellCenter(hub.x0 + rx, hub.z0 + rz))
		end
	end
end

local function noop() end

---------------------------------------------------------------------------
-- NIGHT 1: THE HOUSE

local HOUSE_FLOORS: { [string]: Style } = {
	hall = { material = Enum.Material.WoodPlanks, color = rgb(88, 74, 62) },
	living = { material = Enum.Material.WoodPlanks, color = rgb(98, 82, 68) },
	bedroom = { material = Enum.Material.Carpet, color = rgb(78, 76, 80) },
	kitchen = { material = Enum.Material.CeramicTiles, color = rgb(150, 150, 146) },
	study = { material = Enum.Material.WoodPlanks, color = rgb(80, 68, 58) },
}

local function portrait(ctx: Ctx, frame: CFrame)
	solid(ctx, "PortraitFrame", Vector3.new(3.6, 4.6, 0.3), frame * CFrame.new(0, 0, -0.15), Enum.Material.Wood, rgb(45, 36, 30))
	local canvas = deco(ctx, "Portrait", Vector3.new(3, 4, 0.05), frame * CFrame.new(0, 0, -0.33), Enum.Material.SmoothPlastic, rgb(38, 38, 38))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 1
	gui.Parent = canvas
	local function blob(name: string, pos: UDim2, size: UDim2, color: Color3): Frame
		local f = Instance.new("Frame")
		f.Name = name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = pos
		f.Size = size
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = f
		f.Parent = gui
		return f
	end
	blob("Body", UDim2.fromScale(0.5, 1.05), UDim2.fromScale(0.95, 0.5), rgb(20, 20, 20))
	local face = blob("Face", UDim2.fromScale(0.5, 0.42), UDim2.fromScale(0.5, 0.5), rgb(205, 200, 190))
	face.Rotation = ctx.random:NextNumber(-8, 8)
	blob("EyeL", UDim2.fromScale(0.41, 0.38), UDim2.fromScale(0.11, 0.09), Color3.new(0, 0, 0))
	blob("EyeR", UDim2.fromScale(0.59, 0.38), UDim2.fromScale(0.11, 0.09), Color3.new(0, 0, 0))
	blob("Mouth", UDim2.fromScale(0.5, 0.55), UDim2.fromScale(0.16, 0.12), Color3.new(0, 0, 0))
end

local function ceilingLamp(ctx: Ctx, cell: Cell?, position: Vector3, color: Color3, brightness: number, range: number)
	local H = ctx.ceiling
	ctx.decor(ctx.part(ctx.lights, "LampBase", Vector3.new(2.8, 0.3, 2.8), CFrame.new(position.X, H - 0.15, position.Z), Enum.Material.Metal, rgb(45, 45, 45), nil))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(1.5, 0.35, 1.5), CFrame.new(position.X, H - 0.45, position.Z), Enum.Material.Neon, rgb(215, 212, 200), nil))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = range
	light.Brightness = brightness
	light.Color = color
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("Buzz", ctx.random:NextNumber() < 0.4)
	ctx.addLamp(bulb, light, cell)
end

local function hangingLamp(ctx: Ctx, position: Vector3, brightness: number, color: Color3)
	local H = ctx.ceiling
	local bulbY = H - 3.2
	ctx.decor(ctx.part(ctx.lights, "Cord", Vector3.new(0.12, H - bulbY, 0.12), CFrame.new(position.X, (H + bulbY) / 2, position.Z), Enum.Material.Plastic, rgb(20, 20, 20), nil))
	ctx.decor(ctx.part(ctx.lights, "Shade", Vector3.new(2.2, 0.9, 2.2), CFrame.new(position.X, bulbY + 0.55, position.Z), Enum.Material.Fabric, rgb(120, 116, 110), nil))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(0.9, 0.9, 0.9), CFrame.new(position.X, bulbY, position.Z), Enum.Material.Neon, rgb(215, 212, 200), Enum.PartType.Ball))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = brightness
	light.Color = color
	light.Shadows = true
	light.Parent = bulb
	ctx.addLamp(bulb, light, nil)
end

local function houseProps(ctx: Ctx)
	local O = ctx.hubOrigin
	local random = ctx.random
	local function box(name: string, size: Vector3, x: number, yBottom: number, z: number, material: Enum.Material, color: Color3, rotY: number?): Part
		return solid(ctx, name, size, CFrame.new(O + Vector3.new(x, yBottom + size.Y / 2, z)) * CFrame.Angles(0, rotY or 0, 0), material, color)
	end
	local function wallFrame(x: number, y: number, z: number, facing: Vector3): CFrame
		local pos = O + Vector3.new(x, y, z)
		return CFrame.lookAt(pos, pos + facing)
	end
	local function note(x: number, y: number, z: number, text: string)
		ctx.note(CFrame.new(O + Vector3.new(x, y + 0.025, z)) * CFrame.Angles(0, random:NextNumber(-0.4, 0.4), 0), text)
	end
	local wood = Enum.Material.Wood
	local darkWood = rgb(62, 50, 42)
	local fabric = Enum.Material.Fabric

	-- bedroom: you wake up here
	box("BedFrame", Vector3.new(6, 1.6, 8), 3.6, 0, 29.1, wood, darkWood)
	box("Headboard", Vector3.new(6, 4.2, 0.5), 3.6, 0, 24.85, wood, darkWood)
	box("Mattress", Vector3.new(5.6, 0.9, 7.4), 3.6, 1.6, 29.3, fabric, rgb(196, 194, 188))
	box("Pillow", Vector3.new(3.6, 0.6, 1.5), 3.6, 2.5, 26.2, fabric, rgb(220, 218, 214))
	box("Blanket", Vector3.new(5.8, 0.3, 4.6), 3.7, 2.5, 31.0, fabric, rgb(70, 70, 78), 0.06)
	box("Nightstand", Vector3.new(2.2, 2.4, 2), 8, 0, 25.6, wood, darkWood)
	box("BrokenLamp", Vector3.new(0.6, 1.3, 0.6), 8.4, 2.4, 25.4, Enum.Material.Metal, rgb(80, 80, 80), 0.3)
	note(7.7, 2.4, 25.9, "If you're reading this, you woke up here too.\nThe clock in the hall says midnight. It always says midnight.\nJust make it to 6 AM. Don't let it see you.")
	box("ChairSeat", Vector3.new(2.2, 0.35, 2.2), 21.4, 2.1, 33.6, wood, darkWood, math.rad(45))
	box("ChairBack", Vector3.new(2.2, 3.2, 0.3), 22.2, 2.45, 34.4, wood, darkWood, math.rad(45))
	for _, l in { { 20.7, 33.6 }, { 21.4, 32.9 }, { 22.1, 33.6 }, { 21.4, 34.3 } } do
		box("ChairLeg", Vector3.new(0.3, 2.1, 0.3), l[1], 0, l[2], wood, darkWood)
	end
	portrait(ctx, wallFrame(18, 6.2, 35.5, Vector3.new(0, 0, -1)))

	-- living room
	local couch = rgb(104, 100, 96)
	box("CouchBase", Vector3.new(3.6, 2, 9), 2.9, 0, 12, fabric, couch)
	box("CouchBack", Vector3.new(1.2, 4.2, 9), 1.1, 0, 12, fabric, couch)
	box("CouchArm", Vector3.new(3.6, 3, 1), 2.9, 0, 7, fabric, couch)
	box("CouchArm", Vector3.new(3.6, 3, 1), 2.9, 0, 17, fabric, couch)
	ctx.decor(box("Rug", Vector3.new(10, 0.1, 8), 8, 0.05, 12, fabric, rgb(56, 56, 60)))
	box("CoffeeTable", Vector3.new(3, 1.6, 5), 8.5, 0, 12, wood, darkWood)
	box("TVStand", Vector3.new(2.4, 2.4, 6.4), 22.2, 0, 6, wood, darkWood)
	box("TV", Vector3.new(1, 3.4, 5.4), 22.5, 2.4, 6, Enum.Material.SmoothPlastic, rgb(16, 16, 16))
	local screen = ctx.sign(wallFrame(21.95, 4.1, 6, Vector3.new(-1, 0, 0)), Vector2.new(4.8, 2.9), "NO SIGNAL\n\nSTAY ASLEEP", rgb(150, 150, 150), rgb(46, 46, 46), true, Enum.Font.SpecialElite)
	local tvLight = Instance.new("PointLight")
	tvLight.Range = 10
	tvLight.Brightness = 0.6
	tvLight.Shadows = true
	tvLight.Parent = screen
	ctx.addLamp(screen, tvLight, nil)
	box("Bookshelf", Vector3.new(8, 9, 2), 12, 0, 1.55, wood, darkWood)
	for shelf = 0, 2 do
		local x = 8.6
		while x < 15.2 do
			local w = random:NextNumber(0.35, 0.8)
			local h = random:NextNumber(1.4, 2.2)
			box("Book", Vector3.new(w, h, 1.4), x + w / 2, 1 + shelf * 2.8, 2.0, fabric, ctx.vary(rgb(110, 104, 98), 0.4))
			x += w + random:NextNumber(0.02, 0.4)
		end
	end
	portrait(ctx, wallFrame(0.5, 7, 12, Vector3.new(1, 0, 0)))

	-- hall: the grandfather clock is stuck at midnight
	box("ClockBody", Vector3.new(1.8, 8.6, 1.6), 25.4, 0, 8, wood, darkWood)
	ctx.sign(wallFrame(26.33, 6.8, 8, Vector3.new(1, 0, 0)), Vector2.new(1.3, 1.3), "XII", rgb(30, 30, 30), rgb(200, 196, 186), false, Enum.Font.Fondamento)
	box("CoatRack", Vector3.new(0.4, 7, 0.4), 25.6, 0, 2.2, wood, darkWood)
	ctx.decor(box("Runner", Vector3.new(4, 0.1, 30), 30, 0.05, 18, fabric, rgb(60, 58, 58)))
	portrait(ctx, wallFrame(24.5, 6.5, 24, Vector3.new(1, 0, 0)))
	portrait(ctx, wallFrame(35.5, 6.5, 6, Vector3.new(-1, 0, 0)))

	-- kitchen
	box("Counter", Vector3.new(18, 3.4, 2.6), 47, 0, 1.8, wood, rgb(150, 146, 140))
	box("Countertop", Vector3.new(18.4, 0.3, 2.9), 47, 3.4, 1.8, Enum.Material.Marble, rgb(200, 200, 195))
	box("Cabinets", Vector3.new(18, 3, 1.6), 47, 7.2, 1.3, wood, rgb(140, 136, 130))
	box("Fridge", Vector3.new(3.2, 7.5, 3), 57.9, 0, 14, Enum.Material.Metal, rgb(186, 186, 186))
	box("TableTop", Vector3.new(6, 0.3, 4), 46, 2.9, 13, wood, darkWood)
	for _, l in { { 43.4, 11.4 }, { 48.6, 11.4 }, { 43.4, 14.6 }, { 48.6, 14.6 } } do
		box("TableLeg", Vector3.new(0.3, 2.9, 0.3), l[1], 0, l[2], wood, darkWood)
	end
	box("KitchenChair", Vector3.new(2, 2, 2), 46, 0, 16.2, wood, darkWood)
	box("KitchenChair", Vector3.new(2, 2, 2), 41.6, 0, 13, wood, darkWood, math.rad(70))
	note(46.5, 3.2, 13, "The lockers saved me twice.\nThe third time it WATCHED me get in.\nIf it's chasing you, break line of sight first.")

	-- study
	box("Desk", Vector3.new(6, 3, 2.6), 42, 0, 34.2, wood, darkWood)
	box("DeskChair", Vector3.new(2, 2, 2), 42, 0, 31.6, wood, darkWood)
	box("Bookshelf", Vector3.new(2, 9, 8), 58.5, 0, 30, wood, darkWood)
	note(41.2, 3, 34.0, "Day 14.\nIt doesn't see well in the dark, but it HEARS everything.\nWalk. Crouch. Only run when it's already running at you.\nIt likes the light. Turn yours off when it's close.")
	portrait(ctx, wallFrame(42, 6.5, 24.5, Vector3.new(0, 0, 1)))
end

Themes.house = {
	wall = { material = Enum.Material.Concrete, color = rgb(118, 116, 112) },
	hubWall = { material = Enum.Material.Plaster, color = rgb(170, 164, 154) },
	floor = { material = Enum.Material.Slate, color = rgb(54, 54, 54) },
	hubFloor = function(room: string): Style
		return HOUSE_FLOORS[room] or HOUSE_FLOORS.hall
	end,
	ceiling = { material = Enum.Material.Concrete, color = rgb(42, 42, 42) },
	hubCeiling = { material = Enum.Material.Plaster, color = rgb(128, 126, 122) },
	trim = { material = Enum.Material.Wood, color = rgb(70, 58, 50) },
	tunnel = { material = Enum.Material.Concrete, color = rgb(118, 116, 112) },
	locker = { material = Enum.Material.Metal, color = rgb(100, 102, 104) },
	columns = false,
	writings = {
		"IT SEES YOU", "DON'T RUN", "MAKE IT TO SIX", "HIDE", "IT HEARS YOUR FEET", "WHERE DID THE COLOR GO",
		"I WOKE UP HERE TOO", "TURN OFF YOUR LIGHT", "LISTEN FOR THE CLICKING", "NOT ALONE", "DON'T LOOK BEHIND YOU",
		"WAKE UP WAKE UP WAKE UP", "IT KNOWS THE LOCKERS", "STAY QUIET", "THE CLOCK IS WRONG",
	},
	writingColor = rgb(28, 22, 22),
	writingFont = Enum.Font.Creepster,
	writingGlow = false,
	exitStyle = "double",
	lamp = function(ctx: Ctx, cell: Cell?, position: Vector3)
		ceilingLamp(ctx, cell, position, ctx.night.lighting.LampColor, ctx.random:NextNumber(1.1, 1.7), 20)
	end,
	hubLamps = function(ctx: Ctx)
		local O = ctx.hubOrigin
		for _, spot in { { 12, 12, 1.3 }, { 48, 12, 1.4 }, { 12, 30, 0.8 }, { 48, 30, 1.0 }, { 30, 18, 1.2 }, { 30, 5, 0.9 } } do
			hangingLamp(ctx, O + Vector3.new(spot[1], 0, spot[2]), spot[3], ctx.night.lighting.LampColor)
		end
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C, H, T = ctx.C, ctx.H, ctx.T
		if random:NextNumber() < 0.3 then
			local sides = ctx.wallSides(x, z)
			if #sides > 0 then
				local f = ctx.sideFrame(x, z, sides[1])
				deco(ctx, "Pipe", Vector3.new(C - T, 0.8, 0.8), f * CFrame.new(0, H - 1.6, -0.6), Enum.Material.CorrodedMetal, ctx.vary(rgb(96, 96, 96), 0.2), Enum.PartType.Cylinder)
				if random:NextNumber() < 0.5 then
					deco(ctx, "Pipe", Vector3.new(C - T, 0.45, 0.45), f * CFrame.new(0, H - 2.6, -0.45), Enum.Material.Metal, ctx.vary(rgb(70, 70, 70), 0.2), Enum.PartType.Cylinder)
				end
			end
		end
		if random:NextNumber() < 0.16 then
			local center = ctx.cellCenter(x, z)
			local p = deco(ctx, "Puddle", Vector3.new(random:NextNumber(3, 6), 0.04, random:NextNumber(3, 6)), CFrame.new(center + Vector3.new(random:NextNumber(-2, 2), 0.03, random:NextNumber(-2, 2))) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0), Enum.Material.Glass, rgb(18, 18, 18))
			p.Transparency = 0.3
			p.Reflectance = 0.3
			p.CastShadow = false
		end
		if Maze.passableCount(ctx.layout, x, z) == 1 and not info.spot and random:NextNumber() < 0.6 then
			local sides = ctx.wallSides(x, z)
			if #sides > 0 then
				local f = ctx.sideFrame(x, z, sides[1])
				for i = 1, random:NextInteger(1, 3) do
					local s = random:NextNumber(1.8, 3)
					solid(ctx, "Crate", Vector3.new(s, s, s), f * CFrame.new(random:NextNumber(-3.5, 3.5), s / 2 + (if i == 3 then 2.4 else 0), -s / 2 - 0.2) * CFrame.Angles(0, random:NextNumber(-0.3, 0.3), 0), Enum.Material.WoodPlanks, ctx.vary(rgb(90, 80, 70), 0.2))
				end
			end
		end
	end,
	room = noop,
	hub = houseProps,
	extra = noop,
	spawns = function(ctx: Ctx): { CFrame }
		local points = {}
		for _, s in { { 10, 33.5 }, { 13, 33.5 }, { 10, 29.5 }, { 13, 29.5 }, { 16, 33.5 }, { 16, 30.5 } } do
			local pos = ctx.hubOrigin + Vector3.new(s[1], 3.5, s[2])
			table.insert(points, CFrame.lookAt(pos, pos + Vector3.new(1, 0, 0)))
		end
		return points
	end,
}

---------------------------------------------------------------------------
-- NIGHT 2: THE RED WARD

local WARD_SIGNS = { "WARD B", "ISOLATION  >", "<  RADIOLOGY", "NO VISITORS", "QUIET PLEASE", "ROOM 13", "STAFF ONLY", "SURGERY  >", "PEDIATRICS", "<  MORGUE" }

local function wardBed(ctx: Ctx, frame: CFrame)
	local metal = Enum.Material.Metal
	local fabric = Enum.Material.Fabric
	solid(ctx, "BedFrame", Vector3.new(3.4, 0.4, 7), frame * CFrame.new(0, 2, 0), metal, rgb(185, 185, 182))
	solid(ctx, "Mattress", Vector3.new(3.1, 0.6, 6.6), frame * CFrame.new(0, 2.5, 0), fabric, rgb(225, 225, 220))
	deco(ctx, "Sheet", Vector3.new(3.3, 0.2, 4.2), frame * CFrame.new(0.1, 2.85, 1.1) * CFrame.Angles(0, ctx.random:NextNumber(-0.15, 0.15), 0), fabric, rgb(200, 205, 200))
	deco(ctx, "Pillow", Vector3.new(2.4, 0.5, 1.2), frame * CFrame.new(0, 3, -2.7), fabric, rgb(235, 235, 230))
	solid(ctx, "Headboard", Vector3.new(3.4, 2.6, 0.25), frame * CFrame.new(0, 2.9, -3.45), metal, rgb(170, 170, 168))
	for _, lx in { -1.5, 1.5 } do
		for _, lz in { -3.2, 3.2 } do
			deco(ctx, "BedLeg", Vector3.new(0.2, 1.8, 0.2), frame * CFrame.new(lx, 0.9, lz), metal, rgb(120, 120, 118))
		end
	end
end

local function wardLamp(ctx: Ctx, cell: Cell?, position: Vector3)
	local random = ctx.random
	local H = ctx.ceiling
	local broken = random:NextNumber() < 0.18
	ctx.decor(ctx.part(ctx.lights, "Fixture", Vector3.new(4.2, 0.25, 1.8), CFrame.new(position.X, H - 0.12, position.Z), Enum.Material.Metal, rgb(160, 160, 160), nil))
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(3.8, 0.15, 1.3), CFrame.new(position.X, H - 0.3, position.Z), Enum.Material.Neon, if broken then rgb(240, 240, 230) else rgb(255, 80, 70), nil))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 20
	light.Brightness = if broken then 0.9 else random:NextNumber(1.5, 2.1)
	light.Color = if broken then rgb(255, 250, 240) else ctx.night.lighting.LampColor
	light.Shadows = true
	light.Parent = bulb
	bulb:SetAttribute("Buzz", broken)
	ctx.addLamp(bulb, light, cell)
	-- spinning red alarm beacons
	if random:NextNumber() < 0.2 then
		local beacon = ctx.decor(ctx.part(ctx.lights, "Beacon", Vector3.new(0.9, 0.7, 0.9), CFrame.new(position.X + 2.8, H - 0.5, position.Z), Enum.Material.Neon, rgb(255, 30, 20), nil))
		beacon.CastShadow = false
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Front
		spot.Angle = 40
		spot.Range = 34
		spot.Brightness = 3
		spot.Color = rgb(255, 20, 10)
		spot.Parent = beacon
		CollectionService:AddTag(beacon, "Beacon")
	end
end

Themes.ward = {
	wall = { material = Enum.Material.CeramicTiles, color = rgb(206, 204, 198) },
	hubWall = { material = Enum.Material.Plaster, color = rgb(196, 190, 184) },
	floor = { material = Enum.Material.Marble, color = rgb(165, 162, 158), reflect = 0.08 },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.CeramicTiles, color = rgb(150, 148, 144) }
	end,
	ceiling = { material = Enum.Material.Plaster, color = rgb(175, 172, 168) },
	hubCeiling = { material = Enum.Material.Plaster, color = rgb(175, 172, 168) },
	trim = { material = Enum.Material.Metal, color = rgb(150, 150, 150) },
	tunnel = { material = Enum.Material.CeramicTiles, color = rgb(206, 204, 198) },
	locker = { material = Enum.Material.Metal, color = rgb(176, 186, 192) },
	columns = false,
	writings = {
		"STAY IN YOUR BED", "VISITING HOURS ARE OVER", "IT CRAWLS", "LOOK DOWN", "NURSE?", "ROOM 13 IS EMPTY NOW",
		"THE PATIENTS LEFT", "DON'T RUN IN THE HALLS", "IT WAS ON ALL FOURS", "WE'RE NOT SICK", "IT'S UNDER THE BEDS",
		"NO ONE IS COMING", "ITS FACE IS UPSIDE DOWN",
	},
	writingColor = rgb(110, 8, 8),
	writingFont = Enum.Font.Creepster,
	writingGlow = false,
	exitStyle = "double",
	lamp = wardLamp,
	hubLamps = function(ctx: Ctx)
		hubCellLamps(ctx, Themes.ward)
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		if info.room then
			return
		end
		local random = ctx.random
		local C, T = ctx.C, ctx.T
		local sides = ctx.wallSides(x, z)
		for _, side in sides do
			if random:NextNumber() < 0.45 then
				local f = ctx.sideFrame(x, z, side)
				deco(ctx, "Handrail", Vector3.new(C - T - 1.5, 0.25, 0.25), f * CFrame.new(0, 3.2, -0.35), Enum.Material.Wood, rgb(150, 120, 90), Enum.PartType.Cylinder)
			end
		end
		if #sides == 0 or info.spot then
			return
		end
		local f = ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)])
		local roll = random:NextNumber()
		if roll < 0.13 then
			-- a gurney left against the wall
			wardBed(ctx, f * CFrame.new(random:NextNumber(-1, 1), -1.2, -2.2) * CFrame.Angles(0, math.rad(90), 0))
		elseif roll < 0.23 then
			-- wheelchair
			local base = f * CFrame.new(random:NextNumber(-3, 3), 0, -2.4) * CFrame.Angles(0, random:NextNumber(-1, 1), 0)
			solid(ctx, "Seat", Vector3.new(2, 0.3, 2), base * CFrame.new(0, 1.8, 0), Enum.Material.Fabric, rgb(40, 40, 44))
			solid(ctx, "Back", Vector3.new(2, 2, 0.3), base * CFrame.new(0, 2.9, 1), Enum.Material.Fabric, rgb(40, 40, 44))
			for _, sx in { -1.15, 1.15 } do
				deco(ctx, "Wheel", Vector3.new(0.15, 2.4, 2.4), base * CFrame.new(sx, 1.2, 0.3), Enum.Material.Metal, rgb(90, 90, 90), Enum.PartType.Cylinder)
			end
		elseif roll < 0.32 then
			-- IV stand
			local base = f * CFrame.new(random:NextNumber(-3, 3), 0, -1.5)
			deco(ctx, "Pole", Vector3.new(7, 0.15, 0.15), base * CFrame.new(0, 3.5, 0) * UP, Enum.Material.Metal, rgb(180, 180, 180), Enum.PartType.Cylinder)
			deco(ctx, "Bag", Vector3.new(0.7, 1.1, 0.25), base * CFrame.new(0.35, 6.2, 0), Enum.Material.Glass, rgb(220, 225, 220)).Transparency = 0.4
			for a = 0, 2 do
				deco(ctx, "Foot", Vector3.new(1.4, 0.12, 0.15), base * CFrame.Angles(0, a * 2.09, 0) * CFrame.new(0.6, 0.1, 0), Enum.Material.Metal, rgb(150, 150, 150))
			end
		elseif roll < 0.4 then
			solid(ctx, "MedCart", Vector3.new(3, 3.2, 1.8), f * CFrame.new(random:NextNumber(-3, 3), 1.6, -1.1), Enum.Material.Metal, rgb(170, 175, 180))
		elseif roll < 0.52 then
			ctx.sign(f * CFrame.new(random:NextNumber(-2, 2), 7.6, -0.08), Vector2.new(4, 1), WARD_SIGNS[random:NextInteger(1, #WARD_SIGNS)], rgb(20, 20, 20), rgb(225, 225, 220), false, Enum.Font.GothamBold)
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		local random = ctx.random
		for _, c in block do
			local sides = ctx.wallSides(c.x, c.z)
			if #sides > 0 then
				local f = ctx.sideFrame(c.x, c.z, sides[random:NextInteger(1, #sides)])
				local bed = f * CFrame.new(random:NextNumber(-1.5, 1.5), 0, -3.8) * CFrame.Angles(0, math.rad(180), 0)
				wardBed(ctx, bed * CFrame.new(0, -1.2, 0))
				-- privacy curtain beside the bed
				local curtain = deco(ctx, "Curtain", Vector3.new(0.1, 7.5, 5.5), bed * CFrame.new(2.6, 4.5, 0), Enum.Material.Fabric, rgb(170, 195, 190))
				curtain.Transparency = 0.25
				-- heart monitor flatlining (the only green in the ward)
				local monitor = solid(ctx, "Monitor", Vector3.new(1.4, 1.1, 0.8), bed * CFrame.new(-2.4, 4.2, -3), Enum.Material.SmoothPlastic, rgb(30, 30, 32))
				ctx.sign(monitor.CFrame * CFrame.new(0, 0, 0.41) * CFrame.Angles(0, math.rad(180), 0), Vector2.new(1.2, 0.8), "_____", rgb(60, 255, 120), rgb(5, 20, 10), true, Enum.Font.Code)
				solid(ctx, "MonitorStand", Vector3.new(0.6, 3.6, 0.6), bed * CFrame.new(-2.4, 1.8, -3), Enum.Material.Metal, rgb(120, 120, 120))
			end
		end
	end,
	hub = function(ctx: Ctx)
		local hub = ctx.layout.hub
		local O = ctx.hubOrigin
		local C = ctx.C
		local W = hub.w * C
		-- nurse station near the west wall, waiting chairs on the east
		solid(ctx, "Counter", Vector3.new(2.2, 3.6, 9), CFrame.new(O + Vector3.new(6, 1.8, C * 1.4)), Enum.Material.Marble, rgb(200, 196, 190))
		solid(ctx, "Counter", Vector3.new(6, 3.6, 2.2), CFrame.new(O + Vector3.new(8.9, 1.8, C * 1.4 - 3.4)), Enum.Material.Marble, rgb(200, 196, 190))
		solid(ctx, "Monitor", Vector3.new(1.6, 1.2, 0.3), CFrame.new(O + Vector3.new(7, 4.2, C * 1.4)) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.SmoothPlastic, rgb(25, 25, 28))
		for i = 0, 3 do
			local p = O + Vector3.new(W - 2.2, 0, 4 + i * 2.6)
			solid(ctx, "WaitingChair", Vector3.new(2, 0.4, 2), CFrame.new(p + Vector3.new(0, 1.7, 0)), Enum.Material.Plastic, rgb(70, 90, 110))
			solid(ctx, "WaitingChairBack", Vector3.new(0.3, 2.2, 2), CFrame.new(p + Vector3.new(0.9, 2.8, 0)), Enum.Material.Plastic, rgb(70, 90, 110))
		end
		local notes = {
			"PATIENT FILE #13\nFound on all fours under bed 4. Moves very fast, very low.\nWhen it gets close it LUNGES.\nIt loses interest fast. Break line of sight.",
			"Night shift: the 4 ward keys are gone again. Each one has a tag with a digit.\nThe exit keypad wants all four.\nThe main doors are chained shut until then.",
		}
		local walls = hubWalls(ctx)
		for i, text in notes do
			local w = walls[(i * 3) % #walls + 1]
			ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2), text)
		end
		for i, w in walls do
			if i % 2 == 0 then
				ctx.sign(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 7.5, -0.08), Vector2.new(4, 1), WARD_SIGNS[i % #WARD_SIGNS + 1], rgb(20, 20, 20), rgb(225, 225, 220), false, Enum.Font.GothamBold)
			end
		end
		-- the clock stopped at 3:33
		local w = walls[1]
		ctx.sign(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(2.5, 9, -0.08), Vector2.new(2, 1), "3:33", rgb(255, 60, 50), rgb(10, 10, 10), true, Enum.Font.Code)
		-- glowing EXIT sign above the doors, facing in
		local e = ctx.layout.exitCell
		ctx.sign(ctx.sideFrame(e.x, e.z, "S") * CFrame.new(0, ctx.exitHeight + 1.1, -0.15), Vector2.new(4, 1.2), "EXIT", rgb(230, 255, 230), rgb(20, 160, 60), true, Enum.Font.GothamBlack)
	end,
	extra = noop,
	spawns = hallSpawns,
}

---------------------------------------------------------------------------
-- NIGHT 3: THE DROWNED TUNNELS

local function cagedLamp(ctx: Ctx, cell: Cell?, position: Vector3, powered: boolean)
	local H = ctx.ceiling
	local y = H - 1.2
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(1, 1, 1), CFrame.new(position.X, y, position.Z), Enum.Material.Neon, if powered then rgb(200, 255, 220) else rgb(40, 46, 42), Enum.PartType.Ball))
	bulb.CastShadow = false
	for a = 0, 3 do
		ctx.decor(ctx.part(ctx.lights, "Cage", Vector3.new(0.08, 1.5, 0.08), CFrame.new(position.X, y, position.Z) * CFrame.Angles(0, a * math.pi / 2, 0) * CFrame.new(0.6, 0, 0), Enum.Material.Metal, rgb(60, 60, 60), nil))
	end
	ctx.decor(ctx.part(ctx.lights, "Mount", Vector3.new(0.3, 0.9, 0.3), CFrame.new(position.X, H - 0.45, position.Z), Enum.Material.Metal, rgb(50, 50, 50), nil))
	local light = Instance.new("PointLight")
	light.Range = 20
	light.Brightness = if powered then 0.7 else 1.4
	light.Color = ctx.night.lighting.LampColor
	light.Shadows = true
	light.Enabled = powered
	light.Parent = bulb
	bulb:SetAttribute("Buzz", ctx.random:NextNumber() < 0.5)
	bulb:SetAttribute("OnColor", rgb(200, 255, 220))
	ctx.addLamp(bulb, light, cell)
end

Themes.sewer = {
	wall = { material = Enum.Material.Brick, color = rgb(72, 74, 68) },
	hubWall = { material = Enum.Material.Concrete, color = rgb(96, 98, 94) },
	floor = { material = Enum.Material.Concrete, color = rgb(52, 56, 54) },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.DiamondPlate, color = rgb(80, 82, 80) }
	end,
	ceiling = { material = Enum.Material.Concrete, color = rgb(38, 40, 38) },
	hubCeiling = { material = Enum.Material.Concrete, color = rgb(46, 48, 46) },
	trim = { material = Enum.Material.CorrodedMetal, color = rgb(90, 80, 70) },
	tunnel = { material = Enum.Material.Concrete, color = rgb(96, 98, 94) },
	locker = { material = Enum.Material.CorrodedMetal, color = rgb(92, 80, 70) },
	columns = false,
	writings = {
		"IT'S BLIND", "DON'T SPLASH", "THE NOISE BRINGS IT", "HOLD YOUR BREATH", "IT HEARD ME BREATHE", "CROUCH",
		"PETE?", "THREE GENERATORS", "IT CLICKS WHEN IT LISTENS", "NO LIGHT DOWN HERE", "THE LIFT STILL WORKS",
	},
	writingColor = rgb(190, 196, 186),
	writingFont = Enum.Font.Creepster,
	writingGlow = false,
	exitStyle = "lift",
	lamp = function(ctx: Ctx, cell: Cell?, position: Vector3)
		cagedLamp(ctx, cell, position, false)
	end,
	hubLamps = function(ctx: Ctx)
		local hub = ctx.layout.hub
		for rx = 0, hub.w - 1, 2 do
			cagedLamp(ctx, nil, ctx.cellCenter(hub.x0 + rx, hub.z0), true)
		end
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C, H, T = ctx.C, ctx.H, ctx.T
		local center = ctx.cellCenter(x, z)
		-- ankle-deep water everywhere
		local water = deco(ctx, "Water", Vector3.new(C, 0.25, C), CFrame.new(center + Vector3.new(0, 0.12, 0)), Enum.Material.Glass, if info.room then rgb(16, 32, 28) else rgb(30, 52, 46))
		water.Transparency = 0.35
		water.Reflectance = 0.3
		water.CastShadow = false
		local sides = ctx.wallSides(x, z)
		if #sides > 0 and random:NextNumber() < 0.55 then
			local f = ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)])
			deco(ctx, "Pipe", Vector3.new(C - T, 1.4, 1.4), f * CFrame.new(0, H - 1.6, -0.9), Enum.Material.CorrodedMetal, ctx.vary(rgb(90, 70, 55), 0.2), Enum.PartType.Cylinder)
			if random:NextNumber() < 0.4 then
				local low = f * CFrame.new(0, 2.6, -0.5)
				deco(ctx, "Pipe", Vector3.new(C - T, 0.6, 0.6), low, Enum.Material.Metal, ctx.vary(rgb(80, 84, 80), 0.2), Enum.PartType.Cylinder)
				deco(ctx, "Valve", Vector3.new(0.15, 1.4, 1.4), low * CFrame.new(random:NextNumber(-2, 2), 0, -0.5) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Metal, rgb(130, 30, 25), Enum.PartType.Cylinder)
			end
		end
		if random:NextNumber() < 0.25 then
			local along = if random:NextNumber() < 0.5 then CFrame.new() else CFrame.Angles(0, math.rad(90), 0)
			deco(ctx, "CeilingPipe", Vector3.new(C, 1, 1), CFrame.new(center + Vector3.new(random:NextNumber(-3, 3), H - 0.8, 0)) * along, Enum.Material.CorrodedMetal, ctx.vary(rgb(80, 66, 52), 0.2), Enum.PartType.Cylinder)
		end
		if #sides > 0 and random:NextNumber() < 0.12 then
			local f = ctx.sideFrame(x, z, sides[1])
			deco(ctx, "GrateHole", Vector3.new(3, 2, 0.1), f * CFrame.new(1, 1.4, -0.06), Enum.Material.SmoothPlastic, rgb(5, 5, 5))
			for i = 0, 5 do
				deco(ctx, "GrateBar", Vector3.new(0.12, 2.1, 0.15), f * CFrame.new(-0.25 + i * 0.5, 1.4, -0.12), Enum.Material.Metal, rgb(70, 70, 70))
			end
		end
		if not info.spot and random:NextNumber() < 0.08 then
			solid(ctx, "Drum", Vector3.new(3.4, 2.2, 2.2), CFrame.new(center + Vector3.new(random:NextNumber(-3.5, 3.5), 1.7, random:NextNumber(-3.5, 3.5))) * UP, Enum.Material.CorrodedMetal, ctx.vary(rgb(110, 60, 40), 0.25), Enum.PartType.Cylinder)
		end
		if random:NextNumber() < 0.08 then
			local top = center + Vector3.new(random:NextNumber(-3, 3), H, random:NextNumber(-3, 3))
			for i = 1, 10 do
				deco(ctx, "Chain", Vector3.new(0.25, 0.45, 0.12), CFrame.new(top - Vector3.new(0, i * 0.42, 0)) * CFrame.Angles(0, (i % 2) * math.rad(90), 0), Enum.Material.Metal, rgb(90, 90, 90))
			end
		end
		if random:NextNumber() < 0.15 then
			local drip = deco(ctx, "Drip", Vector3.new(0.2, 0.2, 0.2), CFrame.new(center + Vector3.new(random:NextNumber(-4, 4), H - 0.2, random:NextNumber(-4, 4))), Enum.Material.SmoothPlastic, rgb(0, 0, 0))
			drip.Transparency = 1
			CollectionService:AddTag(drip, "Drip")
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		-- an outflow pipe pouring into the flooded chamber
		local c = block[1]
		local sides = ctx.wallSides(c.x, c.z)
		if #sides > 0 then
			local f = ctx.sideFrame(c.x, c.z, sides[1])
			deco(ctx, "Outflow", Vector3.new(3, 4, 4), f * CFrame.new(0, 6, -1) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.CorrodedMetal, rgb(80, 66, 52), Enum.PartType.Cylinder)
			local fall = deco(ctx, "Waterfall", Vector3.new(2.6, 5, 0.6), f * CFrame.new(0, 2.5, -2.2), Enum.Material.Glass, rgb(60, 90, 80))
			fall.Transparency = 0.5
			fall.CastShadow = false
		end
	end,
	hub = function(ctx: Ctx)
		local O = ctx.hubOrigin
		local hub = ctx.layout.hub
		local C = ctx.C
		local W = hub.w * C
		for i = 0, 1 do
			solid(ctx, "Pump", Vector3.new(6, 3.2, 3.2), CFrame.new(O + Vector3.new(3.5, 2.2, 6 + i * 9)) * CFrame.Angles(0, math.rad(90), 0), Enum.Material.Metal, rgb(70, 90, 80), Enum.PartType.Cylinder)
		end
		local panel = solid(ctx, "Panel", Vector3.new(5, 4.5, 1), CFrame.new(O + Vector3.new(W - 1.2, 2.25, C * 1.5)) * CFrame.Angles(0, math.rad(-90), 0), Enum.Material.Metal, rgb(70, 72, 70))
		local screen = ctx.sign(panel.CFrame * CFrame.new(0, 0.6, -0.55), Vector2.new(4, 2), "MAIN POWER\nOFFLINE", rgb(255, 80, 60), rgb(10, 10, 10), true, Enum.Font.Code)
		screen.Name = "PowerPanel"
		local walls = hubWalls(ctx)
		local w = walls[1]
		ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2), "Maintenance log, day ?\nPower's out in the whole system. Three backup generators, one at the end of each far tunnel.\nThe service lift won't move without all three.\nWhatever lives down here is BLIND. I watched it walk right past Pete while he held his breath.\nThen Pete sneezed.")
		local e = ctx.layout.exitCell
		ctx.sign(ctx.sideFrame(e.x, e.z, "S") * CFrame.new(0, ctx.exitHeight + 1, -0.15), Vector2.new(5, 1.1), "SERVICE LIFT", rgb(255, 210, 60), rgb(25, 25, 20), true, Enum.Font.GothamBlack)
	end,
	extra = noop,
	spawns = hallSpawns,
}

---------------------------------------------------------------------------
-- NIGHT 4: THE ATRIUM

local function lampPost(ctx: Ctx, cell: Cell?, position: Vector3)
	local C = ctx.C
	local p = position + Vector3.new(C * 0.28, 0, C * 0.28)
	solid(ctx, "PostBase", Vector3.new(1.6, 1, 1.6), CFrame.new(p + Vector3.new(0, 0.5, 0)), Enum.Material.Marble, rgb(200, 200, 196))
	solid(ctx, "Post", Vector3.new(13, 0.5, 0.5), CFrame.new(p + Vector3.new(0, 7, 0)) * UP, Enum.Material.Metal, rgb(40, 42, 46), Enum.PartType.Cylinder)
	local bulb = ctx.decor(ctx.part(ctx.lights, "Bulb", Vector3.new(1.8, 1.8, 1.8), CFrame.new(p + Vector3.new(0, 14, 0)), Enum.Material.Neon, rgb(225, 235, 255), Enum.PartType.Ball))
	bulb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 48
	light.Brightness = ctx.random:NextNumber(1, 1.4)
	light.Color = ctx.night.lighting.LampColor
	light.Shadows = true
	light.Parent = bulb
	ctx.addLamp(bulb, light, cell)
end

local function bust(ctx: Ctx, at: CFrame)
	solid(ctx, "Plinth", Vector3.new(2.2, 4, 2.2), at * CFrame.new(0, 2, 0), Enum.Material.Marble, rgb(210, 210, 206))
	local marble = Enum.Material.Marble
	solid(ctx, "Shoulders", Vector3.new(1.8, 0.9, 1), at * CFrame.new(0, 4.45, 0), marble, rgb(232, 232, 228))
	local head = solid(ctx, "BustHead", Vector3.new(0.95, 1.2, 1), at * CFrame.new(0, 5.4, 0) * CFrame.Angles(0, ctx.random:NextNumber(-1, 1), 0), marble, rgb(232, 232, 228))
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = head
end

Themes.atrium = {
	wall = { material = Enum.Material.Marble, color = rgb(218, 218, 214) },
	hubWall = { material = Enum.Material.Marble, color = rgb(205, 205, 200) },
	floor = { material = Enum.Material.Marble, color = rgb(228, 228, 224), reflect = 0.12 },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.Marble, color = rgb(200, 196, 188), reflect = 0.1 }
	end,
	ceiling = { material = Enum.Material.Slate, color = rgb(36, 38, 44) },
	hubCeiling = { material = Enum.Material.Slate, color = rgb(36, 38, 44) },
	trim = { material = Enum.Material.Marble, color = rgb(240, 240, 236) },
	tunnel = { material = Enum.Material.Marble, color = rgb(205, 205, 200) },
	locker = { material = Enum.Material.Wood, color = rgb(90, 66, 44) },
	columns = true,
	writings = {
		"KEEP YOUR EYES OPEN", "IT MOVES WHEN YOU DON'T LOOK", "WHICH ONE IS REAL", "IT WAS NEVER A STATUE", "LOOK AT IT",
		"THE LIGHTS WILL GO OUT", "WALK BACKWARDS", "SIX PHOTOGRAPHS", "DON'T TURN AROUND",
	},
	writingColor = rgb(60, 62, 70),
	writingFont = Enum.Font.Creepster,
	writingGlow = false,
	exitStyle = "grand",
	lamp = lampPost,
	hubLamps = function(ctx: Ctx)
		hubCellLamps(ctx, Themes.atrium)
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C = ctx.C
		local center = ctx.cellCenter(x, z)
		if not info.spot then
			local roll = random:NextNumber()
			local spot = CFrame.new(center + Vector3.new(random:NextNumber(-C * 0.3, C * 0.3), 0, random:NextNumber(-C * 0.3, C * 0.3))) * CFrame.Angles(0, random:NextInteger(0, 3) * math.pi / 2, 0)
			if roll < 0.12 then
				solid(ctx, "Bench", Vector3.new(6, 0.6, 2), spot * CFrame.new(0, 1.6, 0), Enum.Material.Marble, rgb(215, 215, 210))
				for _, sx in { -2.4, 2.4 } do
					solid(ctx, "BenchLeg", Vector3.new(0.8, 1.3, 1.8), spot * CFrame.new(sx, 0.65, 0), Enum.Material.Marble, rgb(200, 200, 196))
				end
			elseif roll < 0.22 then
				bust(ctx, spot)
			elseif roll < 0.28 then
				for i = 0, 2 do
					solid(ctx, "Stanchion", Vector3.new(3.2, 0.3, 0.3), spot * CFrame.new(i * 3 - 3, 1.6, 0) * UP, Enum.Material.Metal, rgb(180, 150, 70), Enum.PartType.Cylinder)
					if i < 2 then
						deco(ctx, "Rope", Vector3.new(3, 0.2, 0.2), spot * CFrame.new(i * 3 - 1.5, 2.8, 0), Enum.Material.Fabric, rgb(120, 20, 25), Enum.PartType.Cylinder)
					end
				end
			elseif roll < 0.34 then
				solid(ctx, "Planter", Vector3.new(2.6, 2.4, 2.6), spot * CFrame.new(0, 1.2, 0), Enum.Material.Marble, rgb(190, 190, 186))
				deco(ctx, "Trunk", Vector3.new(6, 0.5, 0.5), spot * CFrame.new(0, 5, 0) * UP, Enum.Material.Wood, rgb(50, 44, 40), Enum.PartType.Cylinder)
				for _ = 1, 4 do
					deco(ctx, "Branch", Vector3.new(0.2, 3, 0.2), spot * CFrame.new(0, 7.5, 0) * CFrame.Angles(random:NextNumber(-0.8, 0.8), random:NextNumber(0, 6), random:NextNumber(-0.8, 0.8)) * CFrame.new(0, 1.4, 0), Enum.Material.Wood, rgb(50, 44, 40))
				end
			end
		end
		-- huge empty frames on the partition walls
		for _, side in ctx.wallSides(x, z) do
			if random:NextNumber() < 0.25 then
				local f = ctx.sideFrame(x, z, side)
				solid(ctx, "GiltFrame", Vector3.new(9, 7, 0.4), f * CFrame.new(0, 7.5, -0.2), Enum.Material.Wood, rgb(150, 115, 55))
				deco(ctx, "EmptyCanvas", Vector3.new(8, 6, 0.1), f * CFrame.new(0, 7.5, -0.42), Enum.Material.SmoothPlastic, rgb(12, 12, 14))
			end
		end
	end,
	room = noop,
	hub = function(ctx: Ctx)
		local O = ctx.hubOrigin
		local C = ctx.C
		solid(ctx, "TicketBooth", Vector3.new(7, 5, 4), CFrame.new(O + Vector3.new(6, 2.5, C * 1.3)), Enum.Material.Wood, rgb(80, 60, 45))
		local walls = hubWalls(ctx)
		local w = walls[1]
		ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2), "To whoever finds this,\nThe statues were never supposed to move.\nKEEP LOOKING AT IT. It cannot move while it is seen.\nWhen the lights blink, it comes closer.\nSix photographs are scattered through the halls. Collect them and the doors will remember you.\n- the curator")
		local w2 = walls[math.min(3, #walls)]
		ctx.sign(ctx.sideFrame(w2.cell.x, w2.cell.z, w2.side) * CFrame.new(0, 8, -0.1), Vector2.new(10, 3), "THE ATRIUM\nPLEASE DO NOT TOUCH THE EXHIBITS", rgb(40, 40, 46), rgb(220, 218, 210), false, Enum.Font.Fondamento)
	end,
	extra = function(ctx: Ctx)
		-- decoy statues: some of these are just statues
		local layout = ctx.layout
		local spots: { [string]: boolean } = {}
		for _, s in layout.spots do
			spots[Maze.key(s.x, s.z)] = true
		end
		local placed = 0
		local tries = 0
		while placed < 8 and tries < 80 do
			tries += 1
			local x = ctx.random:NextInteger(0, layout.width - 1)
			local z = ctx.random:NextInteger(0, layout.depth - 1)
			local k = Maze.key(x, z)
			if not Maze.isHub(layout, x, z) and not spots[k] and (math.abs(x - layout.entrance.x) + math.abs(z - layout.entrance.z)) > 1 then
				spots[k] = true
				placed += 1
				local rig = Monsters.build("Statue", { preview = true, decoy = true })
				Monsters.applyStatuePose(rig, ctx.random:NextInteger(1, #Monsters.STATUE_POSES), nil)
				local center = ctx.cellCenter(x, z)
				rig.model:PivotTo(CFrame.new(center + Vector3.new(ctx.random:NextNumber(-3, 3), rig.rootHeight, ctx.random:NextNumber(-3, 3))) * CFrame.Angles(0, ctx.random:NextNumber(0, 6.28), 0))
				Monsters.solve(rig)
				rig.model.Name = "Statue"
				rig.model.Parent = ctx.props
				local blocker = ctx.part(ctx.props, "StatueBase", Vector3.new(2.6, 8, 2.4), rig.root.CFrame * CFrame.new(0, -0.4, 0), Enum.Material.Marble, rgb(200, 200, 196), nil)
				blocker.Transparency = 1
			end
		end
	end,
	spawns = hallSpawns,
}

---------------------------------------------------------------------------
-- NIGHT 5: THE VOID

local VEIN_COLORS = { rgb(170, 60, 255), rgb(220, 70, 200), rgb(120, 60, 255) }

local function crystalLamp(ctx: Ctx, cell: Cell?, position: Vector3)
	local random = ctx.random
	local C = ctx.C
	local base = position + Vector3.new(random:NextNumber(-C * 0.32, C * 0.32), 0, random:NextNumber(-C * 0.32, C * 0.32))
	local bulb: BasePart? = nil
	for i = 1, 3 do
		local h = random:NextNumber(2.5, 5)
		local shard = ctx.decor(ctx.part(ctx.lights, "Crystal", Vector3.new(0.6, h, 0.6), CFrame.new(base + Vector3.new(random:NextNumber(-0.8, 0.8), h / 2 - 0.3, random:NextNumber(-0.8, 0.8))) * CFrame.Angles(random:NextNumber(-0.35, 0.35), random:NextNumber(0, 6), random:NextNumber(-0.35, 0.35)), Enum.Material.Neon, VEIN_COLORS[random:NextInteger(1, #VEIN_COLORS)], nil))
		shard.CastShadow = false
		if i == 1 then
			bulb = shard
		end
	end
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = random:NextNumber(1.3, 1.8)
	light.Color = ctx.night.lighting.LampColor
	light.Shadows = true
	light.Parent = bulb
	local b = bulb :: BasePart
	b:SetAttribute("Pulse", true)
	ctx.addLamp(b, light, cell)
end

Themes.void = {
	wall = { material = Enum.Material.Basalt, color = rgb(18, 14, 24) },
	hubWall = { material = Enum.Material.Basalt, color = rgb(26, 20, 34) },
	floor = { material = Enum.Material.Glass, color = rgb(8, 6, 12), reflect = 0.4 },
	hubFloor = function(_room: string): Style
		return { material = Enum.Material.Glass, color = rgb(14, 10, 20), reflect = 0.4 }
	end,
	ceiling = { material = Enum.Material.SmoothPlastic, color = rgb(0, 0, 0) },
	hubCeiling = { material = Enum.Material.SmoothPlastic, color = rgb(0, 0, 0) },
	trim = { material = Enum.Material.Neon, color = rgb(150, 60, 220) },
	tunnel = { material = Enum.Material.Basalt, color = rgb(26, 20, 34) },
	locker = { material = Enum.Material.Basalt, color = rgb(24, 18, 32) },
	columns = false,
	writings = {
		"THIS IS WHERE THE COLOR WENT", "BREAK THE HEARTS", "IT IS ALL OF THEM", "YOU WERE NEVER AWAKE", "WAKE UP",
		"IT CAN SMELL YOU", "THREE HEARTS ONE BODY", "RUN WHEN THE LAST ONE BREAKS", "THERE IS NO MORNING HERE",
		"WE ARE STILL HERE", "YOU CAME BACK",
	},
	writingColor = rgb(210, 120, 255),
	writingFont = Enum.Font.Creepster,
	writingGlow = true,
	exitStyle = "portal",
	lamp = crystalLamp,
	hubLamps = function(ctx: Ctx)
		local hub = ctx.layout.hub
		crystalLamp(ctx, nil, ctx.cellCenter(hub.x0, hub.z0 + 1))
		crystalLamp(ctx, nil, ctx.cellCenter(hub.x0 + hub.w - 1, hub.z0 + 1))
	end,
	cell = function(ctx: Ctx, x: number, z: number, info: CellInfo)
		local random = ctx.random
		local C, H = ctx.C, ctx.H
		local center = ctx.cellCenter(x, z)
		for _, side in ctx.wallSides(x, z) do
			if random:NextNumber() < 0.5 then
				local f = ctx.sideFrame(x, z, side)
				for _ = 1, random:NextInteger(1, 3) do
					local vein = deco(ctx, "Vein", Vector3.new(0.18, random:NextNumber(3, 10), 0.06), f * CFrame.new(random:NextNumber(-C * 0.4, C * 0.4), random:NextNumber(3, H - 2), -0.04) * CFrame.Angles(0, 0, random:NextNumber(-0.7, 0.7)), Enum.Material.Neon, VEIN_COLORS[random:NextInteger(1, #VEIN_COLORS)])
					vein.CastShadow = false
				end
			end
		end
		if random:NextNumber() < 0.25 then
			for _ = 1, random:NextInteger(1, 3) do
				local s = random:NextNumber(1.5, 4.5)
				local rock = deco(ctx, "FloatingRock", Vector3.new(s, s * random:NextNumber(0.6, 1.4), s * random:NextNumber(0.7, 1.3)), CFrame.new(center + Vector3.new(random:NextNumber(-C / 2, C / 2), H + random:NextNumber(3, 18), random:NextNumber(-C / 2, C / 2))) * CFrame.Angles(random:NextNumber(0, 6), random:NextNumber(0, 6), random:NextNumber(0, 6)), Enum.Material.Basalt, rgb(22, 18, 30))
				CollectionService:AddTag(rock, "Float")
			end
		end
		local sides = ctx.wallSides(x, z)
		if #sides > 0 and random:NextNumber() < 0.09 then
			-- something is looking out of the wall
			local f = ctx.sideFrame(x, z, sides[random:NextInteger(1, #sides)])
			local eyes = f * CFrame.new(random:NextNumber(-2, 2), random:NextNumber(4, 8), 0)
			for _, sx in { -0.5, 0.5 } do
				local eye = deco(ctx, "WallEye", Vector3.new(0.45, 0.45, 0.45), eyes * CFrame.new(sx, 0, -0.05), Enum.Material.Neon, rgb(240, 230, 255), Enum.PartType.Ball)
				CollectionService:AddTag(eye, "WallEye")
				deco(ctx, "Pupil", Vector3.new(0.18, 0.18, 0.1), eyes * CFrame.new(sx, 0, -0.27), Enum.Material.SmoothPlastic, rgb(0, 0, 0))
			end
		end
		if not info.spot and random:NextNumber() < 0.06 then
			local m = solid(ctx, "Monolith", Vector3.new(2.4, 9, 1), CFrame.new(center + Vector3.new(random:NextNumber(-3, 3), 4.5, random:NextNumber(-3, 3))) * CFrame.Angles(0, random:NextNumber(0, 6), random:NextNumber(-0.1, 0.1)), Enum.Material.Basalt, rgb(10, 8, 14))
			ctx.sign(m.CFrame * CFrame.new(0, 1, -0.55), Vector2.new(2, 5), "◇\n△\n○", rgb(200, 110, 255), nil, true, Enum.Font.Code)
		end
	end,
	room = function(ctx: Ctx, block: { Cell })
		local sum = Vector3.zero
		for _, c in block do
			sum += ctx.cellCenter(c.x, c.z)
		end
		local center = sum / 4
		for i = 0, 3 do
			local a = i * math.pi / 2 + math.pi / 4
			local m = solid(ctx, "Monolith", Vector3.new(2, 10, 1), CFrame.new(center + Vector3.new(math.cos(a) * 6.5, 5, math.sin(a) * 6.5)) * CFrame.Angles(0, -a + math.pi / 2, 0), Enum.Material.Basalt, rgb(10, 8, 14))
			ctx.sign(m.CFrame * CFrame.new(0, 1.5, -0.55), Vector2.new(1.6, 6), "W\nA\nK\nE", rgb(200, 110, 255), nil, true, Enum.Font.Creepster)
		end
	end,
	hub = function(ctx: Ctx)
		local O = ctx.hubOrigin
		local hub = ctx.layout.hub
		local C = ctx.C
		local center = O + Vector3.new(hub.w * C / 2, 0, hub.d * C / 2 + 2)
		for i = 0, 7 do
			local a = i * math.pi / 4
			local p = solid(ctx, "ThresholdPillar", Vector3.new(1.6, 12, 1.6), CFrame.new(center + Vector3.new(math.cos(a) * 13, 6, math.sin(a) * 13)), Enum.Material.Basalt, rgb(14, 10, 20))
			local top = deco(ctx, "PillarGlow", Vector3.new(1.7, 0.4, 1.7), p.CFrame * CFrame.new(0, 6.2, 0), Enum.Material.Neon, VEIN_COLORS[i % 3 + 1])
			top.CastShadow = false
		end
		local walls = hubWalls(ctx)
		local w = walls[1]
		ctx.note(ctx.sideFrame(w.cell.x, w.cell.z, w.side) * CFrame.new(0, 3.4, -1.2), "There were others before you.\nThey broke the hearts and they ran.\nThe way out only opens when all three stop beating.\nIt KNOWS the moment one stops.\nIt can smell you through a locker door if it's close.")
	end,
	extra = noop,
	spawns = hallSpawns,
}

return Themes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Turns a Maze layout into a themed map: floors, walls, doorways, pillars/columns,
-- lamps, props, writing, the hub, and the exit tunnel. Interactive things (doors,
-- lockers, batteries, notes, the exit, objective items) are added afterwards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maze = require(ReplicatedStorage.Shared.Maze)
local Nights = require(ReplicatedStorage.Shared.Nights)
local Build = require(script.Parent.Build)
local Themes = require(script.Parent.Themes)

type Layout = Maze.Layout
type Style = Build.Style

export type World = {
	model: Model,
	ctx: Build.Ctx,
	theme: Themes.Theme,
	night: Nights.Night,
	spawnPoints: { CFrame },
	escapeZone: BasePart,
	exitLight: PointLight,
	exitFrame: CFrame, -- the exit edge; its Back face looks into the hub
	hiddenSpot: CFrame,
	notes: { Build.Note },
	lamps: { Build.Lamp },
	random: Random,
}

local WorldBuilder = {}

WorldBuilder.setupCollisionGroups = Build.setupCollisionGroups

local function buildEdges(ctx: Build.Ctx, theme: Themes.Theme)
	local layout = ctx.layout
	local W, D = layout.width, layout.depth
	local function styleOf(x: number, z: number): Style
		if Maze.inBounds(layout, x, z) and Maze.isHub(layout, x, z) then
			return theme.hubWall
		end
		return theme.wall
	end
	for z = -1, D - 1 do
		for x = -1, W - 1 do
			for _, dir in { "N", "E" } do
				local valid = if dir == "N" then (x >= 0 and x < W) else (z >= 0 and z < D)
				if valid then
					local kind = Maze.getEdge(layout, x, z, dir)
					local front = styleOf(x, z)
					local back = styleOf(x + Maze.DX[dir], z + Maze.DZ[dir])
					local frame = ctx.edgeFrame(x, z, dir)
					if kind == "wall" then
						Build.wallBox(ctx, ctx.structure, frame, ctx.C - ctx.T, ctx.H, 0, 0, front, back)
					elseif kind == "door" or kind == "doorway" then
						Build.wallWithOpening(ctx, ctx.structure, frame, ctx.doorWidth, ctx.doorHeight, front, back)
						Build.doorTrim(ctx, ctx.structure, frame, ctx.doorWidth, ctx.doorHeight, theme.trim)
					elseif kind == "exit" then
						Build.wallWithOpening(ctx, ctx.structure, frame, ctx.exitWidth, ctx.exitHeight, front, back)
						Build.doorTrim(ctx, ctx.structure, frame, ctx.exitWidth, ctx.exitHeight, theme.trim)
					elseif kind == "hole" then
						Build.brokenWall(ctx, ctx.structure, frame, front, back)
					end
				end
			end
		end
	end
end

local function buildPillars(ctx: Build.Ctx, theme: Themes.Theme)
	local layout = ctx.layout
	local W, D = layout.width, layout.depth
	local C, H, T = ctx.C, ctx.H, ctx.T
	for j = 0, D do
		for i = 0, W do
			if theme.columns then
				-- a colonnade: a column at every grid point, up to the far-away ceiling
				local top = ctx.ceiling
				ctx.part(ctx.structure, "Column", Vector3.new(top, 3.4, 3.4), CFrame.new(i * C, top / 2, j * C) * CFrame.Angles(0, 0, math.rad(90)), theme.trim.material, ctx.vary(theme.trim.color, 0.03), Enum.PartType.Cylinder)
				ctx.part(ctx.structure, "ColumnBase", Vector3.new(4.6, 1.4, 4.6), CFrame.new(i * C, 0.7, j * C), theme.wall.material, theme.wall.color, nil)
				ctx.part(ctx.structure, "ColumnCap", Vector3.new(4.6, 1.2, 4.6), CFrame.new(i * C, top - 0.6, j * C), theme.wall.material, theme.wall.color, nil)
			else
				local needed = false
				for _, ex in { i - 1, i } do
					if ex >= 0 and ex < W and Maze.getEdge(layout, ex, j - 1, "N") ~= "open" then
						needed = true
					end
				end
				for _, ez in { j - 1, j } do
					if ez >= 0 and ez < D and Maze.getEdge(layout, i - 1, ez, "E") ~= "open" then
						needed = true
					end
				end
				if needed then
					local hubCount = 0
					for _, c in { { i - 1, j - 1 }, { i, j - 1 }, { i - 1, j }, { i, j } } do
						if Maze.inBounds(layout, c[1], c[2]) and Maze.isHub(layout, c[1], c[2]) then
							hubCount += 1
						end
					end
					local style = if hubCount >= 2 then theme.hubWall else theme.wall
					ctx.part(ctx.structure, "Pillar", Vector3.new(T + 0.5, H, T + 0.5), CFrame.new(i * C, H / 2, j * C), style.material, ctx.vary(style.color, 0.1), nil)
				end
			end
		end
	end
end

local function buildExitTunnel(ctx: Build.Ctx, theme: Themes.Theme): (BasePart, PointLight)
	local layout = ctx.layout
	local x = (layout.exitCell.x + 0.5) * ctx.C
	local width = ctx.exitWidth + 2
	local height = math.min(ctx.H, ctx.exitHeight + 3)
	local length = 28
	local zMid = -length / 2
	ctx.styled(ctx.structure, "TunnelFloor", Vector3.new(width + 2, 1, length), CFrame.new(x, -0.5, zMid), theme.floor)
	ctx.styled(ctx.structure, "TunnelCeiling", Vector3.new(width + 2, 1, length), CFrame.new(x, height + 0.5, zMid), theme.ceiling)
	for _, sx in { -1, 1 } do
		ctx.styled(ctx.structure, "TunnelWall", Vector3.new(1, height, length), CFrame.new(x + sx * (width / 2 + 0.5), height / 2, zMid), theme.tunnel)
	end
	local glow = ctx.part(ctx.structure, "TheOutside", Vector3.new(width + 2, height, 0.5), CFrame.new(x, height / 2, -length), Enum.Material.Neon, Color3.new(1, 1, 1), nil)
	glow.CastShadow = false
	local light = Instance.new("PointLight")
	light.Range = 45
	light.Brightness = 4
	light.Shadows = true
	light.Enabled = false -- switched on when the exit opens
	light.Parent = glow
	local zone = ctx.decor(ctx.part(ctx.structure, "EscapeZone", Vector3.new(width, 12, 2), CFrame.new(x, 6, -12), Enum.Material.SmoothPlastic, Color3.new(1, 1, 1), nil))
	zone.CanTouch = true
	zone.Transparency = 1
	return zone, light
end

function WorldBuilder.build(layout: Layout, night: Nights.Night): World
	Build.setupCollisionGroups()
	local model = Instance.new("Model")
	model.Name = "World"
	local ctx = Build.new(layout, night, model)
	local theme = Themes[night.theme] or Themes.house
	local C = ctx.C
	local W, D = layout.width, layout.depth

	ctx.styled(ctx.structure, "Floor", Vector3.new(W * C + 2, 1, D * C + 2), CFrame.new(W * C / 2, -0.5, D * C / 2), theme.floor)
	ctx.styled(ctx.structure, "Ceiling", Vector3.new(W * C + 2, 1, D * C + 2), CFrame.new(W * C / 2, ctx.ceiling + 0.5, D * C / 2), theme.ceiling)
	for key, room in layout.rooms do
		local xs, zs = string.match(key, "^(%-?%d+),(%-?%d+)$")
		local cx, cz = tonumber(xs) :: number, tonumber(zs) :: number
		ctx.styled(ctx.structure, "HubFloor", Vector3.new(C, 1, C), CFrame.new((cx + 0.5) * C, -0.45, (cz + 0.5) * C), theme.hubFloor(room))
		ctx.styled(ctx.structure, "HubCeiling", Vector3.new(C, 1, C), CFrame.new((cx + 0.5) * C, ctx.ceiling + 0.45, (cz + 0.5) * C), theme.hubCeiling)
	end

	buildEdges(ctx, theme)
	buildPillars(ctx, theme)

	for _, c in layout.lights do
		theme.lamp(ctx, c, ctx.cellCenter(c.x, c.z))
	end
	theme.hubLamps(ctx)

	local texts = table.clone(theme.writings)
	for i = #texts, 2, -1 do
		local j = ctx.random:NextInteger(1, i)
		texts[i], texts[j] = texts[j], texts[i]
	end
	for i, w in layout.writings do
		local frame = ctx.sideFrame(w.x, w.z, w.side) * CFrame.new(ctx.random:NextNumber(-1.2, 1.2), ctx.random:NextNumber(5, math.min(7, ctx.H - 3)), -0.1)
		ctx.writing(frame, texts[(i - 1) % #texts + 1], theme.writingColor, theme.writingFont, theme.writingGlow)
	end

	local spotCells: { [string]: boolean } = {}
	for _, s in layout.spots do
		spotCells[Maze.key(s.x, s.z)] = true
	end
	for _, l in layout.lockers do
		spotCells[Maze.key(l.x, l.z)] = true -- keep clutter out of locker cells too
	end
	local roomCells: { [string]: boolean } = {}
	for _, block in layout.roomBlocks do
		for _, c in block do
			roomCells[Maze.key(c.x, c.z)] = true
		end
	end
	for z = 0, D - 1 do
		for x = 0, W - 1 do
			if not Maze.isHub(layout, x, z) then
				local k = Maze.key(x, z)
				theme.cell(ctx, x, z, { spot = spotCells[k] == true, room = roomCells[k] == true })
			end
		end
	end
	for _, block in layout.roomBlocks do
		theme.room(ctx, block)
	end
	theme.hub(ctx)
	theme.extra(ctx)

	Build.markFurniture(ctx.props)
	Build.markFurniture(ctx.lights)
	local escapeZone, exitLight = buildExitTunnel(ctx, theme)
	local spawnPoints = theme.spawns(ctx)

	model.Parent = workspace

	return {
		model = model,
		ctx = ctx,
		theme = theme,
		night = night,
		spawnPoints = spawnPoints,
		escapeZone = escapeZone,
		exitLight = exitLight,
		exitFrame = ctx.edgeFrame(layout.exitCell.x, layout.exitCell.z - 1, "N"),
		hiddenSpot = CFrame.new(W * C / 2, -300, D * C / 2),
		notes = ctx.notes,
		lamps = ctx.lamps,
		random = ctx.random,
	}
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="39">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">14</token>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
    <Item class="SoundGroup" referent="40">
      <Properties>
        <string name="Name">AchromaMaster</string>
        <float name="Volume">1</float>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="41">
    <Properties>
      <string name="Name">StarterGui</string>
      <bool name="ResetPlayerGuiOnSpawn">false</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="AutoJumpEnabled">false</bool>
      <float name="CameraMaxZoomDistance">0.5</float>
      <float name="CameraMinZoomDistance">0.5</float>
      <token name="CameraMode">1</token>
      <float name="CharacterJumpPower">0</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Atmosphere</string>
            <string name="Source"><![CDATA[--!strict
-- The dread: fear level, heartbeat, camera shake, blur, the ambient drone, random
-- sounds behind you, lamps that flicker (and die when *it* walks under them), and
-- each map's own touches: spinning alarm lights, dripping water, floating rocks,
-- eyes in the walls, beating hearts, the hour bell.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Nights = require(Shared:WaitForChild("Nights"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Atmosphere = {}

type Lamp = {
	part: BasePart,
	light: Light?,
	base: number,
	litColor: Color3,
	dropUntil: number,
	nextDrop: number,
	buzz: Sound?,
	pulse: boolean,
}

type Floater = { part: BasePart, base: CFrame, phase: number, spin: number }

-- name, weight, min distance, max distance, volume
local STINGERS: { { any } } = {
	{ "StingerCreak", 3, 14, 30, 0.9 },
	{ "StingerBang", 2, 25, 45, 1.0 },
	{ "StingerWhisper", 2, 4, 8, 0.45 },
	{ "StingerScrape", 2, 16, 34, 0.8 },
	{ "StingerDistantScream", 1, 40, 60, 0.8 },
	{ "StingerKnock", 2, 10, 24, 0.9 },
	{ "StingerFootsteps", 2, 10, 20, 0.8 },
	{ "MonsterClicks", 1, 14, 26, 0.7 },
}

local NIGHT_STINGERS: { [string]: { { any } } } = {
	ward = { { "AlarmBeep", 4, 20, 40, 0.8 }, { "StingerFootsteps", 2, 8, 16, 0.8 } },
	sewer = { { "Drip", 4, 4, 12, 0.8 }, { "StingerScrape", 3, 14, 30, 0.9 } },
	atrium = { { "StatueGrind", 2, 30, 60, 0.7 }, { "StingerWhisper", 2, 4, 8, 0.4 } },
	void = { { "StingerWhisper", 4, 3, 8, 0.6 }, { "HeartPulseLoop", 2, 20, 40, 0.6 }, { "AmalgamRoar", 1, 60, 90, 0.5 } },
}

local lamps: { [BasePart]: Lamp } = {}
local beacons: { [BasePart]: boolean } = {}
local floaters: { [BasePart]: Floater } = {}
local wallEyes: { [BasePart]: number } = {}
local hearts: { [BasePart]: Vector3 } = {}
local drips: { [BasePart]: boolean } = {}
local blur: BlurEffect
local grade: ColorCorrectionEffect
local ambience: Sound? = nil
local heartbeatAt = 0
local nextStinger = 0
local nextDrip = 0
local nextLook = 0
local shakeImpulse = 0
local wasChased = false
local wake = 0

local function currentNight(): Nights.Night
	local n = GameState:GetAttribute("Night")
	return Nights.get(if typeof(n) == "number" then n else 1)
end

local function addLamp(inst: Instance)
	if not inst:IsA("BasePart") or lamps[inst] then
		return
	end
	local light = inst:FindFirstChildWhichIsA("Light")
	local base = inst:GetAttribute("BaseBrightness")
	local onColor = inst:GetAttribute("OnColor")
	local lamp: Lamp = {
		part = inst,
		light = light,
		base = if typeof(base) == "number" then base elseif light then light.Brightness else 1,
		litColor = if typeof(onColor) == "Color3" then onColor else inst.Color,
		dropUntil = 0,
		nextDrop = os.clock() + math.random() * 10,
		buzz = nil,
		pulse = inst:GetAttribute("Pulse") == true,
	}
	if inst:GetAttribute("Buzz") == true then
		local buzz = Audio.create("LightBuzzLoop", inst, 0.22)
		if buzz then
			buzz.RollOffMinDistance = 4
			buzz.RollOffMaxDistance = 28
			buzz:Play()
			lamp.buzz = buzz
		end
	end
	lamps[inst] = lamp
end

local function updateLamps(monsterPos: Vector3?)
	local now = os.clock()
	local beat = math.abs(math.sin(now * 2.2)) ^ 6 -- void lamps pulse like a heartbeat
	for part, lamp in lamps do
		if not part.Parent then
			lamps[part] = nil
			continue
		end
		local light = lamp.light
		if not light then
			continue
		end
		if not light.Enabled then
			-- no power
			if lamp.buzz then
				lamp.buzz.Volume = 0
			end
			continue
		end
		local b = lamp.base
		if lamp.pulse then
			b *= 0.55 + beat * 0.9
		end
		if now >= lamp.nextDrop then
			lamp.dropUntil = now + 0.03 + math.random() * 0.25
			lamp.nextDrop = now + 2 + math.random() * 12
		end
		if now < lamp.dropUntil then
			b *= 0.12
		end
		if monsterPos then
			local near = (part.Position - monsterPos).Magnitude
			if near < 14 then
				b = if math.random() < 0.9 then 0 else b
			elseif near < 40 then
				local k = 1 - near / 40
				if math.random() < k * 0.6 then
					b *= math.random() * (1 - k)
				end
			end
		end
		if GameState:GetAttribute("Blink") == true then
			b = 0
		end
		light.Brightness = b
		local dark = b < lamp.base * 0.3
		part.Color = if dark then lamp.litColor:Lerp(Color3.new(0, 0, 0), 0.75) else lamp.litColor
		if lamp.buzz then
			lamp.buzz.Volume = if dark then 0 else 0.22
		end
	end
end

local function updateProps(dt: number, myRoot: BasePart?)
	local t = os.clock()
	for part in beacons do
		if part.Parent then
			part.CFrame *= CFrame.Angles(0, dt * 4.5, 0)
		else
			beacons[part] = nil
		end
	end
	for part, f in floaters do
		if part.Parent then
			part.CFrame = f.base * CFrame.new(0, math.sin(t * 0.6 + f.phase) * 1.2, 0) * CFrame.Angles(0, t * f.spin, 0)
		else
			floaters[part] = nil
		end
	end
	for part, openAt in wallEyes do
		if not part.Parent then
			wallEyes[part] = nil
		elseif t >= openAt then
			part.Transparency = 0
			if math.random() < dt * 0.4 then
				part.Transparency = 1 -- blink
				wallEyes[part] = t + 0.15
			end
		end
	end
	local beat = math.abs(math.sin(t * 2.2)) ^ 6
	for part, size in hearts do
		if part.Parent then
			part.Size = size * (1 + beat * 0.12)
		else
			hearts[part] = nil
		end
	end
	if myRoot and t >= nextDrip then
		nextDrip = t + 0.8 + math.random() * 2.5
		for part in drips do
			if not part.Parent then
				drips[part] = nil
			elseif (part.Position - myRoot.Position).Magnitude < 40 and math.random() < 0.3 then
				Audio.playAt("Drip", part.Position, 0.6, 0.8 + math.random() * 0.5, 50)
				break
			end
		end
	end
end

local function playStinger(origin: BasePart)
	local list = table.clone(STINGERS)
	local extras = NIGHT_STINGERS[currentNight().id]
	if extras then
		for _, extra in extras do
			table.insert(list, extra)
		end
	end
	local total = 0
	for _, s in list do
		total += s[2] :: number
	end
	local pick = math.random() * total
	local chosen = list[1]
	for _, s in list do
		pick -= s[2] :: number
		if pick <= 0 then
			chosen = s
			break
		end
	end
	-- usually behind you
	local back = -origin.CFrame.LookVector
	local angle = math.rad(math.random(-75, 75))
	local dir = (CFrame.Angles(0, angle, 0) * Vector3.new(back.X, 0, back.Z)).Unit
	local dist = (chosen[3] :: number) + math.random() * ((chosen[4] :: number) - (chosen[3] :: number))
	local pos = origin.Position + dir * dist + Vector3.new(0, math.random(1, 5), 0)
	Audio.playAt(chosen[1] :: string, pos, chosen[5] :: number, 0.9 + math.random() * 0.2, 140)
end

local function shake()
	if ClientState.jumpscaring then
		return
	end
	local camera = workspace.CurrentCamera
	if not camera or camera.CameraType == Enum.CameraType.Scriptable then
		return
	end
	local amount = ClientState.fear ^ 2 * 0.004 + shakeImpulse * 0.02 + (if ClientState.chased then 0.004 else 0)
	if amount > 0.0002 then
		local t = os.clock()
		camera.CFrame *= CFrame.Angles(math.noise(t * 9, 0.3) * amount * 2, math.noise(t * 9, 4.1) * amount * 2, math.noise(t * 7, 8.7) * amount * 3)
	end
end

local function update(dt: number)
	local t = os.clock()
	local character = player.Character
	local myRoot = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local monster = workspace:FindFirstChild("Monster")
	local monsterRoot = if monster then monster:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	local playing = ClientState.roundStatus == "alive" and myRoot ~= nil

	local raw = 0
	local dist = math.huge
	local chased = false
	local monsterPos: Vector3? = nil
	if monster and monsterRoot and monsterRoot.Position.Y > -100 then
		monsterPos = monsterRoot.Position
		local state = monster:GetAttribute("State")
		if myRoot and playing then
			dist = (monsterRoot.Position - myRoot.Position).Magnitude
			if state ~= "Dormant" then
				raw = math.clamp(1 - (dist - 10) / 75, 0, 1)
			end
			chased = (state == "Chase" or state == "HuntLocker" or state == "Kill" or state == "Stalk") and monster:GetAttribute("TargetUserId") == player.UserId
			if chased and state ~= "Stalk" then
				raw = math.max(raw, 0.8)
			end
		end
	end

	local fear = ClientState.fear
	fear += (raw - fear) * math.min(1, dt * (if raw > fear then 2.5 else 0.45))
	ClientState.fear = fear
	ClientState.monsterDistance = dist
	ClientState.chased = chased
	ClientState.interference = math.clamp(1 - (dist - 8) / 34, 0, 1)
	Hud.setFear(fear)

	if chased and not wasChased then
		shakeImpulse = 1
		Hud.glitch(0.9, 0.5)
		Hud.flash(0.2, 0.3)
	end
	wasChased = chased
	shakeImpulse = math.max(0, shakeImpulse - dt * 1.5)

	wake = math.max(0, wake - dt * 0.35)
	blur.Size = fear ^ 2 * 4 + (if chased then (math.sin(t * 9) + 1) * 1.5 else 0) + wake * 18
	grade.Contrast = fear * 0.25
	grade.Brightness = ClientState.brightness - fear * 0.06 + (if math.random() < 0.02 then -0.03 else 0) - wake * 0.1

	if playing and fear > 0.15 and t >= heartbeatAt then
		heartbeatAt = t + (1.15 - fear * 0.8)
		Audio.play("Heartbeat", nil, 0.25 + fear * 1.1)
		Hud.pulse(fear)
	end

	if ambience then
		local target = if playing then 0.75 else 0
		ambience.Volume += (target - ambience.Volume) * math.min(1, dt * 0.8)
		ambience.PlaybackSpeed = currentNight().ambiencePitch
	end

	if playing and myRoot and t >= nextStinger then
		nextStinger = t + 16 + math.random() * 26
		playStinger(myRoot)
	end

	-- tell the server where we're looking (the Statue can't move while watched)
	if playing and t >= nextLook then
		nextLook = t + 0.1
		local camera = workspace.CurrentCamera
		if camera then
			Remotes.Look:FireServer(camera.CFrame.LookVector)
		end
	end

	updateLamps(monsterPos)
	updateProps(dt, if playing then myRoot else nil)
end

function Atmosphere.wakeUp()
	wake = 1
	nextStinger = os.clock() + 20
end

local function watchTag(tag: string, add: (BasePart) -> ())
	for _, inst in CollectionService:GetTagged(tag) do
		if inst:IsA("BasePart") then
			add(inst)
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst: Instance)
		if inst:IsA("BasePart") then
			add(inst)
		end
	end)
end

function Atmosphere.init()
	local camera = workspace.CurrentCamera
	blur = Instance.new("BlurEffect")
	blur.Size = 0
	blur.Parent = camera
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "Fear"
	grade.Parent = camera

	ambience = Audio.track("Ambience", nil, 0)
	if ambience then
		ambience:Play()
	end

	watchTag("FlickerLight", addLamp)
	watchTag("Beacon", function(p: BasePart)
		beacons[p] = true
	end)
	watchTag("Float", function(p: BasePart)
		floaters[p] = { part = p, base = p.CFrame, phase = math.random() * 6, spin = (math.random() - 0.5) * 0.4 }
	end)
	watchTag("WallEye", function(p: BasePart)
		wallEyes[p] = 0
	end)
	watchTag("Heart", function(p: BasePart)
		hearts[p] = p.Size
	end)
	watchTag("Drip", function(p: BasePart)
		drips[p] = true
	end)

	Remotes.Apparition.OnClientEvent:Connect(function(position: Vector3)
		local character = player.Character
		local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
		if not root or (root.Position - position).Magnitude > 140 then
			return
		end
		Audio.playAt("StaticBurst", position, 1.3, 1, 140)
		Hud.glitch(0.8, 0.35)
		local now = os.clock()
		for part, lamp in lamps do
			if part.Parent and (part.Position - position).Magnitude < 45 then
				lamp.dropUntil = now + 0.6 + math.random() * 0.4
			end
		end
	end)

	GameState:GetAttributeChangedSignal("MonsterAwake"):Connect(function()
		if GameState:GetAttribute("MonsterAwake") == true and ClientState.roundStatus == "alive" then
			local night = currentNight()
			if night.monsterKind ~= "Statue" then
				Audio.play("StingerDistantScream", nil, 1.1, 0.8)
			end
			Hud.message(if night.monsterKind == "Statue" then "One of the statues has moved." else "Somewhere out there, something wakes up.", "danger")
			shakeImpulse = 0.7
		end
	end)

	GameState:GetAttributeChangedSignal("Hour"):Connect(function()
		local hour = GameState:GetAttribute("Hour")
		if typeof(hour) == "number" and hour > 0 and ClientState.roundStatus == "alive" then
			Audio.play("ClockChime", nil, if hour >= 6 then 1.4 else 0.9, if hour == 3 then 0.8 else 1)
		end
	end)

	GameState:GetAttributeChangedSignal("Blink"):Connect(function()
		if GameState:GetAttribute("Blink") == true and ClientState.roundStatus == "alive" then
			Audio.play("Blink", nil, 0.8)
		end
	end)

	RunService.RenderStepped:Connect(update)
	RunService:BindToRenderStep("AchromaShake", Enum.RenderPriority.Camera.Value + 2, shake)

	-- keep effects attached if the camera object is ever replaced
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local cam = workspace.CurrentCamera
		if cam then
			blur.Parent = cam
			grade.Parent = cam
		end
	end)
end

return Atmosphere
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--!strict
-- Small shared blackboard so client controllers can read each other's state
-- without requiring each other.

local ClientState = {
	started = false, -- clicked "WAKE UP" on the title screen
	roundStatus = "none", -- "none" | "alive" | "caught" | "escaped"
	fear = 0, -- 0..1, how close / how angry the monster is
	monsterDistance = math.huge,
	chased = false, -- the monster is chasing *you*
	hiding = false,
	jumpscaring = false,
	flashlightOn = false,
	interference = 0, -- 0..1, makes your flashlight stutter
	sprinting = false,
	crouching = false,
	brightness = 0, -- settings: added to the screen brightness
}

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Endings</string>
            <string name="Source"><![CDATA[--!strict
-- How a night ends for you: the jumpscare when it catches you, or the white-out
-- when you make it through the exit.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local Endings = {}

local changed = Instance.new("BindableEvent")
Endings.Changed = changed.Event -- fires when a sequence finishes

local DEATH_LINES = {
	"It was standing behind you the whole time.",
	"You should have stayed quiet.",
	"It saw your light.",
	"Nobody heard you scream.",
	"The grey takes another one.",
}

local KIND_LINES: { [string]: { string } } = {
	Crawler = { "It was under the bed the whole time.", "You never looked down." },
	Listener = { "It heard every step.", "You should have stayed quiet." },
	Statue = { "You blinked.", "You looked away. Just for a second." },
	Amalgam = { "It is all of them. Now it's you too.", "There is no morning here." },
}

local function jumpscare(monster: Model)
	local kind = monster:GetAttribute("Kind")
	local lines = if typeof(kind) == "string" and KIND_LINES[kind] then KIND_LINES[kind] else DEATH_LINES
	ClientState.jumpscaring = true
	ClientState.roundStatus = "caught"
	local camera = workspace.CurrentCamera
	local head = monster:FindFirstChild("Head") :: BasePart?

	Hud.setHudVisible(false)
	Hud.setHint("")
	Hud.flash(1, 0.12)
	Audio.play("Jumpscare", nil, 2.6)
	camera.CameraType = Enum.CameraType.Scriptable

	local start = os.clock()
	RunService:BindToRenderStep("AchromaJumpscare", Enum.RenderPriority.Last.Value, function()
		local e = os.clock() - start
		if head and head.Parent then
			local hp = head.Position
			local face = head.CFrame.LookVector
			local dist = 4.4 - math.min(1, e / 0.15) * 2.9 -- it lunges into your face
			local shake = math.max(0.15, 1 - e / 1.6)
			camera.CFrame = CFrame.lookAt(hp + face * dist - Vector3.new(0, 0.3, 0), hp)
				* CFrame.Angles((math.random() - 0.5) * 0.12 * shake, (math.random() - 0.5) * 0.12 * shake, (math.random() - 0.5) * 0.35 * shake)
			camera.FieldOfView = 62 - math.min(e, 0.4) * 30
		end
		Hud.glitch(0.9, 0.1)
		if e > 1.7 then
			RunService:UnbindFromRenderStep("AchromaJumpscare")
			Hud.fade(0, 0)
			Hud.showBig("IT FOUND YOU", lines[math.random(1, #lines)])
			task.delay(3, function()
				Hud.hideBig()
				camera.FieldOfView = 70
				camera.CameraType = Enum.CameraType.Custom
				ClientState.jumpscaring = false
				Hud.fade(1, 1.2)
				changed:Fire()
			end)
		end
	end)
end

local ENDINGS: { [string]: { title: string, sub: string } } = {
	escaped = { title = "YOU ESCAPED", sub = "For a second, you could swear you saw color again." },
	survived = { title = "6:00 AM", sub = "The sun comes up. It's still grey. But you're still here." },
	collected = { title = "YOU FOUND THEM ALL", sub = "The last photograph shows a door that wasn't there before. You're already through it." },
	final = { title = "THE COLOR IS BACK", sub = "You woke up. For real this time.\n\nACHROMA  ·  thank you for playing" },
}

local function escaped(kind: string?)
	local ending = ENDINGS[kind or "escaped"] or ENDINGS.escaped
	ClientState.roundStatus = "escaped"
	ClientState.jumpscaring = true -- freezes input-driven effects for the sequence
	Hud.setHudVisible(false)
	Audio.play(if kind == "survived" then "ClockChime" else "Escape", nil, 1.2)
	Hud.whiteout(0, if kind == "final" then 5 else 2.5)
	if kind == "final" then
		-- the color actually comes back
		local grade = Lighting:FindFirstChild("Monochrome")
		if grade and grade:IsA("ColorCorrectionEffect") then
			TweenService:Create(grade, TweenInfo.new(6, Enum.EasingStyle.Sine), { Saturation = 0.45, TintColor = Color3.new(1, 1, 1), Contrast = 0.1 }):Play()
		end
	end
	task.delay(2, function()
		Hud.setBigColor(Color3.fromRGB(25, 25, 25))
		Hud.showBig(ending.title, ending.sub)
	end)
	task.delay(if kind == "final" then 9 else 6.5, function()
		Hud.hideBig(true)
		Hud.setBigColor(Color3.fromRGB(205, 205, 200))
		Hud.whiteout(1, 1.5)
		ClientState.jumpscaring = false
		changed:Fire()
	end)
end

function Endings.init()
	Remotes.Jumpscare.OnClientEvent:Connect(function(monster: Model)
		jumpscare(monster)
	end)
	Remotes.Escaped.OnClientEvent:Connect(function(kind: string?)
		escaped(kind)
	end)
end

return Endings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Flashlight</string>
            <string name="Source"><![CDATA[--!strict
-- Your flashlight: a shadow-casting spotlight that lags slightly behind your view,
-- drains its battery, stutters when the monster is near, and gives you away.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Config = require(Shared:WaitForChild("Config"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Flashlight = {}

local BRIGHTNESS = 2.6

local holder: Part
local beam: SpotLight
local spill: SpotLight
local battery = 100
local on = false
local sway: CFrame? = nil
local dropUntil = 0
local hinted = false

local function setOn(value: boolean)
	if value and battery <= 0 then
		Audio.play("FlashlightClick", nil, 0.5, 0.8)
		Hud.message("The battery is dead.")
		return
	end
	if value == on then
		return
	end
	on = value
	ClientState.flashlightOn = value
	Audio.play("FlashlightClick", nil, 0.7)
	Remotes.Flashlight:FireServer(value)
end

local function alive(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function update(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if holder.Parent ~= camera then
		holder.Parent = camera
	end
	local target = camera.CFrame * CFrame.new(0.45, -0.5, -0.4)
	local current = if sway then sway:Lerp(target, math.min(1, dt * 14)) else target
	sway = current
	holder.CFrame = CFrame.new(target.Position) * current.Rotation

	if on and (not alive() or ClientState.hiding or ClientState.jumpscaring) then
		setOn(false)
	end
	if on then
		battery = math.max(0, battery - Config.Player.BatteryDrain * dt)
		if battery <= 0 then
			setOn(false)
			Hud.message("Your flashlight flickers... and dies.")
		end
	end
	Hud.setBattery(battery / 100)

	-- stutter when the battery is low or the monster is close
	local now = os.clock()
	local instability = ClientState.interference
	if battery < 20 then
		instability = math.max(instability, (20 - battery) / 20 * 0.7)
	end
	if instability > 0 and math.random() < instability * 0.12 then
		dropUntil = now + 0.03 + math.random() * 0.14
	end
	local brightness = if now < dropUntil then BRIGHTNESS * 0.06 else BRIGHTNESS
	beam.Enabled = on
	spill.Enabled = on
	beam.Brightness = brightness
	spill.Brightness = brightness * 0.22

	-- the server puts a copy of your light on your head for other players; hide ours
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local shared = head and head:FindFirstChild("SharedFlashlight")
	if shared and shared:IsA("SpotLight") then
		shared.Enabled = false
	end
end

function Flashlight.init()
	holder = Instance.new("Part")
	holder.Name = "AchromaFlashlight"
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Transparency = 1
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.CastShadow = false

	beam = Instance.new("SpotLight")
	beam.Face = Enum.NormalId.Front
	beam.Angle = 46
	beam.Range = 48
	beam.Brightness = BRIGHTNESS
	beam.Shadows = true
	beam.Color = Color3.fromRGB(255, 248, 235)
	beam.Enabled = false
	beam.Parent = holder

	spill = Instance.new("SpotLight")
	spill.Face = Enum.NormalId.Front
	spill.Angle = 110
	spill.Range = 16
	spill.Brightness = BRIGHTNESS * 0.22
	spill.Shadows = false
	spill.Enabled = false
	spill.Parent = holder

	ContextActionService:BindAction("AchromaFlashlight", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin and alive() and not ClientState.hiding then
			setOn(not on)
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("AchromaFlashlight", "LIGHT")

	Remotes.Battery.OnClientEvent:Connect(function(amount: number)
		battery = math.min(100, battery + amount)
		Audio.play("Battery", nil, 0.8)
		Hud.message("You found a battery.")
	end)

	player.CharacterAdded:Connect(function()
		battery = 100
		on = false
		ClientState.flashlightOn = false
		if not hinted then
			hinted = true
			task.delay(6, function()
				Hud.message("Press F to use your flashlight.  Shift to run, C to crouch.")
			end)
		end
	end)

	RunService:BindToRenderStep("AchromaFlashlight", Enum.RenderPriority.Camera.Value + 1, update)
end

return Flashlight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Hiding</string>
            <string name="Source"><![CDATA[--!strict
-- While you're inside a locker/wardrobe: darker vignette, a "leave" prompt, and
-- the E key / touch button to get back out.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Hiding = {}

local function refresh()
	local hiding = player:GetAttribute("Hiding") == true
	if hiding == ClientState.hiding then
		return
	end
	ClientState.hiding = hiding
	Hud.setHiding(hiding)
	if hiding then
		Hud.message("Hold your breath.")
		ContextActionService:BindAction("AchromaLeave", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
			if state == Enum.UserInputState.Begin then
				Remotes.LeaveHiding:FireServer()
			end
			return Enum.ContextActionResult.Sink
		end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
		ContextActionService:SetTitle("AchromaLeave", "LEAVE")
	else
		ContextActionService:UnbindAction("AchromaLeave")
	end
end

function Hiding.init()
	player:GetAttributeChangedSignal("Hiding"):Connect(refresh)
	refresh()
end

return Hiding
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!strict
-- On-screen everything: film grain, vignette, glitches, keys/code readout, stamina,
-- flashlight battery, typewriter messages, big titles, fades and flashes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local Nights = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Nights"))

local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Hud = {}

local TEXT = Color3.fromRGB(205, 205, 200)
local DIM = Color3.fromRGB(120, 120, 116)
local BLACK = Color3.new(0, 0, 0)
local FONT = Enum.Font.SpecialElite

local gui: ScreenGui
local info: Frame
local nightLabel: TextLabel
local objectiveLabel: TextLabel
local progressLabel: TextLabel
local blinkFrame: Frame
local staminaFrame: Frame
local staminaFill: Frame
local batteryFrame: Frame
local batterySegments: { Frame } = {}
local messages: Frame
local bigTitle: TextLabel
local bigSub: TextLabel
local fadeFrame: Frame
local flashFrame: Frame
local whiteFrame: Frame
local grain: Frame
local specks: { Frame } = {}
local vignette: { Frame } = {}
local glitchBars: { Frame } = {}
local hint: TextLabel
local crosshair: Frame

local fearLevel = 0
local glitchAmount = 0
local glitchUntil = 0
local pulse = 0
local staminaShownAt = 0
local hidingDark = false

local function new<T>(className: string, props: { [string]: any }, parent: Instance?): T
	local inst = Instance.new(className :: any)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return (inst :: any) :: T
end

local function label(props: { [string]: any }, parent: Instance): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = TEXT,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = BLACK,
		TextSize = 20,
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults, parent)
end

local function corner(parent: Instance, radius: number?)
	new("UICorner", { CornerRadius = UDim.new(radius or 0.5, 0) }, parent)
end

local function edgeShade(name: string, size: UDim2, position: UDim2, anchor: Vector2, rotation: number): Frame
	local f: Frame = new("Frame", {
		Name = name,
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		Size = size,
		Position = position,
		AnchorPoint = anchor,
		ZIndex = 2,
	}, gui)
	new("UIGradient", {
		Rotation = rotation,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.45, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, f)
	return f
end

function Hud.init()
	gui = new("ScreenGui", {
		Name = "AchromaHud",
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, player:WaitForChild("PlayerGui"))

	-- film grain + dust
	grain = new("Frame", { Name = "Grain", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.97, BorderSizePixel = 0, ZIndex = 1 }, gui)
	for _ = 1, 36 do
		table.insert(specks, new("Frame", { Size = UDim2.fromOffset(2, 2), BorderSizePixel = 0, ZIndex = 1, BackgroundTransparency = 1 }, gui))
	end

	-- vignette
	table.insert(vignette, edgeShade("Top", UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 0), Vector2.zero, 90))
	table.insert(vignette, edgeShade("Bottom", UDim2.fromScale(1, 0.38), UDim2.fromScale(0, 1), Vector2.new(0, 1), 270))
	table.insert(vignette, edgeShade("Left", UDim2.fromScale(0.3, 1), UDim2.fromScale(0, 0), Vector2.zero, 0))
	table.insert(vignette, edgeShade("Right", UDim2.fromScale(0.3, 1), UDim2.fromScale(1, 0), Vector2.new(1, 0), 180))

	for _ = 1, 8 do
		table.insert(glitchBars, new("Frame", { BorderSizePixel = 0, Visible = false, ZIndex = 4, BackgroundColor3 = Color3.new(1, 1, 1) }, gui))
	end

	crosshair = new("Frame", { Name = "Crosshair", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(4, 4), BackgroundColor3 = TEXT, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 5 }, gui)
	corner(crosshair)

	-- keys + code (bottom left)
	-- objective panel (top left): night, what to do, how far along you are
	info = new("Frame", { Name = "Info", BackgroundTransparency = 1, Position = UDim2.fromOffset(28, 22), Size = UDim2.fromOffset(460, 96), ZIndex = 5 }, gui)
	nightLabel = label({ Name = "Night", Text = "", Size = UDim2.fromOffset(460, 20), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 16, TextColor3 = DIM, ZIndex = 5 }, info)
	objectiveLabel = label({ Name = "Objective", Text = "", Position = UDim2.fromOffset(0, 22), Size = UDim2.fromOffset(460, 24), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 20, ZIndex = 5 }, info)
	progressLabel = label({ Name = "Progress", Text = "", Position = UDim2.fromOffset(0, 50), Size = UDim2.fromOffset(460, 34), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 28, ZIndex = 5 }, info)
	blinkFrame = new("Frame", { Name = "Blink", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 8 }, gui)

	-- stamina (bottom centre)
	staminaFrame = new("Frame", { Name = "Stamina", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -34), Size = UDim2.fromOffset(260, 4), BackgroundColor3 = Color3.fromRGB(40, 40, 40), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, gui)
	staminaFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = TEXT, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, staminaFrame)

	-- flashlight battery (bottom right)
	batteryFrame = new("Frame", { Name = "Battery", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -28, 1, -28), Size = UDim2.fromOffset(180, 30), BackgroundTransparency = 1, ZIndex = 5 }, gui)
	label({ Text = "LIGHT", Size = UDim2.fromOffset(64, 30), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = DIM, ZIndex = 5 }, batteryFrame)
	for i = 1, 5 do
		table.insert(batterySegments, new("Frame", { Position = UDim2.fromOffset(66 + (i - 1) * 21, 9), Size = UDim2.fromOffset(16, 12), BackgroundColor3 = TEXT, BorderSizePixel = 0, ZIndex = 5 }, batteryFrame))
	end

	hint = label({ Name = "Hint", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -60), Size = UDim2.fromOffset(500, 26), Text = "", TextColor3 = DIM, TextSize = 18, ZIndex = 6 }, gui)

	messages = new("Frame", { Name = "Messages", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.8), Size = UDim2.fromScale(0.62, 0.3), BackgroundTransparency = 1, ZIndex = 6 }, gui)
	new("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, messages)

	bigTitle = label({ Name = "BigTitle", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromScale(0.9, 0.2), Font = Enum.Font.Creepster, TextScaled = true, Text = "", TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 11 }, gui)
	bigSub = label({ Name = "BigSub", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.54), Size = UDim2.fromScale(0.8, 0.12), TextWrapped = true, TextSize = 24, Text = "", TextTransparency = 1, TextStrokeTransparency = 1, TextColor3 = DIM, ZIndex = 11 }, gui)

	fadeFrame = new("Frame", { Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9 }, gui)
	whiteFrame = new("Frame", { Name = "White", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10 }, gui)
	flashFrame = new("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10 }, gui)

	if RunService:IsStudio() and not Audio.isConfigured() then
		label({ Text = "Audio IDs not set: see README (ReplicatedStorage.Shared.SoundIds)", Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(520, 20), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 14, TextColor3 = Color3.fromRGB(150, 150, 150), ZIndex = 12 }, gui)
	end

	local function refreshObjective()
		local night = GameState:GetAttribute("Night")
		local name = GameState:GetAttribute("NightName")
		nightLabel.Text = string.format("NIGHT %s  ·  %s", tostring(night or 1), tostring(name or ""))
		nightLabel.TextColor3 = Nights.get(if typeof(night) == "number" then night else 1).accent
		local objective = GameState:GetAttribute("Objective")
		objectiveLabel.Text = if typeof(objective) == "string" then objective else ""
		local progress = GameState:GetAttribute("Progress")
		progressLabel.Text = if typeof(progress) == "string" then progress else ""
	end
	for _, attr in { "Night", "NightName", "Objective", "Progress" } do
		GameState:GetAttributeChangedSignal(attr):Connect(refreshObjective)
	end
	refreshObjective()
	GameState:GetAttributeChangedSignal("Progress"):Connect(function()
		-- a little flash whenever progress changes
		progressLabel.TextTransparency = 0.6
		TweenService:Create(progressLabel, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
	end)
	-- statue night: everyone blinks
	GameState:GetAttributeChangedSignal("Blink"):Connect(function()
		if GameState:GetAttribute("Blink") == true then
			blinkFrame.BackgroundTransparency = 0
		else
			TweenService:Create(blinkFrame, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
		end
	end)

	Hud.setHudVisible(false)
	RunService.RenderStepped:Connect(Hud._update)
end

function Hud._update(dt: number)
	local t = os.clock()

	-- grain flicker + dust
	grain.BackgroundTransparency = 0.955 + math.random() * 0.03 - fearLevel * 0.02
	for i, s in specks do
		if math.random() < 0.5 then
			s.Position = UDim2.fromScale(math.random(), math.random())
			s.BackgroundColor3 = if i % 3 == 0 then BLACK else Color3.new(1, 1, 1)
			s.BackgroundTransparency = 0.55 + math.random() * 0.4
			s.Size = UDim2.fromOffset(math.random(1, 3), math.random(1, 3))
		end
	end

	-- vignette tightens with fear and pulses with the heartbeat
	pulse = math.max(0, pulse - dt * 3)
	local base = 0.35 - fearLevel * 0.3 - pulse * 0.25 - (if hidingDark then 0.3 else 0)
	for _, v in vignette do
		v.BackgroundTransparency = math.clamp(base, 0, 1)
	end

	-- glitch bars
	local g = math.max(glitchAmount * (if t < glitchUntil then 1 else 0), fearLevel > 0.75 and (fearLevel - 0.75) * 1.6 or 0)
	for _, bar in glitchBars do
		if g > 0 and math.random() < g * 0.9 then
			bar.Visible = true
			bar.Position = UDim2.new(math.random() * 0.1 - 0.05, 0, math.random(), 0)
			bar.Size = UDim2.new(1.1, 0, 0, math.random(2, 4 + math.floor(g * 26)))
			bar.BackgroundColor3 = if math.random() < 0.5 then Color3.new(1, 1, 1) else BLACK
			bar.BackgroundTransparency = 0.35 + math.random() * 0.5
		else
			bar.Visible = false
		end
	end

	-- stamina fades away when full
	local showStamina = t - staminaShownAt < 1.2
	staminaFrame.BackgroundTransparency = if showStamina then 0.4 else 1
	staminaFill.BackgroundTransparency = if showStamina then 0.15 else 1
end

function Hud.setHudVisible(visible: boolean)
	info.Visible = visible
	batteryFrame.Visible = visible
	staminaFrame.Visible = visible
	crosshair.Visible = visible
end

function Hud.setStamina(fraction: number)
	staminaFill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	if fraction < 0.995 then
		staminaShownAt = os.clock()
	end
end

function Hud.setBattery(fraction: number)
	local lit = math.ceil(math.clamp(fraction, 0, 1) * #batterySegments - 0.001)
	for i, seg in batterySegments do
		seg.BackgroundTransparency = if i <= lit then (if fraction < 0.2 then 0.4 + math.random() * 0.3 else 0.15) else 0.85
	end
end

function Hud.setFear(f: number)
	fearLevel = f
end

function Hud.pulse(strength: number)
	pulse = math.max(pulse, strength)
end

function Hud.glitch(amount: number, duration: number)
	glitchAmount = amount
	glitchUntil = os.clock() + duration
end

function Hud.setHiding(on: boolean)
	hidingDark = on
	Hud.setHint(if on then "[E]  leave hiding spot" else "")
end

function Hud.setHint(text: string)
	hint.Text = text
end

function Hud.message(text: string, style: string?)
	local isNote = style == "note"
	local color = if style == "danger" then Color3.fromRGB(240, 240, 240) elseif style == "key" then Color3.fromRGB(225, 225, 215) else TEXT
	local line = label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		Text = text,
		TextSize = if style == "danger" then 26 elseif isNote then 22 else 21,
		TextColor3 = color,
		TextStrokeTransparency = 0.35,
		MaxVisibleGraphemes = 0,
		LayoutOrder = math.floor(os.clock() * 100),
		ZIndex = 6,
	}, messages)
	if isNote then
		line.BackgroundTransparency = 0.25
		line.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
		new("UIPadding", { PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 12), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, line)
	end
	local lifetime = (if isNote then 7 else 3.5) + #text * (if isNote then 0.045 else 0.03)
	task.spawn(function()
		local count = utf8.len(text) or #text
		for i = 1, count do
			if not line.Parent then
				return
			end
			line.MaxVisibleGraphemes = i
			if i % 2 == 0 then
				task.wait()
			end
		end
		line.MaxVisibleGraphemes = -1
		task.wait(lifetime)
		if line.Parent then
			local tween = TweenService:Create(line, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1, BackgroundTransparency = 1 })
			tween:Play()
			tween.Completed:Wait()
			line:Destroy()
		end
	end)
	if style == "danger" then
		Hud.glitch(0.6, 0.4)
	end
	-- keep at most 4 lines
	local lines = {}
	for _, c in messages:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(lines, c)
		end
	end
	table.sort(lines, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #lines - 4 do
		lines[i]:Destroy()
	end
end

function Hud.showBig(title: string, sub: string?, font: Enum.Font?)
	bigTitle.Text = title
	bigTitle.Font = font or Enum.Font.Creepster
	bigSub.Text = sub or ""
	TweenService:Create(bigTitle, TweenInfo.new(0.6), { TextTransparency = 0 }):Play()
	TweenService:Create(bigSub, TweenInfo.new(1.2), { TextTransparency = 0 }):Play()
end

function Hud.setBigColor(color: Color3)
	bigTitle.TextColor3 = color
	bigSub.TextColor3 = color
end

function Hud.hideBig(instant: boolean?)
	if instant then
		bigTitle.TextTransparency = 1
		bigSub.TextTransparency = 1
	else
		TweenService:Create(bigTitle, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
		TweenService:Create(bigSub, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
	end
end

-- 0 = fully black, 1 = clear
function Hud.fade(transparency: number, time: number)
	if time <= 0 then
		fadeFrame.BackgroundTransparency = transparency
	else
		TweenService:Create(fadeFrame, TweenInfo.new(time), { BackgroundTransparency = transparency }):Play()
	end
end

function Hud.whiteout(transparency: number, time: number)
	if time <= 0 then
		whiteFrame.BackgroundTransparency = transparency
	else
		TweenService:Create(whiteFrame, TweenInfo.new(time), { BackgroundTransparency = transparency }):Play()
	end
end

function Hud.flash(strength: number?, time: number?)
	flashFrame.BackgroundTransparency = 1 - (strength or 0.9)
	TweenService:Create(flashFrame, TweenInfo.new(time or 0.25), { BackgroundTransparency = 1 }):Play()
end

function Hud.gui(): ScreenGui
	return gui
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Keypad</string>
            <string name="Source"><![CDATA[--!strict
-- The exit keypad screen: type the four digits from the key tags and press OK.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local ClientState = require(script.Parent.ClientState)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Keypad = {}

local gui: ScreenGui
local display: TextLabel
local code = ""
local isOpen = false
local openedAt: Vector3? = nil

local DIGIT_KEYS: { [Enum.KeyCode]: string } = {
	[Enum.KeyCode.Zero] = "0",
	[Enum.KeyCode.One] = "1",
	[Enum.KeyCode.Two] = "2",
	[Enum.KeyCode.Three] = "3",
	[Enum.KeyCode.Four] = "4",
	[Enum.KeyCode.Five] = "5",
	[Enum.KeyCode.Six] = "6",
	[Enum.KeyCode.Seven] = "7",
	[Enum.KeyCode.Eight] = "8",
	[Enum.KeyCode.Nine] = "9",
	[Enum.KeyCode.KeypadZero] = "0",
	[Enum.KeyCode.KeypadOne] = "1",
	[Enum.KeyCode.KeypadTwo] = "2",
	[Enum.KeyCode.KeypadThree] = "3",
	[Enum.KeyCode.KeypadFour] = "4",
	[Enum.KeyCode.KeypadFive] = "5",
	[Enum.KeyCode.KeypadSix] = "6",
	[Enum.KeyCode.KeypadSeven] = "7",
	[Enum.KeyCode.KeypadEight] = "8",
	[Enum.KeyCode.KeypadNine] = "9",
}

local function refresh()
	local shown = {}
	for i = 1, 4 do
		shown[i] = if i <= #code then string.sub(code, i, i) else "_"
	end
	display.Text = table.concat(shown, " ")
end

local function close()
	isOpen = false
	gui.Enabled = false
	UserInputService.MouseIconEnabled = true
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = if character then character:FindFirstChild("HumanoidRootPart") :: BasePart? else nil
	return if root then root.Position else nil
end

local function open()
	code = ""
	refresh()
	isOpen = true
	openedAt = rootPosition()
	gui.Enabled = true
	UserInputService.MouseIconEnabled = true
end

local function press(key: string)
	if not isOpen then
		return
	end
	if key == "CLR" then
		code = ""
		Audio.play("KeypadBeep", nil, 0.5, 0.8)
	elseif key == "OK" then
		if #code == 4 then
			Audio.play("KeypadBeep", nil, 0.6, 1.2)
			Remotes.SubmitCode:FireServer(code)
			close()
			return
		end
		Audio.play("KeypadError", nil, 0.4)
	elseif #code < 4 then
		code ..= key
		Audio.play("KeypadBeep", nil, 0.55, 1 + #code * 0.04)
	end
	refresh()
end

function Keypad.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "AchromaKeypad"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 15
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Modal = true frees the mouse from first-person lock while this is open
	local panel = Instance.new("TextButton")
	panel.Name = "Panel"
	panel.Modal = true
	panel.AutoButtonColor = false
	panel.Text = ""
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(300, 430)
	panel.BackgroundColor3 = Color3.fromRGB(28, 28, 30)
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(90, 90, 90)
	stroke.Thickness = 2
	stroke.Parent = panel
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = panel

	display = Instance.new("TextLabel")
	display.Position = UDim2.fromOffset(20, 20)
	display.Size = UDim2.new(1, -40, 0, 64)
	display.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	display.BorderSizePixel = 0
	display.Font = Enum.Font.Code
	display.TextSize = 40
	display.TextColor3 = Color3.fromRGB(220, 220, 220)
	display.Parent = panel

	local keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "CLR", "0", "OK" }
	for i, key in keys do
		local col = (i - 1) % 3
		local row = math.floor((i - 1) / 3)
		local b = Instance.new("TextButton")
		b.Name = "Key" .. key
		b.Position = UDim2.fromOffset(20 + col * 90, 100 + row * 78)
		b.Size = UDim2.fromOffset(80, 68)
		b.BackgroundColor3 = Color3.fromRGB(52, 52, 54)
		b.AutoButtonColor = true
		b.BorderSizePixel = 0
		b.Font = Enum.Font.Code
		b.TextSize = if #key > 1 then 22 else 32
		b.TextColor3 = Color3.fromRGB(225, 225, 225)
		b.Text = key
		b.Parent = panel
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 4)
		bc.Parent = b
		b.Activated:Connect(function()
			press(key)
		end)
	end

	local closeButton = Instance.new("TextButton")
	closeButton.AnchorPoint = Vector2.new(1, 0)
	closeButton.Position = UDim2.new(1, -6, 0, -34)
	closeButton.Size = UDim2.fromOffset(110, 28)
	closeButton.BackgroundTransparency = 1
	closeButton.Font = Enum.Font.SpecialElite
	closeButton.TextSize = 18
	closeButton.TextColor3 = Color3.fromRGB(170, 170, 170)
	closeButton.Text = "[ESC] close"
	closeButton.Parent = panel
	closeButton.Activated:Connect(close)

	Remotes.OpenKeypad.OnClientEvent:Connect(open)

	UserInputService.InputBegan:Connect(function(input: InputObject, _processed: boolean)
		if not isOpen then
			return
		end
		local digit = DIGIT_KEYS[input.KeyCode]
		if digit then
			press(digit)
		elseif input.KeyCode == Enum.KeyCode.Backspace then
			code = string.sub(code, 1, math.max(0, #code - 1))
			refresh()
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			press("OK")
		elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			close()
		end
	end)

	-- close it if you get dragged away, die, or walk off
	RunService.Heartbeat:Connect(function()
		if not isOpen then
			return
		end
		local pos = rootPosition()
		if not pos or ClientState.jumpscaring or ClientState.hiding or (openedAt and (pos - openedAt).Magnitude > 10) then
			close()
		end
	end)
end

return Keypad
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- ACHROMA client entry point: hides Roblox's default UI and starts every controller.

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Atmosphere = require(script.Parent.Atmosphere)
local ClientState = require(script.Parent.ClientState)
local Endings = require(script.Parent.Endings)
local Flashlight = require(script.Parent.Flashlight)
local Hiding = require(script.Parent.Hiding)
local Hud = require(script.Parent.Hud)
local Keypad = require(script.Parent.Keypad)
local Menu = require(script.Parent.Menu)
local MonsterAnimator = require(script.Parent.MonsterAnimator)
local Movement = require(script.Parent.Movement)
local Spectate = require(script.Parent.Spectate)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

for _, coreGui in { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.PlayerList } do
	StarterGui:SetCoreGuiEnabled(coreGui, false)
end
task.spawn(function()
	-- resetting your character would be a free escape from the monster
	for _ = 1, 20 do
		if pcall(function()
			StarterGui:SetCore("ResetButtonCallback", false)
		end) then
			break
		end
		task.wait(0.5)
	end
end)

Hud.init()
Movement.init()
Flashlight.init()
Atmosphere.init()
MonsterAnimator.init()
Endings.init()
Hiding.init()
Keypad.init()
Spectate.init()
Menu.init()

Remotes.Notify.OnClientEvent:Connect(function(text: string, style: string?)
	Hud.message(text, style)
end)

local Nights = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Nights"))
local Audio = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Audio"))
local GameState = ReplicatedStorage:WaitForChild("GameState")

player.CharacterAdded:Connect(function(character: Model)
	ClientState.roundStatus = "alive"
	ClientState.jumpscaring = false
	local camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	camera.CameraSubject = humanoid
	Hud.setHudVisible(true)
	Hud.whiteout(1, 0)
	Hud.fade(0, 0)
	Hud.fade(1, 3)
	Atmosphere.wakeUp()

	-- the night's title card, then its opening lines
	local n = GameState:GetAttribute("Night")
	local night = Nights.get(if typeof(n) == "number" then n else 1)
	Audio.play("NightIntro", nil, 1)
	Hud.setBigColor(night.accent)
	Hud.showBig(string.format("NIGHT %d", night.index), night.name .. "\n" .. night.objectiveText)
	task.delay(4.2, function()
		Hud.hideBig()
		task.delay(0.9, function()
			Hud.setBigColor(Color3.fromRGB(205, 205, 200))
		end)
		for i, line in night.intro do
			task.delay((i - 1) * 2.5, function()
				if ClientState.roundStatus == "alive" then
					Hud.message(line)
				end
			end)
		end
	end)
end)

player.CharacterRemoving:Connect(function()
	Hud.setHudVisible(false)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Menu</string>
            <string name="Source"><![CDATA[--!strict
-- The main menu (all five nights, each with a live preview of its monster), the
-- countdown before a night, and the results screen after one.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Monsters = require(Shared:WaitForChild("Monsters"))
local Nights = require(Shared:WaitForChild("Nights"))
local ClientState = require(script.Parent.ClientState)
local Endings = require(script.Parent.Endings)
local Spectate = require(script.Parent.Spectate)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Menu = {}

local TEXT = Color3.fromRGB(215, 215, 210)
local DIM = Color3.fromRGB(125, 125, 120)
local FAINT = Color3.fromRGB(70, 70, 68)
local BLACK = Color3.new(0, 0, 0)
local FONT = Enum.Font.SpecialElite

local OBJECTIVE_TAGS: { [string]: string } = {
	survive = "SURVIVE TILL 6 AM",
	keys = "4 KEYS + CODE",
	power = "3 GENERATORS",
	collect = "6 PHOTOGRAPHS",
	hearts = "3 HEARTS",
}

local GENERAL_TIPS = {
	"It hears running. It barely hears walking. It can't hear you crouch.",
	"Your flashlight lets you see. Usually it also lets IT see you.",
	"If it watched you climb into a locker, the locker won't save you.",
	"Loops in the maze can save your life. Dead ends won't.",
	"When the lights start flickering, it's close.",
}

local gui: ScreenGui
local main: Frame
local overlay: Frame
local overlayTitle: TextLabel
local overlaySub: TextLabel
local howTo: Frame
local settings: Frame
local banner: TextLabel
local viewport: ViewportFrame
local viewCamera: Camera
local details: { [string]: TextLabel } = {}
local playButton: TextButton
local playStroke: UIStroke
local cards: { { button: TextButton, stroke: UIStroke, status: TextLabel, shade: Frame } } = {}
local previews: { [string]: Monsters.Rig } = {}
local shown: Monsters.Rig? = nil
local selected = 1
local music: Sound? = nil
local lastResult: { result: string, survivors: { string }, seconds: number, night: number }? = nil
local highestAtStart = 1
local brightness = 0
local volume = 1
local settingsLabels: { [string]: TextLabel } = {}

local function make<T>(className: string, props: { [string]: any }, parent: Instance?): T
	local inst = Instance.new(className :: any)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return (inst :: any) :: T
end

local function text(parent: Instance, props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = TEXT,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
	}
	for k, v in props do
		defaults[k] = v
	end
	return make("TextLabel", defaults, parent)
end

local function button(parent: Instance, label: string, props: { [string]: any }): (TextButton, UIStroke)
	local defaults: { [string]: any } = {
		BackgroundColor3 = Color3.fromRGB(16, 16, 16),
		AutoButtonColor = true,
		Font = FONT,
		TextColor3 = TEXT,
		TextSize = 24,
		Text = label,
	}
	for k, v in props do
		defaults[k] = v
	end
	local b: TextButton = make("TextButton", defaults, parent)
	local stroke: UIStroke = make("UIStroke", { Color = TEXT, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.3 }, b)
	b.MouseEnter:Connect(function()
		Audio.play("MenuHover", nil, 0.4)
	end)
	return b, stroke
end

local function highest(): number
	local value = player:GetAttribute("HighestNight")
	return if typeof(value) == "number" then value else 1
end

local function unlocked(n: number): boolean
	return n <= highest()
end

local function cleared(n: number): boolean
	return n < highest()
end

local function fullscreen(name: string, parent: Instance): Frame
	return make("Frame", { Name = name, Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0 }, parent)
end

-- Monster preview ---------------------------------------------------------------

local function previewFor(night: Nights.Night): Monsters.Rig
	local rig = previews[night.monsterKind]
	if rig then
		return rig
	end
	local built = Monsters.build(night.monsterKind, { preview = true })
	if night.monsterKind == "Statue" then
		Monsters.applyStatuePose(built, 1, nil)
		Monsters.solve(built)
	end
	previews[night.monsterKind] = built
	return built
end

local function showPreview(night: Nights.Night)
	if shown then
		shown.model.Parent = nil
	end
	local rig = previewFor(night)
	rig.model.Parent = viewport
	shown = rig
	viewport.LightColor = night.accent
	viewport.Ambient = night.accent:Lerp(BLACK, 0.75)
	local height = rig.rootHeight * 2.1
	viewCamera.CFrame = CFrame.lookAt(Vector3.new(0, height * 0.55, height * 1.25), Vector3.new(0, height * 0.45, 0))
end

-- Selecting a night -------------------------------------------------------------

local function select(n: number)
	selected = n
	local night = Nights.get(n)
	local open = unlocked(n)
	details.Number.Text = string.format("NIGHT %d   ·   %s", n, string.upper(night.vibe))
	details.Number.TextColor3 = night.accent
	details.Name.Text = night.name
	details.Place.Text = night.place
	details.Objective.Text = "OBJECTIVE    " .. night.objectiveText
	details.Monster.Text = night.monsterName .. "\n" .. night.monsterBlurb
	details.Tips.Text = "· " .. table.concat(night.tips, "\n· ")
	if open then
		playButton.Text = if cleared(n) then string.format("PLAY NIGHT %d AGAIN", n) else string.format("PLAY NIGHT %d", n)
		playButton.TextColor3 = TEXT
		playStroke.Color = night.accent
	else
		playButton.Text = string.format("LOCKED: BEAT NIGHT %d FIRST", n - 1)
		playButton.TextColor3 = DIM
		playStroke.Color = FAINT
	end
	for i, card in cards do
		card.stroke.Color = if i == n then Nights.get(i).accent else FAINT
		card.stroke.Thickness = if i == n then 3 else 1
	end
	showPreview(night)
end

local function refreshCards()
	for i, card in cards do
		local isOpen = unlocked(i)
		card.shade.Visible = not isOpen
		card.status.Text = if cleared(i) then "CLEARED" elseif isOpen then "" else "LOCKED"
		card.status.TextColor3 = if cleared(i) then Nights.get(i).accent else DIM
	end
	select(selected)
end

-- Screen state ------------------------------------------------------------------

local function formatTime(seconds: number): string
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function refresh()
	local phase = GameState:GetAttribute("Phase")
	local hasCharacter = player.Character ~= nil
	local heading: string? = nil
	local sub = ""

	if not ClientState.started then
		main.Visible = true
		overlay.Visible = false
		if phase == "Playing" or phase == "Intermission" then
			banner.Text = string.format("NIGHT %s  ·  %s  IS UNDERWAY. PRESS PLAY TO JOIN.", tostring(GameState:GetAttribute("Night") or ""), tostring(GameState:GetAttribute("NightName") or ""))
		else
			banner.Text = ""
		end
	else
		main.Visible = false
		if ClientState.jumpscaring then
			heading = nil
		elseif phase == "Results" and lastResult then
			local r = lastResult
			local night = Nights.get(r.night)
			if ClientState.roundStatus == "escaped" then
				heading = if night.objective == "survive" then "YOU SURVIVED" elseif night.index == Nights.count then "THE COLOR IS BACK" else "YOU MADE IT"
			elseif r.result == "Escaped" then
				heading = "THEY MADE IT"
			else
				heading = "NOBODY MADE IT"
			end
			sub = night.name .. "   ·   " .. formatTime(r.seconds)
			if #r.survivors > 0 then
				sub ..= "\nSurvivors: " .. table.concat(r.survivors, ", ")
			end
			if highest() > highestAtStart and highest() <= Nights.count then
				sub ..= string.format("\n\nNIGHT %d UNLOCKED: %s", highest(), Nights.get(highest()).name)
			elseif r.result == "Escaped" and night.index == Nights.count then
				sub ..= "\n\nYou beat every night. Thank you for playing ACHROMA."
			end
		elseif phase == "Intermission" and not hasCharacter then
			local n = GameState:GetAttribute("Night")
			local night = Nights.get(if typeof(n) == "number" then n else selected)
			heading = string.format("NIGHT %d", night.index)
			local countdown = GameState:GetAttribute("Countdown")
			sub = night.name .. "\n" .. night.objectiveText
			if typeof(countdown) == "number" then
				sub ..= string.format("\n\nbegins in %d", countdown)
			end
			local readyCount = GameState:GetAttribute("ReadyCount")
			if typeof(readyCount) == "number" and readyCount > 1 then
				sub ..= string.format("   ·   %d players", readyCount)
			end
		elseif (phase == "Lobby" or phase == "Playing") and not hasCharacter and not Spectate.isActive() then
			heading = "..."
			sub = if phase == "Playing" then "Waiting for the others to make it out. Or not." else "Waiting..."
		end
		overlay.Visible = heading ~= nil
		if heading then
			overlayTitle.Text = heading
			overlaySub.Text = sub
		end
	end

	if music then
		local wanted = if main.Visible or overlay.Visible then 0.4 else 0
		TweenService:Create(music, TweenInfo.new(1.5), { Volume = wanted }):Play()
	end
end

local function play()
	if not unlocked(selected) then
		Audio.play("KeypadError", nil, 0.5)
		return
	end
	Audio.play("MenuSelect", nil, 0.8)
	ClientState.started = true
	highestAtStart = highest()
	Remotes.Ready:FireServer(selected)
	refresh()
end

-- Settings ----------------------------------------------------------------------

local function applySettings()
	ClientState.brightness = brightness
	local group = SoundService:FindFirstChild("AchromaMaster")
	if group and group:IsA("SoundGroup") then
		group.Volume = volume
	end
	settingsLabels.Brightness.Text = string.format("%+d", math.floor(brightness * 100 + 0.5))
	settingsLabels.Volume.Text = string.format("%d%%", math.floor(volume * 100 + 0.5))
end

local function settingRow(parent: Instance, y: number, name: string, onChange: (number) -> ())
	text(parent, { Text = string.upper(name), Position = UDim2.new(0, 30, 0, y), Size = UDim2.new(0, 200, 0, 34), TextSize = 24, TextYAlignment = Enum.TextYAlignment.Center })
	local minus = button(parent, "-", { Position = UDim2.new(0, 250, 0, y), Size = UDim2.fromOffset(44, 34) })
	settingsLabels[name] = text(parent, { Position = UDim2.new(0, 300, 0, y), Size = UDim2.fromOffset(90, 34), TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
	local plus = button(parent, "+", { Position = UDim2.new(0, 396, 0, y), Size = UDim2.fromOffset(44, 34) })
	minus.Activated:Connect(function()
		onChange(-1)
		applySettings()
	end)
	plus.Activated:Connect(function()
		onChange(1)
		applySettings()
	end)
end

-- Build -------------------------------------------------------------------------

function Menu.init()
	gui = make("ScreenGui", { Name = "AchromaMenu", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 20, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

	main = fullscreen("Main", gui)
	-- keeps the mouse free while the menu is up
	make("TextButton", { Name = "MouseCatcher", Modal = true, Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 0 }, main)

	viewport = make("ViewportFrame", { Name = "Preview", Position = UDim2.fromScale(0.42, 0), Size = UDim2.fromScale(0.58, 0.72), BackgroundTransparency = 1, LightDirection = Vector3.new(-0.6, -1, -0.4) }, main)
	viewCamera = make("Camera", { FieldOfView = 40 }, viewport)
	viewport.CurrentCamera = viewCamera
	local fadeIn: Frame = make("Frame", { Position = UDim2.fromScale(0.42, 0), Size = UDim2.fromScale(0.25, 0.72), BackgroundColor3 = BLACK, BorderSizePixel = 0 }, main)
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, fadeIn)

	text(main, { Name = "Logo", Text = "ACHROMA", Font = Enum.Font.Creepster, TextScaled = true, Position = UDim2.fromScale(0.05, 0.04), Size = UDim2.fromScale(0.42, 0.13) })
	text(main, { Text = "five nights. five monsters. no color.", TextColor3 = DIM, Position = UDim2.fromScale(0.05, 0.165), Size = UDim2.fromScale(0.42, 0.04), TextSize = 20 })

	local panel: Frame = make("Frame", { Name = "Details", BackgroundTransparency = 1, Position = UDim2.fromScale(0.05, 0.23), Size = UDim2.fromScale(0.4, 0.46) }, main)
	details.Number = text(panel, { Text = "", TextSize = 20, Size = UDim2.new(1, 0, 0, 24) })
	details.Name = text(panel, { Text = "", Font = Enum.Font.Creepster, TextSize = 54, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 58) })
	details.Place = text(panel, { Text = "", TextColor3 = DIM, TextSize = 18, Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 0, 22) })
	details.Objective = text(panel, { Text = "", TextSize = 21, Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 0, 26) })
	details.Monster = text(panel, { Text = "", TextColor3 = DIM, TextSize = 18, Position = UDim2.fromOffset(0, 152), Size = UDim2.new(1, 0, 0, 64) })
	details.Tips = text(panel, { Text = "", TextColor3 = FAINT:Lerp(TEXT, 0.4), TextSize = 16, Position = UDim2.fromOffset(0, 222), Size = UDim2.new(1, 0, 0, 72) })
	playButton, playStroke = button(panel, "PLAY", { Name = "Play", Position = UDim2.new(0, 0, 1, -54), Size = UDim2.new(0.75, 0, 0, 54), TextSize = 28 })
	playButton.Activated:Connect(play)

	-- the five nights
	local row: Frame = make("Frame", { Name = "Nights", BackgroundTransparency = 1, Position = UDim2.fromScale(0.05, 0.74), Size = UDim2.fromScale(0.9, 0.21) }, main)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0.012, 0), SortOrder = Enum.SortOrder.LayoutOrder }, row)
	for _, night in Nights.list do
		local card: TextButton = make("TextButton", { Name = "Night" .. night.index, LayoutOrder = night.index, Text = "", AutoButtonColor = true, BackgroundColor3 = Color3.fromRGB(14, 14, 14), Size = UDim2.fromScale(0.19, 1) }, row)
		local stroke: UIStroke = make("UIStroke", { Color = FAINT, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, card)
		make("Frame", { Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = night.accent, BorderSizePixel = 0 }, card)
		text(card, { Text = "NIGHT " .. night.index, TextColor3 = night.accent, TextSize = 16, Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 20) })
		text(card, { Text = night.name, Font = Enum.Font.Creepster, TextScaled = true, Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0.32, 0) })
		text(card, { Text = string.upper(night.vibe), TextColor3 = DIM, TextSize = 15, Position = UDim2.new(0, 12, 0.6, 0), Size = UDim2.new(1, -24, 0, 18) })
		text(card, { Text = OBJECTIVE_TAGS[night.objective] or "", TextSize = 15, Position = UDim2.new(0, 12, 0.6, 20), Size = UDim2.new(1, -24, 0, 18) })
		local shade: Frame = make("Frame", { Name = "Locked", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 3 }, card)
		local status = text(card, { Name = "Status", Text = "", TextSize = 16, Position = UDim2.new(0, 12, 1, -26), Size = UDim2.new(1, -24, 0, 20), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4 })
		card.MouseEnter:Connect(function()
			Audio.play("MenuHover", nil, 0.4)
		end)
		card.Activated:Connect(function()
			Audio.play("MenuHover", nil, 0.7, 0.8)
			select(night.index)
		end)
		table.insert(cards, { button = card, stroke = stroke, status = status, shade = shade })
	end

	local helpButton = button(main, "HOW TO PLAY", { Position = UDim2.new(1, -460, 0, 30), Size = UDim2.fromOffset(200, 40), TextSize = 20 })
	local settingsButton = button(main, "SETTINGS", { Position = UDim2.new(1, -240, 0, 30), Size = UDim2.fromOffset(200, 40), TextSize = 20 })
	banner = text(main, { Text = "", TextSize = 18, TextColor3 = TEXT, Position = UDim2.new(0.05, 0, 0.7, 0), Size = UDim2.new(0.9, 0, 0, 24), TextXAlignment = Enum.TextXAlignment.Center })

	-- How to play
	howTo = make("Frame", { Name = "HowTo", Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(720, 520), BackgroundColor3 = Color3.fromRGB(10, 10, 10), ZIndex = 10 }, gui)
	make("UIStroke", { Color = DIM, Thickness = 1.5 }, howTo)
	text(howTo, { Text = "HOW TO PLAY", Font = Enum.Font.Creepster, TextSize = 46, Position = UDim2.fromOffset(30, 20), Size = UDim2.new(1, -60, 0, 50), ZIndex = 11 })
	text(howTo, {
		ZIndex = 11,
		TextSize = 19,
		Position = UDim2.fromOffset(30, 84),
		Size = UDim2.new(1, -60, 1, -150),
		Text = "Every night has its own place, its own monster and its own way out. Beat a night to unlock the next.\n\n"
			.. "WASD  move         SHIFT  run         C  crouch (silent)\n"
			.. "F  flashlight        E  interact / hide / leave a hiding spot\n\n"
			.. "· " .. table.concat(GENERAL_TIPS, "\n· "),
	})
	local closeHelp = button(howTo, "CLOSE", { Position = UDim2.new(1, -170, 1, -60), Size = UDim2.fromOffset(140, 40), ZIndex = 11 })
	closeHelp.Activated:Connect(function()
		howTo.Visible = false
	end)
	helpButton.Activated:Connect(function()
		settings.Visible = false
		howTo.Visible = not howTo.Visible
	end)

	-- Settings
	settings = make("Frame", { Name = "Settings", Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(480, 260), BackgroundColor3 = Color3.fromRGB(10, 10, 10), ZIndex = 10 }, gui)
	make("UIStroke", { Color = DIM, Thickness = 1.5 }, settings)
	text(settings, { Text = "SETTINGS", Font = Enum.Font.Creepster, TextSize = 44, Position = UDim2.fromOffset(30, 16), Size = UDim2.new(1, -60, 0, 50), ZIndex = 11 })
	settingRow(settings, 90, "Brightness", function(step: number)
		brightness = math.clamp(brightness + step * 0.03, -0.09, 0.21)
	end)
	settingRow(settings, 140, "Volume", function(step: number)
		volume = math.clamp(volume + step * 0.1, 0, 1.5)
	end)
	for _, d in settings:GetDescendants() do
		if d:IsA("GuiObject") then
			d.ZIndex = 11
		end
	end
	local closeSettings = button(settings, "CLOSE", { Position = UDim2.new(1, -170, 1, -56), Size = UDim2.fromOffset(140, 40), ZIndex = 11 })
	closeSettings.Activated:Connect(function()
		settings.Visible = false
	end)
	settingsButton.Activated:Connect(function()
		howTo.Visible = false
		settings.Visible = not settings.Visible
	end)
	applySettings()

	-- Countdown / results overlay
	overlay = fullscreen("Overlay", gui)
	overlay.Visible = false
	overlayTitle = text(overlay, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromScale(0.85, 0.16), Font = Enum.Font.Creepster, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
	overlaySub = text(overlay, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.47), Size = UDim2.fromScale(0.75, 0.4), TextColor3 = DIM, TextSize = 24, TextXAlignment = Enum.TextXAlignment.Center })

	music = Audio.track("MusicBox", nil, 0.4)
	if music then
		music:Play()
	end

	selected = math.min(highest(), Nights.count)
	refreshCards()

	player:GetAttributeChangedSignal("HighestNight"):Connect(function()
		if not ClientState.started then
			selected = math.min(highest(), Nights.count)
		end
		refreshCards()
		refresh()
	end)
	GameState:GetAttributeChangedSignal("Phase"):Connect(function()
		local phase = GameState:GetAttribute("Phase")
		if phase == "Lobby" and ClientState.started and player.Character == nil then
			-- back to the menu, with the next night ready to go
			ClientState.started = false
			ClientState.roundStatus = "none"
			selected = math.min(highest(), Nights.count)
			refreshCards()
		end
		refresh()
	end)
	for _, attr in { "Countdown", "Night", "NightName", "ReadyCount" } do
		GameState:GetAttributeChangedSignal(attr):Connect(refresh)
	end
	Remotes.RoundResult.OnClientEvent:Connect(function(result: string, survivors: { string }, seconds: number, night: number)
		lastResult = { result = result, survivors = survivors, seconds = seconds, night = night }
		refresh()
	end)
	player.CharacterAdded:Connect(refresh)
	player.CharacterRemoving:Connect(function()
		task.defer(refresh)
	end)
	Endings.Changed:Connect(refresh)

	-- the logo flickers like a dying bulb; the preview monster slowly turns
	local accum = 0
	RunService.RenderStepped:Connect(function(dt: number)
		if main.Visible then
			local logo = main:FindFirstChild("Logo")
			if logo and logo:IsA("TextLabel") then
				logo.TextTransparency = if math.random() < 0.04 then 0.2 + math.random() * 0.6 else 0
			end
			local rig = shown
			if rig then
				rig.model:PivotTo(CFrame.Angles(0, os.clock() * 0.35, 0) * CFrame.new(0, rig.rootHeight, 0))
			end
			viewport.ImageTransparency = if math.random() < 0.03 then 0.5 else 0
		end
		accum += dt
		if accum > 0.5 then
			accum = 0
			if ClientState.started and player.Character == nil then
				refresh()
			end
		end
	end)
	refresh()
end

return Menu
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">MonsterAnimator</string>
            <string name="Source"><![CDATA[--!strict
-- Procedural animation for every monster, run locally on each client. Nothing
-- here walks smoothly: heads snap to new angles, jaws hang, limbs twitch.
--   Hollow    lurching gait, arms drag (or reach for you), unhinged jaw
--   Crawler   eight legs skittering, upside-down face snapping around
--   Listener  head sways side to side listening; the mouth splits when it charges
--   Statue    no animation at all: a new pose every time it moves while unseen
--   Amalgam   four legs, front arms reaching, back arms writhing, three heads

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Monsters = require(Shared:WaitForChild("Monsters"))

local MonsterAnimator = {}

type Joint = { motor: Motor6D, base: CFrame }
type Rig = {
	model: Model,
	root: BasePart,
	kind: string,
	joints: { [string]: Joint },
	gait: number,
	twitchAt: { [string]: number },
	headTarget: { [string]: CFrame },
	headCurrent: { [string]: CFrame },
	nextClick: number,
	lastStepSign: number,
	pose: number,
	eyeGlow: PointLight?,
}

local current: Rig? = nil

local function collect(model: Model): Rig?
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return nil
	end
	local joints: { [string]: Joint } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and not joints[d.Name] then
			joints[d.Name] = { motor = d, base = d.C0 }
		end
	end
	if not joints.Neck then
		return nil -- still replicating
	end
	local glow = model:FindFirstChild("EyeGlow", true)
	local kind = model:GetAttribute("Kind")
	return {
		model = model,
		root = root,
		kind = if typeof(kind) == "string" then kind else "Hollow",
		joints = joints,
		gait = 0,
		twitchAt = {},
		headTarget = {},
		headCurrent = {},
		nextClick = os.clock() + 3,
		lastStepSign = 1,
		pose = 0,
		eyeGlow = if glow and glow:IsA("PointLight") then glow else nil,
	}
end

local function set(rig: Rig, name: string, offset: CFrame)
	local j = rig.joints[name]
	if j then
		j.motor.C0 = j.base * offset
	end
end

local function rnd(scale: number): number
	return (math.random() - 0.5) * scale
end

-- A head that holds still, then snaps to a new angle.
local function twitchHead(rig: Rig, name: string, dt: number, interval: number, yaw: number, pitch: number, roll: number, snap: number, extra: CFrame?)
	local t = os.clock()
	if t >= (rig.twitchAt[name] or 0) then
		rig.twitchAt[name] = t + interval * (0.3 + math.random())
		rig.headTarget[name] = CFrame.Angles(rnd(pitch), rnd(yaw), rnd(roll))
	end
	local target = rig.headTarget[name] or CFrame.new()
	if extra then
		target = extra * target:Lerp(CFrame.new(), 0.6)
	end
	local cur = rig.headCurrent[name] or CFrame.new()
	cur = cur:Lerp(target, math.min(1, dt * snap))
	rig.headCurrent[name] = cur
	set(rig, name, cur * CFrame.Angles(rnd(0.04), rnd(0.04), rnd(0.04)))
end

local function footstep(rig: Rig, s: number, speed: number, volume: number, pitch: number)
	local sign = if s >= 0 then 1 else -1
	if sign ~= rig.lastStepSign and speed > 2 then
		Audio.playAt("MonsterStep", rig.root.Position - Vector3.new(0, 4, 0), math.clamp(speed / 11, 0.4, 1.5) * volume, pitch + math.random() * 0.2, 110)
	end
	rig.lastStepSign = sign
end

local function animateHollow(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local staring = state == "Apparition"
	local stride = math.clamp(speed / 14, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)

	twitchHead(rig, "Neck", dt, if chase then 0.25 elseif staring then 2.5 else 1.1, 1.0, 0.7, if staring then 0.4 else 1.4, if chase then 32 else 18, if staring then CFrame.Angles(0.15, 0, 1.1) else nil)
	local jawOpen = if kill then 1.1 + math.random() * 0.2 elseif chase then 0.55 + math.abs(math.sin(t * 14)) * 0.35 elseif staring then 0.7 else 0.12 + (math.sin(t * 1.7) + 1) * 0.08
	set(rig, "Jaw", CFrame.Angles(-jawOpen, 0, 0))
	local lean = if chase then -0.28 elseif kill then -0.2 else 0
	set(rig, "Spine", CFrame.Angles(lean + math.abs(s1) * 0.06 * stride + math.sin(t * 0.8) * 0.03, s1 * 0.08 * stride, math.sin(t * 0.9) * 0.05))
	set(rig, "Waist", CFrame.new(0, math.abs(math.cos(g)) * 0.25 * stride, 0) * CFrame.Angles(0, -s1 * 0.12 * stride, 0))
	set(rig, "LHip", CFrame.Angles(s1 * 0.75 * stride, 0, 0))
	set(rig, "RHip", CFrame.Angles(s2 * 0.75 * stride, 0, 0))
	set(rig, "LKnee", CFrame.Angles(-math.max(0, math.cos(g)) * 0.9 * stride, 0, 0))
	set(rig, "RKnee", CFrame.Angles(-math.max(0, math.cos(g + math.pi)) * 0.9 * stride, 0, 0))
	set(rig, "LAnkle", CFrame.Angles(s1 * 0.3 * stride, 0, 0))
	set(rig, "RAnkle", CFrame.Angles(s2 * 0.3 * stride, 0, 0))
	local reach = if chase or kill then 1.3 else 0
	set(rig, "LShoulder", CFrame.Angles(reach + s2 * 0.4 * stride + math.sin(t * 1.3) * 0.06 + (if math.random() < 0.02 then rnd(0.6) else 0), 0, -0.12 * reach))
	set(rig, "RShoulder", CFrame.Angles(reach + s1 * 0.4 * stride + math.sin(t * 1.1 + 1) * 0.06 + (if math.random() < 0.02 then rnd(0.6) else 0), 0, 0.12 * reach))
	set(rig, "LElbow", CFrame.Angles(-0.15 - reach * 0.25 + math.sin(t * 2.1) * 0.05, 0, 0))
	set(rig, "RElbow", CFrame.Angles(-0.15 - reach * 0.25 + math.sin(t * 2.3 + 2) * 0.05, 0, 0))
	for i = 1, 4 do
		local curl = (math.sin(t * 6 + i * 1.3) + 1) * 0.15 + (if chase or kill then 0.45 else 0) + rnd(0.05)
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
	end
	footstep(rig, s1, speed, 1, 0.85)
end

local function animateCrawler(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local stride = math.clamp(speed / 12, 0, 1.4)
	local g = rig.gait * 1.6
	twitchHead(rig, "Neck", dt, if chase then 0.15 else 0.7, 1.2, 0.6, 1.6, 40, nil)
	set(rig, "Jaw", CFrame.Angles(if kill then 1.0 elseif chase then 0.5 + math.abs(math.sin(t * 18)) * 0.4 else 0.15 + math.abs(math.sin(t * 2)) * 0.1, 0, 0))
	set(rig, "Waist", CFrame.new(0, math.abs(math.sin(g * 2)) * 0.15 * stride, 0) * CFrame.Angles(rnd(0.03), math.sin(g) * 0.06 * stride, rnd(0.03)))
	set(rig, "Tail", CFrame.Angles(math.sin(t * 2.4) * 0.15, math.sin(t * 1.7) * 0.3, 0))
	-- tetrapod gait: L1 R2 L3 R4 together, the others opposite
	for i = 1, 4 do
		for _, side in { -1, 1 } do
			local name = (if side < 0 then "L" else "R") .. i
			local phase = if (i % 2 == 1) == (side < 0) then 0 else math.pi
			local s = math.sin(g + phase)
			local lift = math.max(0, math.cos(g + phase))
			set(rig, name .. "Hip", CFrame.Angles(0, s * 0.45 * stride, 0) * CFrame.Angles(0, 0, -side * lift * 0.35 * stride + rnd(0.04)))
			set(rig, name .. "Knee", CFrame.Angles(0, 0, side * lift * 0.25 * stride))
		end
	end
	if math.sin(g) * rig.lastStepSign < 0 and speed > 2 then
		Audio.playAt("MonsterClicks", rig.root.Position, 0.6, 1.4 + math.random() * 0.3, 70)
	end
	rig.lastStepSign = if math.sin(g) >= 0 then 1 else -1
end

local function animateListener(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local hunting = state == "Chase" or state == "HuntLocker" or state == "Investigate"
	local kill = state == "Kill"
	local stride = math.clamp(speed / 12, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)
	-- listening: the head sways slowly side to side, then freezes and points when it hears
	local listen = if hunting then CFrame.Angles(0.2, 0, 0) else CFrame.Angles(math.sin(t * 0.7) * 0.15, math.sin(t * 0.45) * 0.5, math.sin(t * 0.6) * 0.5)
	twitchHead(rig, "Neck", dt, if hunting then 0.4 else 2.2, 0.5, 0.3, 0.6, if hunting then 25 else 6, listen)
	set(rig, "NeckA", CFrame.Angles(math.sin(t * 0.5) * 0.08, math.sin(t * 0.4) * 0.15, 0))
	set(rig, "NeckB", CFrame.Angles(math.sin(t * 0.6 + 1) * 0.08, math.sin(t * 0.5 + 1) * 0.15, 0))
	local open = if kill then 0.9 elseif hunting then 0.35 + math.abs(math.sin(t * 9)) * 0.3 else 0.05 + math.abs(math.sin(t * 1.3)) * 0.05
	set(rig, "JawL", CFrame.Angles(0, -open, 0))
	set(rig, "JawR", CFrame.Angles(0, open, 0))
	set(rig, "EarL", CFrame.Angles(0, 0, math.sin(t * 5) * 0.15 + (if math.random() < 0.03 then rnd(0.6) else 0)))
	set(rig, "EarR", CFrame.Angles(0, 0, math.sin(t * 5.3) * 0.15 + (if math.random() < 0.03 then rnd(0.6) else 0)))
	set(rig, "Spine", CFrame.Angles((if hunting then -0.2 else 0) + math.sin(t * 0.8) * 0.04, s1 * 0.06 * stride, 0))
	set(rig, "LHip", CFrame.Angles(s1 * 0.6 * stride, 0, 0))
	set(rig, "RHip", CFrame.Angles(s2 * 0.6 * stride, 0, 0))
	set(rig, "LKnee", CFrame.Angles(-math.max(0, math.cos(g)) * 0.8 * stride, 0, 0))
	set(rig, "RKnee", CFrame.Angles(-math.max(0, math.cos(g + math.pi)) * 0.8 * stride, 0, 0))
	local reach = if hunting or kill then -0.6 else 0
	set(rig, "LShoulder", CFrame.Angles(reach + math.sin(t * 1.1) * 0.08, 0, 0))
	set(rig, "RShoulder", CFrame.Angles(reach + math.sin(t * 1.2 + 2) * 0.08, 0, 0))
	for i = 1, 3 do
		local curl = (math.sin(t * 4 + i) + 1) * 0.2
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
	end
	footstep(rig, s1, speed, 0.7, 1)
end

local function animateStatue(rig: Rig)
	local pose = rig.model:GetAttribute("Pose")
	local index = if typeof(pose) == "number" then pose else 1
	if index ~= rig.pose then
		rig.pose = index
		local offsets = Monsters.STATUE_POSES[(index - 1) % #Monsters.STATUE_POSES + 1]
		for name, j in rig.joints do
			local offset = offsets[name]
			j.motor.C0 = if offset then j.base * offset else j.base
		end
	end
end

local function animateAmalgam(rig: Rig, dt: number, speed: number, state: string)
	local t = os.clock()
	local chase = state == "Chase" or state == "HuntLocker"
	local kill = state == "Kill"
	local stride = math.clamp(speed / 14, 0, 1.2)
	local g = rig.gait
	local s1, s2 = math.sin(g), math.sin(g + math.pi)
	twitchHead(rig, "Neck", dt, if chase then 0.3 else 1.2, 0.8, 0.5, 1.0, 22, nil)
	twitchHead(rig, "NeckL", dt, 0.5, 1.2, 0.8, 1.4, 30, nil)
	twitchHead(rig, "NeckR", dt, 0.45, 1.2, 0.8, 1.4, 30, nil)
	local jaw = if kill then 1.1 elseif chase then 0.6 + math.abs(math.sin(t * 12)) * 0.3 else 0.2 + math.abs(math.sin(t * 1.4)) * 0.15
	set(rig, "Jaw", CFrame.Angles(-jaw, 0, 0))
	set(rig, "JawL2", CFrame.Angles(-(0.3 + math.abs(math.sin(t * 3.1)) * 0.5), 0, 0))
	set(rig, "JawR2", CFrame.Angles(-(0.3 + math.abs(math.sin(t * 2.7 + 1)) * 0.5), 0, 0))
	set(rig, "Spine", CFrame.Angles((if chase then -0.2 else 0) + math.sin(t * 1.1) * 0.05, s1 * 0.05 * stride, math.sin(t * 0.7) * 0.04))
	set(rig, "Waist", CFrame.new(0, math.abs(math.cos(g)) * 0.3 * stride, 0))
	for _, suffix in { "", "2" } do
		local a, b = if suffix == "" then s1 else s2, if suffix == "" then s2 else s1
		set(rig, "LHip" .. suffix, CFrame.Angles(a * 0.6 * stride, 0, 0))
		set(rig, "RHip" .. suffix, CFrame.Angles(b * 0.6 * stride, 0, 0))
		set(rig, "LKnee" .. suffix, CFrame.Angles(-math.max(0, a) * 0.8 * stride, 0, 0))
		set(rig, "RKnee" .. suffix, CFrame.Angles(-math.max(0, b) * 0.8 * stride, 0, 0))
	end
	local reach = if chase or kill then 1.2 else 0
	set(rig, "LShoulder", CFrame.Angles(reach + s2 * 0.35 * stride + math.sin(t * 1.4) * 0.07, 0, -0.1 * reach))
	set(rig, "RShoulder", CFrame.Angles(reach + s1 * 0.35 * stride + math.sin(t * 1.2 + 1) * 0.07, 0, 0.1 * reach))
	for i = 1, 4 do
		local curl = (math.sin(t * 6 + i * 1.3) + 1) * 0.15 + (if chase or kill then 0.45 else 0)
		set(rig, "LFinger" .. i, CFrame.Angles(-curl, 0, 0))
		set(rig, "RFinger" .. i, CFrame.Angles(-curl, 0, 0))
		-- back arms never stop moving
		local speedUp = if chase then 2.2 else 1
		set(rig, "BackArm" .. i, CFrame.Angles(math.sin(t * 1.7 * speedUp + i) * 0.35, math.sin(t * 1.3 * speedUp + i * 2) * 0.3, 0))
		set(rig, "BackElbow" .. i, CFrame.Angles(0, 0, math.sin(t * 2.3 * speedUp + i * 1.7) * 0.4))
	end
	if rig.eyeGlow then
		rig.eyeGlow.Brightness = 1.2 + math.abs(math.sin(t * (if chase then 6 else 2))) * 1.6
	end
	footstep(rig, s1, speed, 1.4, 0.6)
end

local function animate(rig: Rig, dt: number)
	local root = rig.root
	if root.Position.Y < -100 then
		return -- parked out of sight
	end
	local stateAttr = rig.model:GetAttribute("State")
	local state = if typeof(stateAttr) == "string" then stateAttr else "Wander"
	local vel = root.AssemblyLinearVelocity
	local speed = if root.Anchored then 0 else Vector3.new(vel.X, 0, vel.Z).Magnitude
	rig.gait += dt * speed * 0.42

	if rig.kind == "Statue" then
		animateStatue(rig)
		return
	elseif rig.kind == "Crawler" then
		animateCrawler(rig, dt, speed, state)
	elseif rig.kind == "Listener" then
		animateListener(rig, dt, speed, state)
	elseif rig.kind == "Amalgam" then
		animateAmalgam(rig, dt, speed, state)
	else
		animateHollow(rig, dt, speed, state)
	end

	-- clicking while it hunts
	local t = os.clock()
	if t >= rig.nextClick then
		rig.nextClick = t + 4 + math.random() * 7
		if (rig.kind == "Hollow" or rig.kind == "Listener") and (state == "Wander" or state == "Search" or state == "Investigate" or state == "Apparition") then
			local head = rig.model:FindFirstChild("Head")
			if head then
				Audio.play("MonsterClicks", head, 1.1, 0.9 + math.random() * 0.2, 80)
			end
		end
	end
	if rig.eyeGlow and rig.kind ~= "Amalgam" then
		local chase = state == "Chase" or state == "Kill"
		rig.eyeGlow.Brightness = (if chase then 2 else 1.2) * (if math.random() < 0.03 then 0.2 else 1)
	end
end

function MonsterAnimator.init()
	RunService.RenderStepped:Connect(function(dt: number)
		local model = workspace:FindFirstChild("Monster")
		if not model or not model:IsA("Model") then
			current = nil
			return
		end
		if not current or current.model ~= model then
			current = collect(model)
		end
		if current then
			animate(current, dt)
		end
	end)
end

return MonsterAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[--!strict
-- Sprinting (with stamina), crouch-walking, head bob, breathing, field of view.

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Audio = require(Shared:WaitForChild("Audio"))
local Config = require(Shared:WaitForChild("Config"))
local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local P = Config.Player
local player = Players.LocalPlayer

local Movement = {}

local humanoid: Humanoid? = nil
local stamina = P.StaminaMax
local sprintHeld = false
local exhausted = false
local lastSprint = 0
local bobTime = 0
local crouchOffset = 0
local breath: Sound? = nil

local function onCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	stamina = P.StaminaMax
	exhausted = false
	crouchOffset = 0
	ClientState.crouching = false
	if humanoid then
		humanoid.WalkSpeed = P.WalkSpeed
	end
end

local function update(dt: number)
	local h = humanoid
	if not h or not h.Parent or h.Health <= 0 then
		return
	end
	local now = os.clock()
	local camera = workspace.CurrentCamera

	local frozen = ClientState.hiding or ClientState.jumpscaring
	local moving = not frozen and h.MoveDirection.Magnitude > 0.1
	local wantsSprint = sprintHeld and moving and not ClientState.crouching and not exhausted

	if wantsSprint then
		stamina = math.max(0, stamina - P.StaminaDrain * dt)
		lastSprint = now
		if stamina <= 0 then
			exhausted = true
			Hud.message("You're out of breath.")
		end
	elseif now - lastSprint > P.StaminaRegenDelay then
		stamina = math.min(P.StaminaMax, stamina + P.StaminaRegen * dt)
	end
	if exhausted and stamina > P.StaminaMax * 0.35 then
		exhausted = false
	end
	ClientState.sprinting = wantsSprint
	Hud.setStamina(stamina / P.StaminaMax)

	local speed = P.WalkSpeed
	if ClientState.crouching then
		speed = P.CrouchSpeed
	elseif wantsSprint then
		speed = P.SprintSpeed
	elseif exhausted then
		speed = P.WalkSpeed * 0.75
	end
	h.WalkSpeed = speed

	-- crouch + head bob through the camera offset
	local crouchTarget = if ClientState.crouching and not frozen then -1.9 else 0
	crouchOffset += (crouchTarget - crouchOffset) * math.min(1, dt * 10)
	local bobX, bobY = 0, 0
	if moving then
		bobTime += dt * speed * 0.75
		local amp = if wantsSprint then 0.16 elseif ClientState.crouching then 0.05 else 0.09
		bobX = math.sin(bobTime) * amp
		bobY = math.abs(math.cos(bobTime)) * amp * 1.4
	end
	h.CameraOffset = Vector3.new(bobX, crouchOffset + bobY, 0)

	if camera and not ClientState.jumpscaring then
		local targetFov = P.FieldOfView + (if wantsSprint then 7 else 0) + ClientState.fear * 6
		camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(1, dt * 5)
	end

	-- heavy breathing when winded or terrified
	if breath then
		local need = math.max(0.65 - stamina / P.StaminaMax, ClientState.fear - 0.45, 0)
		local targetVolume = if frozen and ClientState.hiding then need * 0.6 else need * 1.6
		breath.Volume += (targetVolume - breath.Volume) * math.min(1, dt * 2)
		breath.PlaybackSpeed = 1 + need * 0.3
	end
end

function Movement.init()
	ContextActionService:BindAction("AchromaSprint", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin then
			sprintHeld = true
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			sprintHeld = false
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
	ContextActionService:SetTitle("AchromaSprint", "RUN")

	ContextActionService:BindAction("AchromaCrouch", function(_: string, state: Enum.UserInputState, _: InputObject): Enum.ContextActionResult?
		if state == Enum.UserInputState.Begin then
			ClientState.crouching = not ClientState.crouching
		end
		return Enum.ContextActionResult.Pass
	end, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
	ContextActionService:SetTitle("AchromaCrouch", "CROUCH")

	breath = Audio.create("BreathLoop", nil, 0)
	if breath then
		breath:Play()
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.RenderStepped:Connect(update)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Spectate</string>
            <string name="Source"><![CDATA[--!strict
-- After you're caught (or escape) while others are still inside, watch over a
-- survivor's shoulder. Click / R1 / tap to switch who you follow.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local ClientState = require(script.Parent.ClientState)
local Hud = require(script.Parent.Hud)

local GameState = ReplicatedStorage:WaitForChild("GameState")
local player = Players.LocalPlayer

local Spectate = {}

local target: Player? = nil
local active = false
local smoothed: CFrame? = nil

local function survivors(): { Player }
	local list = {}
	for _, p in Players:GetPlayers() do
		local character = p.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if p ~= player and humanoid and humanoid.Health > 0 and character and character:FindFirstChild("Head") then
			table.insert(list, p)
		end
	end
	return list
end

local function nextTarget()
	local list = survivors()
	if #list == 0 then
		target = nil
		return
	end
	local index = table.find(list, target :: any) or 0
	target = list[index % #list + 1]
	smoothed = nil
end

function Spectate.isActive(): boolean
	return active
end

function Spectate.init()
	UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
		if not active or processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonR1 then
			nextTarget()
		end
	end)

	RunService:BindToRenderStep("AchromaSpectate", Enum.RenderPriority.Camera.Value + 3, function(dt: number)
		local camera = workspace.CurrentCamera
		local shouldSpectate = ClientState.started
			and not ClientState.jumpscaring
			and player.Character == nil
			and GameState:GetAttribute("Phase") == "Playing"
		if not shouldSpectate then
			if active then
				active = false
				Hud.setHint("")
			end
			return
		end

		local list = survivors()
		if not target or not table.find(list, target) then
			target = nil
			nextTarget()
		end
		local t = target
		local character = if t then t.Character else nil
		local head = if character then character:FindFirstChild("Head") :: BasePart? else nil
		if not t or not head then
			active = false
			Hud.setHint("")
			return
		end
		active = true
		camera.CameraType = Enum.CameraType.Scriptable
		local look = head.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude < 0.01 then
			flatLook = Vector3.new(0, 0, -1)
		end
		local goal = CFrame.lookAt(head.Position - flatLook.Unit * 5 + Vector3.new(0, 2.2, 0), head.Position + flatLook.Unit * 10)
		smoothed = if smoothed then smoothed:Lerp(goal, math.min(1, dt * 6)) else goal
		camera.CFrame = smoothed :: CFrame
		Hud.setHint("SPECTATING  " .. t.DisplayName .. "     [click] next")
	end)
end

return Spectate
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
