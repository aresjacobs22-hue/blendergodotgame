          <string name="Name">SoundAtlas</string>
          <string name="Source"><![CDATA[--!strict
-- AUTO-GENERATED by tools/generate_audio.py. Do not edit by hand.
-- Where every effect lives inside assets/audio/ACHROMA_SFX.ogg (seconds).

