			Width = 13,
			Depth = 13,
			Hub = "hall",
			HubWidth = 3,
			HubDepth = 2,
			DeadEndBraid = 0.4,
			ExtraOpenings = 6,
			Openness = 0,
			Rooms = 6,
			RoomDoors = true,
			SpotCount = 4,
			BatteryCount = 4,
			LockerCount = 8,
			LampChance = 0.7,
			LampSpacing = 3,
			WritingCount = 12,
		},
		lighting = {
